      end
      group_stat = OS.ERROR()
      if group_stat = 0 then
        crt sysmsg(10014,group_name)   ;* Group -  %1 created
      end else
        crt sysmsg(10015,group_name,group_stat)   ;* Unable to create group: %1 status: %2
