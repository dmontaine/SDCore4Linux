$internal
program $create.account
$catalog $CREATEA

$include keys.h
$include int$keys.h
$include parser.h
$include err.h
* 20240219 mab user must be member of sdusers  
deffun is_grp_member(user,group) calling '!is_grp_member'
* rev 0.9.0 *
deffun is_group(group) calling '!is_group'
deffun is_user(uname) calling '!is_user'
deffun create_user(uname) calling '!create_user'
deffun set_passwd(uname)  calling '!set_passwd'
deffun valid_os_name(name) calling '!valid_os_name'
deffun valid_os_path(path) calling '!valid_os_path'

   prompt ''

* rev 0.9.0 create-account requires admin priv, are we admin?
   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end
      
* we run as root, and the root umask is usually 022, that will not work for us
   if umask(002) then null

   parser = "!PARSER"
   no.query = @false

   @system.return.code = -ER$ARGS     ;* Preset for argument errors


   openpath @sdsys:@ds:'ACCOUNTS' to acc.f else
      @system.return.code = -status()
      stop sysmsg(6000) ;* Cannot open ACCOUNTS file in SDSYS account
   end


   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb create-account
   * 20240219 mab dflt user and group parent directory for accounts
   * Get next token, could be USER, GROUP or account name

   call @parser(PARSER$GET.TOKEN, token.type, acc.type, keyword)
   *
   uid = ''
   group_name = ''   ;* will be set to callers entered group name on group create, no case changes
* 09 Sep 26 dm - PRE_RELEASE 18.  STANDARD is the default, so an account made
*   by somebody who has read none of this is the least privileged one.  The
*   keyword GRANTS rather than restricts.
   tier = 'STANDARD'
* 10 Sep 26 dm - Parity audit: SH-ON / OS-ON at creation.  Off unless typed.
   os.sh = @false
   os.exec = @false
   begin case
   case upcase(acc.type) = 'USER'
*    CREATE.ACCOUNT USER <user acct name>  {NO.QUERY}   
     pathname = CONFIG('USRDIR')
     if pathname = '' then pathname = '/home/sd/user_accounts'
     call @parser(PARSER$GET.TOKEN, token.type, acc.uname, keyword)
     if token.type = PARSER$END then stop
     * any other args? (specifically no.query)
     * rem we may abort in this routine
     gosub more.args
     
     * Is the user a valid os user?
     * Check reserved names then
     * Check user name as entered, then force to lower case and re check
     begin case
     
     * is user reserved?
     case upcase(acc.uname) = 'ROOT' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
     
     case upcase(acc.uname) = 'SDSYS' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
      
     case upcase(acc.uname) = 'SDUSERS' 
       @system.return.code = -ER$ARGS
       stop sysmsg(6052) ;* User name is invalid
          
     case is_user(acc.uname)
       null ;* user name as entered is valid
  
     case is_user(downcase(acc.uname))
       * lower is a valid user, use it
       acc.uname = downcase(acc.uname)
 
     case no.query
       * we don't have a valid user name and option no query specified, this will not work!
         @system.return.code = -ER$ARGS
         stop sysmsg(6074)  ;*    Invalid user name 
       
     case 1
       * not a valid os user, are we configured to auto create os user?
* 10 Sep 26 dm - CONFORM TO THE PORT (its CREATEA, 14 Aug 2026): the
*   config('CREATUSR') gate is gone.  SD has accounts, not accounts-and-users as
*   QM/ScarletDME do - creating an account IS creating the OS account, so there is
*   nothing to opt in to.  CREATUSR still parses (config.c) and CONFIG still
*   prints it; nothing consults it here any more.  (no.query with no OS user is
*   still refused above - creating one needs the interactive password prompt.)
       * sd convention is os user names are lowercase, if you don't want this, pre create the os user
         acc.uname = downcase(acc.uname)
		 * Check INVERT/NOINVERT STATUS (1=INVERT on)
         PVAL = SYSTEM(1001)
         IF PVAL = 1 THEN
           CRT "Warning: **** Case Inversion is not active during password entry! ****"   
         END
         if not(create_user(acc.uname)) then
           * create user failed
           * 10 Sep 26 dm - the minus was missing (port's 21 Aug fix): a refused
           *   create left +6, indistinguishable from "6 things done".
           @system.return.code = -ER$NOT.CREATED
           stop sysmsg(10006,STATUS()) ;* Create User Failed, OS Error: %1
         end else
           crt sysmsg(10007,acc.uname)  ;* 'User ':acc.uname:' Created' 
           * user created set passowrd
PW.TRY.AGAIN:
           if not(set_passwd(acc.uname)) then
* 11 Sep 26 dm - SAY WHY (port PRE_RELEASE_FIXES 22).  !set_passwd already
*   left the reason in status() and this discarded it, so every failure read
*   the same.  status() is read IMMEDIATELY, before anything can reset it.
*   The Linux cases, and why they are these and not the port's four:
*     6  - !set_passwd's own refusal, the session is not an administrator.
*          Unreachable from here (this verb is gated at the top) and mapped
*          anyway so 10120 keeps the port's meaning.
*     2  - the name was refused: !set_passwd's valid_os_name check, or
*          sd-elevate's refusal (it exits 2 for root, sdsys and every account
*          below UID_MIN).  passwd's own 2, "invalid combination of options",
*          cannot arise from the fixed argument list.
*     10 - passwd(1): "an error was returned by pam" (man 1 passwd).  That one
*          code covers both "the two entries did not match" and "the policy
*          refused it", so the port's 10118/10119 cannot be told apart here and
*          10910 says both.
*     any other - the number, verbatim (10121).
*   2 and 6 cannot succeed on a retry, so no retry is offered for them.
              pw.stat = status()
              pw.retry = @true
              begin case
                 case pw.stat = 6
                    crt sysmsg(10120) ;* Not an SD administrator - retrying will not help
                    pw.retry = @false
                 case pw.stat = 2
                    crt sysmsg(10909, acc.uname) ;* SD may not set this user's password
                    pw.retry = @false
                 case pw.stat = 10
                    crt sysmsg(10910) ;* Not accepted: mismatch, or the password rules
                 case 1
                    crt sysmsg(10121, pw.stat) ;* The password could not be set (status %1)
              end case
              if pw.retry then
                 crt sysmsg(10008): ;* 'Warning, user created but password not set, Retry (Y/N)'
                 input yn
                 if upcase(yn) = 'Y' then goto PW.TRY.AGAIN
              end
           end
         end
     end case
     
     
     * save uid and gid for set.owner of USER account
     uid = acc.uname  
     gid = "sdu_":acc.uname
     pathname := @ds:acc.uname
     acc.name = acc.uname
     

   case upcase(acc.type) = 'GROUP' 
*    CREATE.ACCOUNT GROUP <grp acct name>  {NO.QUERY}     
     pathname = CONFIG('GRPDIR')
     if pathname = '' then pathname = '/home/sd/group_accounts'
     call @parser(PARSER$GET.TOKEN, token.type, acc.name, keyword)
     if token.type = PARSER$END then stop
     pathname := @ds:acc.name
     if upcase(acc.name) = 'SDUSERS' then
       @system.return.code = -ER$ARGS
       stop sysmsg(2202) ;* Account name is invalid
     end        
     * any other args? (specifically no.query)
     * rem we may abort in this routine
     gosub more.args
       
*
   case upcase(acc.type) = 'OTHER'  
*  CREATE.ACCOUNT OTHER <acc name> <path> {NO.QUERY} 
     * get account name
     call @parser(PARSER$GET.TOKEN, token.type, acc.name, keyword)
     if token.type = PARSER$END then stop
     if upcase(acc.name) = 'SDUSERS' then
       @system.return.code = -ER$ARGS
       stop sysmsg(2202) ;* Account name is invalid
     end 
     * Get pathname
     call @parser(parser$get.token, token.type, pathname, keyword)
     if token.type = PARSER$END then stop
     pathname = trim(pathname)
     * any other args? (specifically no.query)
     * rem we may abort in this routine
     gosub more.args
*
   case 1
*   invalid command arg
* rev 0.9.0 
    crt 'Command Syntax: CREATE.ACCOUNT USER | GROUP <user name | group name> {ADMINISTRATOR | PROGRAMMER} {SH-ON} {OS-ON} {NO.QUERY}'
    @system.return.code = -ER$ARGS
    stop 
   end case

   * Check if already exists in ACCOUNTS file.  We will need to do this
   * again when we are ready to create the account but doing it here
   * saves the user typing the path name before we spot the error.

   read acc.rec from acc.f, acc.name then      ;* 0275
      @system.return.code = -ER$ACC.EXISTS
      stop sysmsg(6002) ;* Account already exists
   end

   * Validate account name

   acc.name = upcase(acc.name)

   if len(acc.name) > 32 or not(alpha(acc.name[1,1])) or index(acc.name, ' ', 1) then
      stop sysmsg(6003) ;* Account name is invalid
   end

   * Validate pathname

   if not(ospath(pathname, OS$PATHNAME)) then
      stop sysmsg(6005) ;* Invalid account pathname
   end


   * Check if already exists in ACCOUNTS file

   readu acc.rec from acc.f, acc.name locked
      stop sysmsg(6006, status()) ;* ACCOUNTS record is locked by user xx
   end then
      @system.return.code = -ER$ACC.EXISTS
      stop sysmsg(6002) ;* Account already exists
   end

   * Check parent directory exists


   if index(pathname, @ds, 1) then
      parent.dir = field(pathname, @ds, 1, dcount(pathname, @ds) - 1)
      if parent.dir # '' and not(parent.dir matches "1A':") then
         if not(ospath(parent.dir, OS$EXISTS)) then
            @system.return.code = -ER$NO.DIR
            stop sysmsg(6008) ;* Parent directory does not exist
         end
      end
   end

   pathname = ospath(pathname, OS$FULLPATH)

   * Check if account directory exists
   * rev 0.9.0 we no longer support conversion of existing directoris to sd accounts
   * too many unknows with whether this is a non sd type account (Scarlett or other)

   if ospath(pathname, OS$EXISTS) then
      @system.return.code = -ER$NOT.CREATED
      stop sysmsg(10009) ;* 'Cannot Create a New SD Account in an Existing Directory'
   end else
   * create the new account directory  
      create.file pathname directory on error
         @system.return.code = -ER$NOT.CREATED
         stop sysmsg(6013) ;* Unable to create account directory
      end
      
* rev 0.9.0 *
* for all accounts set the setgid bit
* When the bit is set for a directory, the set of files in that directory will have the same group as the group of the parent directory,
* and not that of the user who created those files.
* This is used for file sharing since they can be now modified by all the users who are part of the group of the parent directory.
*
      if upcase(acc.type) = "GROUP"  or  upcase(acc.type) = "USER" then
        * Modified by Composer AI - 2026/06/10.
        * Use shared !valid_os_path before OS.EXECUTE (phase 2).
        * path.chars = '...'
        * if pathname = '' or convert(path.chars, '', pathname) # '' then
        if not(valid_os_path(pathname)) then
          crt sysmsg(10011,2) ;* 'Warning unable to setgid bit on Group Folder, status: %1
        end else
* 09 Sep 26 dm - PRE_RELEASE 14.  Through the helper; see SET_PASSWD for why.
*   "sudo chmod g+s" on an arbitrary path is root by another route.  sd-elevate
*   resolves the path with realpath FIRST and refuses anything outside the
*   accounts root, so a planted symlink cannot aim it at /usr or /etc.
        OS.EXECUTE "sudo /usr/local/sbin/sd-elevate setgid ":pathname
        * --------------------
        stat = OS.ERROR()
        if stat = 0 then
          crt sysmsg(10010,pathname)  ;* setgid bit set on: %1 
        end else
          crt sysmsg(10011,stat) ;* 'Warning unable to setgid bit on Group Folder, status: %1
        end
        end
      end

      
     * rev 0.9.0  create group for the account *   
      begin case
      case upcase(acc.type) = "USER" 

     *  is this user a member or sdusers?
        if not(is_grp_member(acc.uname,'sdusers')) then
         * not a member, add them
          * Modified by Composer AI - 2026/06/10.
          * Use shared !valid_os_name before os.execute (phase 2).
          * os.name.chars = '...'
          if not(valid_os_name(acc.uname)) then
             crt sysmsg(10012,acc.uname,2) ;* Warning unable to add user to sdusers, user: %1 status: %2
          end else
* 09 Sep 26 dm - PRE_RELEASE 14.  Through the helper.  Argument order reverses:
*   "addgroup <user> <group>", not "-aG <group> <user>".
          os.execute "sudo /usr/local/sbin/sd-elevate addgroup ":acc.uname:" sdusers"
          * --------------------
          stat = OS.ERROR()
          if stat = 0 then
            crt sysmsg(10013,acc.uname)   ;* %1 added to sdusers'
          end else
            @system.return.code = -ER$FAILED
            stop sysmsg(10012,acc.uname,stat) ;* Unable to add user %1 to sdusers, status: %2
          end
          end
        end

* 09 Sep 26 dm - PRE_RELEASE 18/14.  AN ADMINISTRATOR ALSO JOINS sdadmin, which
*   is the group the sudoers drop-in grants SD's privileged helper to.  Nothing
*   populated it before this, so the helper shipped and no one could invoke it.
*
*   sdusers ABOVE IS THE OTHER HALF AND IS NOT DUPLICATED HERE.  Every USER
*   account joins sdusers whatever its tier - that is what LOGIN's
*   "registered for SD use" test reads - and an administrator is a registered
*   user first and a privileged one second, which is the owner's definition in
*   the order he gave it.
*
*   THE GUARD IS THE TIER AND NOTHING ELSE.  Group and Other accounts have no
*   person to privilege, and this arm is already inside case acc.type = USER.
        if tier = 'ADMINISTRATOR' then
          if not(is_grp_member(acc.uname,'sdadmin')) then
            if not(valid_os_name(acc.uname)) then
              crt sysmsg(10033,acc.uname,2) ;* Unable to add user %1 to sdadmin, status: %2
            end else
* 09 Sep 26 dm - PRE_RELEASE 14.  Through the helper.  This was called out as
*   the one call that could not use it, because the first administrator is not
*   in sdadmin when it runs and the helper would refuse them.  ***THAT IS NO
*   LONGER TRUE AND THE REASON IS WORTH KEEPING***: this code only ever runs in
*   a session that reached CPROC's root-entry block, so its REAL uid is 0, and
*   sudo permits root whatever the drop-in says.  The drop-in's %sdadmin rule
*   is what a non-root administrator would need, and there is no such caller.
              os.execute "sudo /usr/local/sbin/sd-elevate addgroup ":acc.uname:" sdadmin"
              stat = OS.ERROR()
              if stat = 0 then
                crt sysmsg(10032,acc.uname)  ;* %1 added to sdadmin
              end else
                @system.return.code = -ER$FAILED
                stop sysmsg(10033,acc.uname,stat) ;* Unable to add user %1 to sdadmin, status: %2
              end
            end
          end
        end


      *
      * create user's sd group      
        group_name = "sdu_":acc.uname      
        gosub create.group  
        if not(group_success) then
          stop
        end
		
      case upcase(acc.type) = "GROUP" 
      *
      * create account's sd group 
* rev 1.0-1	  
        group_name = downcase("sdg_" : acc.name) ;* callers entered group name, force lower case with sdg_prefix
        gosub create.group
        if not(group_success) then
          stop
        end     
      end case
      
      *      
*     make the accountfolders and copy files    
*     Note --> if there is a failure in make.account the program terminates
*     We could end up with groups created and no acctual account
*
      gosub make.account
      

 * 20240225 mab set file ownership for account parent dir
      set.owner.path = pathname
      gosub set.owner

   end

   * Add ACCOUNTS entry

   display sysmsg(6014) ;* Adding to register of accounts...

   acc.rec = ''
   acc.rec<ACC$PATH> = pathname
   * rev 0.9.0 add group name to ACCOUNT record
   * group name depends on which type of ACCOUNT we are creating
   * We do not default to ACCOUNT name because account names are (historically?) always upper case
   * Not sure what to do about account type "OTHER" ???
   begin case
   case upcase(acc.type) = "USER"
     acc.rec<ACC$GROUP> = "sdu_":acc.uname
   case upcase(acc.type) = "GROUP"
     acc.rec<ACC$GROUP> = group_name
   end case
* 09 Sep 26 dm - PRE_RELEASE 18.  Field 5 is the SD half of the owner's
*   definition of an administrator: sudoers membership is the OS half, and this
*   is the register saying what SD thinks the account is.  Written for every
*   account type, so a listing never has to treat a blank as a tier.
*   ACC$PRIOR.TIER (6) is left blank, which is what "not suspended" reads as.
*   NOTHING CONSULTS THIS YET - the gates are the second commit.
   acc.rec<ACC$TIER> = tier

* 10 Sep 26 dm - PARITY AUDIT: THE OS-ACCESS GRANTS AT CREATION.  The port's
*   grant.os.access writes them for a USER account only and returns for any
*   other type - a GROUP or OTHER account has no person to grant a shell to,
*   and MODIFY.ACCOUNT's os.set refuses one (10105).  An ADMINISTRATOR holds
*   both by tier (LOGIN / CPROC logto), so nothing is written for one and
*   MODIFY.ACCOUNT refuses to change them (10106).  10102 reports the result.
   os.written = @false
   if upcase(acc.type) = 'USER' and tier # 'ADMINISTRATOR' then
      if os.sh or os.exec then
         acc.rec<ACC$SH> = 'no'
         if os.sh then acc.rec<ACC$SH> = 'yes'
         acc.rec<ACC$OS.EXEC> = 'no'
         if os.exec then acc.rec<ACC$OS.EXEC> = 'yes'
         os.written = @true
      end
   end

   write acc.rec to acc.f, acc.name
   close acc.f

   if os.written then
      display sysmsg(10102, acc.name, acc.rec<ACC$SH>, acc.rec<ACC$OS.EXEC>)
      * Account %1 has SH %2, OS.EXECUTE %3
   end

   @system.return.code = 0
   return

* ======================================================================

make.account:
   * Set up VOC

   display sysmsg(6015) ;* Creating VOC...
* rev 0.9-3 Nov 25 move voc back to dynamic file
   create.file pathname:@ds:'VOC' dynamic on error
      @system.return.code = -6
      stop sysmsg(6016) ;* Unable to create VOC
   end
   set.owner.path = pathname:@ds:'VOC'
   gosub set.owner
   set.owner.path = pathname:@ds:'VOC':@ds:'%0'
   gosub set.owner
   set.owner.path = pathname:@ds:'VOC':@ds:'%1'
   gosub set.owner

   openpath pathname:@ds:'VOC' to voc.f else
      @system.return.code = -status()
      stop sysmsg(6017) ;* Unable to open new VOC
   end

   openpath @sdsys:@ds:"NEWVOC" to newvoc.f else
      @system.return.code = -status()
      stop sysmsg(6018) ;* Cannot open SDSYS NEWVOC
   end

* 10 Sep 26 dm - SL1, the per-tier VOC.  The VOC an account gets now depends on
*   its tier (the `tier` variable set above, written to ACC$TIER).  STANDARD gets
*   NEWVOC less the verbs named in NEWVOC's TIER.OMIT.STANDARD ("run an
*   application, not build one"); PROGRAMMER gets NEWVOC entire; ADMINISTRATOR
*   gets that plus the admin verbs named in TIER.ADD.ADMINISTRATOR, copied from
*   VOC_TEMPLATE.  The two control records are never copied into an account VOC.
*   Matching is case-insensitive so it survives the lower-case conversion (SL M).
   omit.rec = ''
   add.rec = ''
   if tier = 'STANDARD' then
      read omit.rec from newvoc.f, 'TIER.OMIT.STANDARD' else omit.rec = ''
   end
   if tier = 'ADMINISTRATOR' then
      read add.rec from newvoc.f, 'TIER.ADD.ADMINISTRATOR' else add.rec = ''
   end
   omit.count = dcount(omit.rec, @fm)

   select newvoc.f to 11
   loop
      readnext id from 11 else exit

      copy.it = @true
      if upcase(id) = 'TIER.OMIT.STANDARD' then copy.it = @false
      if upcase(id) = 'TIER.ADD.ADMINISTRATOR' then copy.it = @false
      if copy.it and omit.count > 1 then
         for omit.i = 2 to omit.count
            if upcase(trim(omit.rec<omit.i>)) = upcase(id) then
               copy.it = @false
               omit.i = omit.count         ;* stop looking
            end
         next omit.i
      end

      if copy.it then
         read rec from newvoc.f, id then
* 10 Sep 26 dm - THE RECORD IS COPIED WHOLE, the port's PRE_RELEASE_FIXES 136
*   (2 Sep 2026).  Two lines here reduced field 1 - the DESCRIPTION whose first
*   character is the type code - to that one character, and did the same to
*   field 3 of a K record, so every created account listed a bare "F" where
*   SDSYS shows a sentence.  CPROC reads only voc.rec[1,1] and [1,2], so
*   nothing needed the bare form.  LOGIN's update.voc and MODIFYA's
*   tier.build.rec changed with it: all three must agree, or an update or a
*   tier change undoes what creation wrote.
            write rec to voc.f, id

         end
      end
   repeat

   close newvoc.f

   if tier = 'ADMINISTRATOR' then
      add.count = dcount(add.rec, @fm)
      if add.count > 1 then
         openpath @sdsys:@ds:"VOC_TEMPLATE" to voctmpl.f then
            for add.i = 2 to add.count
               add.id = trim(add.rec<add.i>)
               read rec from voctmpl.f, add.id then
                  write rec to voc.f, add.id
               end
            next add.i
            close voctmpl.f
         end
      end
   end

