more.args:
   loop
      call @parser(parser$get.token, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case keyword = KW$NO.QUERY
            no.query = @true

* 09 Sep 26 dm - PRE_RELEASE 18, the tier keywords.
*
*   MATCHED ON THE TOKEN TEXT RATHER THAN ON A KW$ CONSTANT, and that is the
*   port's reasoning taken as-is: the keyword numbers in SYSCOM/PARSER.H are a
*   positional table shared by every verb, so adding an entry to serve one verb
*   is a larger and riskier change than this is worth.  THE COST IS THAT THESE
*   CANNOT BE ABBREVIATED, unlike NO.QUERY.
*
*   STANDARD IS NOT A KEYWORD, it is the default - again matching the port.  A
*   caller who types it gets the "unexpected token" answer below.
         case upcase(token) = 'ADMINISTRATOR'
            tier = 'ADMINISTRATOR'

* AND PROGRAMMER MUST NOT DOWNGRADE.  Both keywords are accepted on one command
*   line and in either order, so PROGRAMMER given after ADMINISTRATOR would
*   otherwise silently take the higher tier away again.
         case upcase(token) = 'PROGRAMMER'
            if tier # 'ADMINISTRATOR' then tier = 'PROGRAMMER'

* 10 Sep 26 dm - PARITY AUDIT: "SH-ON" AND "OS-ON", the port's grammar (its
*   CREATEA, 27 Aug 2026).  Two independent switches, so "SH-ON OS-ON" is both
*   and neither cancels the other.  Written at the register write below.
         case upcase(token) = 'SH-ON'
            os.sh = @true
         case upcase(token) = 'OS-ON'
            os.exec = @true

         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
   repeat
return
