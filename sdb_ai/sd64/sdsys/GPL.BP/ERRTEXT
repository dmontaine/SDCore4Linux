subroutine errtext(expansion, errno)
$catalogue !errtext
* Linux port, plan D6: ERRGEN empties SYSCOM/ERR.H before it regenerates, and
* reads ./gplsrc/err.h - a path that only exists in the dev tree - so a compile
* of ERRTEXT on an installed system would wipe every error definition.  ERRTEXT.H
* and SYSCOM/ERR.H are generated by gplbld/gen_includes.py now; the tracked
* ERRTEXT.H included below is current.
*$execute 'RUN GPL.BP ERRGEN'

   err = ''
   text = ''
$include errtext.h

   locate errno in err<1> setting pos then
      expansion = text<pos>
      if expansion[10] = '(os.error)' then
         expansion = expansion[1, len(expansion)-1] : ' ' : os.error() : ')'
      end
   end else
      expansion = errno
   end

   return
end

* END-CODE
