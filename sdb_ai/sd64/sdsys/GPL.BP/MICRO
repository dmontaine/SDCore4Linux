* START-HISTORY:
* 10 Sep 26 MICRO RAN NOTHING OUTSIDE A sudo SESSION.  It launched micro with
*           execute "!", which CPROC's SH gate (10053) refuses to anyone without
*           the SH grant - found by the owner, 10 Sep.  Now, as the port's
*           gpl.bp/EDIT: check_permitted refuses in words BEFORE a working copy
*           exists (no terminal; neither administrator nor OS.EXECUTE grant),
*           find_editor says so when micro is not installed (PRE_RELEASE 4),
*           and the editor is launched with os.execute, which this $internal
*           program may use.  The file name is also tried as typed, then lower,
*           then upper case, so "micro bp test" finds BP.
* 09 Sep 26 A BP record's working copy now ends ".sdbasic", so micro can pick
*           the SD BASIC syntax file. micro matches on the file name it is
*           given, which is this working copy's and not the record's, so
*           without the suffix nothing could carry the language across and the
*           highlighting silently did not happen. Same test the Windows port's
*           gpl.bp/EDIT uses.
* END-HISTORY
*
PROGRAM MICRO

$internal
$catalog $MICRO

$include int$keys.h

*************************************************************
* Main Program                                              *
*************************************************************

True			= @true
False			= @false

* flag variables
CompiledDict	= False
DeleteError		= False
FilesOpened		= False
RecordSaved		= False
WriteError		= False

Cmd			= convert(" ",@FM,trim(@COMMAND," ","C"))
Editor			= "micro"
ErrorText		= ""
InputRecord		= ""
Response		= ""
TempRecord 		= ""

if trim(cmd<2>," ","B") = "DICT" then
	InFileName	= cmd<3>
	InRecordName	= cmd<4>
	DictText	= "DICT"
end else
	InFileName	= cmd<2>
	InRecordName	= cmd<3>
	DictText	= ""
end 

if trim(InFileName) = "" then
	ErrorText = "No File Name Specified"
	goto End_Program
end

* 10 Sep 26 dm - THE TWO REFUSALS COME FIRST, BEFORE THE SCREEN IS CLEARED OR A
*   WORKING COPY IS WRITTEN, so a refusal leaves nothing behind and says why.
gosub check_permitted
if ErrorText # "" then goto End_Program
gosub find_editor
if ErrorText # "" then goto End_Program

* 10 Sep 26 dm - THE RECORD NAME REACHES THE SHELL inside single quotes, so a
*   name containing one would break the command.  Refused rather than escaped:
*   ED edits such a record without any shell.
if index(InRecordName, "'", 1) then
	ErrorText = "MICRO cannot edit a record whose name contains a single quote; use ED."
	goto End_Program
end

TempFileName	= "$HOLD"

if DictText = "DICT" then
	TempRecordName	= "DICT." : InRecordName : ".editing"
end else
	TempRecordName	= InRecordName : ".editing"
end

*  ***AND A BP RECORD GETS A ".sdbasic" ON THE END, WHICH IS WHAT MAKES THE
*  HIGHLIGHTING WORK.***  micro chooses a syntax file by matching a regex
*  against the FILE NAME, and the name it sees is this working copy's, not the
*  record's - a record called MY.REPORT tells it nothing.  The suffix is the
*  only thing that can carry the language across, and gplbld/microcfg/syntax/
*  sdbasic.yaml detects exactly it.
*
*  ".editing" IS KEPT IN FRONT OF IT so a working copy left behind by a session
*  that died is still recognisable as one, whichever kind it is.
*
*  Taken from the Windows port's gpl.bp/EDIT, which uses the same test.
if DictText # "DICT" and upcase(InFileName[-2, 2]) = "BP" then
	TempRecordName := ".sdbasic"
end

*************************************************************
* Main Program                                              *
*************************************************************
crt @(-1) :

gosub open_files

if FilesOpened = True then

	loop
		gosub process_record
		if trim(TempRecord," ","B") <> "" then			
			crt
			if TempRecord <> InputRecord then
				gosub save_record_query	
			end else
				crt @(0,5) : @(-3) : "Record is unchanged"
				RecordSaved = True
			end
			if RecordSaved =  True then
				gosub compile_record_query
				Response = ""
				loop
					crt @(0,22) : @(-3) : "<E>xit or <R>e-edit : " :
					input @(22,22) : Response,1 :
					crt
					Response = upcase(Response)
				until index("ER",Response,1) > 0 repeat		
				if Response = "E" then	
					delete TempFile,TempRecordName on error DeleteError = True
					if DeleteError = True then
						ErrorText = "Warning: Temporary record " : Tempfilename : " " : TempRecordName : "was not  deleted."
					end
					goto End_Program		
				end			
			end		
		end else
			ErrorText = "Record is empty - not saved"
			goto End_Program
		end	
	repeat
end else
	ErrorText = "Error: Could not open files"
end

End_Program:
	if ErrorText = "" then
		crt @(0,25) : "Micro Ended Normally"
	end else
		crt @(0,25) : ErrorText
	end
	crt @(0,27) :
	Stop


*****************************************************
* SUBROUTINES: Alphabetical                         *
*****************************************************

compile_record_query:
	if CompiledDict = True then
		execute "CD " : InfileName : " " : InRecordName
	end else
        if DictText <> "DICT" then
		    prompt ""
		    response = ""
		    if upcase(InfileName[-2,2]) = "BP" then
 		       loop
 			       crt @(0,8) : @(-3) : "Compile " : InfileName : " " : InRecordName
			       crt @(3,9) : "<Y>es, <N>o : " :
			       input @(17,9), Response,1 :
			       Response = upcase(Response)
		       until index("YN",Response,1) > 0 repeat
		       if Response = "Y" then
		           crt @(0,12) :  @(-3):
			       execute "BASIC " : InFileName : " " : InRecordName
			       crt
			       loop
				       crt @(0,20) : @(-3) : "Catalog? <L>ocal, <P>rivate, <G>lobal, <N>o : " :
				       input @(46,20), Response,1 :
				       Response = Upcase(Response)
			       until index("LPGN",Response,1) > 0 repeat
			       crt @(0,22) : @(-3) :
			       begin case
				       case Response = "L"
					       execute "CATALOG " : InFileName : " " : InRecordName : " LOCAL"
				       case Response = "P"
					       execute "CATALOG " : InFileName : " " : InRecordName 
				       case Response = "G"
					      execute "CATALOG " : InFileName : " " : InRecordName : " GLOBAL"
				       case Response = "N"
					      crt InfileName : " " : InRecordName : " Not Cataloged"
			       end case
			       crt
			   end
		    end
        end
	end			
return

open_files:
* 10 Sep 26 dm - AS TYPED, THEN LOWER CASE, THEN UPPER CASE - the order SL M1
*   sets for the lower-case conversion.  "micro bp test" found nothing because
*   only BP exists on a case-sensitive filesystem.  The name that opened
*   replaces InFileName, so the compile and catalogue prompts use it too.
*   SL M's fold will make this redundant; it is harmless after it.
	OpenOk = False
	OpenName = InFileName
	open DictText, OpenName to InputFile then OpenOk = True
	if not(OpenOk) and downcase(InFileName) # InFileName then
		OpenName = downcase(InFileName)
		open DictText, OpenName to InputFile then OpenOk = True
	end
	if not(OpenOk) and upcase(InFileName) # InFileName then
		OpenName = upcase(InFileName)
		open DictText, OpenName to InputFile then OpenOk = True
	end
	if OpenOk then
		InFileName = OpenName
		open TempFileName to TempFile then	
			FilesOpened = True
		end else
			ErrorText = "File Error: " : TempFileName : " could not be opened."	
			goto End_Program	
		end	
	end else
		ErrorText = "File Error: " : DictText : " " : InFileName : " could not be opened."
		goto End_Program
	end
return

process_record:
    if trim(InRecordName," ","B") <> "" then
		crt @(-1) : "Editing " : InFileName : "," : InRecordName :
    	read InputRecord from InputFile,InRecordName then
    		TempRecord = InputRecord
    		if DictText = "DICT" then
				TempStr = field(TempRecord,@FM,1)
				TempStr = trim(TempStr," ","B")
				TempStr = TempStr[1,1]
				if index("CI",TempStr,1) > 0 then
					CompiledDict = True
					TempRecord = field(TempRecord,@FM,1,15)
				end
			end 		
			Write TempRecord to Tempfile,TempRecordName on error WriteError = True
			if WriteError = True then
				ErrorText = "Write Error: Temporary Record Could Not Be Created"
				goto End_Program
			end
		end
		
		gosub place_syntax_file
* 10 Sep 26 dm - os.execute, NOT execute "!".  The "!" verb is CPROC's
*   os.command, which applies the SH gate (10053) to the PERSON, so MICRO failed
*   for everyone without the SH grant even when check_permitted would have
*   allowed it.  This program is $internal, so op_sh admits the call; the
*   permission question has already been asked, in check_permitted.
	   	os.execute "'" : EditorPath : "' '" : TempFileName : "/" :  TempRecordName : "'"
		EditorRc = os.error()

		Read TempRecord from TempFile,TempRecordName then
			*null
		end else
			ErrorText =  "Record was not saved: Micro =  <Ctrl+s>"
			if EditorRc # 0 then ErrorText := "  (the editor exited " : EditorRc : ")"
			goto End_Program
		end
	end else
		ErrorText =  "Error: No Record Name Provided"
		goto End_Program
	end
return


save_record_query:
	if DictText <> "DICT" then
		prompt ""
		Response = ""
		loop
		    crt @(0,5) : @(-3) : DictText : " " : InfileName : " " : InRecordName : " has been updated"
		    crt @(5,6) : "Save <Y>es, <N>o : " :
		    input @(24,6) : Response,1 :
		    crt
		    Response = upcase(Response)
		until index("YN",Response,1) > 0 repeat
		crt
	end else
		* always save dicts
		Response = "Y"
	end	
	if Response = "Y" then
		gosub update_record
		RecordSaved = True			
	end else
		ErrorText = "Record Not Saved"
		goto End_Program
	end
return

update_record:
	Write TempRecord to InputFile,InRecordName on error WriteError = True
	if WriteError = True then
		ErrorText = "Write Error: Original Record " : DictText : " " : InFileName : " " : InRecordName : " Could Not Be Updated."
		goto End_Program
	end
return

*************************************************************
* place_syntax_file                                         *
*************************************************************
*
* 09 Sep 26 dm - PRE_RELEASE 12.  PUT sdbasic.yaml WHERE micro ACTUALLY LOOKS.
*
*  ENTRY 2 GENERATED AND VALIDATED THE FILE AND NOTHING PLACED IT, so the
*  highlighting the owner asked to keep from the Windows port never reached
*  anybody.  ***AND INERT LOOKS EXACTLY LIKE WORKING***: micro reports a syntax
*  file it cannot use, or never found, by simply not highlighting.
*
*  IT HAS TO BE PER-USER, WHICH IS WHY THE INSTALLER CANNOT DO IT.  Measured on
*  this machine, 9 Sep 26: micro 2.0.15, config directory ~/.config/micro, and
*  ***there is no /usr/share/micro*** - stock micro has no system-wide syntax
*  path.  installsdai.sh runs under sudo and cannot populate the home of every
*  user who will ever run SD, and an account created next month would get
*  nothing.  So the copy happens here, on first use, per caller, with no
*  privilege - and it self-heals for accounts made later.
*
*  cp -u, NOT cp: it copies only when the master is NEWER, so a regenerated
*  sdbasic.yaml reaches an existing user on their next edit, and a user who has
*  edited their own copy keeps it until SD's genuinely moves on.
*
*  $HOME IS LEFT FOR THE SHELL TO EXPAND.  SD does not interpolate it, and the
*  shell knows the caller's home whatever SD thinks the account is - which is
*  the distinction that matters on the sudo path, where the account is SDSYS
*  and the person is not.
*
*  IT IS DELIBERATELY SILENT AND DELIBERATELY IGNORED.  A failure here costs
*  colour, not correctness, and the edit must go ahead regardless; the one
*  thing it must never do is stop somebody editing a record.

*  THE QUOTING IS THE FIDDLY PART AND IT IS ON PURPOSE.  The BASIC strings are
*  SINGLE quoted so that DOUBLE quotes survive into the shell: $HOME has to
*  reach the shell unexpanded, and it has to be quoted there, or a home
*  directory with a space in it takes the mkdir apart.

place_syntax_file:
	SyntaxMaster = @sdsys : '/microcfg/syntax/sdbasic.yaml'
	SyntaxHome   = '"$HOME/.config/micro/syntax"'
	os.execute 'mkdir -p ' : SyntaxHome : ' && cp -u "' : SyntaxMaster : '" ' : SyntaxHome : ' 2>/dev/null'
return

*************************************************************
* check_permitted                                           *
*************************************************************
*
* 10 Sep 26 dm - THE SECOND GATE, the port's gpl.bp/EDIT check.permitted.  Owner
*  (port, 26 Aug 2026): "these commands will only work if the user has
*  OS.EXECUTE privileges.  If not, they should get a message that the command
*  is not available."  The VOC tier decides who HAS the verb (STANDARD does not);
*  this decides whether it runs, because an editor outside SD is reaching the
*  operating system.
*
*  WHY HERE AND NOT LEFT TO op_sh.  This program is $internal, so op_sh admits
*  its os.execute on HDR_INTERNAL and never asks.  The test must be made here,
*  and making it here refuses before anything is created, in words that name
*  the verb and what to ask for.
*
*  THE TERMINAL TEST IS FIRST.  K$TTY is ttyname(stdin) (kernel.c:177), blank
*  when stdin is not a terminal - an API session or a piped script, which has
*  nowhere to draw micro.
*
*  K$OS.EXEC is the account's OS-ON grant, and LOGIN / CPROC's logto load it as
*  granted for an administrator's own account (10 Sep 26); K$ADMINISTRATOR covers
*  a sudo session in any account.

check_permitted:
	if kernel(K$TTY, 0) = "" then
		ErrorText = "MICRO needs a terminal to draw on, and this session has none. ED, the line editor, works anywhere."
		return
	end
	if kernel(K$ADMINISTRATOR, -1) then return
	if kernel(K$OS.EXEC, -1) then return
	ErrorText = "MICRO is not available to " : @logname : ". It runs an editor outside SD, so it needs OS.EXECUTE permission "
	ErrorText := "(MODIFY.ACCOUNT <account> OS-ON, by an administrator). ED, the line editor, needs none of this."
return

*************************************************************
* find_editor                                               *
*************************************************************
*
* 10 Sep 26 dm - PRE_RELEASE 4.  MICRO shelled out to "micro" with no check it
*  exists, and a missing editor then read back no working copy and blamed the
*  user ("Record was not saved").  Ask the shell once, keep the resolved path,
*  and say what is missing.  The port's find.editor, without the bundled copy:
*  this port uses the distribution's micro (PRE_RELEASE 2).

find_editor:
	EditorPath = ""
	os.execute "command -v " : Editor capturing EditorPath
	EditorPath = trim(convert(@FM, " ", EditorPath), " ", "B")
	if EditorPath = "" then
		ErrorText = Editor : " is not installed, so MICRO has nothing to edit with. "
		ErrorText := "Install it with the distribution's package manager, or use ED, the line editor."
	end
return

end
