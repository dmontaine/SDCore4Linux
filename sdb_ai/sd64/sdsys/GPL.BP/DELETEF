$internal
program $DELETE.FILE
$catalog $DELETEF

$include int$keys.h
$include parser.h
$include syscom keys.h
$include syscom err.h

$define max.name.len 12

   parser = "!PARSER"

   @system.return.code = -ER$ARGS      ;* Preset for argument errors

* 20240121 mab use @VM not hard coded hex fd 
   banned.files = 'VOC':@VM:'$ACC'
   no.query = @false

   * Open VOC here rather than using @VOC so that it will be closed on
   * exit avoiding the need for explicit releases on locks in error paths.

   open 'VOC' to voc.f else stop sysmsg(2026) ;* Cannot open VOC

   prompt ''

   delete.dict = @true
   delete.data = @true
   file.name = ''
   component = ''
   deleting.multifile.element = @false   ;* 0483
   force = @false

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   call @parser(PARSER$MFILE, token.type, token, keyword)
   begin case
      case keyword = KW$DATA
         delete.dict = @false
         call @parser(PARSER$MFILE, token.type, token, keyword)

      case keyword = KW$DICT
         delete.data = @false
         call @parser(PARSER$MFILE, token.type, token, keyword)
   end case

   loop
   while token.type # PARSER$END
      begin case
         case keyword = KW$NO.QUERY
            no.query = @true

         case keyword = KW$FORCE
            force = @true

         case 1
            if len(file.name) then
               stop sysmsg(2018, token) ;* Unexpected token (xx)
            end

            file.name = field(token, ',', 1)
            component = field(token, ',', 2)
      end case

      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   repeat   


   if file.name = '' then       ;* Delete from select list?
      if not(selectinfo(0, sl$active)) then
         stop sysmsg(2102) ;* File name required
      end

      readnext file.name then
         if not(no.query) and not(option(OPT.NO.SEL.LIST.QUERY)) then
            loop
               display sysmsg(2050, file.name) :  ;* Use active select list (First item 'xx')?
               input yn
               yn = upcase(yn[1,1])
            until yn = 'Y' or yn = 'N'
            repeat
            if yn = "N" then
               clearselect       ;* Remove list as we have taken one item
               stop
            end
         end

         @system.return.code = 0

         loop
            component = ''
            deleting.multifile.element = @false
            gosub delete.file
            readnext file.name else exit
         repeat
      end
   end else                                  ;* File name provided
      @system.return.code = 0
      gosub delete.file
   end

   if @system.return.code then stop

   return


*=============================================================================
* DELETE.FILE  -  Do the actual delete

delete.file:
    * Check that VOC entry exists for this name

    readu voc.rec from voc.f, file.name else
      release voc.f, file.name
      display sysmsg(6130, file.name) ;* No VOC record found for xx
      file.name = upcase(file.name)
      readu voc.rec from voc.f, file.name then
         if upcase(voc.rec[1,1]) = "F" then
            loop
               display sysmsg(6131, file.name) :  ;* Use file 'xx' (y/<n>)?
               input yn
               yn = upcase(yn[1,1])
               if yn = '' then yn = 'N'  ;* 11 Sep 26 - Enter is the default the prompt shows
            until yn = 'Y' or yn = 'N'
            repeat
            if yn = "Y" then goto delete.upcased.file
         end
      end

      @system.return.code = -ER$STOPPED
      return
   end

   if upcase(voc.rec[1,1]) # "F" then
      @system.return.code = -ER$VNF
      stop sysmsg(2015, file.name) ;* VOC record xx is not a file
   end

delete.upcased.file:

* 11 Sep 26 Windows port - UPCASE BOTH SIDES (port PROJECT_STATUS 5.12 (b)).
*   file.name arrives here as the user TYPED it whenever the exact read at the
*   top of delete.file succeeded - the upcase() above is only in the else
*   branch.  banned.files is upper case, so a lower-case VOC id would walk
*   straight past this guard and take the account's VOC with it.
   locate upcase(file.name) in banned.files<1,1> setting pos then
      @system.return.code = -ER$VNF
      stop sysmsg(6132, file.name) ;* Cannot delete system file xx
   end

   dummy = ospath("", os$flush.cache)

   if delete.data then
      if component = '' then
         data.pathnames = voc.rec<2>
         if dcount(data.pathnames, @vm) > 1 then
            loop
               display sysmsg(6133) :  ;* Delete all data components of multifile?
               input yn
               yn = upcase(yn)
            until yn = 'Y'
               if yn = 'N' then goto delete.dict
            repeat
         end
         pos = 1
      end else
         locate component in voc.rec<4,1> setting pos else
            u.voc.rec = upcase(voc.rec)
            locate upcase(component) in u.voc.rec<4,1> setting pos else
               stop sysmsg(6134) ;* Multifile component not found
            end
         end
         data.pathnames = voc.rec<2,pos>
         deleting.multifile.element = @true   ;* 0483
       end

      if len(data.pathnames) then  ;* Multivalued if deleting all of multifile
         loop
            remove data.path from data.pathnames setting more
            if upcase(data.path[1,6]) = '@SDSYS' then
               part = 'data'
               gosub check.sdsys.file
* 12 Sep 26 dm - AND THE SKIP TAKES THE SAME UGLY GOTO THE 2024 COMMENT BELOW
* PRESCRIBES, FOR THE SAME REASON.  "continue" here re-entered the loop at its
* FIRST statement rather than at "while more", so "remove" ran a second time on
* an exhausted list, handed back an EMPTY data.path, and the empty path then
* failed the "data.path # default.path" test further down and raised the 6135
* prompt - under NO.QUERY, which had just been honoured five lines earlier.
* MEASURED 12 Sep 2026 on install 06d3a4a, as don, no sudo: a piped
* "DELETE.FILE ZZVVF NO.QUERY" against a copy of the SYSCOM pointer printed
* 6145 and 10117 correctly, then printed "OK to delete DATA portion '' (y/<n>)?"
* THREE TIMES, eating the two commands that followed it - the transcript's tell
* is that "CT VOC ZZVVF" and "OFF" appear as ANSWERS to the prompt.  It is not
* the endless loop the 2024 note feared only because the Enter=N fix below now
* turns end-of-input into N.  The VOC entry did go, and the system file was
* left alone, so the OUTCOME was right and only the route was wrong: this is a
* defect an outcome check cannot see.
* SAME CODE IN SD CORE FOR WINDOWS at its gpl.bp/DELETEF:246, NOT MEASURED
* THERE - filed to the port as a Linux-found bug.
               if skip.part then
                  del voc.rec<2,pos>
                  del voc.rec<4,pos>
                  goto more_test
               end
               data.path = @sdsys:data.path[7,9999]
            end

            default.path = file.name

* 11 Sep 26 Windows port - COMPARE THE TWO PATHS WITHOUT CASE.  CREATEF
* upper-cases the name before storing it in the VOC; file.name is whatever the
* caller typed, and is only upcased on the fallback path where the record was
* NOT found as typed.  So on the ordinary path the two differ whenever the verb
* was typed in lower case, and the "OK to delete DATA portion" prompt fired for
* a file that is exactly where it should be.  Port PRE_RELEASE_FIXES 26,
* UPSTREAM_FIXES 27.
*
* 11 Sep 26 dm - AND ENTER IS N.  The port's rule (its PRE_RELEASE 79) is that
* every prompt says which answer Enter gives; 6135 was missed because it has no
* "Y/N" in it to find.  At end of input "input" yields '', which is neither Y
* nor N, so this loop re-asked for ever - measured 11 Sep 2026: a piped
* "delete.file zzak no.query" printed 98.9 MB in 40 s before a timeout killed
* it.  N is the answer that deletes nothing.

            if upcase(data.path) # upcase(default.path) then
               if not(force) then
                  loop
                     display sysmsg(6135, data.path) :  ;* OK to delete DATA portion 'xx' (y/<n>)?
                     input yn
                     yn = upcase(yn[1,1])
                     if yn = '' then yn = 'N'
                  until yn = 'Y' or yn = 'N'
                  repeat
* 20240121 mab using continue here will create endless loop "while more" is not tested. I know an ugly goto                 
*                  if yn = "N" then continue
                   if yn = "N" then goto more_test
               end  
            end

            * Check for relocated indices

            openpath data.path to data.f then
               akpath = fileinfo(data.f, FL$AKPATH)
               close data.f
            end else akpath = ''

            if ospath(data.path, OS$OPEN) then
               stop sysmsg(6198, data.path) ;* Cannot delete file - Data part %1 is open
            end

            if ospath(data.path, OS$DELETE) then
* 11 Sep 26 Windows port - a relocated index directory is no longer orphaned
* in silence: the answer is taken and a failure reported with 2636, the message
* MKINDX already uses for the same call (port PRE_RELEASE 104, UPSTREAM 34) -
* but only when the directory IS there.  FL$AKPATH comes back non-empty for a
* file that never had an index, and "nothing to delete" must not read as
* "could not delete" (port 113).
               if akpath # '' then
                  if ospath(akpath, OS$EXISTS) then
                     if not(ospath(akpath, OS$DELETE)) then
                        display sysmsg(2636) ;* Failed to delete index directory
                        @system.return.code = -status()
                     end
                  end
               end

               display sysmsg(6136, data.path) ;* DATA portion 'xx' deleted

               if voc.rec<4> # '' then  ;* It is a multifile
                  parent.dir = field(data.path, @ds, 1, dcount(data.path, @ds)-1)
                  if dir(parent.dir) = '' then
                     * The directory is now empty. Delete it.

                     if ospath(parent.dir, OS$DELETE) then
                        display sysmsg(6137, parent.dir) ;* Multifile directory 'xx' deleted
                     end
                  end
               end

               del voc.rec<2,pos>
               del voc.rec<4,pos>
            end else
               display sysmsg(6138, data.path) ;* Error deleting DATA portion 'xx'
               @system.return.code = -status()
            end
* 20240121 mab endless loop goto label
more_test: * 			
         while more
         repeat
      end else
         display sysmsg(6139) ;* DATA part of file does not exist
      end
   end

delete.dict:

   if delete.dict and not(deleting.multifile.element) then  ;* 0483
      dict.path = voc.rec<3>

      if len(dict.path) then
         if upcase(dict.path[1,6]) = '@SDSYS' then
            part = 'dictionary'
            gosub check.sdsys.file
            if skip.part then
               voc.rec<3> = ""
               goto write.voc
            end
           dict.path= @sdsys:dict.path[7,9999]
         end

         default.path = file.name : ".DIC"

* 11 Sep 26 Windows port - and the DICT half of the same comparison, for the
* reason given at the DATA one above (port PRE_RELEASE_FIXES 26).  Enter is N
* here too, for the reason given there.

         if upcase(dict.path) # upcase(default.path) then
            if not(force) then
               loop
                  display sysmsg(6140, dict.path) : ;* OK to delete DICT portion 'xx' (y/<n>)?
                  input yn
                  yn = upcase(yn[1,1])
                  if yn = '' then yn = 'N'
               until yn = 'Y' or yn = 'N'
               repeat
               if yn = "N" then goto write.voc
            end  
         end

         * Check for relocated indices

         openpath dict.path to dict.f then
            akpath = fileinfo(dict.f, FL$AKPATH)
            close dict.f
         end else akpath = ''

         if ospath(dict.path, OS$OPEN) then
            stop sysmsg(6199, dict.path) ;* Cannot delete file - Dictionary part %1 is open
         end

         if ospath(dict.path, OS$DELETE) then
* 11 Sep 26 Windows port - checked, and only when present; see the DATA half.
            if akpath # '' then
               if ospath(akpath, OS$EXISTS) then
                  if not(ospath(akpath, OS$DELETE)) then
                     display sysmsg(2636) ;* Failed to delete index directory
                     @system.return.code = -status()
                  end
               end
            end

            voc.rec<3> = ""
            display sysmsg(6141, dict.path) ;* DICT portion 'xx' deleted
         end else
            display sysmsg(6142, dict.path) ;* Error deleting DICT portion 'xx'
            @system.return.code = -status()
         end
      end else
         display sysmsg(6143) ;* DICT part of file does not exist
      end
   end

write.voc:
   * Write VOC entry

   if (voc.rec<2> # "") or (voc.rec<3> # "") then
      write voc.rec to voc.f,file.name
   end else
      delete voc.f, file.name
      display sysmsg(6144, file.name) ;* VOC entry 'xx' deleted
   end

   return

* ======================================================================

check.sdsys.file:

* 11 Sep 26 Windows port - NO.QUERY TAKES THE SAFE BRANCH INSTEAD OF ASKING.
* This routine prompted unconditionally, so "delete.file zzak force no.query"
* stopped on a question nobody was there to answer.  THE BRANCH TAKEN IS THE
* CONSERVATIVE ONE, 'N' AND NOT 'Y': it deletes the VOC reference and leaves
* the file in the system account alone, because NO.QUERY says "do not ask me",
* not "assume yes to a question about other accounts' data" - and it says so,
* because a caller who wanted the file gone needs to know it is still there.
* Port PRE_RELEASE_FIXES 14, UPSTREAM_FIXES 23.

   if no.query then
      display sysmsg(6145, part) ;* Warning re part in SDSYS account
      display sysmsg(10117, part) ;* NO.QUERY: VOC reference deleted, file kept
      skip.part = @true
      return
   end

   display sysmsg(6145, part) ;* Warning re part in SDSYS account
   loop
      display sysmsg(6146) :  ;* Delete the file from the system account (y/<n>)?
      input yn
      yn = upcase(yn[1,1])
* 10 Sep 26 dm - Enter takes the default the prompt shows, N (port
*   PRE_RELEASE_FIXES 79).  An empty answer used to re-ask for ever.
      if yn = '' then yn = 'N'
   until yn = 'Y' or yn = 'N'
   repeat
   
   skip.part = (yn = 'N')
   return

   * Avoid compiler warnings
   dummy = dummy
end

* END-CODE
