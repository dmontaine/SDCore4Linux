* START-HISTORY:
* 10 Sep 26 dm  ADOPTED FROM SD CORE FOR WINDOWS' gpl.bp/EDIT, REPLACING
*               GPL.BP/MICRO.  Owner, 10 Sep 2026: Microsoft Edit is not in the
*               Linux distributions' repositories and is dropped; on Linux the
*               NANO verb runs nano and the MICRO verb runs micro, both with SD
*               BASIC syntax highlighting.  THE EDIT VERB IS NOT THIS PROGRAM:
*               "edit" was Microsoft Edit's name in the port, and here EDIT
*               stays an alias for ED, the line editor (owner, 10 Sep 2026).
*               The program keeps the port's name, $EDIT.  The port's own history for this
*               program (26 Aug - 3 Sep 2026) is in its gpl.bp/EDIT and is not
*               repeated; the reasoning that matters is kept at each site below.
*
*               KEPT FROM THE PORT: two verbs in one program; the lossless mark
*               grammar and both scanners, with the round trip still checked;
*               both gates before anything is written; the working copy removed
*               on every exit; sequential screen writes and one crt per message
*               line; the save query and the compile-and-catalogue offer.
*
*               ADAPTED, EACH FOR A LINUX REASON:
*               - find.editor asks the shell (command -v), not PowerShell, and
*                 names the distribution's package manager rather than winget.
*               - NO micro.home.  On Windows micro's configuration home had to
*                 be made writable per user (port PRE_RELEASE 29); on Linux it
*                 is the user's own ~/.config/micro, already theirs.  micro's
*                 syntax file is copied there on first use (place.syntax, as
*                 GPL.BP/MICRO did - PRE_RELEASE 12).  nano's is system-wide,
*                 /usr/share/nano/sdbasic.nanorc, which /etc/nanorc includes;
*                 the installer places it.
*               - THE WORKING-COPY PATH IS fileinfo(FL$PATH) AS IT STANDS.  SD
*                 works in POSIX paths here, so there is no K$WINPATH step.
*               - check.permitted asks the account's OS-ON grant (K$OS.EXEC),
*                 this system's model, instead of the port's os.users field 2.
*               - The file is opened as typed, then lower, then upper case (a
*                 case-sensitive filesystem, until the lower-case conversion),
*                 and a record name holding a single quote is refused, because
*                 the editor is launched through the shell.
*               - The working copy is in $HOLD, upper case until SL M.
* END-HISTORY
*
PROGRAM EDIT

$internal
$catalog $EDIT

$include syscom keys.h
$include int$keys.h

   q            = char(39)          ;* single quote, for the shell command line
   ds           = @ds

*  ***THE MARK GRAMMAR.  EVERY TOKEN IS "~" PLUS ONE CHARACTER, AND "~" IS THE
*  ONLY ESCAPE CHARACTER.***  See marks.out and marks.back.  One place each, so
*  the two directions cannot disagree.
*
*      ~~   value mark          ~-   a literal "~"
*      ~`   subvalue mark       ~,   a literal "," where one would be a separator
*      ~!   text mark
*
*  THE TEXT MARK IS "~!" AND NOT "`~", which was the first proposal, and the
*  owner spotted why on 27 Aug 2026: a token led by a backtick breaks the rule
*  that every token starts with "~", and a broken rule is not cosmetic here.
*  It would make the BACKTICK a second escape-introducing character, so a
*  literal backtick before a tilde would need escaping too - a whole second
*  mechanism - and "~`" and "`~" are anagrams, so a run of marks came out as
*  "~``~" and could only be read by a strict left-to-right scanner.  With "~!"
*  a backtick is an ordinary character again and needs nothing.
*
*  THE BACKTICK IS char(96) RATHER THAN TYPED, because a lone backtick inside
*  a quoted string is the kind of character that survives one editor and not
*  the next, and this record is edited by hand.
   bq           = char(96)
   vm.token     = '~~'
   sm.token     = '~' : bq
   tm.token     = '~!'
   esc.token    = '~-'
   comma.token  = '~,'

*  The character after the "~" in each token, in one string, so the scanners
*  can test membership with index() instead of five comparisons.
   token.chars  = '~' : bq : '!-,'
   mark.letters = '~' : bq : '!'
   mark.chars   = @vm : @sm : @tm

*  What a literal "~" has to be escaped in front of: anything that would make
*  the pair look like a token, plus the three marks, whose tokens begin "~".
   danger.chars = token.chars : mark.chars

   compiled.dict = @false
   files.opened  = @false
   record.saved  = @false
   temp.written  = @false
   error.text    = ''
   input.record  = ''
   temp.record   = ''
   response      = ''

* ---------------------------------------------------------------------------
* The command line:  nano | micro {DICT} file record
* ---------------------------------------------------------------------------
   cmd = convert(' ', @fm, trim(@command, ' ', 'C'))

* ---------------------------------------------------------------------------
* THE VERB CHOOSES THE EDITOR, AND THERE IS ONE PROGRAM RATHER THAN TWO.
*
* The port's owner ruling, 26 Aug 2026: two full-screen editors, "one called
* with the verb micro and the other with the verb edit".  Both VOC entries are
* CA $EDIT and this reads field 1 of the command line - the verb as typed.
* On Linux (owner, 10 Sep 2026) the verbs are NANO and MICRO, each named for
* the editor it runs.  The port's "edit" was Microsoft Edit's; here EDIT is an
* alias for ED and never reaches this program.
*
* WHY NOT TWO PROGRAMS.  Everything either verb does is the same: the working
* copy, the save query, the compile-and-catalogue loop, the cleanup.  A second
* copy of that is a second place for the next defect to be fixed in only one -
* which is the shape of MICRO's own faults.  If the two ever need to behave
* differently, the table below is where it goes.
* ---------------------------------------------------------------------------
   begin case
      case upcase(trim(cmd<1>, ' ', 'B')) = 'MICRO'
         editor.exe  = 'micro'
         editor.name = 'micro'
      case 1                              ;* NANO, or any other verb aimed here
         editor.exe  = 'nano'
         editor.name = 'nano'
   end case

   if upcase(trim(cmd<2>, ' ', 'B')) = 'DICT' then
      in.file.name   = cmd<3>
      in.record.name = cmd<4>
      dict.text      = 'DICT'
   end else
      in.file.name   = cmd<2>
      in.record.name = cmd<3>
      dict.text      = ''
   end

*  The verb as typed, lower cased, so every message this program prints names
*  the command the user actually used rather than one of the two.
   verb.text = downcase(trim(cmd<1>, ' ', 'B'))
   usage     = 'Usage: ' : verb.text : ' {dict} <file> <record>'

   if trim(in.file.name) = '' then
      error.text = 'No file name specified.  ' : usage
      goto end.program
   end

   if trim(in.record.name) = '' then
      error.text = 'No record name specified.  ' : usage
      goto end.program
   end

*  10 Sep 26 dm - LINUX: THE EDITOR IS LAUNCHED THROUGH THE SHELL with the
*  working copy's path in single quotes, so a record name holding one would
*  break the command line.  Refused rather than escaped, before anything is
*  written; ED edits such a record without any shell.
   if index(in.record.name, q, 1) then
      error.text  = verb.text : ' cannot edit a record whose name contains a'
      error.text := ' single quote.' : char(10)
      error.text := 'ed, the line editor, handles it.'
      goto end.program
   end

   temp.file.name = '$HOLD'
   if dict.text = 'DICT' then
      temp.record.name = 'dict.' : in.record.name : '.editing'
   end else
      temp.record.name = in.record.name : '.editing'
   end

*  ***AND A BP RECORD GETS A ".sdbasic" ON THE END, WHICH IS WHAT MAKES THE
*  HIGHLIGHTING WORK.***  micro and nano both choose a syntax by matching a
*  regex against the FILE NAME, and the name they see is this working copy's,
*  not the record's - a record called MY.REPORT tells them nothing.  The suffix
*  is the only thing that can carry the language across; microcfg/syntax/
*  sdbasic.yaml and nanocfg/sdbasic.nanorc detect exactly it.
*
*  ".editing" IS KEPT IN FRONT OF IT so a working copy left behind by a
*  session that died is still recognisable as one, whichever kind it is.
*
*  Same test as the compile offer below, and deliberately so: what is worth
*  compiling as BASIC is what is worth highlighting as BASIC.
   if dict.text # 'DICT' and upcase(in.file.name[-2, 2]) = 'BP' then
      temp.record.name := '.sdbasic'
   end

* ---------------------------------------------------------------------------
* Both gates BEFORE anything is written, so a session that may not do this is
* told so rather than handed a working copy it cannot edit.
* ---------------------------------------------------------------------------
   gosub check.permitted
   if not(permitted) then goto end.program

   gosub find.editor
   if editor.path = '' then goto end.program

   gosub place.syntax

   gosub open.files
   if not(files.opened) then goto end.program

   crt @(-1) :

   loop
      gosub process.record
      if trim(temp.record, ' ', 'B') = '' then
*        NAME THE FILE THE EDITOR WAS GIVEN, because this message is what a
*        failed LAUNCH looks like as well as a genuinely empty record.  Told
*        only "Record is empty" there is nothing to go on; told the path, a
*        wrong one is obvious at a glance.
         error.text  = 'Record is empty - not saved.' : char(10)
         error.text := 'The editor was given:' : char(10)
         error.text := '   ' : os.file : char(10)
         error.text := 'If you typed something and it is not here, check that'
         error.text := ' path exists.'
         goto end.program
      end

      crt
      if temp.record = input.record then
         crt 'Record is unchanged'
         record.saved = @true
      end else
         gosub save.record.query
      end

      if record.saved then
         gosub compile.record.query
         response = ''
         crt
         loop
            crt '<E>xit or <R>e-edit : ' :
            input response, 1 :
            crt
            response = upcase(response)
         until index('ER', response, 1) > 0 repeat
         if response = 'E' then goto end.program
      end
   repeat

* ---------------------------------------------------------------------------
end.program:
   gosub remove.temp.record

   if error.text = '' then
      crt verb.text : ' ended normally'
   end else
*     ***ONE crt PER LINE, NOT ONE crt OF A STRING WITH char(10) IN IT.***
*     Every message in this program is built with char(10) as the line
*     separator, and a bare LF moves DOWN a line without returning to column
*     0, so a single crt of the whole thing staircases across the screen - the
*     port's owner saw it on a real console, 26 and 27 Aug 2026.  A pipe hides
*     it.  Fixing it here rather than at every place that builds the text means
*     the next message written cannot reintroduce it.
      err.lines = dcount(error.text, char(10))
      for err.i = 1 to err.lines
         crt field(error.text, char(10), err.i)
      next err.i
   end
   stop

* ===========================================================================
* SUBROUTINES: alphabetical
* ===========================================================================

* ---------------------------------------------------------------------------
* check.permitted  -  THE SECOND GATE.
*
* The port's owner, 26 Aug 2026: *"these commands will only work if the user
* has OS.EXECUTE privileges.  If not, they should get a message that the
* command is not available."*
*
* THE VOC TIER IS THE FIRST GATE AND IS NOT ENOUGH ON ITS OWN.  A programmer
* account has the verb; running an editor is still reaching the operating
* system, and who may do that is the same grant that governs OS.EXECUTE from
* inside a program.
*
* WHY THE TEST IS HERE RATHER THAN LEFT TO os_permitted().  This program is
* $internal, so op_sh admits its os.execute on HDR_INTERNAL and never asks.
* Testing here refuses before anything is created and says what to do about it.
*
* LINUX: THE GRANT IS THE ACCOUNT'S OS-ON (K$OS.EXEC), loaded at account entry
* by LOGIN and CPROC's logto - and loaded as granted for an administrator's own
* account.  K$ADMINISTRATOR covers a sudo session in any account.
*
* AND THE TERMINAL TEST IS FIRST, because it is the plainer answer.  K$TTY is
* ttyname(stdin), blank for an API session or a piped script, which have
* nowhere to draw a full screen.
* ---------------------------------------------------------------------------
check.permitted:
   permitted = @false

   if kernel(K$TTY, 0) = '' then
      error.text  = verb.text : ' needs a terminal to draw on, and this session'
      error.text := ' has none.' : char(10)
      error.text := 'ed, the line editor, works anywhere.'
      return
   end

   if kernel(K$ADMINISTRATOR, -1) then
      permitted = @true
      return
   end

   if kernel(K$OS.EXEC, -1) then
      permitted = @true
      return
   end

   error.text  = verb.text : ' is not available to ' : @logname : '.' : char(10)
   error.text := 'It runs an editor outside SD, so it needs OS.EXECUTE'
   error.text := ' permission, which an administrator grants with' : char(10)
   error.text := '   MODIFY.ACCOUNT <account> OS-ON' : char(10)
   error.text := 'ed, the line editor, needs none of this.'
return

* ---------------------------------------------------------------------------
* compile.record.query  -  a DICT record is always re-compiled; a BP record is
* offered the compile and the catalogue, exactly as MICRO offered them.
* ---------------------------------------------------------------------------
compile.record.query:
   if compiled.dict then
      execute 'CD ' : in.file.name : ' ' : in.record.name
      return
   end

   if dict.text = 'DICT' then return
   if upcase(in.file.name[-2, 2]) # 'BP' then return

   prompt ''
   response = ''
   crt
   loop
      crt 'Compile ' : in.file.name : ' ' : in.record.name : '?  <Y>es, <N>o : ' :
      input response, 1 :
      crt
      response = upcase(response)
   until index('YN', response, 1) > 0 repeat
   if response # 'Y' then return

   execute 'BASIC ' : in.file.name : ' ' : in.record.name
   crt

   response = ''
   crt
   loop
      crt 'Catalog?  <L>ocal, <P>rivate, <G>lobal, <N>o : ' :
      input response, 1 :
      crt
      response = upcase(response)
   until index('LPGN', response, 1) > 0 repeat

   begin case
      case response = 'L'
         execute 'CATALOG ' : in.file.name : ' ' : in.record.name : ' LOCAL'
      case response = 'P'
         execute 'CATALOG ' : in.file.name : ' ' : in.record.name
      case response = 'G'
         execute 'CATALOG ' : in.file.name : ' ' : in.record.name : ' GLOBAL'
      case response = 'N'
         crt in.file.name : ' ' : in.record.name : ' not catalogued'
   end case
return

* ---------------------------------------------------------------------------
* find.editor  -  ask the shell where the editor is, once.
*
* IT RETURNS THE RESOLVED PATH AND THE PATH IS WHAT IS RUN (the port's rule).
* Asking and then running the bare name would be two lookups that could
* disagree, and printing the path is what makes a wrong editor obvious.
*
* LINUX: "command -v" is POSIX and answers in every shell.  ANYTHING BUT AN
* ABSOLUTE PATH IS REFUSED - an alias or a function prints its name or its
* body, not an executable, and is the one answer that cannot be run as given.
* ---------------------------------------------------------------------------
find.editor:
   editor.path = ''
   probe.out = ''
   os.execute 'command -v ' : editor.exe capturing probe.out

   editor.path = trim(convert(@fm : char(13) : char(10), '   ', probe.out), ' ', 'B')
   if editor.path[1, 1] # '/' then editor.path = ''

   if editor.path = '' then
      error.text  = editor.name : ' (' : editor.exe : ') was not found on this'
      error.text := ' machine, so ' : verb.text : ' has nothing to edit with.'
      error.text := @fm
      error.text := 'Install the ' : editor.exe : ' package with the'
      error.text := ' distribution''s package manager, for example:' : @fm
      error.text := '   sudo apt install ' : editor.exe : @fm
      error.text := 'or use ed, the line editor, which needs nothing installed.'
      error.text  = change(error.text, @fm, char(10))
   end
return

* ---------------------------------------------------------------------------
* marks.out  -  temp.record (SD) -> work.record (what the editor is given).
*
* A FIELD mark is a line break, so a text editor handles fields on its own.
* The other three are control characters an editor either draws as a stray
* glyph or drops, so each becomes a two-character token; see the grammar at
* the top of the program.
*
* ***CONSECUTIVE MARKS ARE SEPARATED BY A COMMA.***  Owner, 27 Aug 2026: a run
* of marks written token against token cannot be read.  Text mark, text mark,
* value mark is "~!,~!,~~" and not "~!~!~~".  A LITERAL COMMA STANDING IN THAT
* EXACT POSITION - after a mark and before a mark - is therefore written "~,",
* because "~~,~~" already means two value marks.  Nowhere else does a comma
* need anything: they are far too common in real text to escape on sight.
*
* A LITERAL "~" IS WRITTEN "~-" ONLY WHERE THE NEXT CHARACTER WOULD MAKE THE
* PAIR LOOK LIKE A TOKEN.  Escaping every tilde would be shorter and would
* show "~-" wherever the author wrote "~", which is the complaint this whole
* conversion exists to answer.  "a~b" is "a~b" in the editor.
*
* IT COSTS FOUR count() CALLS ON A RECORD THAT HAS NONE OF THIS, which is
* almost every BASIC source record.  The scan is per character otherwise, but
* it appends whole runs of ordinary text rather than one character at a time.
* ---------------------------------------------------------------------------
marks.out:
   work.record = temp.record

   n.special = count(work.record, '~')
   n.special += count(work.record, @vm)
   n.special += count(work.record, @sm)
   n.special += count(work.record, @tm)
   if n.special = 0 then return

   m.s = work.record
   m.w = ''
   m.len = len(m.s)
   m.run = 1                        ;* start of the plain run not yet appended
   m.prev.mark = @false

   for m.i = 1 to m.len
      m.c  = m.s[m.i, 1]
      m.nx = m.s[m.i + 1, 1]        ;* '' at the end of the record

      m.tok = ''
      m.is.mark = @false
      begin case
         case m.c = @vm
            m.tok = vm.token
            m.is.mark = @true
         case m.c = @sm
            m.tok = sm.token
            m.is.mark = @true
         case m.c = @tm
            m.tok = tm.token
            m.is.mark = @true
         case m.c = ','
*           Only the comma that would be read back as a run separator.
            if m.prev.mark and m.nx # '' then
               if index(mark.chars, m.nx, 1) > 0 then m.tok = comma.token
            end
         case m.c = '~'
            if m.nx # '' then
               if index(danger.chars, m.nx, 1) > 0 then m.tok = esc.token
            end
      end case

      if m.tok # '' then
         m.w := m.s[m.run, m.i - m.run]
         if m.is.mark and m.prev.mark then m.w := ','
         m.w := m.tok
         m.run = m.i + 1
      end
      m.prev.mark = m.is.mark
   next m.i

   m.w := m.s[m.run, m.len - m.run + 1]
   work.record = m.w
return

* ---------------------------------------------------------------------------
* marks.back  -  work.record (what came back from the editor) -> temp.record.
*
* ***IT IS A LEFT-TO-RIGHT SCAN AND NOT A SEQUENCE OF change() CALLS.***  It
* was three change() calls until 27 Aug 2026 and could not stay one: change()
* rewrites the whole string for each token, so a token that only exists
* because of where it sits - the run separator - cannot be expressed, and a
* later pass can cut a token an earlier pass created.  A scan reads each
* position once and decides there.
*
* EVERY TOKEN IS "~" PLUS ONE CHARACTER, so the scan only ever has to look at
* a tilde; every other character is itself.  A record with no tilde in it
* comes back unchanged for one count().
* ---------------------------------------------------------------------------
marks.back:
   temp.record = work.record
   if count(temp.record, '~') = 0 then return

   m.s = temp.record
   m.w = ''
   m.len = len(m.s)
   m.run = 1
   m.prev.mark = @false
   m.i = 1

   loop
   while m.i <= m.len
      m.c  = m.s[m.i, 1]
      m.nx = m.s[m.i + 1, 1]

      m.hit = ''
      m.drop = @false
      m.is.mark = @false
      m.step = 1

      begin case
         case m.c = '~' and m.nx # '' and index(token.chars, m.nx, 1) > 0
            m.step = 2
            begin case
               case m.nx = '~'
                  m.hit = @vm
                  m.is.mark = @true
               case m.nx = bq
                  m.hit = @sm
                  m.is.mark = @true
               case m.nx = '!'
                  m.hit = @tm
                  m.is.mark = @true
               case m.nx = '-'
                  m.hit = '~'
               case 1
                  m.hit = ','
            end case

         case m.c = ',' and m.prev.mark and m.nx = '~'
*           A comma between two mark tokens is the separator this program
*           wrote, and it is not data.  The run continues across it.
            m.after = m.s[m.i + 2, 1]
            if m.after # '' then
               if index(mark.letters, m.after, 1) > 0 then
                  m.drop = @true
                  m.is.mark = @true
               end
            end
      end case

      if m.hit # '' or m.drop then
         m.w := m.s[m.run, m.i - m.run]
         if not(m.drop) then m.w := m.hit
         m.run = m.i + m.step
         m.prev.mark = m.is.mark
      end else
         m.prev.mark = @false
      end

      m.i += m.step
   repeat

   m.w := m.s[m.run, m.len - m.run + 1]
   temp.record = m.w
return

* ---------------------------------------------------------------------------
* open.files  -  the record's file, and $HOLD for the working copy.
*
* 10 Sep 26 dm - LINUX: AS TYPED, THEN LOWER CASE, THEN UPPER CASE - the order
* SL M sets for the lower-case conversion.  On a case-sensitive filesystem
* "edit bp test" otherwise finds nothing when only BP exists.  The name that
* opened replaces in.file.name, so the compile and catalogue offers use it.
* ---------------------------------------------------------------------------
open.files:
   open.ok = @false
   open.name = in.file.name
   open dict.text, open.name to input.file then open.ok = @true
   if not(open.ok) and downcase(in.file.name) # in.file.name then
      open.name = downcase(in.file.name)
      open dict.text, open.name to input.file then open.ok = @true
   end
   if not(open.ok) and upcase(in.file.name) # in.file.name then
      open.name = upcase(in.file.name)
      open dict.text, open.name to input.file then open.ok = @true
   end

   if open.ok then
      in.file.name = open.name
      open temp.file.name to temp.file then
         files.opened = @true
      end else
         error.text = 'File error: ' : temp.file.name : ' could not be opened.'
      end
   end else
      error.text = 'File error: ' : trim(dict.text : ' ' : in.file.name)
      error.text := ' could not be opened.'
   end
return

* ---------------------------------------------------------------------------
* place.syntax  -  micro's SD BASIC syntax file into this user's own config.
*
* 09 Sep 26 dm - PRE_RELEASE 12, carried over from GPL.BP/MICRO.  Stock micro
* has no system-wide syntax path, so the file has to land in a per-user
* directory, and the installer cannot populate the home of every user who will
* ever run SD.  So the copy happens here, on first use, per caller, with no
* privilege - and it self-heals for accounts made later.  cp -u, not cp: a
* regenerated file reaches an existing user, and a user's own edits survive
* until SD's genuinely moves on.  $HOME is left for the shell to expand.
*
* nano needs none of this: its syntax file is system-wide and the installer
* places it.  DELIBERATELY SILENT AND IGNORED - a failure costs colour, not
* correctness, and must never stop somebody editing a record.
* ---------------------------------------------------------------------------
place.syntax:
   if editor.exe # 'micro' then return
   syntax.master = @sdsys : '/microcfg/syntax/sdbasic.yaml'
   syntax.home   = '"$HOME/.config/micro/syntax"'
   os.execute 'mkdir -p ' : syntax.home : ' && cp -u "' : syntax.master : '" ' : syntax.home : ' 2>/dev/null'
return

* ---------------------------------------------------------------------------
* process.record  -  write the working copy, run the editor on it, read it
* back.  A record that does not exist yet is editable: the copy is simply
* empty, which is how a new program is written.
* ---------------------------------------------------------------------------
process.record:
   read input.record from input.file, in.record.name else input.record = ''
   temp.record = input.record

   if dict.text = 'DICT' then
      temp.str = trim(field(temp.record, @fm, 1), ' ', 'B')[1, 1]
      if index('CI', upcase(temp.str), 1) > 0 then
         compiled.dict = @true
         temp.record = field(temp.record, @fm, 1, 15)
      end
   end

*  MARKS BECOME TYPEABLE TEXT ON THE WAY OUT AND COME BACK ON THE WAY IN.
*  ***THE CONVERSION IS LOSSLESS, NOT REFUSABLE*** (the port's owner, 27 Aug
*  2026): "the whole purpose of these editors is primarily to edit source code
*  ... the conversion needs to be handled seamlessly, just like CRLF or LF".
   gosub marks.out

*  ***AND THE ROUND TRIP IS STILL TESTED RATHER THAN REASONED ABOUT.***  It is
*  expected never to fire: gplbld/test-edittokens-units.py runs these two
*  algorithms against each other over every short string of the dangerous
*  characters and over every shipped GPL.BP record.  It stays because losing a
*  user's data silently is the one outcome worth a few lines to prevent.
   check.keep  = temp.record
   check.in    = work.record
   gosub marks.back
   check.back  = temp.record
   temp.record = check.keep
   work.record = check.in

   if check.back # temp.record then
      error.text  = verb.text : ' cannot represent this record safely, which is'
      error.text := ' a fault in SD rather than anything wrong with the record.'
      error.text := char(10)
      error.text := 'Nothing has been changed.  Please report it.' : char(10)
      error.text := 'ed, the line editor, handles the record meanwhile.'
      goto end.program
   end

   write work.record to temp.file, temp.record.name on error
      error.text = 'Write error: the working copy could not be created in '
      error.text := temp.file.name
      goto end.program
   end
   temp.written = @true

*  THE REAL PATH, NOT "$HOLD/name".  $HOLD is a directory file, so its record
*  is a file on disk, and fileinfo() is what knows where.  MICRO passed a
*  relative path and it resolved only because the process happened to be
*  standing in the account directory.  LINUX: the answer is already the POSIX
*  path the editor wants, so it is used as it stands.
   hold.dir = fileinfo(temp.file, FL$PATH)
   if hold.dir = '' then
      error.text = 'Could not find the operating-system path of ' : temp.file.name
      goto end.program
   end
   if hold.dir[len(hold.dir), 1] = ds then hold.dir = hold.dir[1, len(hold.dir) - 1]
   os.file = hold.dir : ds : temp.record.name

   if index(os.file, q, 1) then
      error.text  = 'The working copy path contains a single quote, which the'
      error.text := ' shell command line cannot carry:' : char(10)
      error.text := '   ' : os.file
      goto end.program
   end

   crt @(-1) : 'Editing ' : trim(dict.text : ' ' : in.file.name) : ' ' :
   crt in.record.name

   os.execute q : editor.path : q : ' ' : q : os.file : q
   rc = os.error()

   crt @(-1) :

   read work.record from temp.file, temp.record.name else
      error.text = 'The working copy has gone - nothing was read back.'
      if rc # 0 then
         error.text := '  The editor exited ' : rc : '.'
      end
      goto end.program
   end

*  Back the other way, so what is compared and what is written are both in
*  SD's own representation.  This is also where anything the USER typed is
*  interpreted, which is what makes the tokens a feature rather than only a
*  transport.
   gosub marks.back
return

* ---------------------------------------------------------------------------
* remove.temp.record  -  on EVERY exit, not only the tidy one.
* ---------------------------------------------------------------------------
remove.temp.record:
   if temp.written then
      delete temp.file, temp.record.name on error
         crt 'Warning: the working copy ' : temp.record.name : ' is still in '
         crt temp.file.name
      end
      temp.written = @false
   end
return

* ---------------------------------------------------------------------------
* save.record.query  -  a DICT record is always saved, as in MICRO.
* ---------------------------------------------------------------------------
save.record.query:
   if dict.text = 'DICT' then
      response = 'Y'
   end else
      prompt ''
      response = ''
      crt
      loop
         crt trim(dict.text : ' ' : in.file.name) : ' ' : in.record.name :
         crt ' has been changed'
         crt 'Save?  <Y>es, <N>o : ' :
         input response, 1 :
         crt
         response = upcase(response)
      until index('YN', response, 1) > 0 repeat
   end

   if response # 'Y' then
      error.text = 'Record not saved'
      goto end.program
   end

   write temp.record to input.file, in.record.name on error
      error.text = 'Write error: ' : trim(dict.text : ' ' : in.file.name)
      error.text := ' ' : in.record.name : ' could not be updated.'
      goto end.program
   end
   record.saved = @true
return

end
