* TOOL_AUDIT
* The audit trail on one screen: the newest lines first in view, filters, a go-to-date, a follow mode, the parts of the line under the cursor, and the lines shown saved to a record (S.75,
* plan .claude/plan-fullscreen-toolkit.md section 5, A5).
* Copyright (c) 2026, SD Core for Linux.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 25 Oct 26 dm  New.
* 28 Oct 26 dm  S.88 L2: the three boxes are panes of the layout service ($tk_layout): at 140 by 43 exactly the boxes the page has always drawn, in a bigger window the list shows more lines
*               (twice the share of the box under it, which shows more of the line and its pairs), every box is wider and a line of the list shows more of its pairs.  The resize key makes the
*               layout again.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.AUDIT      (SDSYS's VOC only; the audience is the administrator, asked of the kernel before anything is read)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least).  The top box says which audit file is shown, how big it is, how many lines are loaded, whether older
*   lines remain, the filters in force and whether the page is following the file.  The list is the audit trail itself, oldest line at the top and newest at the bottom, one line of the
*   file to a row: time, user, the event words and the key=value pairs.  The box under it shows the whole line under the cursor, wrapped, and its parts.
*
*   WHAT IT READS.  The audit file of the system directory (audit, or a rotated one, audit.yyyymmdd-hhmmss), through $AUDIT_READ, which asks for the administrator itself and reads the
*   file BACKWARDS from its end in blocks, so a large trail is never read whole: the page opens on the newest 200 lines that pass the filter, loads 200 more when the cursor goes above the
*   first, and reads forward from where it stopped on F5 and (in follow mode) every three seconds.  It keeps at most 3000 lines; beyond that it drops the newest when going back and the
*   oldest when following.  It READS ONLY: the page runs no command and changes no account, record or file, except the one key that saves the lines shown (X).
*
*   Keys: Up, Down, PgUp, PgDn, Home (the first loaded line), End (the newest line; it reads the file again); F asks for the filters (from, to, event, account, user, text; Esc leaves them
*   as they were); C clears them; D goes to the first line at or after a time (it loads older lines as far as it needs; no filter changes); O shows the next audit file (the current one,
*   then the rotated ones, newest first); L follows the file; X saves the lines shown to a record of the $HOLD file of the administrator's account (the record id is shown; ED $HOLD id reads
*   it) and writes an audit line saying how many; F5 reads again; F1 or ? or a click on the [?] explains the page; Ctrl-Q leaves.  A click on a row puts the cursor there.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_audit
$catalog $tool_audit

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   call $tk_open('tool.audit', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.audit')
   gosub declare.layout

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'f', 'filter', 'filter', '', 1)
   call $tk_keys('add', keys, 'c', 'clear', 'clear', '', 1)
   call $tk_keys('add', keys, 'd', 'date', 'goto', '', 1)
   call $tk_keys('add', keys, 'o', 'file', 'file', '', 1)
   call $tk_keys('add', keys, 'l', 'follow', 'follow', '', 1)
   call $tk_keys('add', keys, 'x', 'save', 'export', '', 1)
   call $tk_keys('add', keys, 'f5', 'read', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* S.88 U1: Esc clears the filters first, else opens the menu bar
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'filter', '&Audit', '&Filter the lines', '', '')
   call $tk_keys('menu', keys, 'clear', '&Audit', '&Clear the filters', '', '')
   call $tk_keys('menu', keys, 'goto', '&Audit', '&Go to a time', '', '')
   call $tk_keys('menu', keys, 'file', '&Audit', '&Open another audit file', '', '')
   call $tk_keys('menu', keys, 'follow', '&Audit', 'Fo&llow the file', '', '')
   call $tk_keys('menu', keys, 'export', '&Audit', 'Sa&ve the lines shown', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this page', '', '')

   BLK = 200                                                    ;* lines read at a time
   MAXENT = 3000                                                ;* lines kept
   ha = fmt('Time', '19L') : ' ' : fmt('User', '10L') : ' ' : fmt('Event', '28L') : ' ' : 'Details'

   cur.file = 'audit'
   flt = ''                                                     ;* the filter, as $audit_read takes it: from to event account user text
   ent = '' ; nent = 0                                          ;* the loaded lines, <n,1> their offset and <n,2> their text, oldest first
   lo = 0 ; hi = 0 ; fsz = 0 ; moreold = 0
   follow = 0
   ci = 1 ; ta = 0
   gen = 0
   done = 0
   msg = ''

   gosub read.initial
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, 'Audit', '', '', mr)              ;* the bar first: it writes row 0 whole, and the frame then writes the app name at its right end
      call $tk_frame(ctx, keys, 'Audit', msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key timeout 3 returning nm
      mr = ''
      busy = (if flt # '' then 1 else 0)
      if nm # '' then call $tk_menubar('key', ctx, keys, 'Audit', nm, busy, mr)       ;* the Esc rule: the filters are cleared before the bar opens
      if mr<1> # '' then nm = mr<4>
      begin case
         case nm = ''
            if status() = ER$EOF then exit
            if follow then gosub timed.follow
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', lchg)
            gosub get.rects
            gosub keep.in.view
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the file says

* The newest lines that pass the filter, from the end of the file
read.initial:
   ent = '' ; nent = 0 ; lo = 0 ; hi = 0 ; moreold = 0 ; ci = 1 ; ta = 0
   call $audit_read('back', cur.file, flt, '' : @fm : BLK, res, rerr)
   if rerr # '' then
      msg = rerr
      return
   end
   lo = res<1>
   fsz = res<2>
   hi = res<3>
   for i = 4 to dcount(res, @fm)
      ent<-1> = res<i>
   next i
   nent = dcount(ent, @fm)
   if ent = '' then nent = 0
   moreold = (lo > 0)
   ci = nent
   if ci < 1 then ci = 1
   if nent = 0 then
      msg = (if moreold then 'no line in the newest part of the file passes the filter' else 'no line passes the filter')
   end
   return

* BLK more lines from before the oldest loaded one; ci and ta move down by the number added, so the cursor stays on its line.  n.old is how many were added.
load.older:
   n.old = 0
   if not(moreold) then
      msg = 'that is the start of the file'
      return
   end
   call $audit_read('back', cur.file, flt, lo : @fm : BLK, res, rerr)
   if rerr # '' then
      msg = rerr
      return
   end
   olds = ''
   for i = 4 to dcount(res, @fm)
      olds<-1> = res<i>
   next i
   fsz = res<2>
   lo = res<1>
   moreold = (lo > 0)
   if olds = '' then
      moreold = 0
      msg = 'no older line passes the filter'
      return
   end
   n.old = dcount(olds, @fm)
   if ent = '' then ent = olds else ent = olds : @fm : ent
   nent += n.old
   ci += n.old
   ta += n.old
   if nent > MAXENT then
      for i = nent to MAXENT + 1 step -1
         del ent<i>
      next i
      nent = MAXENT
      if ci > nent then ci = nent
      hi = ent<nent, 1> + len(ent<nent, 2>) + 1
      msg = 'only the oldest ' : MAXENT : ' lines are kept; End loads the newest again'
   end
   return

* The lines written since the last read; the cursor goes with the newest if it was on it.  newn is how many were added.
read.newer:
   newn = 0
   for iter = 1 to 10
      call $audit_read('fwd', cur.file, flt, hi : @fm : BLK, res, rerr)
      if rerr # '' then
         msg = rerr
         return
      end
      if res<2> < hi then
         gosub read.initial
         msg = 'the audit file was rotated; read again from its end'
         return
      end
      newl = ''
      for i = 4 to dcount(res, @fm)
         newl<-1> = res<i>
      next i
      fsz = res<2>
      hi = res<1>
      if newl = '' then exit
      nn = dcount(newl, @fm)
      was.last = (ci >= nent)
      if ent = '' then ent = newl else ent = ent : @fm : newl
      nent += nn
      newn += nn
      if was.last then ci = nent
      if nent > MAXENT then
         ncut = nent - MAXENT
         for i = 1 to ncut
            del ent<1>
         next i
         nent = MAXENT
         ci -= ncut
         ta -= ncut
         if ci < 1 then ci = 1
         if ta < 0 then ta = 0
         lo = ent<1, 1>
         moreold = (lo > 0)
      end
      if nn < BLK then exit
   next iter
   return

timed.follow:
   gosub read.newer
   if newn > 0 then
      gosub draw.filter
      gosub redraw
   end
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.88 L2).  The three boxes are the panes of the layout service, declared in the sizes of the reference layout (140 by 43, the body 138 by 39): the box at the top stays as
* high as it is, and the rows a bigger window gives are shared by the list (twice) and the box under it (once, which shows more of the line under the cursor).  The page never hands the
* terminal over, so the declaration is made once, after the open, and the rectangles are fetched again after each 'refresh'.
* Out: top (the audit trail), lst (the lines), det (the line under the cursor), each .x .y .w .h; ttw, ltw, dtw (the text width of each box); VL (the list rows on the screen) and
* DR (the rows of the box under it).
declare.layout:
   ld = ''
   ld<1> = 'trail' : @vm : 1 : @vm : 1 : @vm : 6 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   ld<2> = 'lines' : @vm : 2 : @vm : 1 : @vm : 20 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 2 : @vm : 'stretch' : @vm : 1
   ld<3> = 'detail' : @vm : 3 : @vm : 1 : @vm : 13 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   call $tk_layout('declare', ctx, ld, perr)
   if perr # '' then
      call $tk_close(ctx)
      display perr
      stop
   end
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'trail', lrc)
   top.x = lrc<1, 1> ; top.y = lrc<1, 2> ; top.w = lrc<1, 3> ; top.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'lines', lrc)
   lst.x = lrc<1, 1> ; lst.y = lrc<1, 2> ; lst.w = lrc<1, 3> ; lst.h = lrc<1, 4>
   call $tk_layout('pane', ctx, 'detail', lrc)
   det.x = lrc<1, 1> ; det.y = lrc<1, 2> ; det.w = lrc<1, 3> ; det.h = lrc<1, 4>
   ttw = top.w - 4
   ltw = lst.w - 4
   dtw = det.w - 4
   VL = lst.h - 3                                               ;* the heading, the list rows and the border: 17 rows of 20
   DR = det.h - 2                                               ;* the rows of the box under the list: 11 of 13
   return

* After a resize the rows scrolled off the top are not more than the lines loaded less the rows that fit
keep.in.view:
   if ta > nent - VL then ta = nent - VL
   if ta < 0 then ta = 0
   return

draw.all:
   cw2 = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,1 size cw2,chh
   screen box at top.x,top.y size top.w,top.h title 'Audit trail'
   screen box at lst.x,lst.y size lst.w,lst.h title 'Lines'
   screen box at det.x,det.y size det.w,det.h title 'The line under the cursor'
   gosub draw.filter
   gosub redraw
   return

draw.filter:
   s = 'File: ' : cur.file : '   (' : fsz : ' bytes)   Lines loaded: ' : nent : '   Older lines: ' : (if moreold then 'more in the file' else 'none') : '   Follow: ' : (if follow then 'on' else 'off')
   screen text s at top.x + 2,top.y + 1 attr 'bold' width ttw - 6
   s = 'From: ' : (if flt<1> = '' then 'any' else flt<1>) : '   To: ' : (if flt<2> = '' then 'any' else flt<2>)
   screen text s at top.x + 2,top.y + 2 width ttw
   s = 'Event: ' : (if flt<3> = '' then 'any' else flt<3>) : '   Account: ' : (if flt<4> = '' then 'any' else flt<4>) : '   User: ' : (if flt<5> = '' then 'any' else flt<5>) : '   Text: ' : (if flt<6> = '' then 'any' else flt<6>)
   screen text s at top.x + 2,top.y + 3 width ttw
   screen text 'F filters   C clears them   D goes to a time   O shows another audit file   L follows   X saves the lines shown   F5 reads again' at top.x + 2,top.y + 4 width ttw
   call $tk_help('mark', top.x + top.w - 5, top.y + 1, 0, 0)
   return

redraw:
   gosub draw.list
   gosub draw.detail
   return

draw.list:
   screen text ha at lst.x + 2,lst.y + 1 attr 'header' width ltw
   if ci <= ta then ta = ci - 1
   if ci > ta + VL then ta = ci - VL
   if ta < 0 then ta = 0
   for r = 1 to VL
      kk = ta + r
      s = ''
      if kk <= nent then
         rw = kk
         gosub row.text
         s = rtext
      end
      rat = 'normal'
      if kk = ci and kk <= nent then rat = 'highlight'
      screen text s at lst.x + 2,lst.y + 1 + r attr rat width ltw
   next r
   return

* Entry rw as a line of text: time, user, event words, then the pairs
row.text:
   call $audit_read('parse', '', '', ent<rw, 2>, pr, perr)
   rpairs = ''
   for q = 7 to dcount(pr, @fm)
      rpairs := (if rpairs = '' then '' else '  ') : pr<q>
   next q
   rtime = pr<1>
   ruser = pr<2>
   revent = pr<6>
   rtext = fmt(rtime[1, 19], '19L') : ' ' : fmt(ruser[1, 10], '10L') : ' ' : fmt(revent[1, 28], '28L') : ' ' : rpairs
   rtext = rtext[1, ltw]
   return

* The whole line under the cursor, wrapped, and its parts
draw.detail:
   for r = 1 to DR
      screen text '' at det.x + 2,det.y + r width dtw
   next r
   if nent = 0 or ci < 1 or ci > nent then
      screen text 'There is no line to show.' at det.x + 2,det.y + 1 width dtw
      return
   end
   lines = ''
   cline = ent<ci, 2>
   call $tk_wrap(cline, dtw, pieces)
   for r = 1 to dcount(pieces, @fm)
      if r <= 3 then lines<-1> = pieces<r>
   next r
   if dcount(pieces, @fm) > 3 then
      l3 = lines<3>
      lines<3> = l3[1, dtw - 4] : ' ...'
   end
   call $audit_read('parse', '', '', cline, pr, perr)
   lines<-1> = ''
   s = 'Time ' : pr<1> : '   User ' : pr<2> : (if pr<3> = '' then '' else '   Sudo ' : pr<3>) : '   Uid ' : pr<4> : '   Pid ' : pr<5>
   lines<-1> = s
   lines<-1> = 'Event ' : pr<6>
   np = dcount(pr, @fm) - 6
   room = DR - dcount(lines, @fm)
   for q = 1 to np
      if q <= room then
         ix = 6 + q
         pr.s = pr<ix>
         k = index(pr.s, '=', 1)
         if k > 0 then
            pk = pr.s[1, k - 1]
            pv = pr.s[k + 1, len(pr.s)]
            pr.s = fmt(pk[1, 18], '18L') : ' = ' : pv
         end
         if q = room and np > room then
            lines<-1> = '... and ' : np - room + 1 : ' more pairs'
         end else
            lines<-1> = '  ' : pr.s
         end
      end
   next q
   for r = 1 to dcount(lines, @fm)
      if r <= DR then
         lr = lines<r>
         screen text lr[1, dtw] at det.x + 2,det.y + r width dtw
      end
   next r
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 and nm >= 'A' and nm <= 'Z' then nm = downcase(nm)
   begin case
      case nm = 'up'
         want = 1
         gosub go.up
      case nm = 'down'
         ci += 1
         if ci > nent then ci = nent
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'pgup'
         want = VL
         gosub go.up
      case nm = 'pgdn'
         ci += VL
         if ci > nent then ci = nent
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'home'
         ci = 1
         gosub redraw
      case nm = 'end'
         gosub read.newer
         ci = nent
         if ci < 1 then ci = 1
         gosub draw.filter
         gosub redraw
      case nm = 'f'
         gosub do.filter
      case nm = 'c' or (nm = 'esc' and flt # '')
         flt = ''
         gosub read.initial
         gosub draw.filter
         gosub redraw
         if msg = '' then msg = 'the filters are cleared'
      case nm = 'd'
         gosub do.goto
      case nm = 'o'
         gosub do.file
      case nm = 'l'
         follow = (if follow then 0 else 1)
         gosub draw.filter
         msg = (if follow then 'following the file: new lines appear as they are written' else 'not following the file')
      case nm = 'x'
         gosub do.export
      case nm = 'f1' or nm = '?'
         call $tk_help('box', 'tool.audit.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'f5'
         gosub read.newer
         gosub draw.filter
         gosub redraw
         if msg = '' then msg = (if newn = 0 then 'read again: no new line' else newn : ' new line' : (if newn = 1 then '' else 's'))
      case nm = 'ctrl-q'
         done = 1
   end case
   return

* want rows up; above the first loaded line older lines are loaded when the file has them (load.older moves ci down by what it adds)
go.up:
   ci -= want
   if ci < 1 then
      if moreold then gosub load.older
      if ci < 1 then ci = 1
   end
   gosub draw.filter
   gosub redraw
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, 'Audit', mev, '', mr)                     ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key                          ;* a bar left with nothing chosen has no name: the status message stays
      return
   end
   call $tk_help('hit', mev, top.x + top.w - 5, top.y + 1, hit.m)
   if hit.m then
      call $tk_help('box', 'tool.audit.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      if mx >= lst.x + 2 and mx <= lst.x + lst.w - 3 and my >= lst.y + 2 and my <= lst.y + 1 + VL then
         if ta + my - lst.y - 1 <= nent then
            ci = ta + my - lst.y - 1
            gosub redraw
         end
      end
   end
   return

* ------------------------------------------------------------------------------------------------- the filters

* Ask for the six filters one after another.  Esc at any question leaves all of them as they were.
do.filter:
   nf = flt
   cv = flt<1>
   screen ask 'From: a time such as 2026-10-25 or 2026-10-25 14:30 (empty for any)' width 20 value cv title 'Audit filter  1 of 6' returning v else return
   v = trim(v)
   gosub chk.stamp
   if not(stamp.ok) then return
   nf<1> = v
   cv = flt<2>
   screen ask 'To: a time such as 2026-10-25 (the whole day) or 2026-10-25 14:30 (empty for any)' width 20 value cv title 'Audit filter  2 of 6' returning v else return
   v = trim(v)
   gosub chk.stamp
   if not(stamp.ok) then return
   nf<2> = v
   cv = flt<3>
   screen ask 'Event: words of the event, such as login or modify.account (empty for any)' width 40 value cv title 'Audit filter  3 of 6' returning v else return
   v = trim(v)
   nf<3> = v[1, 60]
   cv = flt<4>
   screen ask 'Account: the account= value (empty for any)' width 40 value cv title 'Audit filter  4 of 6' returning v else return
   v = trim(v)
   nf<4> = v[1, 60]
   cv = flt<5>
   screen ask 'User: the user or the sudo user (empty for any)' width 40 value cv title 'Audit filter  5 of 6' returning v else return
   v = trim(v)
   nf<5> = v[1, 60]
   cv = flt<6>
   screen ask 'Text: anywhere in the line (empty for any)' width 60 value cv title 'Audit filter  6 of 6' returning v else return
   v = trim(v)
   nf<6> = v[1, 60]
   flt = nf
   gosub read.initial
   gosub draw.all
   if msg = '' then msg = (if nent = 0 then 'no line passes the filters' else nent : ' line' : (if nent = 1 then '' else 's') : ' loaded')
   return

* v is a time stamp or the start of one: digits, '-', ' ' and ':' only, up to 19 characters; stamp.ok is 1 when it is (and msg says why when not)
chk.stamp:
   stamp.ok = 1
   if len(v) > 19 then stamp.ok = 0
   for si = 1 to len(v)
      if index('0123456789- :', v[si, 1], 1) = 0 then stamp.ok = 0
   next si
   if not(stamp.ok) then msg = 'a time looks like 2026-10-25 or 2026-10-25 14:30'
   return

* Go to the first line at or after a time: load older lines until the oldest one is before it
do.goto:
   screen ask 'Go to the first line at or after: 2026-10-25 or 2026-10-25 14:30' width 20 value '' title 'Go to a time' returning v else return
   v = trim(v)
   if v = '' then return
   gosub chk.stamp
   if not(stamp.ok) then return
   loop
      if nent > 0 then
         o1 = ent<1, 2>
         if o1[1, len(v)] < v then exit
      end
      if not(moreold) or nent >= MAXENT then exit
      gosub load.older
      if n.old = 0 then exit
   repeat
   hit.i = 0
   for i = 1 to nent
      o1 = ent<i, 2>
      if o1[1, len(v)] >= v then
         hit.i = i
         exit
      end
   next i
   if hit.i = 0 then
      msg = 'no loaded line is at or after ' : v
   end else
      ci = hit.i
      msg = 'at the first loaded line at or after ' : v
   end
   gosub draw.filter
   gosub redraw
   return

* The next audit file: the current one, then the rotated ones newest first, and round
do.file:
   call $audit_read('files', '', '', '', fl, ferr)
   if ferr # '' then
      msg = ferr
      return
   end
   nfl = dcount(fl, @fm)
   if nfl <= 1 then
      msg = 'there is no other audit file'
      return
   end
   fi = 0
   for i = 1 to nfl
      if fl<i> = cur.file then fi = i
   next i
   fi += 1
   if fi > nfl then fi = 1
   cur.file = fl<fi>
   gosub read.initial
   gosub draw.all
   if msg = '' then msg = 'showing ' : cur.file
   return

* ------------------------------------------------------------------------------------------------- saving the lines shown

* The lines loaded, each as it stands in the file, as one record of the $HOLD file of this account
do.export:
   if nent = 0 then
      msg = 'there is no line to save'
      return
   end
   open '$hold' to hold.f else
      msg = 'the $HOLD file of this account cannot be opened'
      return
   end
   tm = oconv(time(), 'MTS')
   convert ':' to '' in tm
   mm = @month
   if len(mm) < 2 then mm = '0' : mm
   dd = @day
   if len(dd) < 2 then dd = '0' : dd
   rid = 'audit.' : @year4 : mm : dd : '.' : tm
   etxt = ''
   for i = 1 to nent
      etxt<i> = ent<i, 2>
   next i
   write etxt to hold.f, rid on error
      msg = 'the record could not be written (status ' : status() : ')'
      return
   end
   void kernel(K$AUDIT, 'tool export app=tool.audit lines=' : nent : ' record=' : rid)
   msg = nent : ' line' : (if nent = 1 then '' else 's') : ' saved as record ' : rid : ' of $HOLD (ED $HOLD ' : rid : ' reads it)'
   return

end

