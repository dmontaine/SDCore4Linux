* UPGRADE_GATES
* S.63 (owner, 13 Oct 2026).  Keep what the existing accounts have when the OS-access gates return.
*
* The gates return OFF by default: a new account has no SH and no OS.EXECUTE until SDSYS gives them
* (MODIFY.ACCOUNT SH-ON / OS-ON).  But the accounts that exist when this ships have been running with
* both since 18 Sep, and a blank in the register reads as denied, so an upgrade that did nothing would
* lock every one of them out of `sh`, `!`, nano, micro, OS.EXECUTE and Python on the morning after.  The
* owner's rule for this (13 Oct): "existing accounts leave on to preserve their existing situation".
*
* So this sets ACC$SH and ACC$OS.EXEC to 'yes' ONCE for every USER account in the register (an sdu_ group:
* the only kind with a Linux user of its own).  ssh and the API are not touched - those accounts are
* members of sdssh / sdapi already and the route words (S.29) keep their meaning.  GROUP and OTHER accounts
* have no shell to permit and are left blank.  SDSYS needs nothing: the administrator passes the gate.
*
* ONCE MEANS ONCE.  An administrator who later runs MODIFY.ACCOUNT jack SH-OFF must not find the next
* install turning it back on, so the walk leaves a marker, sdsys/$gates.done, and does nothing when the
* marker is there.  The marker is written only after every account was written, so a run that stopped
* half way is repeated whole (setting 'yes' on a record that already says 'yes' changes nothing).
*
* RUN gpl.bp upgrade_gates           set the gates for the existing accounts, once
*
* It runs from the installer's upgrade block, as sd -internal, AFTER UPDATE.ACCOUNTS ALL and before the
* register is chowned to sdsys.  It prints COMPLETE on a line of its own when, and only when, the register
* holds what it should; the installer matches on that word and nothing else.
*
* START-HISTORY:
* 13 Oct 26 dm  New.
* END-HISTORY
*
* START-CODE

$internal
program upgrade_gates

$include syscom keys.h
$include int$keys.h

   marker = @sdsys:@ds:'$gates.done'

   if ospath(marker, OS$EXISTS) then
      crt 'The OS-access gates were set for the existing accounts by an earlier install; nothing changed.'
      crt 'COMPLETE'
      stop
   end

   openpath @sdsys:@ds:'accounts' to acc.f else
      crt 'Cannot open the account register: the OS-access gates were NOT set.'
      stop
   end

   changed = 0
   kept = 0
   failed = 0
   select acc.f to 12
   loop
      readnext reg.name from 12 else exit
      readu rec from acc.f, reg.name else
         continue
      end
      if rec<ACC$GROUP>[1, 4] = 'sdu_' then
         if upcase(trim(rec<ACC$SH>)) = 'YES' and upcase(trim(rec<ACC$OS.EXEC>)) = 'YES' then
            kept += 1
            release acc.f, reg.name
         end else
            rec<ACC$SH> = 'yes'
            rec<ACC$OS.EXEC> = 'yes'
            written = @true
            write rec to acc.f, reg.name on error written = @false
            if written then
               changed += 1
            end else
               failed += 1
               release acc.f, reg.name
               crt 'Cannot write the register record of ' : reg.name
            end
         end
      end else
         release acc.f, reg.name
      end
   repeat

   crt 'OS-access gates: switched on for ' : changed : ' existing account(s); ' : kept : ' already had both; ' : failed : ' failed'

   if failed # 0 then
      crt 'The gates were NOT all set, so the marker is not written and the next install repeats this.'
      stop
   end

   openseq marker to marker.f then
      weofseq marker.f
   end else
      create marker.f else
         crt 'Cannot write ' : marker : ': the gates are set, but the next install will repeat the walk (harmless).'
         crt 'COMPLETE'
         stop
      end
   end
   writeseq 'S.63: the OS-access gates were set for the existing accounts' to marker.f else null
   closeseq marker.f

   crt 'COMPLETE'
   stop

end

* END-CODE
