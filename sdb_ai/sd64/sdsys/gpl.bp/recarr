* RECARR
* A record as a nested array, and back (the one-editor plan, stage 1, 26 Oct 2026): the way a multivalue record is shown and edited by CED in its data mode (ced_edit,
* ftype 2), so that nobody types a value or a subvalue mark.
* Copyright (c) 2026, SD Core for Linux.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 26 Oct 26 dm  New.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $recarr(op, a, b, ok)
*
*     op = 'to'    a = a record (fields separated by field marks, values by value marks, subvalues by subvalue marks)
*                  b = out: an array of the fields.  ok = 1.
*     op = 'from'  a = such an array
*                  b = out: the record.  ok = 1, or 0 when the array holds something that is not a record's shape (see below); b is then null.
*
*   THE CANONICAL FORM, which is what makes the round trip exact:
*     - a field is a STRING unless it holds a value mark or a subvalue mark, when it is an array of its values;
*     - a value is a STRING unless it holds a subvalue mark, when it is an array of its subvalues;
*     - a subvalue is always a string.
*   So the record 'a]b\c' (] a value mark, \ a subvalue mark) is the array ['a'], then ['b' and 'c' as an array]: field 1 is an array of two values, value 2 of which is an
*   array of two subvalues.  A record with no fields (the null string) is the empty array; the array of one empty string is the same record, the null string.
*
*   Elements are numbered from 1 with no gaps (an array of a collection is), so field n of the record is element n.  A text with other marks in it (the text mark, the item
*   mark) is just text.  'from' puts the marks back from the shape alone, so an edit that adds a value, removes a subvalue or changes a text comes out as that edit; what the
*   editor can make is limited by the data mode of CED (a string or an array, an array nowhere below the third level).  An array deeper than a record can be, or a number,
*   a boolean, a null or a collection where a string or an array should be, is refused (ok = 0): nothing is guessed.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine recarr(op, a, b, ok)
$catalog $recarr

   ok = 1
   begin case
      case op = 'to'
         gosub to.array
      case op = 'from'
         gosub from.array
      case 1
         b = ''
         ok = 0
   end case
   return

* ----------------------------------------------------------------------
* The record in a as the array b

to.array:
   b = jparse('[]')
   n.f = dcount(a, @fm)
   for f.i = 1 to n.f
      f.t = a<f.i>
      if index(f.t, @vm, 1) or index(f.t, @sm, 1) then
         b{f.i} = mat()
         f.a = b{f.i}
         n.v = dcount(f.t, @vm)
         for v.i = 1 to n.v
            v.t = f.t<1, v.i>
            if index(v.t, @sm, 1) then
               f.a{v.i} = mat()
               v.a = f.a{v.i}
               n.s = dcount(v.t, @sm)
               for s.i = 1 to n.s
                  v.a{s.i} = v.t<1, 1, s.i>
               next s.i
            end else
               f.a{v.i} = v.t
            end
         next v.i
      end else
         b{f.i} = f.t
      end
   next f.i
   return

* ----------------------------------------------------------------------
* The array in a as the record b.  The text is put together with the marks by hand, not by assigning to <f, v, s>, so that an empty value or a trailing mark is kept.

from.array:
   b = ''
   if jtype(a) # 'array' then
      ok = 0
      return
   end
   n.f = inmat(a)
   for f.i = 1 to n.f
      if f.i > 1 then b := @fm
      f.e = a{f.i}
      f.k = jtype(f.e)
      begin case
         case f.k = 'string'
            b := f.e
         case f.k = 'array'
            n.v = inmat(f.e)
            for v.i = 1 to n.v
               if v.i > 1 then b := @vm
               v.e = f.e{v.i}
               v.k = jtype(v.e)
               begin case
                  case v.k = 'string'
                     b := v.e
                  case v.k = 'array'
                     n.s = inmat(v.e)
                     for s.i = 1 to n.s
                        if s.i > 1 then b := @sm
                        s.e = v.e{s.i}
                        if jtype(s.e) = 'string' then b := s.e else ok = 0
                     next s.i
                  case 1
                     ok = 0
               end case
            next v.i
         case 1
            ok = 0
      end case
   next f.i
   if not(ok) then b = ''
   return

end
