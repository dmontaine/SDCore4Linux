* START-DESCRIPTION:
*
*   call $sl_picker(mode, file, id, res, newtext)
*
*     mode     null: the person picks a file, then a record in it.  'file': only the file (file is the answer, id is null).  'record': file is given
*              and only the record is picked (Esc then ends the picker).
*     file     the file picked (or, with mode 'record', the file to pick in)
*     id       the record id picked, exactly as the file stores it
*     res      'ok' a record (or, with mode 'file', a file) was picked; 'new' the person pressed Ctrl-N in the list of records: file is the file and newtext
*              is what had been typed into the filter, and id is null - the caller then runs ITS OWN new-record path, with its own gates; 'cancel' Esc at the
*              first list, a session with no terminal, no file to pick from, or a file that cannot be opened
*     newtext  see 'new'
*
*   The files are the account's VOC entries of type F (or whose first line begins "File "), leaving out the names that begin with a dollar sign: the list the
*   IDE shows.  The records are listed by $sl_pickwin's paged source, so a file of a million records is read a page at a time.  Esc in the list of records
*   goes back to the list of files.  THE PICKER NEVER WRITES: it opens the file for reading, takes no lock and creates, changes and deletes nothing.  What the
*   caller does with the answer, and whether it may, is the caller's.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_picker(mode, file, id, res, newtext)
$catalog $sl_picker

   res = 'cancel'
   id = ''
   newtext = ''
   if system(25) then return                  ;* a phantom has no terminal

   stage = 1
   if mode = 'record' then stage = 2

   loop
      if stage = 1 then
         gosub list.files
         if fl = '' then return
         call $sl_pickwin(fl, sysmsg(11171), 0, 0, pr, ps, '', '')
         if ps # 0 then return
         file = fl<pr, 1>
         if mode = 'file' then
            res = 'ok'
            return
         end
         stage = 2
      end else
         open file to fv else return
         call $sl_pickwin('', sysmsg(11172, file), 0, 0, pr, ps, fv, '0' : @fm : 200 : @fm : 100000 : @fm : 20000, 'ctrl-n', typed)
         close fv
         begin case
            case ps = 0
               id = pr
               res = 'ok'
               return
            case ps = 2
               newtext = typed
               res = 'new'
               return
            case mode = 'record'
               return
            case 1
               stage = 1
         end case
      end
   repeat

   return

* The files of the account, one to a field: the VOC's type F entries (or a description that begins "File "), not the names that begin with a dollar sign
list.files:
   fl = ''
   open 'VOC' to vocf then
      sselect vocf to 9
      readlist ids from 9 else ids = ''
      nid = dcount(ids, @fm)
      if ids = '' then nid = 0
      for i = 1 to nid
         read r from vocf, ids<i> then
            t1 = upcase(r<1>)
            if (t1 = 'F' or t1[1, 5] = 'FILE ') and ids<i>[1, 1] # '$' then fl<-1> = ids<i>
         end
      next i
      close vocf
   end
   return
end

* END-CODE
