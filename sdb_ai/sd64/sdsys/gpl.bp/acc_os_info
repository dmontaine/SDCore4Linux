* ACC_OS_INFO
* What the operating system knows about an SD account, as manifest lines.
* Copyright (c) String Database
*
* START-HISTORY:
* 21 Oct 26 dm S.73 item 3: the manifest key route.files.admin (1 if the user is in the group sdfilesadmin, which lets the files-only login administer files), after route.files.write.
* 18 Oct 26 dm S.65 write group: the manifest key route.files.write (1 if the user is in the group sdfileswrite, which lets the files-only login change files), after route.files.
* 18 Oct 26 dm S.66: the manifest keys shared.read (1 unless ACC$SHARED.READ says no: a blank field means on) and shared.write (1 only if yes), USER arm only.
* 17 Oct 26 dm S.65 slice 2c: the manifest key route.files (1 if the user is in the group sdfiles, the files-only SDNet login), beside route.ssh and
*              route.api.  NOT `files`: the backup writes `files: N` (the file count) into the same section, and restorea reads it as that count.
* 17 Oct 26 dm S.65 slice 1: the manifest key net (1 only if ACC$NET says yes), beside edit.voc, edit.bp and edit.dict; the NET gate does nothing yet.
* 01 Oct 26 dm Written for S.50 (per-OS helper; signature agreed with SD Core
*              for Windows by mail, 2026-10-01T1030 and 1115).
* END-HISTORY
*
* START-DESCRIPTION:
*
*    call !acc_os_info(acc.name, acc.rec, info, err)
*
*    info: "key: value" lines, one per field.
*
*    acc.name ''  - the system keys: product, host, accounts.root, sd.version.
*    acc.name set - the account's keys, from its ACCOUNTS record (acc.rec):
*                   type, os.user, os.group, route.ssh, route.api, route.files, route.files.write, route.files.admin, os.sh,
*                   os.execute, and for a GROUP account its members.
*
*    LINUX DETAIL.  The type comes from the register's group (sdu_ USER, sdg_
*    GROUP, anything else OTHER), as DELETE.ACCOUNT reads it.  A route is
*    membership of sdssh / sdapi (S.29).  os.sh and os.execute (S.63) are the
*    register's ACC$SH and ACC$OS.EXEC, 1 only if the field says yes - the same
*    keys the Windows port writes from os.users - so RESTORE.ACCOUNT gives a
*    restored account the gates it had.  A GROUP account's members are its
*    sdg_ group's members less root and sdsys, which createa adds to every
*    account group.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine acc_os_info(acc.name, acc.rec, info, err)
$catalog !acc_os_info

$include keys.h
$include int$keys.h

deffun is_grp_member(user,group) calling '!is_grp_member'

   info = ''
   err = ''

   if acc.name = '' then
      usr = config('USRDIR')
      if usr = '' then usr = '/home/sd/user_accounts'
      info<-1> = 'product: linux-full'
      info<-1> = 'host: ':downcase(field(@hostname, '.', 1))
      info<-1> = 'accounts.root: ':field(usr, @ds, 1, dcount(usr, @ds) - 1)
      info<-1> = 'sd.version: ':system(1012)
      return
   end

   grp = acc.rec<ACC$GROUP>
   begin case
      case grp[1,4] = 'sdu_'
         user = grp[5,999]
         info<-1> = 'type: USER'
         info<-1> = 'os.user: ':user
         info<-1> = 'os.group: ':grp
         info<-1> = 'route.ssh: ':(if is_grp_member(user, 'sdssh') then 1 else 0)
         info<-1> = 'route.api: ':(if is_grp_member(user, 'sdapi') then 1 else 0)
         info<-1> = 'route.files: ':(if is_grp_member(user, 'sdfiles') then 1 else 0)     ;* 17 Oct 26, S.65 slice 2c: membership of sdfiles, the files-only login
         info<-1> = 'route.files.write: ':(if is_grp_member(user, 'sdfileswrite') then 1 else 0)     ;* 18 Oct 26, S.65 write group: membership of sdfileswrite
         info<-1> = 'route.files.admin: ':(if is_grp_member(user, 'sdfilesadmin') then 1 else 0)     ;* 21 Oct 26, S.73 item 3: membership of sdfilesadmin
         info<-1> = 'os.sh: ':(if upcase(trim(acc.rec<ACC$SH>)) = 'YES' then 1 else 0)
         info<-1> = 'os.execute: ':(if upcase(trim(acc.rec<ACC$OS.EXEC>)) = 'YES' then 1 else 0)
         info<-1> = 'edit.voc: ':(if upcase(trim(acc.rec<ACC$VOC.EDIT>)) = 'YES' then 1 else 0)     ;* 17 Oct 26, S.64
         info<-1> = 'edit.bp: ':(if upcase(trim(acc.rec<ACC$BP.EDIT>)) = 'YES' then 1 else 0)
         info<-1> = 'edit.dict: ':(if upcase(trim(acc.rec<ACC$DICT.EDIT>)) = 'YES' then 1 else 0)
         info<-1> = 'net: ':(if upcase(trim(acc.rec<ACC$NET>)) = 'YES' then 1 else 0)     ;* 17 Oct 26, S.65 slice 1: the NET gate (does nothing yet)
         info<-1> = 'shared.read: ':(if upcase(trim(acc.rec<ACC$SHARED.READ>)) # 'NO' then 1 else 0)     ;* 18 Oct 26, S.66: BLANK MEANS ON, so only the word no gives 0
         info<-1> = 'shared.write: ':(if upcase(trim(acc.rec<ACC$SHARED.WRITE>)) = 'YES' then 1 else 0)

      case grp[1,4] = 'sdg_'
         info<-1> = 'type: GROUP'
         info<-1> = 'os.group: ':grp
         if index(grp, "'", 1) then
            err = 11013:@vm:grp
            return
         end
         out = ''
         os.execute "getent group '":grp:"'" capturing out
         stat = os.error()
         if stat # 0 or out<1> = '' then
            err = 11021:@vm:grp:@vm:stat ;* Cannot read the Linux group %1
            return
         end
         members = ''
         list = field(out<1>, ':', 4)
         n = dcount(list, ',')
         for i = 1 to n
            m = field(list, ',', i)
            if m # '' and m # 'root' and m # 'sdsys' then
               if members # '' then members := ','
               members := m
            end
         next i
         info<-1> = 'members: ':members

      case 1
         info<-1> = 'type: OTHER'
   end case
   return

end

* END-CODE
