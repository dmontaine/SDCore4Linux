* START-HISTORY:
* 18 Nov 26 dm  Every EXECUTE traps aborts, as load.examples': an abort in an account the session cannot write ended the verb inside that account.
* 17 Nov 26 dm  New (the owner, 17 Nov 2026: "there should be a companion remove.examples verb for the administrator, both load.examples and remove.examples
*               should take a list of accounts").  Made from loadexamples, which it undoes.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   REMOVE.EXAMPLES                     every registered account
*   REMOVE.EXAMPLES account ...         the accounts named, a list; a name that is not registered is said and skipped, and the others go on
*
*   The administrator's verb, the companion of LOAD.EXAMPLES.  In each account it deletes from examples.bp every program the system ships (the files of
*   the examples directory of the SD system directory, the same list LOAD.EXAMPLES writes) together with its compiled object in examples.bp.out.
*   A program the administrator or the account's person added under another name is KEPT, and so are its object and the file; examples.bp and
*   examples.bp.out are deleted only when nothing is left in examples.bp.  An account with no examples.bp is counted and left alone.
*
*   THE EXAMPLES COME BACK: the installer and an upgrade run LOAD.EXAMPLES for every account, and create.account runs it for a new one, so what this
*   verb removes is put back by the next of those, or by LOAD.EXAMPLES by hand.  It enters each account with LOGTO, as the administrator may (an
*   administrator's LOGTO runs no LOGIN paragraph), and goes back to the account it began in.  An account it cannot enter, and a program that cannot be
*   deleted, is named and counted; the command goes on with the others.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program remove.examples
$catalog $removeexamples

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS
   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001) ;* Command requires administrator privileges
   end

   keychars = 'abcdefghijklmnopqrstuvwxyz0123456789._-'
   src = @sdsys : @ds : 'examples'
   entries = dir(src)
   if entries = '' then stop sysmsg(14121, src)                   ;* The example programs directory is missing or empty: %1

*  The names of the shipped programs (a file name that LOAD.EXAMPLES would not take is not one of them)
   names = ''
   n.bad = 0
   for i = 1 to dcount(entries, @fm)
      name = entries<i, 1>
      if entries<i, 2> # 'F' then continue
      ok = (len(name) >= 1 and len(name) <= 80 and index('abcdefghijklmnopqrstuvwxyz', name[1, 1], 1) > 0)
      if ok then
         for ci = 2 to len(name)
            if index(keychars, name[ci, 1], 1) = 0 then ok = 0
         next ci
      end
      if ok then
         locate name in names<1> by 'AL' setting np else ins name before names<np>
      end
   next i
   if names = '' then stop sysmsg(14121, src)

*  The accounts: those named (a list, each once), or every one in the register.  A name that is not registered is said and skipped.
   want = downcase(trim(@sentence))                              ;* the verb, then the account names
   openpath @sdsys : @ds : 'accounts' to acc.f else stop sysmsg(6003)
   accts = ''
   if dcount(want, ' ') > 1 then
      for w = 2 to dcount(want, ' ')
         aid = field(want, ' ', w)
         read arec from acc.f, aid else
            display sysmsg(14130, aid)                           ;* No account is registered as %1 ...
            n.bad += 1
            continue
         end
         locate aid in accts<1> by 'AL' setting ap else ins aid before accts<ap>
      next w
   end else
      select acc.f to 11
      loop
         readnext aid from 11 else exit
         read arec from acc.f, aid else continue
         if upcase(trim(arec<ACC$SUSPENDED>)) = 'SUSPENDED' then continue     ;* a suspended account is not entered (LOGTO refuses it)
         locate aid in accts<1> by 'AL' setting ap else ins aid before accts<ap>
      repeat
   end
   close acc.f

   origin = @who
   n.acc = 0 ; n.removed = 0 ; n.files = 0 ; n.none = 0 ; n.kept = 0
   for a = 1 to dcount(accts, @fm)
      acct = accts<a>
      gosub do.account
   next a
   if downcase(@who) # downcase(origin) then execute 'logto ' : origin trapping aborts capturing lt

   void kernel(K$AUDIT, 'remove.examples accounts=' : n.acc : ' removed=' : n.removed : ' files=' : n.files : ' none=' : n.none : ' kept=' : n.kept : ' skipped=' : n.bad)
   display sysmsg(14127, n.acc, n.removed, n.files)               ;* SYSMSG takes four places
   display sysmsg(14128, n.none, n.kept)
   @system.return.code = (if n.bad then -ER$FAILED else 0)
   stop

* ------------------------------------------------------------------------------------------------- one account

do.account:
   if downcase(@who) # acct then execute 'logto ' : acct trapping aborts capturing lt
   if downcase(@who) # acct then
      display sysmsg(14131, acct)                                ;* Could not enter the account %1 ...
      n.bad += 1
      return
   end
   open 'examples.bp' to xf else
      n.none += 1
      return
   end
   n.acc += 1
   have.obj = @false
   open 'examples.bp.out' to of then have.obj = @true
   for p = 1 to dcount(names, @fm)
      read old from xf, names<p> then
         dok = @true
         delete xf, names<p> on error dok = @false
         if dok then
            n.removed += 1
         end else
            display sysmsg(14129, acct : ' ' : names<p>, 'it could not be deleted')
            n.bad += 1
         end
      end
      if have.obj then
         read obj from of, names<p> then
            dok = @true
            delete of, names<p> on error dok = @false
            if not(dok) then
               display sysmsg(14129, acct : ' ' : names<p> : ' (compiled)', 'it could not be deleted')
               n.bad += 1
            end
         end
      end
   next p
*  What is left in examples.bp is the account's own: it stays, and so do the files while there is any
   left = 0
   select xf to 12
   loop
      readnext rid from 12 else exit
      left += 1
   repeat
   n.kept += left
   close xf
   if have.obj then close of
   if left = 0 then
      execute 'delete.file examples.bp' trapping aborts capturing out
      open 'examples.bp' to xf then
         close xf
         display sysmsg(14129, acct : ' examples.bp', 'the file could not be deleted')
         n.bad += 1
      end else
         n.files += 1
         open 'examples.bp.out' to of then
            close of
            execute 'delete.file examples.bp.out' trapping aborts capturing out
            open 'examples.bp.out' to of then
               close of
               display sysmsg(14129, acct : ' examples.bp.out', 'the file could not be deleted')
               n.bad += 1
            end
         end
      end
   end
   return

end

* END-CODE
