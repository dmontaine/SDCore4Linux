*
* START-HISTORY:
* 22 Oct 26 dm  New (S.75, TK-0.8).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN SLIDER f, id, text {AT x,y} {VALUE v}
*
*   is compiled into
*
*   call !screen_slider(f, id, text, x, y, value, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     text     shown after the switch
*     x y      the place of the switch from the form's top left corner, default 1,1
*     value    1 to start on (default 0)
*     status   0 added; 1 not (ELSE)
*
*   The switch is drawn [O--] text when it is off and [==O] text when it is on.  The space bar slides it the other way, Left slides it off, Right slides it
*   on, a click slides it the other way.  SCREEN GET f, id answers 1 or 0; SCREEN SET f, id VALUE v sets it; a change is a change event of SCREEN WAIT, as for a
*   check box.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_slider(f, id, text, ax, ay, value, ret, status)
$catalog !screen_slider

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'text'} = text
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   call $sl_slider('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
