* START-HISTORY:
* 28 Oct 26 dm  S.87: * and - are no longer global prefix characters (! $ and _ are).
* 27 Oct 26 dm  S.87 batch 8: OPTION CATALOGUE.LOCAL is gone; CATALOG with no word catalogues privately, and LOCAL says local.
* 25 Oct 26 dm  W.11 F2, real-install witness: a global object is written with umask 022 (644) and the umask put back; under CPROC's umask 002 it was 0664, group
*               sdusers on an install, and the kernel refused to load it - the installer's own bootstrap stopped there.
* 17 Oct 26 dm  S.64: cataloguing needs bp.edit (SDSYS passes); message 11408.
* 12 Oct 26 dm  openQM 241: the longest call name is the lower of 128 and MAXIDLEN (63 unless the
*               administrator raised it), as op_jumps.c valid_call_name() has it.
* 13 Oct 26 dm  openQM 210: GLOBAL may be followed by a prefix character (one of * ! _ $), which is put in front
*               of every call name that has no prefix of its own - so a select list can be catalogued globally
*               with a prefix.  A hyphen, which openQM also lists as a prefix, is not accepted.
* 16 Oct 26 dm  openQM 217: the hyphen is accepted as a global prefix (CATALOG bp -name, GLOBAL -).
* 07 Oct 26 dm  PAL-1 D2 (the Windows port's RELEASE_1.1 5, d236ac72 and bc54c53a): the
*               upper-case rename and the second 3033 question run only on a
*               case-sensitive VOC; on a NOCASE one they deleted the new entry.
* 07 Oct 26 dm  PAL-1 stage 3a: catalogue names are stored lower case and an
*               old upper-case entry is found and replaced (the Windows port's
*               4d8136b2).
* 13 Sep 26 dm  The default source file is bp, not BP (plan M3 D3; the port's
*               1943704).
* 12 Sep 26 dm  Name lookups fold as typed, then lower, then upper (plan M1).
* 11 Sep 26 The three "also in ... catalogue. Remove?" prompts show their
*           default and Enter is N (port PRE_RELEASE_FIXES 79's rule; the
*           port missed these).  At end of input they re-asked for ever.
* 09 Sep 26 PRE_RELEASE 18 commit 2. Both global-catalogue checks ask the
*           administrator flag rather than "is this process root".
* 08 Sep 26 The rev 0.9.0 administrator check covered the GLOBAL keyword only,
*           not the *, !, _ and $ prefix routes, which are the common form.
*           One check now gates every route that reaches the global catalogue.
* rev 0.9.0 Jan 25 mab require admin priviliges for global catalog
*                       and set owner : group to sdsys : sdusers on write
* 19 Jan 04  0.6.1 SD launch. Earlier history details suppressed.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    CATALOG [file.name [call.name]] [program.name] [LOCAL]  [NO.XREF]
*                                    [*]            [GLOBAL]
*                                                   [PCODE]
*
* Omitting the program name is only valid if there is an active select list.
*
* Global mode is implied by use of catalog prefix character.
*
* Use of PCODE requires that program.name begins with an underscore.
*
* END-DESCRIPTION
*
* START-CODE

$internal

program $catalog
$catalog $CATALOG

$include parser.h
$include header.h
$include syscom.h

$include keys.h
$include int$keys.h
$include err.h

* 17 Oct 26 dm - S.64: cataloguing puts code where commands and CALLs find it, so it needs bp.edit (SDSYS passes).
   if not(kernel(K$ADMINISTRATOR, -1)) and not(kernel(K$BP.EDIT, -1)) then
      @system.return.code = -ER$PERM
      stop sysmsg(11408) ;* Programs can only be compiled or catalogued by an account that has bp.edit
   end

   prompt ''

   parser = "!PARSER"

   @system.return.code = -ER$ARGS  ;* Preset for command format errors

   dim name(3)
   no.names = 0
   no.query = @false
   relative = @false

   option.seen = @false          ;* No options yet - names still allowed

   mode = 0
$define CAT_LOCAL  1
$define CAT_GLOBAL 2
$define CAT_PCODE  3

   no.xref = @false              ;* Not seen NOXREF option
   catalogue.all = @false        ;* Not using * tolen
   using.list = @false           ;* Not using a select list
   prefix.chars = "!_$"           ;* 28 Oct 26 dm - S.87: * and - are no longer global prefixes (the _ is kept: it names a recursive pcode program)
   leading.chars = "abcdefghijklmnopqrstuvwxyz0123456789"         ;* 14 Sep 26 stage 3a: call names are lower
   following.chars = "abcdefghijklmnopqrstuvwxyz0123456789.%$-_"

   * Check for alternative private catalogue location

   private.catalogue = 'cat'
   * 11 Oct 26 dm  $PRIVATE.CATALOG is accepted as well (openQM ref 93)
   read voc.rec from voc, "$PRIVATE.CATALOGUE" else
      read voc.rec from voc, "$PRIVATE.CATALOG" else voc.rec = ''
   end
   if upcase(voc.rec[1,1]) = 'X' then private.catalogue = voc.rec<2>


   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb

   global.prefix = ''            ;* 13 Oct 26 dm - openQM 210: GLOBAL c
   after.global = @false
   loop
      call @parser(PARSER$MFILE, token.type, token, keyword)

   while token.type = parser$token
      was.global = after.global
      after.global = @false
      begin case
         case was.global and len(token) = 1 and index(prefix.chars, token, 1)
            global.prefix = token           ;* The prefix for names that carry none of their own
            option.seen = @true

         case keyword = KW$LOCAL
            if mode and mode # CAT_LOCAL then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
            option.seen = @true
            mode = CAT_LOCAL

         case keyword = KW$GLOBAL
            if mode and mode # CAT_GLOBAL then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
            option.seen = @true
            mode = CAT_GLOBAL
            after.global = @true
            * rev 0.9.0 must be admin for Global
* 09 Sep 26 dm - PRE_RELEASE 18 commit 2.  system(27) # 0 asked "is this
*   process not root", which is not what "must be admin" means under the
*   owner's definition.  CPROC's grant.administrator now decides that once,
*   and this reads the answer.
            if not(kernel(K$ADMINISTRATOR,-1)) then
              stop sysmsg(2001)  ;* Command requires administrator privileges
            end

         case keyword = KW$PCODE
            if mode and mode # CAT_PCODE then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
            option.seen = @true
            mode = CAT_PCODE

         case keyword = KW$NO.QUERY
            no.query = @true

         case upcase(token) = 'RELATIVE' and no.names >= 1     ;* 12 Oct 26 dm - openQM 131
            relative = @true
            option.seen = @true

         case keyword = KW$NOXREF
            no.xref.keyword = token  ;* Hang onto name (May not be NOXREF)
            option.seen = @true
            no.xref = @true

         case 1
            if option.seen or (no.names = 3) then
               stop sysmsg(2018, token) ;* Unexpected token (xx)
            end

            no.names += 1
            name(no.names) = token
      end case
   repeat

   * Sort out which name is which

   begin case
      case no.names = 0
         if not(selectinfo(0, sl$active)) then
            stop sysmsg(3020) ;* Program name or select list required
         end
         file.name = "bp"
         using.list = @true

      case no.names = 1
         if name(1) = '*' then
            file.name = "bp"
            catalogue.all = @true
         end else if selectinfo(0, sl$active) then
            file.name = name(1)
            using.list = @true
         end else
            file.name = "bp"
            call.name = downcase(name(1))
            program.name = name(1)
            if mode # CAT_PCODE and index(prefix.chars, call.name[1,1], 1) then
               program.name = program.name[2,999]
               if mode and mode # CAT_GLOBAL then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
               mode = CAT_GLOBAL
            end
         end

      case no.names = 2
         file.name = name(1)
         if name(2) = '*' then
            catalogue.all = @true
         end else
            program.name = name(2)
            call.name = downcase(name(2))
            if mode # CAT_PCODE and index(prefix.chars, call.name[1,1], 1) then
               program.name = program.name[2,999]
               if mode and mode # CAT_GLOBAL then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
               mode = CAT_GLOBAL
            end
         end

      case no.names = 3
         file.name = name(1)
         call.name = downcase(name(2))
         program.name = name(3)
         if mode # CAT_PCODE and index(prefix.chars, call.name[1,1], 1) then
            if mode and mode # CAT_GLOBAL then stop sysmsg(3021) ;* Incompatible cataloguing modes specified
            mode = CAT_GLOBAL
         end
   end case

* 08 Sep 26  Global cataloguing required administrator rights only when it was
* asked for by the GLOBAL keyword.  It did NOT when the same thing was asked for
* by putting a *, !, _ or $ in front of the name -- "CATALOG BP $MYPROG" -- which
* is the form most people use, and which reaches mode = CAT_GLOBAL by three
* separate routes in the case block above (no.names 1, 2 and 3).
*
* This matters because the global catalogue holds the programs SD runs for
* everybody, $LOGIN among them: replacing one runs your code in every session on
* the machine, administrators included.
*
* The check is here, once, rather than copied into each of the three routes.
* Every route that can set CAT_GLOBAL has to pass this point to reach the
* catalogue, so one test cannot fall out of step with another.  The KW$GLOBAL
* case keeps its own check as well, because refusing at the moment the keyword is
* read gives the better message; this one is what actually holds.
* 09 Sep 26 dm - PRE_RELEASE 18 commit 2.  The flag, not the uid.  See the
* KW$GLOBAL case above.
   if mode = CAT_GLOBAL and not(kernel(K$ADMINISTRATOR,-1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

   * Open the object file

   if index(file.name, ',', 1) then   ;* Multifile
      file.name = file.name[',', 1, 1] : '.OUT,' : file.name[',', 2, 999]
   end else                           ;* Simple file
      file.name := '.OUT'
   end

   open file.name to object.file else
      open downcase(file.name) to object.file then
         file.name = downcase(file.name)
      end else
         open upcase(file.name) to object.file else
            stop sysmsg(2021, file.name) ;* File %1 not found
         end

         file.name = upcase(file.name)
      end
   end

   mark.mapping object.file, off

   * Open the global and private catalogue files

   openpath @sdsys:@ds:'gcat' to gcat.f else
      stop sysmsg(3022) ;* Cannot open global catalogue directory
   end

   openpath private.catalogue to cat.f else
      stop sysmsg(3023) ;* Cannot open private catalogue directory
   end

   * Are we cataloguing every program in the file?

   if catalogue.all then
      select object.file to 11
      readnext program.name from 11 then
         loop
            call.name = downcase(program.name)
            gosub catalogue.program
            readnext program.name from 11 else exit
         repeat
      end
   end else if using.list then
      readnext program.name then
         loop
            call.name = downcase(program.name)
            gosub catalogue.program
            readnext program.name else exit
         repeat
      end
   end else           ;* No select list
      gosub catalogue.program
   end

   i = events(-1, EVT$UNLOAD)

   @system.return.code = 0

   return

* ======================================================================

catalogue.program:
   * 13 Oct 26 dm - openQM 210: GLOBAL c gives a prefix to every name that has none, so a select list can be
   * catalogued with one.  The program is still read under its own name; only the call name changes.
   if global.prefix # '' and mode = CAT_GLOBAL and not(index(prefix.chars, call.name[1,1], 1)) then
      call.name = global.prefix : call.name
   end
   gosub validate.call.name

   * Read object code image

   read object.code from object.file, program.name else
      read object.code from object.file, downcase(program.name) then
         program.name = downcase(program.name)
      end else
         read object.code from object.file, upcase(program.name) then
            program.name = upcase(program.name)
         end else
            display sysmsg(3024, file.name, program.name) ;* fn pn not found
            return
         end
      end
   end

   * Check that it is an object file

   magic = if system(1009) then HDR.MAGIC.NO.B else HDR.MAGIC.NO.L
   if object.code[hdr.magic,1] # char(magic) then
      display sysmsg(3025, program.name) ;* Invalid object record (xx)
      return
   end

   if object.code[hdr.rev,1] # char(hdr.revision) then
      display sysmsg(3026, program.name) ;* Invalid object record revision level in xx
      return
   end

   flags = oconv(object.code[hdr.flags, 2], "IS")

   * Ensure call name is in object code

   if mode # CAT_PCODE then
      object.code[hdr.program.name, hdr.program.name.len] = call.name:char(0)
   end

   * Remove symbol and line tables if NOXREF option used
   * The line table always appears before the symbol table. Both are optional.

   if no.xref then
      if bitand(flags, hdr.debug) then
         display sysmsg(3027, no.xref.keyword,  program.name) ;* xx option ignored - Program xx is in debug mode
      end else
         object.code.size = oconv(object.code[hdr.object.size, 4], "IL")

         * Reduce object size to before symbol table, if present
         symbol.table.offset = oconv(object.code[hdr.sym.tab.offset, 4], "IL")
         if symbol.table.offset then object.code.size = symbol.table.offset

         * Reduce object size to before line table, if present
         line.table.offset = oconv(object.code[hdr.lin.tab.offset, 4], "IL")
         if line.table.offset then object.code.size = line.table.offset

         object.code[hdr.object.size, 4] = iconv(object.code.size, "IL")
         object.code[hdr.sym.tab.offset, 4] = iconv(0, "IL")
         object.code[hdr.lin.tab.offset, 4] = iconv(0, "IL")

         object.code = object.code[1, object.code.size]
      end
   end


   begin case
      case mode = CAT_LOCAL
*        14 Sep 26 - stage 3a.  An entry catalogued before call names went lower
*        is under the upper-case VOC id.  It is found here and deleted once the
*        lower-case one is written, so the entry is renamed, not twinned.
*        07 Oct 26 - ONLY ON A CASE-SENSITIVE VOC (PAL-1 D2, the Windows port's
*        14 Sep 26).  On a case-insensitive one the upcase read below hits the
*        lower-case entry ITSELF, so the write updated it and the delete removed
*        it: a second CATALOG ... LOCAL printed 3029 and left no entry.  There the
*        exact read of call.name already finds an old upper entry, and writing
*        over it keeps the catalogue whole.
         old.local.id = ''
         if upcase(call.name) # call.name and not(fileinfo(@voc, FL$NOCASE)) then
            readu old.voc.rec from @voc, upcase(call.name) then
               if upcase(old.voc.rec[1,1]) = 'V' and old.voc.rec<2> = 'CS' then
                  old.local.id = upcase(call.name)
               end else
                  release @voc, upcase(call.name)
               end
            end else
               release @voc, upcase(call.name)
            end
         end

         had.local = @false
         old.local.path = ''
         readu voc.rec from @voc, call.name then
            if upcase(voc.rec[1,1]) # 'V' or voc.rec<2> # 'CS' then
               release @voc, call.name
               if old.local.id # '' then release @voc, old.local.id
               display sysmsg(3028, call.name) ;* VOC already contains a conflicting entry named xx
               return
            end
            had.local = @true
            old.local.path = voc.rec<3>
         end

         program.path = fileinfo(object.file, fl$path) : @ds : program.name
         * 12 Oct 26 dm - openQM 131: RELATIVE stores the path below the account directory as a relative path, so
         * the account (and its programs) can be moved; an object file elsewhere keeps its full path.
         if relative then
            home = @path : @ds
            if program.path[1, len(home)] = home then program.path = program.path[len(home) + 1, 99999]
         end
         * 14 Oct 26 dm  openQM item 490: a local pointer that already exists and names a DIFFERENT object file is not
         * overwritten without asking (NO.QUERY goes ahead as before).  Enter is N, as at 3033-3035.
         if had.local and old.local.path # program.path and not(no.query) then
            loop
               display sysmsg(11262, call.name, old.local.path) : ;* Local catalogue entry xx is for yy. Replace it (y/<n>)?
               input yn
               yn = upcase(yn)
               if yn = '' then yn = 'N'
            until yn = 'Y' or yn = 'N'
            repeat
            if yn = 'N' then
               release @voc, call.name
               if old.local.id # '' then release @voc, old.local.id
               return
            end
         end

         voc.rec = "V" : @fm : "CS" : @fm : program.path
         write voc.rec to @voc, call.name
         if old.local.id # '' then delete @voc, old.local.id

         display sysmsg(3029, call.name) ;* xx added to local catalogue
         gosub check.private
         gosub check.global

      case mode = CAT_GLOBAL
         recordlocku gcat.f, call.name
         mark.mapping gcat.f, off
         deleteu gcat.f, call.name   ;* 14 Sep 26 stage 3a: NTFS keeps an overwritten file's old case
         * 25 Oct 26 W.11 F2, found by the real-install witness: CPROC sets umask 002 for every session, so the object was made 0664 and, with the group sdusers it gets below,
         * the kernel refuses to load it (message 11930) - the installer's own bootstrap stopped there, and so would an administrator cataloguing globally.  A global object
         * is made with umask 022 (644), then the umask is put back.
         old.umask = umask(18)       ;* 18 = 022 octal
         write object.code to gcat.f, call.name
         if umask(old.umask) then null
         *
         * rev 0.9.0 set file ownership
         set.owner.path =  @sdsys:@ds:'gcat':@ds:call.name 
         gosub set.owner     
         display sysmsg(3030, call.name) ;* xx added to global catalogue

         gosub check.local
         gosub check.private

      case mode = CAT_PCODE
         if program.name[1,1] # '_' then
            stop sysmsg(7701, program.name) ;* %1 is not a valid recursive pcode name
         end

         program.name = downcase(program.name[2,999])   ;* 14 Sep 26 stage 3a: pcode names are lower (sd.c load_pcode)

         if not(bitand(flags, HDR.RECURSIVE)) then
            stop sysmsg(3048, program.name) ;* %1 is not a recursive pcode item
         end

         openpath @sdsys:@ds:'bin' to bin.f else
            stop sysmsg(3049) ;* Cannot open pcode library
         end

         * Delete entry from composite library if it exists

         mark.mapping bin.f, off
         readu pcode from bin.f, 'pcode' then
            * Make a backup copy of the existing pcode library.
            write pcode to bin.f, 'pcode.old'
         end

         i = 0
         loop
            s = field(pcode[i+HDR.PROGRAM.NAME, 999], char(0), 1)
            j = bitand(oconv(pcode[i+HDR.OBJECT.SIZE, 4], 'IL') + 3, bitnot(3))

            if s = program.name then       ;* Found it
               pcode = pcode[1, i] : pcode[i+j+1, 999999]
               exit
            end

            i += j
         while i < len(pcode)
         repeat

         * Now add the new entry on the end of the library file
         * We round the length to a multiple of 4 bytes to ensure
         * word alignment.

         pcode := object.code
         pcode := str(char(0), bitand(4 - bitand(len(pcode),3), 3))

         write pcode to bin.f, 'pcode'
         close bin.f
         display sysmsg(7700, call.name) ;* xx added to pcode library

      case 1
         recordlocku cat.f, call.name
         mark.mapping cat.f, off
         deleteu cat.f, call.name   ;* 14 Sep 26 stage 3a: NTFS keeps an overwritten file's old case
         write object.code to cat.f, call.name
      
         display sysmsg(3031, call.name) ;* xx added to private catalogue

         gosub check.local
         gosub check.global
   end case

   return

* ======================================================================

validate.call.name:
!!CALLNAME!!
*  12 Oct 26 dm  openQM item 241: the longest call name is the lower of 128 and
*  MAXIDLEN (63 unless raised).  The same limit is in op_jumps.c, bcomp and apisrvr.
   max.call.len = config('MAXIDLEN')
   if max.call.len > 128 then max.call.len = 128
   if max.call.len < MAX.CALL.NAME.LEN then max.call.len = MAX.CALL.NAME.LEN
   if len(call.name) > max.call.len ~
    or index(prefix.chars:leading.chars, call.name[1,1], 1) = 0 ~
    or convert(following.chars, '', call.name[2,999]) # '' ~
    or (index(prefix.chars, call.name[1,1], 1) and len(call.name) = 1) then
      stop sysmsg(3032, call.name)  ;* Illegal call name (%1)
   end
   return

* ======================================================================

check.local:
* 14 Sep 26 - stage 3a.  A local entry catalogued before call names went lower
* is under the upper-case VOC id, so both spellings are checked.
* 07 Oct 26 - ONLY ON A CASE-SENSITIVE VOC (PAL-1 D2, the Windows port's 14 Sep 26).
*   On a NOCASE one both reads hit the same record, so 3033 was asked twice and
*   the second question ate the lines after it.
   local.ids = call.name
   if upcase(call.name) # call.name and not(fileinfo(@voc, FL$NOCASE)) then local.ids<2> = upcase(call.name)
   for local.i = 1 to dcount(local.ids, @fm)
      local.id = local.ids<local.i>
      gosub check.local.id
   next local.i
   return

check.local.id:
   readu voc.rec from @voc, local.id then
      if upcase(voc.rec[1,1]) = 'V' and voc.rec<2> = 'CS' then
         if no.query then
            delete @voc, local.id
         end else
            loop
               display sysmsg(3033) : ;* Program is also in local catalogue. Remove (y/<n>)?
               input yn
               yn = upcase(yn)
               if yn = '' then yn = 'N'  ;* 11 Sep 26 - Enter is the default the prompt shows
            until yn = 'Y' or yn = 'N'
            repeat

            if yn = 'Y' then delete @voc, local.id
         end
      end
   end

   release @voc, local.id    ;* Ensure released for all paths

   return

* ======================================================================

check.private:
   readvu s from cat.f, call.name, 0 then
      if no.query then
         delete cat.f, call.name
      end else
         loop
            display sysmsg(3034) : ;* Program is also in private catalogue. Remove (y/<n>)?
            input yn
            yn = upcase(yn)
            if yn = '' then yn = 'N'  ;* 11 Sep 26 - Enter is the default the prompt shows
         until yn = 'Y' or yn = 'N'
         repeat
   
         if yn = 'Y' then delete cat.f, call.name
      end
   end

   release cat.f, call.name    ;* Ensure released for all paths

   return

* ======================================================================

check.global:
   readvu s from gcat.f, call.name, 0 then
      if no.query then
         delete gcat.f, call.name
      end else
         loop
            display sysmsg(3035) : ;* Program is also in global catalogue. Remove (y/<n>)?
            input yn
            yn = upcase(yn)
            if yn = '' then yn = 'N'  ;* 11 Sep 26 - Enter is the default the prompt shows
         until yn = 'Y' or yn = 'N'
         repeat
   
         if yn = 'Y' then delete gcat.f, call.name
      end
   end

   release gcat.f, call.name    ;* Ensure released for all paths

   return
   
   
* ======================================================================
* rev 0.9.0  mab set file ownership    
* assumes:
* set.owner.path - file path

set.owner:
   uid='sdsys'
   gid='sdusers'
   chown_parm = uid:@VM:gid:@VM:set.owner.path
   * print 'set.owner: ':chown_parm
   result = ospath(chown_parm,OS$CHOWN)
   if result <= 0 then
     st = set.owner.path:' err: ':status()
     display sysmsg(10000,st) ;* Unable change ownership of directory error %1 
   end

return
   
end

* END-CODE
