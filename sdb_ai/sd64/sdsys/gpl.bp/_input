      $internal
      $recursive
      $no.symbols
      $no.xref
      $flags allow.break

      subroutine input(string.arg, max.input, (timeout), flags)

      * Flags:
      *   IN$NOCRLF          Suppress automatic CR/LF (underscore used)
      *   IN$NOLF            Suppress LF after CR (colon used)
      *   IN$NOT.DATA        Do not use DATA queue
      *   IN$PASSWORD        Use password style masking if input
      *   IN$UPCASE          Force input to uppercase
      *   IN$TIMEOUT         Timeout supplied (else timeout value is 0 from kernel)
      *   IN$THENELSE        THEN/ELSE present - return status on stack
      *   IN$NO.ECHO.DATA    Supress character echo of input source is DATA
      *   IN$NO.CASE.INVERT  Suppress case inversion regardless of PTERM status

      $include syscom.h
      $include int$keys.h

      $include keys.h
      $include keyin.h
      $include err.h

      set.status 0
      then.else.flag = 1

      use.data.queue = not(bitand(flags, IN$NOT.DATA))
      password = bitand(flags, IN$PASSWORD)
      pagination = kernel(K$PAGINATE, -1)
      return.key = seq(pterm(PT$INEWLINE,''))
      uppercase = bitand(flags, IN$UPCASE)
      no.echo.data = bitand(flags, IN$NO.ECHO.DATA)
      raw = bitand(flags, IN$RAW)               ;* 14 Oct 26 dm - openQM 548, INPUT ... RAW (the compiler insists on a length)
      no.echo = bitand(flags, IN$NO.ECHO)       ;* 14 Oct 26 dm - openQM 168: no echo of typed characters;
                                                ;* the new line at the end of the entry is still echoed
      no.case.invert = bitand(flags, IN$NO.CASE.INVERT)

      if pterm(PT$INVERT, -1) then
         original.case.inversion = 1
      end else
         original.case.inversion = 0
      end
      if no.case.invert then
         if original.case.inversion = 1 then
            i = pterm(PT$INVERT, @false)
         end
      end
      
      c = terminfo('kbs')    ;* 0402

*     07 Oct 26 - PAL-21, BOTH ERASE BYTES (the Windows port's 22 Aug 26 fix, which
*     _KEYCODE's 14 Sep 26 Linux twin, verify-keys.py, did not reach: this routine reads
*     RAW BYTES with keyinc() and compared them with the one byte kbs named).  A
*     terminal that sends the other byte - DEL under vt100, whose kbs is ^H; ^H under a
*     type that names DEL - got no erase, and because a single-line INPUT has no
*     forward delete the unmatched byte fell through to the catch-all case and was
*     APPENDED to the string.  On INPUT ... HIDDEN, which is what the password
*     prompts of MODIFY.PASSWORD are, a typing mistake could not be corrected and the
*     attempt to correct it made the entry longer.  Measured here, sandbox-input.py
*     before this change: vt100 + DEL, linux + ^H and xterm + ^H gave 'ab' DEL 'c'.
*     ADDITIVE, AND kbs STILL COUNTS: whatever the terminal type names stays in the
*     set and 8 and 127 are added.  DEL has no other meaning in this routine.
      erase.keys = char(8) : char(127)
      if len(c) = 1 and index(erase.keys, c, 1) = 0 then erase.keys := c

*     12 Oct 26 dm - openQM 253, PTERM ERASE: when the session has named an erase key that one
*     is the only one, 256 means none at all (a backspace is then an ordinary character), and
*     0, the start-up state, leaves the set above. PTERM CTRL.FILTER discards the other C0 characters.
      erase.setting = pterm(PT$ERASE, -1)
      begin case
         case erase.setting = 256
            erase.keys = ''
         case erase.setting > 0
            erase.keys = char(erase.setting)
      end case
      ctrl.filter = pterm(PT$CTRL.FILTER, -1)

      string = ''
      if max.input = 0 then max.input = 99999

      * 14 Oct 26 dm - openQM 389, INPUT var, length, fill: the first fill character shows the width of the field while it is typed
      * in, the second (a blank when only one is given) fills what is left when the entry is done, a third leaves the cursor at the
      * end of the field.  Only with a length, and only when the characters are echoed.  The string was put in the kernel by the
      * compiled code; it is collected here whether or not it is used, so that no later INPUT can find it.
      fill1 = ' ' ; fill2 = ' ' ; fill.end = @false ; has.fill = @false
      if bitand(flags, IN$FILL) then
         fill.str = kernel(K$INPUT.FILL.GET, '')
         if len(fill.str) and max.input < 99999 and echo.input and not(no.echo) and not(raw) then
            has.fill = @true
            fill1 = fill.str[1, 1]
            if len(fill.str) > 1 then fill2 = fill.str[2, 1]
            fill.end = (len(fill.str) > 2)
         end
      end

      * Display prompt character if required

      * 14 Oct 26 dm - openQM 584, INPUTIF: with nothing in the DATA queue and nothing typed ahead there is nothing to
      * read, and no prompt either: the caller takes its ELSE clause
      nothing.waiting = 0
      if bitand(flags, IN$IF) then
         if not(len(data.queue) and use.data.queue) and not(keyready()) then nothing.waiting = 1
      end

      if len(prompt()) and not(nothing.waiting) then display prompt() :

      if has.fill and not(nothing.waiting) then display str(fill1, max.input) : str(char(8), max.input) :

      * Process input

      if nothing.waiting then
         then.else.flag = 0
      end else
      if len(data.queue) and use.data.queue then       ;* Get text from DATA queue
         string = field(data.queue, @im, 1, 1)[1,max.input]
         if uppercase then string = upcase(string)
         data.queue = data.queue[col2() + 1, 99999999]

         if not(no.echo.data) then
            if echo.input then
               if not(no.echo) then display if password then str('*', len(string)) else string :
               if has.fill then gosub fill.finish
               if not(bitand(flags, in$nolf)) then display
            end
         end
      end else                     ;* Not taking data from a DATA statement
         string = ""

         loop
            c = keyinc(timeout)
            if c = '' then          ;* Exception condition
               if status() = ER$TIMEOUT then then.else.flag = 0

               * Other exception conditions return a null string and leave the
               * caller to sort out what happened.

               string = ''
               exit
            end

            n = seq(c)
            begin case  ;* 0392 Allow rebindable values
               case raw                               ;* 14 Oct 26 dm - openQM 548: every character is data
                  if uppercase then c = upcase(c)
                  string := c

               case index(erase.keys, c, 1)           ;* BACKSPACE key
                  if len(string) then
                     string = string[1, len(string) - 1]
*                    07 Oct 26 - char(8), as the Windows port has had it since 22 Aug 26,
*                    not @(IT$CUB): BS-space-BS is the portable destructive erase and
*                    must not rest on a capability string (cub1 came back EMPTY in the
*                    Windows installer's console, so the erase printed a bare space and
*                    the cursor walked forward).  For vt100, linux and xterm cub1 IS ^H
*                    (infocmp, and SD's own terminfo.src, 7 Oct 26), so on those this
*                    prints exactly what it printed before.
                     if echo.input and not(no.echo) then display char(8) : fill1 : char(8) :
                  end

               case n = return.key                    ;* RETURN key
                  if has.fill then gosub fill.finish
                  if echo.input and not(bitand(flags, in$nolf)) then display
                  exit
               case n = 10
                  null
               case n = 13
                  null
               case ctrl.filter and n < 32           ;* PTERM CTRL.FILTER ON
                  null
               case 1
                  if len(string) < max.input then
                     if uppercase then c = upcase(c)
                     string := c
                     if echo.input and not(no.echo) then
                        display if password then '*' else c :
                        if has.fill and len(string) < max.input then display str(fill1, max.input - len(string)) : str(char(8), max.input - len(string)) :
                     end
                  end

            end case

            * If we have reached the character limit and the underscore option
            * was not used, terminate input.

            if raw and len(string) = max.input then exit     ;* RAW: exactly length characters, nothing echoed
            if len(string) = max.input and not(bitand(flags, in$nocrlf)) then
               if echo.input and not(bitand(flags, in$nolf)) then display
               exit
            end
         repeat
      end
      end                          ;* of: if nothing.waiting ... else

      * Reset line number if pagination was active when we entered

      c = kernel(K$PAGINATE, pagination)

      * Unless we timed out the input, update the caller's variable

      if then.else.flag then string.arg = string

      * Restore the PTERM CASE inversion mode

      if no.case.invert then
         if original.case.inversion = 1 then
            i = pterm(PT$INVERT, @true)
         end else
            i = pterm(PT$INVERT, @false)
         end
      end

      * If we have a THEN/ELSE clause, we need to leave a status on the stack

      if bitand(flags, IN$THENELSE) then return value then.else.flag

      return

* ======================================================================
* 14 Oct 26 dm - openQM 389: the entry is finished; the unused part of the field gets the second fill character, and the cursor
* stays at the end of the field if a third was given, else comes back to the end of the entry

fill.finish:
      rem.n = max.input - len(string)
      if rem.n > 0 then
         display str(fill2, rem.n) :
         if not(fill.end) then display str(char(8), rem.n) :
      end
      return
      end

      * END-CODE
