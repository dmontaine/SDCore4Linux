* END-HISTORY
*
* START-DESCRIPTION:
*
*   IDE {DICT} {file {record | CREATING.SEQKEY}}
*   IDE path:/full/name                 an operating system file (see the history: !ide_osfile)
*
*   The account is the project: the tree lists the files of the VOC (type F); Return on a file lists its
*   records (up to 2000) and its dictionary, Return on the dictionary lists its items, and Return on a record
*   opens it in the editor.  Everything the editor does with a record is the SCREEN MEMO's own; this program
*   adds what a development environment needs around it.
*
*   A record named on the command line that is not there opens as a new record (nothing is written until it
*   is saved).  With a file and no record, an active select list opens its first records in tabs.  A record
*   open in a tab is locked; a record another session has locked opens read-only.
*
*   Save writes the record, and asks first if somebody else changed it since it was read.  Compile saves,
*   runs BASIC and shows the compiler's lines in the table at the bottom; Return on one goes to its line.
*   Run, Catalogue and Debug compile first and do nothing if the compile failed.  Run and Debug give the
*   terminal back to the program and return to the IDE afterwards.  Find searches every record of a file
*   for a text and lists the lines in the same table.
*
*   Nothing here is privileged: the IDE reads and writes records and runs commands exactly as the account's
*   user could from the command prompt, so the per-account gates apply to it as they do there.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $ide
$catalog $ide

$include keyin.h
$include syscom keys.h
$include int$keys.h
$include sl.h
$include tk.h
$include dictdict.h

   deffun edit_msg(kind) calling '!edit_msg'      ;* 18 Oct 26 dm, S.66

   prompt ''
   if system(25) then stop                 ;* a phantom has no terminal

   MAXREC = 2000                           ;* records listed for a file (and read by Find in the records, and from a select list)
   MAXHIT = 500                            ;* lines a search lists
   MAXSEL = 10                             ;* 28 Oct 26 (stage B): records of an active select list opened in tabs at the start
   MAXLOCK = 100                           ;* 28 Oct 26 (stage B): tabs that can hold a record lock at one time (file variables kept in tfv)
   LAYW = 140                              ;* what the layout is made for (the owner's 140 by 43 for every full-screen app): a bigger window is used whole, a smaller one
   LAYH = 43                               ;* is refused at the start and, if it becomes smaller while the IDE runs, the keyboard is held until it is big enough again (layout lock)

   * 28 Oct 26 (stage B): IDE {DICT} {file {record | CREATING.SEQKEY}}.  A record id in quotes is taken as it is (so "creating.seqkey" is that record);
   *   the file name is lower case, as everywhere SD writes one (the name form makes it so too, and the tabs and the tree compare with it)
   dflag0 = ''
   fn0 = field(@sentence, ' ', 2)
   id0 = field(@sentence, ' ', 3)
   if upcase(fn0) = 'DICT' then
      dflag0 = 'DICT'
      fn0 = field(@sentence, ' ', 3)
      id0 = field(@sentence, ' ', 4)
   end
   fn0 = downcase(fn0)
   seq0 = (upcase(id0) = 'CREATING.SEQKEY')
   q0 = id0[1, 1]
   if len(id0) > 1 and (q0 = '"' or q0 = "'") and id0[len(id0), 1] = q0 then id0 = id0[2, len(id0) - 2]

   * 28 Oct 26 (stage E): IDE path:/full/name opens an operating system file.  The path is the rest of the sentence after the first word (it may hold blanks), as it was typed: it is
   *   never folded to lower case or split, and the word path: is not a file of the VOC (the file and record above are cleared, so the start is the bare one and the path opens over it)
   path0 = ''
   rest0 = field(@sentence, ' ', 2, 9999)
   if upcase(rest0[1, 5]) = 'PATH:' then
      path0 = trimf(trimb(rest0[6, 9999]))     ;* the ends only: TRIM would squeeze two blanks inside a name into one and open another file (review of 28 Oct 26, finding 5)
      pq0 = path0[1, 1]
      if len(path0) > 1 and (pq0 = '"' or pq0 = "'") and path0[len(path0), 1] = pq0 then path0 = path0[2, len(path0) - 2]
      fn0 = ''
      id0 = ''
      dflag0 = ''
      seq0 = 0
   end

   * The file variables through which the tabs hold their record locks: a lock belongs to the file variable it was taken through, and goes when that
   *   variable is closed, so each tab that holds one keeps its own (bx l<uid> is the slot, tused the slots in use)
   dim tfv(MAXLOCK)
   mat tfv = 0
   tused = ''

   * Ctrl-C and the terminal's break are keys of the editor; both are given back on the way out.  The setting is also kept by $tk_brk, so that an abort
   * inside the IDE (which skips every way out below) does not leave the person at the prompt with Ctrl-C dead: $sl_cleanup gives it back (28 Oct 26)
   saved.trap = pterm(PT$BREAK, -1)
   call $tk_brk('save', saved.trap)
   void pterm(PT$BREAK, @false)
   break off

   * Line-drawing characters (the frame, the drop-downs, the scroll bars) when the terminal says it is UTF-8 -
   * LC_ALL, then LC_CTYPE, then LANG as a shell resolves them - and + - | otherwise.  Only the borders change.
   loc = env('LC_ALL')
   if loc = '' then loc = env('LC_CTYPE')
   if loc = '' then loc = env('LANG')
   loc = upcase(loc)
   utf8 = (index(loc, 'UTF-8', 1) > 0 or index(loc, 'UTF8', 1) > 0)

   * A window smaller than the layout is refused before the screen is taken (the library's one check and message)
   call $sl_need('IDE', LAYW, LAYH, need.msg, '')
   if need.msg # '' then
      call $tk_brk('close', saved.trap)        ;* the setting back and BREAK ON; nothing is held any more
      display need.msg
      stop
   end

   gosub open.screen
   if not(opened) then
      call $tk_brk('close', saved.trap)
      stop
   end

   * 23 Oct 26: whether the AI is usable for this account (the gate, a provider, a model and a key): without it the IDE has no AI entry, no AI menu and the same layout as ever
   call $tk_ai('usable', '', ai.on, ai.pm)

   * 28 Oct 26 (S.88 plan 2.9, D2): whether this session keeps recovery copies (the account's switch, delivered off; kept in the person's own Linux home)
   call !edit_recovery('on', '', '', '', rc.on)
   rc.warned = 0
   RC.LOOK = 10                            ;* seconds between two looks for a copy a tab does not own (rc.tick)

   * 28 Oct 26: the bytes that make a record read-only here (128 to 247: text in another character set, or UTF-8; 248 to 255 are SD's marks, which the
   *   token form shows), and the AUTOLOGOUT countdown (idle.text reads the kernel's own inactivity clock)
   NA.CHARS = ''
   for na.i = 128 to 247
      NA.CHARS := char(na.i)
   next na.i
   IDL.WARN = 60                           ;* seconds before the sign-out that the status line says so

   * The function-key row (foot.draw): the keys the IDE acts on in do.key, most used first, so that a narrow row loses the last.  $tk_fkeys cuts it to the width.
   ide.keys = ''
   call $tk_keys('add', ide.keys, 'esc', 'menu', 'menu', '', 1)
   call $tk_keys('add', ide.keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-s', 'save', 'save', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-o', 'open', 'open', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-w', 'close', 'close', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', ide.keys, 'f4', 'problem', 'nexterr', '', 1)
   call $tk_keys('add', ide.keys, 'f5', 'run', 'run', '', 1)
   call $tk_keys('add', ide.keys, 'f6', 'pane', 'nextpane', '', 1)
   call $tk_keys('add', ide.keys, 'f7', 'debug', 'debug', '', 1)
   call $tk_keys('add', ide.keys, 'f8', 'compile', 'compile', '', 1)
   call $tk_keys('add', ide.keys, 'f9', 'build', 'catalog', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-l', 'go to', 'goto', '', 1)
   call $tk_keys('add', ide.keys, 'f12', 'fields', 'fields', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-n', 'new', 'new', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-e', 'SED', 'sed', '', 1)
   call $tk_keys('add', ide.keys, 'ctrl-r', 'replace', 'replace', '', 1)
   last.foot = ''

   call $sl_scr('get', scr)
   w = scr<SL.S.W> + 0
   h = scr<SL.S.H> + 0

   * blue first: in classic the bar and the window are the same black on white, so the menu bar and its
   * drop-downs do not stand out from the form under them
   themes = 'blue' : @fm : 'classic' : @fm : 'dark' : @fm : 'light' : @fm : 'mono'
   theme.n = 1
   gosub apply.theme

   * The menus: one message each, entries separated by | and the parts of an entry by ~
   menus = ''
   for j = 11225 to 11230
      if j = 11230 and ai.on then
         m = change(sysmsg(11654), '|', @vm)             ;* the AI menu, before Help
         m = change(m, '~', @sm)
         menus<-1> = m
      end
      m = change(sysmsg(j), '|', @vm)
      m = change(m, '~', @sm)
      menus<-1> = m
   next j

   * State
   nbuf = 0                          ;* the records open: bn (file), bi (record), bu (unique number) in step
   cb = 0                            ;* the one in the editor
   uid = 0
   bn = ''
   bi = ''
   bu = ''
   bx = collection()                 ;* s<uid> the text as it is on disk, t<uid> the text as it was left, c<uid> the cursor
   *                                   28 Oct 26 (stage B): k<uid> the kind (source, dict, voc, data), d<uid> 'DICT' or '', l<uid> the lock slot (0: no lock
   *                                   held), o<uid> the user who holds the record's lock when the tab is read-only ('' when it is not)
   fl = ''                           ;* the files of the VOC
   lfiles = ''                       ;* the files whose records are listed in the tree
   lrecs = ''                        ;* their record ids, as values, in step
   ldict = ''                        ;* in step: 1 when the file has a dictionary (the tree shows a node for it)
   dfiles = ''                       ;* the files whose DICTIONARY items are listed in the tree (opened by Return on the dictionary node)
   drecs = ''                        ;* their item ids, as values, in step
   or.dict = ''                      ;* open.record's dictionary flag and "a missing record is a new one": each call takes them and puts them back to ''
   or.mknew = 0
   rt.dict = ''
   out.dict = ''                     ;* the dictionary flag of the records a search or a select list put in the table
   cur.code = ''
   err.rows = ''                     ;* the table at the bottom
   err.lines = ''
   sid = ''
   sln = ''
   out.kind = ''
   out.file = ''
   focus.id = 'tree'
   msg = ''
   ai.sel = ''                       ;* the AI: the selected text and a sentence about it, for the request being made
   ai.note = ''
   ai.req = ''
   sv.ok = @true
   have.form = @false
   done = @false
   untitled = 0                      ;* the number of the last untitled buffer made

   * 28 Oct 26 (stage B): a file named with no record and an active select list (SELECT, then IDE file, as SED takes it): its ids are read here, before anything
   *   could use list 0, at most MAXREC of them and without building the rest of a list that is still being made; the list is used up, as SED's is
   sel0 = ''
   sel0.more = @false
   if fn0 # '' and id0 = '' and not(seq0) then
      if selectinfo(0, SL$ACTIVE) then
         sel0.n = 0
         loop
            readnext sel.id from 0 else exit
            if sel0.n >= MAXREC then
               sel0.more = @true
               exit
            end
            sel0.n += 1
            sel0<-1> = sel.id
         repeat
         clearselect 0
      end
   end

   gosub build.files
   if fn0 # '' then
      lf.name = fn0
      gosub load.file
      cur.code = 'F:' : fn0
      if dflag0 # '' then
         ld.name = fn0
         gosub load.dict
         cur.code = 'D:' : fn0
      end
   end

   * 28 Oct 26 (S.88 Phase 4): with no record named the IDE opens an editable "Untitled 1", the focus in the editor; with only a file named the tree keeps the focus
   if id0 = '' and not(seq0) and sel0 = '' then
      gosub add.untitled
      if fn0 = '' then focus.id = 'ed'
   end

   gosub new.form
   begin case
      case fn0 # '' and seq0
         * 28 Oct 26 (stage B): CREATING.SEQKEY in the place of the record: the file's next sequential id, as SED takes it, and a new record of that id
         sq.dict = dflag0
         sq.file = fn0
         gosub seq.take
         if sq.id # '' then
            or.dict = dflag0
            or.file = fn0
            or.id = sq.id
            or.mknew = 1
            gosub open.record
         end
      case fn0 # '' and id0 # ''
         or.dict = dflag0
         or.file = fn0
         or.id = id0
         or.mknew = 1                          ;* 28 Oct 26 (stage B): a record that is not there is a new one (it said "Cannot read record" and opened nothing)
         gosub open.record
      case sel0 # ''
         gosub open.select
   end case
   if fn0 # '' and (id0 # '' or seq0 or sel0 # '') then
      if nbuf = 0 then
         gosub add.untitled                    ;* nothing could be opened: the editor is never left without a buffer
         gosub load.current
      end
      screen focus f, 'ed'
      focus.id = 'ed'
   end
   if path0 # '' then
      op.path = path0                          ;* 28 Oct 26 (stage E): the bare start's untitled buffer is taken away by the file that opens, and stays when it does not
      gosub open.path
      screen focus f, 'ed'
      focus.id = 'ed'
   end
   if id0 = '' and not(seq0) and sel0 = '' and path0 = '' then gosub rc.untitled          ;* 28 Oct 26 (D2): the text of untitled buffers kept when an editor ended

   menu.click = ''                          ;* the column of a click on the menu bar, while the menu it opens is being started
   loop
      gosub status.line
      * A second of quiet is an event (timeout), so that the status line follows what is typed: the editor
      * consumes its own keys and nothing else returns to this loop for them
      screen wait f timeout 1 returning ev then
         et = ev<1>
         eid = ev<2>
         edata = ev<3>
         begin case
            case et = 'activate'
               msg = ''
               focus.id = eid
               gosub do.act
            case et = 'focus'
               focus.id = eid
            case et = 'change'
               if eid = 'tabs' then
                  new.cb = edata + 0
                  if new.cb >= 1 and new.cb <= nbuf and new.cb # cb then
                     gosub switch.to
                  end
               end
            case et = 'key'
               gosub do.key
            case et = 'resize'
               gosub relayout
         end case
      end else
         begin case
            case ev<1> = 'end'
               gosub rc.tick                    ;* the input ended or the terminal hung up: the changed buffers' copies are brought up to date (D2)
               done = @true
            case ev<1> = 'timeout'
               gosub rc.tick                    ;* a second of quiet: the copies follow the buffers (an abort cannot be caught)
            case 1
               cmd = 'menu'             ;* Esc
               gosub run.cmd
         end case
      end
   until done
   repeat

   gosub release.all                           ;* 28 Oct 26 (stage B): every record lock the tabs hold is given back (quit, the end of the input, a hang-up, the cursor lock)
   screen close
   call $tk_brk('close', saved.trap)           ;* the setting back (or the one an earlier, aborted app left held) and BREAK ON
   display @(-1) :
   stop

* ======================================================================
* Themes

apply.theme:
   screen theme themes<theme.n> returning th else
      th = ''
   end
   return

* Out: opened.  The screen is taken, with line-drawing borders if the terminal is UTF-8
open.screen:
   opened = @false
   if utf8 then
      screen open clear lines then
         opened = @true
      end
   end else
      screen open clear then
         opened = @true
      end
   end
   * The window lock (the layout mode of $sl_guardmode, 28 Oct 26): while the WINDOW is smaller than LAYW by LAYH the keys are not the IDE's, wherever its cursor is - the
   *   keyboard is held, the warning names both sizes, and Ctrl-Q then y leaves ('guardquit'); the lock lifts the moment the window is big enough
   if opened then call $sl_guardmode('IDE', LAYW, LAYH, 'layout', LAYW, LAYH)
   return

* ======================================================================
* The files of the account: the VOC entries of type F

build.files:
   fl = ''
   open 'VOC' to vocf then
      sselect vocf to 9
      readlist ids from 9 else ids = ''
      n = dcount(ids, @fm)
      if ids = '' then n = 0
      for i = 1 to n
         read r from vocf, ids<i> then
            * the first field is F, or a description that starts "File" (a file's description is kept there)
            t1 = upcase(r<1>)
            * the $ entries ($acc, $hold, $map, $release) are SD's own, not files of records (28 Oct 26, Opus's review): the tree does not list them
            if (t1 = 'F' or t1[1, 5] = 'FILE ') and ids<i>[1, 1] # '$' then fl<-1> = ids<i>
         end
      next i
   end
   return

* In: lf.name.  The records of the file go into lfiles / lrecs (or are replaced there), and ldict says whether it has a dictionary
load.file:
   open lf.name to fv else
      msg = sysmsg(11200, lf.name)
      return
   end
   gosub list.ids
   if lr.more then msg = sysmsg(11219, MAXREC, lf.name)
   ids = lr.ids
   lf.dict = 0
   open 'DICT', lf.name to lf.dv then lf.dict = 1
   lp = 0
   nl = dcount(lfiles, @fm)
   if lfiles = '' then nl = 0
   for q = 1 to nl
      if lfiles<q> = lf.name then
         lp = q
         exit
      end
   next q
   if lp = 0 then
      lfiles<-1> = lf.name
      lrecs<-1> = ids
      ldict<dcount(lfiles, @fm)> = lf.dict
   end else
      lrecs<lp> = ids
      ldict<lp> = lf.dict
   end
   return

* In: ld.name.  The items of the file's DICTIONARY go into dfiles / drecs (or are replaced there).  28 Oct 26 (stage B): read when the dictionary node is opened, not before
load.dict:
   open 'DICT', ld.name to fv else
      msg = sysmsg(11200, 'dict ' : ld.name)
      return
   end
   gosub list.ids
   if lr.more then msg = sysmsg(11219, MAXREC, 'dict ' : ld.name)
   lp = 0
   nl = dcount(dfiles, @fm)
   if dfiles = '' then nl = 0
   for q = 1 to nl
      if dfiles<q> = ld.name then
         lp = q
         exit
      end
   next q
   if lp = 0 then
      dfiles<-1> = ld.name
      drecs<-1> = lr.ids
   end else
      drecs<lp> = lr.ids
   end
   return

* In: fv, an open file.  Out: lr.ids, its record ids as values, in order; lr.more, true when the file has more than MAXREC records and the list stops there.
* 28 Oct 26 (stage B): SELECT and READNEXT, stopped at MAXREC, and the list cleared - a hashed file's SELECT is made a group at a time as it is read, so a big
*   file is not read to the end (the SSELECT that was here sorted the whole file first, which hangs the IDE on a big data file).  The ids read are put in order.
list.ids:
   lr.ids = ''
   lr.n = 0
   lr.more = @false
   select fv to 9 on error
      clearselect 9
      return
   end
   loop
      readnext lr.id from 9 else exit
      if lr.n >= MAXREC then
         lr.more = @true
         exit
      end
      lr.n += 1
      locate lr.id in lr.ids<1> by 'AL' setting lr.p else null
      ins lr.id before lr.ids<1, lr.p>
   repeat
   clearselect 9                       ;* a select left part read keeps the file from splitting and merging: it is ended here
   return

* ======================================================================
* The layout from w and h

size.layout:
   lw = w
   lh = h
   if lw < LAYW then lw = LAYW                 ;* the window is smaller only after the start: the layout keeps its size, the library cuts what falls outside
   if lh < LAYH then lh = LAYH                 ;* (the upper left corner shows) and the window lock holds the keyboard until the window is big enough
   * the rows, as the toolkit's pages have them (tk.h): the menu bar on row 0, the form from row 1, then the status line, the border and the function keys on the last three
   ystat = lh - 3
   ybord = lh - 2
   ykeys = lh - 1
   fw = lw
   fh = ystat - 1
   iw = fw - 2
   ih = fh - 2
   tw = 28
   if iw < 90 then tw = int(iw / 3)
   if tw < 14 then tw = 14
   eh = 7
   if ih < 20 then eh = 4
   ex = tw + 1
   ew = iw - tw
   mh = ih - 1 - eh
   err.y = 2 + mh
   ai.rows = (if ai.on then 1 else 0)          ;* the AI entry takes the last row of the form under the editor and the table: the table is one row shorter
   ai.y = ih
   return

* The form and everything on it, from the state
new.form:
   last.status = char(1)                ;* the screen is made again: the status line has to be written (status.line writes only a changed text), and the foot (it forgets last.foot)
   lc.nodraw = @false                   ;* see load.current
   did.focus = @false
   call $sl_scr('get', scr)
   w = scr<SL.S.W> + 0
   h = scr<SL.S.H> + 0
   * 19 Oct 26 dm - the layout is made for the WINDOW as well as the display, like SED, CED and the debugger (a display of 200 by 60 typed with TERM on a
   *   140 by 42 window made the IDE lay out 200 by 60, which scrolled and garbled the screen): the smaller of the two.
   call $sl_window(ww0, wh0)
   if ww0 < w then w = ww0
   if wh0 < h then h = wh0
   gosub size.layout
   t = sysmsg(11199, @who)
   screen form title t at 0,1 size fw,fh returning f
   have.form = @true

   gosub tree.nodes
   screen tree f, 'tree', nodes at 1,1 size tw - 1,ih value cur.k

   * A vertical line between the tree and the editor, from the top of the form to its bottom, in the colours of the
   * form's own frame (a line-drawing character on a UTF-8 terminal, | otherwise)
   call $sl_line('v', '', vch)
   for r = 1 to ih
      screen label f, 'sep' : r, vch at tw,r width 1 attr 'window'
   next r

   * The strip of tabs on a bar of its own, as wide as the editor
   screen label f, 'tabbar', ' ' at ex,1 width ew attr 'tab'
   gosub tab.labels
   screen tabs f, 'tabs', labels at ex,1 value tab.n

   ed.text = ''
   ed.syn = ''
   ed.ro = 1
   if nbuf > 0 then
      u = bu<cb>
      k = 't' : u
      tb.u = u
      tb.raw = bx{k}
      gosub tab.display
      ed.text = tb.disp
      k = 'o' : u
      ed.ro = (bx{k} # '')                ;* 28 Oct 26 (stage B): read-only while another session holds the record's lock
      k = 'a' : u
      if bx{k} then ed.ro = 1              ;* 28 Oct 26: or while the record holds bytes 128 to 247 (na.mark)
      k = 'z' : u
      if bx{k} then ed.ro = 1              ;* 28 Oct 26 (stage E, review finding 7): or an operating system file this session may not change - load.current had it, the form made again after a resize did not
      sy.file = bn<cb>
      sy.id = bi<cb>
      if bn<cb> = 'path:' then
         sy.file = ''                      ;* (stage E) named by its last component, as load.current does
         sy.id = field(bi<cb>, '/', dcount(bi<cb>, '/'))
      end
      sy.first = field(tb.raw, @fm, 1)
      gosub syntax.for
      ed.syn = syn
   end
   if ed.ro then
      screen memo f, 'ed', ed.text at ex,2 size ew,mh syntax ed.syn lnum readonly
   end else
      screen memo f, 'ed', ed.text at ex,2 size ew,mh syntax ed.syn lnum
   end
   * 18 Oct 26 dm - a horizontal scroll bar in the editor's last row (the owner: "there is no horizontal scroll bar"); the text has one row less
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   mw{'hbar'} = 1
   mw{'passkeys'} = 'ctrl-e'                     ;* Ctrl-E hands the record to SED (the area's own meaning of it, end of row, is End); F3 / Shift-F3 are the area's find next / previous (the owner's D31)
   mw{'stay'} = 1                                ;* 28 Oct 26 (I3): Up on the first line and Down on the last stay in the editor and do not move the focus to the tabs or the messages
   mw{'tabindent'} = 3                           ;* 28 Oct 26 (approved by the owner): Tab and Shift-Tab indent and outdent here, by the codebase's 3; F6 / Shift-F6 move between the panes
   mw{'softcur'} = 1                             ;* 19 Oct 26: the character under the cursor is highlighted while the editor has the focus

   cols = sysmsg(11221) : @sm : '6R' : @vm : sysmsg(11222) : @sm : (ew - 11) : 'L'
   * A bar of its own above the table: the table is drawn like the editor (the text style), and with nothing
   * between them the messages read as the end of the editor
   screen label f, 'errbar', sysmsg(11231) at ex,err.y width ew attr 'window'
   screen table f, 'err', cols, err.rows at ex,err.y + 1 size ew,eh - 1 - ai.rows
   if ai.on then
      * 23 Oct 26: the AI line, the last stop of the Tab ring: a label and an entry in the form's last row, Return in it is an event of its own (aw{'activate'})
      screen label f, 'ailab', sysmsg(11636) at ex,ai.y width 4 attr 'window'
      screen entry f, 'ai' at ex + 4,ai.y width ew - 4 maxlen 300
      call $sl_form('find', f, '', 'ai', an)
      aw = f{'widgets', an}
      aw{'activate'} = 1
   end
   * Return in the tree and in the table is an event of its own (activate), not the press of a default button
   f{'activate'} = 1
   f{'bgclick'} = 1                     ;* a left click on no widget (the menu bar) comes back as the key mouse: the bar is the IDE's, not a widget

   * 19 Oct 26 dm - the owner: "a small visual indicator in the top right corner of each pane to indicate that it is active, [-] for off, [*] for on".
   *   One three-cell label to a pane that can have the focus, added last so that it is drawn over the pane's own top edge: the files on the form's top
   *   border above the tree, the editor on the border above it, the tabs at the right end of their strip, the messages at the right end of their bar.
   ind.ids = 'ixtree' : @fm : 'ixtabs' : @fm : 'ixed' : @fm : 'ixerr'
   ind.panes = 'tree' : @fm : 'tabs' : @fm : 'ed' : @fm : 'err'
   gosub indicator.texts
   screen label f, 'ixtree', ind.want<1> at tw - 4,0 width 3 attr 'window'
   screen label f, 'ixtabs', ind.want<2> at ex + ew - 3,1 width 3 attr 'tab'
   screen label f, 'ixed', ind.want<3> at ex + ew - 4,0 width 3 attr 'window'
   screen label f, 'ixerr', ind.want<4> at ex + ew - 3,err.y width 3 attr 'window'
   ind.cur = ind.want

   gosub tree.apply
   if nbuf > 0 then gosub memo.cursor
   screen focus f, focus.id
   screen menubar menus row 0 draw else null
   return

* The nodes of the tree (a file, and under it the records of a file that is loaded), the numbers of the open ones
* and the number of the node whose code is cur.code
tree.nodes:
   nodes = ''
   open.list = ''
   cur.k = 1
   nn = 0
   nf = dcount(fl, @fm)
   if fl = '' then nf = 0
   for i = 1 to nf
      nm = fl<i>
      nn += 1
      nodes<-1> = nm : @sm : 1 : @sm : 'F:' : nm
      if 'F:' : nm = cur.code then cur.k = nn
      lp = 0
      nl = dcount(lfiles, @fm)
      if lfiles = '' then nl = 0
      for q = 1 to nl
         if lfiles<q> = nm then
            lp = q
            exit
         end
      next q
      if lp then
         open.list<1, -1> = nn
         * 28 Oct 26 (stage B): the file's dictionary, first under the file, a node of its own; its items are under it once it has been opened
         if ldict<lp> then
            nn += 1
            nodes<-1> = sysmsg(11693) : @sm : 2 : @sm : 'D:' : nm
            if 'D:' : nm = cur.code then cur.k = nn
            dp = 0
            ndl = dcount(dfiles, @fm)
            if dfiles = '' then ndl = 0
            for q = 1 to ndl
               if dfiles<q> = nm then
                  dp = q
                  exit
               end
            next q
            if dp then
               open.list<1, -1> = nn
               dids = drecs<dp>
               ndi = dcount(dids, @vm)
               if dids = '' then ndi = 0
               for j = 1 to ndi
                  nn += 1
                  c2 = 'Q:' : nm : ':' : dids<1, j>
                  nodes<-1> = dids<1, j> : @sm : 3 : @sm : c2
                  if c2 = cur.code then cur.k = nn
               next j
            end
         end
         ids = lrecs<lp>
         ni = dcount(ids, @vm)
         if ids = '' then ni = 0
         for j = 1 to ni
            nn += 1
            c2 = 'R:' : nm : ':' : ids<1, j>
            nodes<-1> = ids<1, j> : @sm : 2 : @sm : c2
            if c2 = cur.code then cur.k = nn
         next j
      end
   next i
   return

* The tree widget takes the nodes again, keeping the current one
tree.apply:
   gosub tree.nodes
   call $sl_form('find', f, '', 'tree', tn)
   if tn = 0 then return
   tr = f{'widgets', tn}
   tr{'items'} = convert(@fm, @vm, nodes)
   tr{'cur'} = cur.k
   tr{'open'} = open.list
   tr{'opened'} = 1
   call $sl_widget_init(tr)
   return

tab.labels:
   labels = ''
   for i = 1 to nbuf
      labels<1, i> = bi<i>
      k = 'd' : bu<i>
      if bx{k} # '' then labels<1, i> = 'dict ' : bi<i>         ;* 28 Oct 26 (stage B): a dictionary item says so on its tab
      if bn<i> = 'path:' then labels<1, i> = 'os ' : field(bi<i>, '/', dcount(bi<i>, '/'))     ;* 28 Oct 26 (stage E): an operating system file: its last name, the whole path is on the status line
      if bi<i> = '' then
         k = 'u' : bu<i>
         labels<1, i> = sysmsg(11963, bx{k})              ;* an untitled buffer
      end
   next i
   if nbuf = 0 then labels = sysmsg(11220)
   tab.n = cb
   if tab.n < 1 then tab.n = 1
   return

* In: sy.file, sy.id, sy.first (the first line of the record).  Out: syn, the language the editor colours the record as ('' for none).  $sl_syntax decides, as it does for SED:
* the file name first, then the record id, then the first line (a script that begins #!/bin/sh), then the languages a site added.
syntax.for:
   syn = ''
   if sy.file = '' and sy.id = '' then sy.file = 'bp'          ;* an untitled buffer is coloured as a program until it is named
   call $sl_syntax('detect', sy.file, sy.id, sy.first, '', syn)
   return

* ======================================================================
* The token form of a record (26 Oct 26).  The tab's record is always the real one; only the editor's text is converted.

* In: tb.u (the tab's uid), tb.raw (its record).  Out: tb.disp, the text the editor shows.  A tab in token mode (bx m) shows the record with @vm / @sm / @tm; if the record
* cannot be shown so any more (a replace made a field that holds the text of a token) the tab goes back to showing it as it is, and says so.
tab.display:
   tb.disp = tb.raw
   k = 'm' : tb.u
   if bx{k} then
      call $recarr('totext', tb.raw, tb.disp, tb.ok)
      if not(tb.ok) then
         bx{k} = 0
         msg = sysmsg(11992, tb.disp)
         tb.disp = tb.raw
      end
   end
   return

* In: tm.u (the tab's uid), tm.raw (its record, as it is on disk).  Sets bx m: 1 when the tab shows the token form, else 0.
* 28 Oct 26 (stage B): the KIND decides, not what the record held when it was read: a dictionary item, a VOC record and a data record are shown in the token form
*   (one with no marks too, so that :@vm: typed into it is a mark when it is kept), a program never is, whatever it holds (bx k 'source', and an untitled buffer).
*   The form is used only when 'totext' accepts the record (it reads every line back); one it refuses is shown as it is and says why.
set.token.mode:
   k = 'm' : tm.u
   bx{k} = 0
   tm.k = 'k' : tm.u
   tm.kind = bx{tm.k}
   if tm.kind # 'dict' and tm.kind # 'voc' and tm.kind # 'data' then return
   tm.marks = (index(tm.raw, @vm, 1) or index(tm.raw, @sm, 1) or index(tm.raw, @tm, 1))
   call $recarr('totext', tm.raw, tm.disp, tm.ok)
   if tm.ok then
      bx{k} = 1
      if tm.marks then msg = sysmsg(11991)
   end else
      msg = sysmsg(11992, tm.disp)
   end
   return

* ======================================================================
* The editor and the buffers

* Keep what the editor holds (text and cursor) with the record that is open
stash.current:
   if nbuf > 0 and have.form then
      call $sl_form('find', f, '', 'ed', en)
      mw = f{'widgets', en}
      screen get f, 'ed' returning txt
      u = bu<cb>
      k = 'm' : u
      if bx{k} then
         call $recarr('fromtext', txt, tb.raw, tb.ok)         ;* the editor shows tokens: the tab keeps the record
         txt = tb.raw
      end
      k = 't' : u
      bx{k} = txt
      k = 'c' : u
      bx{k} = mw{'cx'} : @vm : mw{'cy'} : @vm : mw{'top'} : @vm : mw{'left'}
   end
   return

* The editor shows the record cb: its text, its language, its cursor; the tab strip says which
load.current:
   gosub tab.labels
   f{'quiet'} = 1                        ;* SCREEN SET draws the whole form after each set: the strip and the editor are drawn below, alone
   screen set f, 'tabs' items labels
   screen set f, 'tabs' value tab.n
   f{'quiet'} = 0
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   if nbuf > 0 then
      u = bu<cb>
      k = 't' : u
      tb.u = u
      tb.raw = bx{k}
      gosub tab.display
      mw{'value'} = tb.disp
      sy.file = bn<cb>
      sy.id = bi<cb>
      if bn<cb> = 'path:' then
         sy.file = ''                    ;* 28 Oct 26 (stage E): an operating system file is named by its last component (the language follows its suffix, or a #! first line)
         sy.id = field(bi<cb>, '/', dcount(bi<cb>, '/'))
      end
      sy.first = field(tb.raw, @fm, 1)
      gosub syntax.for
      k = 'o' : u
      ro = (bx{k} # '')                  ;* 28 Oct 26 (stage B): another session holds the record's lock: the tab is read-only
      k = 'a' : u
      if bx{k} then ro = 1               ;* 28 Oct 26: so is a record that holds bytes 128 to 247 (na.mark)
      k = 'z' : u
      if bx{k} then ro = 1               ;* 28 Oct 26 (stage E): and an operating system file this session may not change
   end else
      mw{'value'} = ''
      syn = ''
      ro = 1
   end
   call $sl_widget_init(mw)
   nl = 0
   if syn # '' then call $sl_syntax('index', syn, '', '', '', nl)
   mw{'synlang'} = nl + 0
   mw{'readonly'} = ro
   if nbuf > 0 then gosub memo.cursor
   * 18 Oct 26 dm - only the tab strip and the editor have changed: drawing the whole form again wrote every cell of the screen, which the
   *   owner saw as a flash each time a record was chosen ("flashes the whole screen").  A caller that is about to focus the editor (which
   *   draws it) sets lc.nodraw and draws the tab strip itself.
   if not(lc.nodraw) then gosub redraw.editor
   return

* The cursor of the record cb goes back where it was
memo.cursor:
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   u = bu<cb>
   k = 'c' : u
   cc = bx{k}
   if cc # '' then
      k = 't' : u
      nl = dcount(bx{k}, @fm)
      if cc<1, 2> + 0 >= 1 and cc<1, 2> + 0 <= nl then
         mw{'cx'} = cc<1, 1> + 0
         mw{'cy'} = cc<1, 2> + 0
         mw{'top'} = cc<1, 3> + 0
         mw{'left'} = cc<1, 4> + 0
         mw{'want'} = cc<1, 1> + 0
      end
   end
   return

redraw:
   call $sl_scr('get', scr)
   call $sl_form('redraw', f, scr, '', rr)
   call $sl_scr('put', scr)
   return

* The tab strip and the editor only (a record chosen, a tab closed or switched); the rest of the screen is as it was
redraw.editor:
   call $sl_scr('get', scr)
   call $sl_form('drawwidget', f, scr, 'tabbar', rr)       ;* the blank bar under the strip: a strip that got shorter leaves no label behind
   call $sl_form('drawwidget', f, scr, 'tabs', rr)
   call $sl_form('drawwidget', f, scr, 'ed', rr)
   call $sl_scr('put', scr)
   return

* A file name and a record id for a command line: qp.file and qp.id in, qp.f and qp.i out, each in quotes when it holds a blank (the command
* parser reads one word to a name otherwise, and the verifier's Ctrl-E on the record "my rec" opened a new record "my" in SED).  A name that
* holds both kinds of quote is left as it is.
quote.pair:
   qp.f = qp.file
   qp.i = qp.id
   for qp.k = 1 to 2
      qp.v = if qp.k = 1 then qp.file else qp.id
      if index(qp.v, ' ', 1) or index(qp.v, '"', 1) or index(qp.v, "'", 1) then
         if not(index(qp.v, '"', 1)) then
            qp.v = '"' : qp.v : '"'
         end else
            if not(index(qp.v, "'", 1)) then qp.v = "'" : qp.v : "'"
         end
      end
      if qp.k = 1 then qp.f = qp.v else qp.i = qp.v
   next qp.k
   return

* The focus goes to widget ft.id and is shown there: the widget that had it and the one that has it are drawn, and the cursor goes to the new one
focus.to:
   focus.id = ft.id
   call $sl_scr('get', scr)
   call $sl_form('focus', f, scr, ft.id, rr)
   call $sl_scr('put', scr)
   return

redraw.tabs:
   call $sl_scr('get', scr)
   call $sl_form('drawwidget', f, scr, 'tabbar', rr)
   call $sl_form('drawwidget', f, scr, 'tabs', rr)
   call $sl_scr('put', scr)
   return

* The tree only (a file opened or closed in it)
redraw.tree:
   call $sl_scr('get', scr)
   call $sl_form('drawwidget', f, scr, 'tree', rr)
   call $sl_scr('put', scr)
   return

* In: or.file, or.id; or.dict ('DICT': an item of the file's dictionary) and or.mknew (1: a record that is not there opens as a NEW record, after the account's
*   edit gate), which are taken here and put back to '' and 0 at once, so that every other caller gets the data part and "not found".  Opens the record in a tab
*   of its own, or goes to the tab it is already in.  28 Oct 26 (stage B): the record is read under its lock, which the tab keeps (lock.take); a record another
*   session holds opens read-only; a collection file's record is refused (stage F hands it to CED).
open.record:
   od = or.dict
   omk = or.mknew
   or.dict = ''
   or.mknew = 0
   tf.dict = od
   tf.file = or.file
   tf.id = or.id
   gosub tab.find
   if tf.p then
      new.cb = tf.p
      if new.cb # cb then gosub switch.to
      return
   end
   lk.dict = od
   lk.file = or.file
   lk.id = or.id
   gosub lock.take
   if lk.err # '' then
      msg = lk.err
      return
   end
   or.name = lk.name
   rec = lk.rec
   if lk.kind = 'dict' then
      dt.rec = rec
      gosub dict.trim
      rec = dt.rec
   end
   * 28 Oct 26 (D2): a recovery copy of the record is offered before the tab is made - also for a record that is not on the disk (a new record that was never
   *   saved), which then opens as a new record holding the copy.  Cancel opens nothing and keeps the copy.
   or.new = 0
   rc.file = or.name                  ;* 'dict file' for a dictionary item, whose copy is not the data record's
   rc.id = or.id
   if not(lk.exists) then
      if lk.owner # '' then
         msg = sysmsg(11686, or.name, or.id, lk.owner)     ;* %1 %2 is being made by another session (user %3); it was not opened
         return
      end
      rc.has.disk = @false
      rc.disk = ''
      gosub rc.offer
      begin case
         case rc.choice = 'use'
            null
         case rc.choice = 'cancel'
            gosub lock.free
            return
         case omk
            * 28 Oct 26 (stage B): a record named on the command line that is not there is a new one - after the account's edit gate, as the name form asks it
            gosub edit.check
            if not(edit.ok) then
               gosub lock.free
               rf.text = msg
               gosub refuse.box
               return
            end
            if rc.res = '' then msg = sysmsg(11685, or.id, or.name)   ;* New record %1 in %2: nothing is written until you save it
         case 1
            gosub lock.free
            if rc.res = '' then msg = sysmsg(11201, or.id, or.name)
            return
      end case
      rec = ''
      or.new = 1
   end else
      rc.has.disk = @true
      rc.disk = rec
      gosub rc.offer
      if rc.choice = 'cancel' then
         gosub lock.free
         return
      end
   end
   gosub stash.current
   gosub drop.clean.untitled
   nbuf += 1
   uid += 1
   bn<nbuf> = or.file
   bi<nbuf> = or.id
   bu<nbuf> = uid
   k = 'n' : uid
   bx{k} = or.new
   k = 's' : uid
   bx{k} = rec
   k = 'c' : uid
   bx{k} = ''
   tb.shown = rec
   if rc.choice = 'use' then tb.shown = rc.text
   k = 't' : uid
   bx{k} = tb.shown
   gosub rc.init.tab
   ts.kind = lk.kind
   ts.dict = od
   ts.slot = lk.slot
   ts.owner = lk.owner
   gosub tab.state
   tm.u = uid
   tm.raw = tb.shown
   gosub set.token.mode
   if rc.choice = 'use' then gosub rc.took
   na.u = uid
   na.text = rec : @fm : tb.shown
   gosub na.mark                         ;* 28 Oct 26: bytes 128 to 247 in the record (or in the copy taken) make the tab read-only
   if lk.owner # '' then msg = sysmsg(11689, or.name, or.id, lk.owner)    ;* %1 %2 is open read-only: user %3 holds its lock
   k = 'a' : uid
   if bx{k} then msg = sysmsg(11761, or.name, or.id)                     ;* %1 %2 is open read-only: it holds characters outside ASCII
   cb = nbuf
   gosub load.current
   return

* ======================================================================
* Operating system files (28 Oct 26, the editor merge's stage E)

* In: op.path, the full name as typed (the command line's, or the name form's: never folded).  Opens the file in a tab of its own, or goes to the tab it is already in.
*   EVERYTHING THAT TOUCHES THE FILE IS !ide_osfile's, which is not $internal, so the kernel asks the account's OS gate and the edit gates for it; K$PATH.OK is asked here of the
*   same string first, for its own message.  The tab: bn 'path:', bi the path, kind 'path', no dictionary flag; it keeps the file variable (tfv, bx l) and with it the file's SD
*   lock until it is closed; bx p holds the line ends and bx z is 1 when the file is read-only.  A recovery copy is never kept for it (rc.tick), and Save writes it in place.
open.path:
   op.path = trimf(trimb(op.path))
   call !ide_osfile('check', op.path, op.f, op.text, op.info, op.why)
   if op.why # '' then
      gosub path.refusal
      return
   end
   tf.dict = ''
   tf.file = 'path:'
   tf.id = op.path
   gosub tab.find
   if tf.p then
      new.cb = tf.p
      if new.cb # cb then gosub switch.to
      return
   end
   if not(kernel(K$PATH.OK, op.path)) then
      msg = sysmsg(11180, @who)                ;* %1 has no OS access, so a file or directory outside its own account cannot be reached by pathname
      return
   end
   for op.s = 1 to MAXLOCK
      if tused<op.s> = '' then exit
   next op.s
   if op.s > MAXLOCK then
      msg = sysmsg(11690)                      ;* Too many records are open: close a tab first
      return
   end
   call !ide_osfile('open', op.path, op.f, op.text, op.info, op.why)
   if op.why # '' then
      gosub path.refusal
      return
   end
   tfv(op.s) = op.f
   close op.f                                  ;* the tab's variable is the one that holds the file, and its lock, from here
   tused<op.s> = 1
   gosub stash.current
   gosub drop.clean.untitled
   nbuf += 1
   uid += 1
   bn<nbuf> = 'path:'
   bi<nbuf> = op.path
   bu<nbuf> = uid
   k = 'n' : uid
   bx{k} = 0
   k = 's' : uid
   bx{k} = op.text
   k = 'c' : uid
   bx{k} = ''
   k = 't' : uid
   bx{k} = op.text
   gosub rc.init.tab
   ts.kind = 'path'
   ts.dict = ''
   ts.slot = op.s
   ts.owner = ''
   gosub tab.state
   k = 'm' : uid
   bx{k} = 0                                   ;* never the token form: the lines of a file are text
   k = 'p' : uid
   bx{k} = (op.info<1> + 0) : @fm : (op.info<2> + 0)
   k = 'z' : uid
   bx{k} = op.info<3> + 0
   na.u = uid
   na.text = op.text
   gosub na.mark                               ;* bytes 128 to 247: read-only, as for a record
   cb = nbuf
   begin case
      case op.info<3> + 0
         msg = sysmsg(11735, op.path)
      case op.info<1> + 0
         msg = sysmsg(11740, 'path:', op.path)
   end case
   k = 'a' : uid
   if bx{k} then msg = sysmsg(11761, 'path:', op.path)      ;* %1 %2 is open read-only: it holds characters outside ASCII
   gosub load.current
   return

* In: op.why, op.path, op.info.  Out: msg, why an operating system file was not opened
path.refusal:
   begin case
      case op.why = 'name'
         msg = sysmsg(11728, op.path)
      case op.why = 'none'
         msg = sysmsg(11729, op.path)
      case op.why = 'gate'
         msg = sysmsg(11180, @who)
      case op.why = 'dir' or op.why = 'special'
         msg = sysmsg(11730, op.path)
      case op.why = 'locked'
         msg = sysmsg(11731, op.path)
      case op.why = 'big'
         msg = sysmsg(11732, op.path, op.info<4>)
      case op.why = 'bytes'
         msg = sysmsg(11733, op.path)
      case 1
         msg = sysmsg(11734, op.path, op.info<6>)
   end case
   return

* Out: pa.no, true (and msg says why) when the tab in the editor is an operating system file: the commands for records and programs - compile, run, debug, catalogue, SED, fields,
*   Save as, Write a copy, Open the include - do not apply to it
path.not.for:
   pa.no = @false
   if nbuf = 0 then return
   if bn<cb> # 'path:' then return
   pa.no = @true
   msg = sysmsg(11739, bn<cb>, bi<cb>)
   return

* ======================================================================
* Kinds and locks (28 Oct 26, the editor merge's stage B)

* In: uid, ts.kind, ts.dict, ts.slot, ts.owner.  The tab uid's kind, dictionary flag, lock slot and read-only owner
tab.state:
   k = 'k' : uid
   bx{k} = ts.kind
   k = 'd' : uid
   bx{k} = ts.dict
   k = 'l' : uid
   bx{k} = ts.slot
   k = 'o' : uid
   bx{k} = ts.owner
   k = 'a' : uid
   bx{k} = 0                         ;* 28 Oct 26: no byte outside ASCII until na.mark says so
   k = 'z' : uid
   bx{k} = 0                         ;* 28 Oct 26 (stage E): not an operating system file that this session may not change (open.path sets it)
   k = 'p' : uid
   bx{k} = ''                        ;* an operating system file's line ends: 1 when every line ends CR LF, FM, 1 when the last line had its line end (the helper's INFO<1> and <2>, as they are passed to 'save')
   return

* In: na.u (a tab's uid), na.text (its record, and the text it shows).  28 Oct 26 (the owner's approval): bx a<uid> is 1 when the text holds a byte from 128 to
*   247 - another character set's letters, or UTF-8, which the editor shows a byte at a time and cannot be trusted to keep.  Such a tab is read-only (load.current,
*   new.form, ro.check) and nothing is converted: the bytes stay as the disk has them.  The marks (248 to 255) are not counted: the token form shows them.
na.mark:
   k = 'a' : na.u
   bx{k} = (convert(NA.CHARS, '', na.text) # na.text)
   return

* In: tf.dict, tf.file, tf.id.  Out: tf.p, the tab that holds that record (0: none).  A dictionary item and the data record of the same id are two records
tab.find:
   tf.p = 0
   for tf.i = 1 to nbuf
      tf.k = 'd' : bu<tf.i>
      if bn<tf.i> = tf.file and bi<tf.i> = tf.id and bx{tf.k} = tf.dict then
         tf.p = tf.i
         exit
      end
   next tf.i
   return

* In: ko.dict, fv (the file, open).  Out: ko.kind - 'dict' for the dictionary part (or a file the kernel knows as one), 'voc' for a VOC, 'source' for a program
*   file (the kernel's own test of the name: bp, bp.out, *.bp) and for any directory file (scripts, C, text), 'data' for every other file.  A collection file is
*   refused before this is asked.  The kind decides the token form (never for source) and that a dictionary item is not compiled.
kind.of:
   ko.kind = 'data'
   if ko.dict # '' then
      ko.kind = 'dict'
      return
   end
   ko.ek = kernel(K$EDIT.KIND, fileinfo(fv, FL$PATH))
   begin case
      case ko.ek = 1
         ko.kind = 'voc'
      case ko.ek = 2
         ko.kind = 'dict'
      case ko.ek = 3
         ko.kind = 'source'
      case fileinfo(fv, FL$TYPE) = FL$TYPE.DIR
         ko.kind = 'source'
   end case
   return

* In: dt.rec, a dictionary item.  An A, C, I or S item loses its compiled code (the fields from DICT.SYS.INFO on), as SED shows it: the editor holds what a
*   person writes, and the item is compiled again when it is next used.  The same is done to the disk record before the compare at a save.
dict.trim:
   dt.t = upcase(dt.rec[1, 1])
   if dt.t = 'A' or dt.t = 'C' or dt.t = 'I' or dt.t = 'S' then
      dt.rec = trim(field(dt.rec, @fm, 1, DICT.SYS.INFO - 1), @fm, 'T')
   end
   return

* In: lk.dict, lk.file, lk.id.  Out: lk.err ('' or why nothing can be opened), lk.name (the file as the person reads it: 'dict file' for a dictionary), lk.kind,
*   lk.exists and lk.rec (the record, '' when it is not there), lk.slot (the slot of tfv the lock is held through; 0 when none is held) and lk.owner (the user
*   who holds the lock, when it is not this session).  fv is the file, open.  A record that is there and locked by another session is read without a lock (the
*   tab is read-only); one that is not there is locked for its creation, as SED locks it.
lock.take:
   lk.err = ''
   lk.kind = ''
   lk.slot = 0
   lk.owner = ''
   lk.exists = @false
   lk.rec = ''
   lk.name = lk.file
   if lk.dict # '' then lk.name = 'dict ' : lk.file
   open lk.dict, lk.file to fv else
      lk.err = sysmsg(11200, lk.name)
      return
   end
   * a collection file's record is not text, and a plain READ of it would stop the IDE and every tab with it: refused until stage F hands it to CED
   if fileinfo(fv, FL$COLLECTION) then
      lk.err = sysmsg(11684, lk.name, lk.id)
      return
   end
   ko.dict = lk.dict
   gosub kind.of
   lk.kind = ko.kind
   for lk.s = 1 to MAXLOCK
      if tused<lk.s> = '' then exit
   next lk.s
   if lk.s > MAXLOCK then
      lk.err = sysmsg(11690)               ;* Too many records are open: close a tab first
      return
   end
   tfv(lk.s) = fv                        ;* the tab's own file variable: the lock is taken through it and lives as long as it does
   lk.got = @false
   readu lk.rec from tfv(lk.s), lk.id on error
      lk.err = sysmsg(11201, lk.id, lk.name) : ' (' : status() : ')'
      lk.rec = ''
   end locked
      lk.owner = status()
      read lk.rec from tfv(lk.s), lk.id then
         lk.exists = @true
      end else
         lk.rec = ''
      end
   end then
      lk.exists = @true
      lk.got = @true
   end else
      lk.rec = ''
      lk.got = @true
   end
   if lk.err # '' then lk.got = @false
   if lk.got then
      lk.slot = lk.s
      tused<lk.s> = 1
   end else
      tfv(lk.s) = 0
   end
   return

* In: lk.slot, lk.id.  The lock lock.take took is given back (no tab was made for it)
lock.free:
   if lk.slot then
      release tfv(lk.slot), lk.id
      tfv(lk.slot) = 0
      tused<lk.slot> = ''
      lk.slot = 0
   end
   return

* In: tu.i.  The lock tab tu.i holds is given back (the tab is being closed, or becomes another record)
tab.unlock:
   tu.k = 'l' : bu<tu.i>
   tu.s = bx{tu.k} + 0
   if tu.s then
      tu.k2 = 'k' : bu<tu.i>
      if bx{tu.k2} = 'path' then
         close tfv(tu.s)                 ;* 28 Oct 26 (stage E): an operating system file's lock goes with the file variable (bi is a path, not a record id to release)
      end else
         release tfv(tu.s), bi<tu.i>
      end
      tfv(tu.s) = 0
      tused<tu.s> = ''
      bx{tu.k} = 0
   end
   return

* Every lock the tabs hold is given back (every way the IDE ends)
release.all:
   for tu.i = 1 to nbuf
      gosub tab.unlock
   next tu.i
   return

* In: tu.i.  The tab is given its record's lock (a tab that has just become a record: an untitled buffer named, Save as, New record).  Out: tl.ok, false when
*   another session holds it (the tab then holds none; its save will say so) or the file cannot be opened (msg)
tab.lock:
   tl.ok = @false
   tl.u = bu<tu.i>
   tl.k = 'd' : tl.u
   lk.dict = bx{tl.k}
   lk.file = bn<tu.i>
   lk.id = bi<tu.i>
   gosub lock.take
   if lk.err # '' then
      msg = lk.err
      return
   end
   tl.k = 'k' : tl.u
   bx{tl.k} = lk.kind
   tl.k = 'l' : tl.u
   bx{tl.k} = lk.slot
   tl.ok = (lk.slot > 0)
   return

* After the terminal was handed to a program (Run, Debug, SED, CED): a lock the program let go - a RELEASE in it, or SED's own READU of the record, which moves the
*   lock to SED's file variable and gives it back when SED closes the file - is taken again through the tab's own file variable (a lock this session already holds
*   is only moved back to it).  One that another session took meanwhile makes the tab read-only, and says so.
relock.all:
   for rl.i = 1 to nbuf
      rl.u = bu<rl.i>
      rl.k = 'l' : rl.u
      rl.s = bx{rl.k} + 0
      rl.k2 = 'k' : rl.u
      if bx{rl.k2} = 'path' then rl.s = 0     ;* 28 Oct 26 (stage E): an operating system file's lock is the file variable's own and is not taken again here. A BARE RELEASE in a program run from the IDE lets it go (review, finding 3): the save then still reads the file again (a changed or replaced file is caught), and only another session's write between that read and ours is not
      if rl.s then
         rl.lost = @false
         recordlocku tfv(rl.s), bi<rl.i> locked
            rl.lost = @true
            rl.owner = status()
         end
         if rl.lost then
            tfv(rl.s) = 0
            tused<rl.s> = ''
            bx{rl.k} = 0
            k = 'o' : rl.u
            bx{k} = rl.owner
            i = rl.i
            gosub buf.label
            msg = sysmsg(11692, bf.name, bf.id, rl.owner)   ;* %1 %2: another session (user %3) took its lock while the IDE was away; the tab is read-only
         end
      end
   next rl.i
   return

* In: ro.i.  Out: ro.ok, false (and msg says why) when tab ro.i is read-only: another session holds its record's lock, so nothing may change its text;
*   ro.why 'lock' for that, and (28 Oct 26) 'ascii' when the record holds bytes 128 to 247 (na.mark)
ro.check:
   ro.ok = @true
   ro.why = ''
   ro.k = 'a' : bu<ro.i>
   if bx{ro.k} then
      ro.ok = @false
      ro.why = 'ascii'
      i = ro.i
      gosub buf.label
      msg = sysmsg(11754, bf.name, bf.id)                         ;* %1 %2 holds characters outside ASCII ... read-only in the IDE ...
      return
   end
   ro.k = 'z' : bu<ro.i>
   if bx{ro.k} then
      ro.ok = @false                                              ;* 28 Oct 26 (stage E): an operating system file this session may not change
      ro.why = 'osro'
      i = ro.i
      gosub buf.label
      msg = sysmsg(11737, bf.name, bf.id)                         ;* %1 %2 is read-only here: the operating system, or an edit gate of this account, does not let this session change it
      return
   end
   ro.k = 'o' : bu<ro.i>
   if bx{ro.k} = '' then return
   ro.ok = @false
   ro.why = 'lock'
   i = ro.i
   gosub buf.label
   msg = sysmsg(11688, bf.name, bf.id, bx{ro.k})                 ;* %1 %2 is read-only here: user %3 holds its lock ...
   return

* After ro.check refused: the refusal for bytes outside ASCII is shown in a box, whole (28 Oct 26; the owner's approval); the lock's stays on the status line
ro.box:
   if ro.why # 'ascii' then return
   rf.text = msg
   gosub refuse.box
   return

* 28 Oct 26: Save as and Write a copy are refused for a tab whose record holds bytes 128 to 247, in a box (a lock does not stop them: they write another record).
*   In: cb.  Out: na.ok
na.check:
   na.ok = @true
   if nbuf = 0 then return
   na.msg = msg
   ro.i = cb
   gosub ro.check
   if ro.why # 'ascii' then
      msg = na.msg                   ;* a lock's refusal is not this one's
      return
   end
   na.ok = @false
   gosub ro.box
   return

* In: sq.dict, sq.file.  Out: sq.id, the file's next sequential record id (CREATING.SEQKEY, as SED takes it: $seqkey), or '' with the reason in msg.  The account's
*   edit gate is asked first: an id taken is not given back
seq.take:
   sq.id = ''
   sq.name = sq.file
   if sq.dict # '' then sq.name = 'dict ' : sq.file
   open sq.dict, sq.file to fv else
      msg = sysmsg(11200, sq.name)
      return
   end
   gosub edit.check
   if not(edit.ok) then
      rf.text = msg
      gosub refuse.box
      return
   end
   sq.why = ''
   call $seqkey(fv, @true, sq.id, sq.why)
   if sq.why # '' then
      msg = sq.why
      sq.id = ''
   end
   return

* The records of the select list that was active at the start (sel0, read before anything else could use list 0): all of them in the table at the bottom, where
*   Return opens one, and the first MAXSEL of them in tabs
open.select:
   os.n = dcount(sel0, @fm)
   err.rows = ''
   err.lines = ''
   sid = ''
   sln = ''
   for os.i = 1 to os.n
      err.rows<-1> = 1 : @vm : sel0<os.i>
      err.lines<-1> = 1
      sid<-1> = sel0<os.i>
      sln<-1> = 1
   next os.i
   out.kind = 'search'
   out.file = fn0
   out.dict = dflag0
   gosub err.load
   os.open = os.n
   if os.open > MAXSEL then os.open = MAXSEL
   for os.i = 1 to os.open
      or.dict = dflag0
      or.file = fn0
      or.id = sel0<os.i>
      gosub open.record
   next os.i
   if nbuf > 1 and cb # 1 then
      new.cb = 1
      gosub switch.to
   end
   msg = sysmsg(11694, os.n, os.open)          ;* %1 records of the select list are listed below; the first %2 are open in tabs
   if sel0.more then msg := '  ' : sysmsg(11219, MAXREC, 'the select list')
   return

* Go / Open the include: the line at the editor's cursor is $include {file} record (the compiler's form: a comment after ; is not part of it).  The record opens in a
*   tab.  With no file the compiler's own order is looked in: the file of the record in the editor, then syscom
do.include:
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub path.not.for                   ;* 28 Oct 26 (stage E): a $include names a record of the account's files
   if pa.no then return
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   in.line = mw{'value'}<mw{'cy'} + 0>
   in.line = trim(field(in.line, ';', 1))
   if downcase(field(in.line, ' ', 1)) # '$include' then
      msg = sysmsg(11695)                              ;* The line at the cursor is not a $include line
      return
   end
   in.n = dcount(in.line, ' ')
   begin case
      case in.n = 2
         in.rec = field(in.line, ' ', 2)
         in.files = bn<cb>
         if in.files = '' then in.files = 'bp'
         k = 'd' : bu<cb>
         if bx{k} # '' then in.files = 'bp'               ;* a dictionary item has no program file of its own
         if in.files # 'syscom' then in.files<-1> = 'syscom'
      case in.n = 3
         in.rec = field(in.line, ' ', 3)
         in.files = field(in.line, ' ', 2)
      case 1
         msg = sysmsg(11695)
         return
   end case
   in.found = @false
   in.nf = dcount(in.files, @fm)
   for in.j = 1 to in.nf
      in.file = in.files<in.j>
      open in.file to fv else
         open downcase(in.file) to fv then in.file = downcase(in.file) else continue
      end
      if fileinfo(fv, FL$COLLECTION) then continue
      read in.x from fv, in.rec on error
         continue
      end then
         in.found = @true
      end else
         read in.x from fv, downcase(in.rec) then
            in.rec = downcase(in.rec)
            in.found = @true
         end
      end
      if in.found then exit
   next in.j
   if not(in.found) then
      msg = sysmsg(11696, in.rec, change(in.files, @fm, ', '))   ;* Include record %1 was not found (looked in %2)
      return
   end
   or.file = in.file
   or.id = in.rec
   cur.code = 'R:' : or.file : ':' : or.id
   gosub open.record
   if nbuf > 0 then
      ft.id = 'ed'
      gosub focus.to
      gosub redraw.tabs
   end
   return

* In: new.cb
switch.to:
   gosub stash.current
   cb = new.cb
   gosub load.current
   return

* Whether record i has changes: dirty
is.dirty:
   u = bu<i>
   k = 't' : u
   d1 = bx{k}
   k = 's' : u
   d2 = bx{k}
   dirty = ((d1 : '|') # (d2 : '|'))     ;* as strings: # compares two numbers as numbers, so a one-line "1.0" changed to "1" was not a change (review of 28 Oct 26, finding 6)
   k = 'n' : u
   if bx{k} and d1 # '' then dirty = @true            ;* a record that is not on the disk yet and holds text
   return

* ======================================================================
* The recovery copy (28 Oct 26, S.88 plan 2.9, D2).  Only where the administrator has turned it on for the account (MODIFY.ACCOUNT RECOVERY-ON; delivered off), and
* only in a store in the person's own Linux home (28 Oct 26: it was the account's $recovery): !edit_recovery decides that, makes and checks the owner-only
* directories, and keeps the copies.  The IDE says WHICH text and
* WHEN.  For each tab: bx qk<uid> is the file and record (as two values) of the copy THIS TAB owns ('' none), bx r<uid> the text that copy holds, bx w<uid> the
* token an untitled buffer's copy is kept under.  A tab owns a copy it wrote or one the person took into it (Use the copy); a copy it does not own is never written
* over, and the person is asked about it (rc.offer) before any tab for that record is made.  NOTHING HERE WRITES THE RECORD: the person's save does, as ever.

* A new tab owns no copy.  In: uid
rc.init.tab:
   k = 'qk' : uid
   bx{k} = ''
   k = 'r' : uid
   bx{k} = ''
   k = 'w' : uid
   bx{k} = ''
   k = 'x' : uid
   bx{k} = ''                        ;* file VM record VM time: a copy the tab does not own was found under that key, look again at that time (rc.tick)
   return

* In: uid, rc.file, rc.id, rc.text.  The tab uid has just taken the copy: it owns it, and the copy stays until the record is saved or the tab closed
rc.took:
   k = 'qk' : uid
   bx{k} = rc.file : @vm : rc.id
   k = 'r' : uid
   bx{k} = rc.text
   if rc.file = '' then
      k = 'w' : uid
      bx{k} = rc.id
   end
   msg = sysmsg(11773)               ;* The recovery copy is in the editor; the record on disk is unchanged until you save it
   return

* In: ri.  Out: rk.file, rk.id, the key of buffer ri's copy: its file and record, or for an untitled buffer no file and a token of its own (made the first time)
rc.key:
   rk.u = bu<ri>
   rk.file = bn<ri>
   k = 'd' : rk.u
   if bx{k} # '' then rk.file = 'dict ' : bn<ri>     ;* 28 Oct 26 (stage B): a dictionary item's copy is not the data record's (open.record offers it so)
   rk.id = bi<ri>
   if rk.id = '' then
      rk.file = ''
      k = 'w' : rk.u
      rk.id = bx{k}
      if rk.id = '' then
         rk.id = 'untitled.' : date() : '.' : int(time()) : '.' : rk.u
         bx{k} = rk.id
      end
   end
   return

* In: ri.  The copy buffer ri owns goes (its record was saved, or the person closed the buffer, saved or discarded, or it has no changes any more)
rc.drop.tab:
   k = 'qk' : bu<ri>
   rq = bx{k}
   if rq # '' then
      call !edit_recovery('drop', rq<1, 1>, rq<1, 2>, '', rr)
      bx{k} = ''
      k = 'r' : bu<ri>
      bx{k} = ''
   end
   return

* After a second of quiet, before the screen is handed to a program, and when the IDE ends without the person's word: every buffer with changes has a copy holding
* its text, and a buffer without changes has none.  Nothing at all when the switch is off.  A failure is said once on the status line (11777) and the text stays in
* the editor; 'off' (RECOVERY-OFF since the IDE started) stops the tries.
rc.tick:
   if not(rc.on) then return
   gosub stash.current
   for ri = 1 to nbuf
      i = ri
      gosub is.dirty
      rk.pk = 'k' : bu<ri>
      if bx{rk.pk} = 'path' then continue                  ;* 28 Oct 26 (stage E): no recovery copy is kept of an operating system file: the store is in the person's home, the file may be anywhere
      if not(dirty) then
         gosub rc.drop.tab
      end else
         k = 't' : bu<ri>
         rt.text = bx{k}
         gosub rc.key
         rk.now = rk.file : @vm : rk.id
         k = 'qk' : bu<ri>
         rq = bx{k}
         rt.write = @true
         if rq = rk.now then
            k = 'r' : bu<ri>
            if bx{k} = rt.text then rt.write = @false     ;* the copy already holds this text
         end else
*           The tab is another record now (save as; an untitled buffer that was named), or owns no copy yet: the old one goes, and a copy somebody else
*           left under the new name (another session of the same person) is not written over.
            if rq # '' then
               call !edit_recovery('drop', rq<1, 1>, rq<1, 2>, '', rr)
               bx{k} = ''
            end
*           28 Oct 26 (TUI phase 2 review): a copy the tab does not own was found under its key once, and then the tab never wrote a copy again, even after that copy
*           was gone, and the person was not told.  Now the person is told (11778) the first time, and the copy is looked for again every RC.LOOK seconds (not
*           every second: it is a file read and a digest); once it is gone the tab writes its own.  Such a copy is another IDE session's of the same person in the
*           same account with the same record open and changed, or one left when an editor ended, under a name this tab took without the question (Save as, or
*           the first save of an untitled buffer, to that record): either holds text the person may want, so it is never written over.
            k = 'x' : bu<ri>
            rx = bx{k}
            rt.now = date() * 86400 + int(time())
            rt.seen = @false
            if rx # '' then rt.seen = (rx<1, 1> = rk.file and rx<1, 2> = rk.id)
            if rt.seen and rt.now < rx<1, 3> + 0 then
               rt.write = @false                                  ;* looked for less than RC.LOOK seconds ago
            end else
               call !edit_recovery('find', rk.file, rk.id, rt.other, rr)
               if rr # '' then
                  rt.write = @false
                  bx{k} = rk.now : @vm : rt.now + RC.LOOK
                  if not(rt.seen) then
                     i = ri
                     gosub buf.label
                     msg = sysmsg(11778, bf.name, bf.id)   ;* %1 %2 gets no recovery copy: another one is there (another session's, or older) and is kept
                  end
               end else
                  bx{k} = ''                                      ;* none there (or no longer): the tab writes its own below
               end
            end
         end
         if rt.write then
            call !edit_recovery('write', rk.file, rk.id, rt.text, rr)
            if rr = '' then
               k = 'qk' : bu<ri>
               bx{k} = rk.now
               k = 'r' : bu<ri>
               bx{k} = rt.text
               rc.warned = 0
            end else
               k = 'qk' : bu<ri>
               bx{k} = ''                                   ;* a failed write leaves no copy behind (!edit_recovery removes it)
               if rr = 'off' then
                  rc.on = 0
               end else
                  if not(rc.warned) then msg = sysmsg(11777, rr)   ;* A recovery copy could not be written (%1); the text is still in the editor
                  rc.warned = 1
               end
            end
         end
      end
   next ri
   return

* In: rc.file, rc.id (a record a tab is about to be made for), rc.has.disk and rc.disk (the record as it is on the disk).  Out: rc.res ('' when there is no whole,
* private copy), rc.choice and rc.text: 'none' (no copy; or a copy that says nothing the record does not, which is removed; or the person deleted it), 'use'
* (rc.text is the copy, for the tab to take) or 'cancel' (no tab: the copy stays).  The question is the person's; Enter is Use the copy, which writes nothing.
rc.offer:
   rc.choice = 'none'
   rc.text = ''
   call !edit_recovery('find', rc.file, rc.id, rc.text, rc.res)
   if rc.res = '' then return
   if rc.has.disk and rc.text = rc.disk then
      call !edit_recovery('drop', rc.file, rc.id, '', rr)
      rc.text = ''
      return
   end
   rc.when = oconv(rc.res<2>, 'D') : ' ' : oconv(rc.res<3>, 'MT')
   rf.w = lw - 16
   if rf.w > 100 then rf.w = 100
   call $tk_wrap(sysmsg(11772, rc.file, rc.id, rc.when), rf.w, rc.pieces)   ;* A recovery copy of %1 %2, kept on %3, holds text that was not saved...
   screen msgbox change(rc.pieces, @fm, @vm) buttons 'Use the copy,Delete the copy,Cancel' default 1 returning rc.b else rc.b = 3
   last.status = char(1)
   begin case
      case rc.b = 1
         rc.choice = 'use'
      case rc.b = 2
         call !edit_recovery('drop', rc.file, rc.id, '', rr)
         rc.text = ''
         msg = sysmsg(11774)                  ;* The recovery copy was deleted
      case 1
         rc.choice = 'cancel'
         rc.text = ''
         msg = sysmsg(11775, rc.file, rc.id)  ;* The recovery copy of %1 %2 is kept; the record was not opened
   end case
   return

* A bare IDE: the copies of untitled buffers that were kept when an editor ended are offered, each in a tab of its own (Open), deleted, or left for another time
rc.untitled:
   rc.list = ''
   call !edit_recovery('list', '', '', rc.list, rc.n)
   rc.got = @false
   for ru = 1 to rc.n
      rc.file = ''
      rc.id = rc.list<ru, 1>
      call !edit_recovery('find', rc.file, rc.id, rc.text, rc.res)
      if rc.res # '' then
         rc.when = oconv(rc.res<2>, 'D') : ' ' : oconv(rc.res<3>, 'MT')
         rf.w = lw - 16
         if rf.w > 100 then rf.w = 100
         call $tk_wrap(sysmsg(11776, rc.when), rf.w, rc.pieces)   ;* Text typed in an untitled buffer was kept on %1 when the editor ended.  Open it in a new tab?
         screen msgbox change(rc.pieces, @fm, @vm) buttons 'Open,Delete the copy,Later' default 1 returning rc.b else rc.b = 3
         last.status = char(1)
         begin case
            case rc.b = 1
               gosub drop.clean.untitled
               gosub add.untitled
               k = 't' : uid
               bx{k} = rc.text
               tm.u = uid
               tm.raw = rc.text
               gosub set.token.mode
               gosub rc.took
               na.u = uid
               na.text = rc.text
               gosub na.mark                ;* 28 Oct 26: a copy holding bytes outside ASCII is read-only, as a record is
*              28 Oct 26 (TUI phase 2 review): the editor is made to hold this tab at once.  It still held the empty startup buffer, so the next Open's add.untitled
*              (stash.current: the editor's text into the tab in the editor) wrote that empty text over THIS copy's tab, and the next tick deleted the copy from the
*              disk as a buffer without changes.  The copy stays on the disk; it goes only by the rules of any tab's copy, now that its text is in a tab.
               gosub load.current
               rc.got = @true
            case rc.b = 2
               call !edit_recovery('drop', rc.file, rc.id, '', rr)
               msg = sysmsg(11774)
         end case
      end
   next ru
   if rc.got then
      ft.id = 'ed'
      gosub focus.to
   end
   return

* ======================================================================
* The pane indicators: [*] on the pane that has the focus (focus.id), [-] on the others

* ind.want = the four texts, in the order of ind.panes
indicator.texts:
   ind.want = ''
   for ix = 1 to 4
      ind.want<ix> = if focus.id = ind.panes<ix> then '[*]' else '[-]'
   next ix
   return

* The ones that changed are set and drawn again, alone: the form is not drawn again (f{'quiet'}), and a label that has not changed is not touched
set.indicators:
   gosub indicator.texts
   if ind.want = ind.cur then return
   f{'quiet'} = 1
   for ix = 1 to 4
      if ind.want<ix> # ind.cur<ix> then screen set f, ind.ids<ix> text ind.want<ix>
   next ix
   f{'quiet'} = 0
   call $sl_scr('get', scr)
   for ix = 1 to 4
      if ind.want<ix> # ind.cur<ix> then call $sl_form('drawwidget', f, scr, ind.ids<ix>, rr)
   next ix
   call $sl_scr('put', scr)
   ind.cur = ind.want
   return

* ======================================================================
* The AUTOLOGOUT countdown (28 Oct 26, approved by the owner).  The kernel ends a session whose AUTOLOGOUT period passes with nothing typed (keyin counts
* the time spent waiting, across the IDE's one-second waits, the waits of a dialog and of the AI line), and an IDE with unsaved changes then loses them.  The
* countdown is read from that same clock: kernel(K$AUTOLOGOUT, -2) is the time waited with nothing typed, as AUTOLOGOUT will judge it at the next wait, 0 after a
* key.  (The first version GUESSED it from what the IDE could see - a wait that took long, a change in the editor - and was late by an AI wait and by a stall.)

* Out: idl.txt, the countdown for the status line, or '' when the period is off (0) or more than IDL.WARN seconds away
idle.text:
   idl.txt = ''
   idl.al = kernel(K$AUTOLOGOUT, -1) + 0          ;* ms, as the autologout verb reads it; 0 is off
   if idl.al <= 0 then return
   idl.ms = kernel(K$AUTOLOGOUT, -2) + 0          ;* ms waited with nothing typed: the kernel's own clock
   idl.left = int((idl.al - idl.ms + 999) / 1000)
   if idl.left > IDL.WARN then return
   if idl.left < 1 then idl.left = 1
   idl.dirty = @false
   for idl.i = 1 to nbuf
      i = idl.i
      gosub is.dirty
      if dirty then idl.dirty = @true
   next idl.i
   begin case
      case not(idl.dirty)
         idl.txt = sysmsg(11752, idl.left)        ;* Idle: signing out in %1 s
      case rc.on
         idl.txt = sysmsg(11751, idl.left)        ;* ...; a recovery copy is kept
      case 1
         idl.txt = sysmsg(11750, idl.left)        ;* ...; unsaved changes will be lost
   end case
   return

* ======================================================================
* The status line, and the bar

status.line:
   if last.status = char(1) then last.foot = ''     ;* the screen was made again, or a dialog or a program wrote over it: the foot is written too
   gosub set.indicators
   t = ''
   if nbuf > 0 then
      gosub stash.current
      i = cb
      gosub is.dirty
      call $sl_form('find', f, '', 'ed', en)
      mw = f{'widgets', en}
      gosub buf.label
      t = bf.name : ' ' : bf.id
      if bi<cb> = '' then t = bf.name
      if dirty then t := ' *'
      k = 'o' : bu<cb>
      if bx{k} # '' then t := '  ' : sysmsg(11687, bx{k})        ;* 28 Oct 26 (stage B): [read-only: user %1 holds its lock]
      k = 'a' : bu<cb>
      if bx{k} then t := '  ' : sysmsg(11753)                    ;* 28 Oct 26: [read-only: characters outside ASCII]
      k = 'z' : bu<cb>
      if bx{k} then t := '  ' : sysmsg(11736)                    ;* 28 Oct 26 (stage E): [read-only: this session may not change it]
      t := '   ' : sysmsg(11213, mw{'cy'}, mw{'cx'})
   end
   if msg # '' then t := '   ' : msg
   gosub idle.text                                               ;* 28 Oct 26: the AUTOLOGOUT countdown goes first, where it is read
   if idl.txt # '' then t = idl.txt : (if t = '' then '' else '   ' : t)
   * 18 Oct 26 dm - SCREEN TEXT leaves the cursor after the text, so the cursor stayed at the end of the status row and the editor showed none
   *   (found by the owner: "no cursor when it is first started"; the loop writes this line once a second and on every key).  It is put back
   *   where the widget with the focus had left it.
   * The line is written only when its text has changed since it was last written: the loop comes here about ten times a second, and an idle IDE
   *   wrote 140 cells each time (new.form, which makes the screen again, forgets the text so that the line is written then)
   * 19 Oct 26 dm - which pane has the focus, first on the line (the owner, using the keyboard only: "no visible indication of which box is active"):
   *   Tab moves the focus from the files to the tabs, the editor and the messages, and the terminal's own cursor is the only other sign of it
   begin case
      case focus.id = 'tree'
         pn = sysmsg(11237)
      case focus.id = 'tabs'
         pn = sysmsg(11238)
      case focus.id = 'ed'
         pn = sysmsg(11239)
      case focus.id = 'err'
         pn = sysmsg(11240)
      case focus.id = 'ai'
         pn = 'AI'
      case 1
         pn = ''
   end case
   if pn # '' then t = '[' : pn : ']' : (if t = '' then '' else '  ' : t)
   t = fmt(t[1, lw], lw : 'L')
   if t # last.status then
      last.status = t
      keep.cur = ''
      call $sl_curat('get', keep.cur)
      screen text t at 0,ystat attr 'reverse'     ;* the status row: off the screen in a smaller window
      call $sl_curat('back', keep.cur)
   end
   gosub foot.draw
   return

* The border and the function-key row under the status line (the toolkit's frame: tk.h rows H-2 and H-1, plan section 5.1).  Written only when the layout's size
* changed or the screen was made again (status.line forgets last.foot then); the row is made by $tk_fkeys from the IDE's key table (ide.keys), cut to the layout's width.
foot.draw:
   foot.geo = lw : '/' : lh
   if foot.geo = last.foot then return
   last.foot = foot.geo
   fk.ctx = ''
   fk.ctx<TK.C.W> = lw
   call $tk_fkeys(fk.ctx, ide.keys, '', fk.text)
   call $sl_line('h', 0, fk.hc)
   keep.cur = ''
   call $sl_curat('get', keep.cur)
   screen text str(fk.hc, lw) at 0,ybord
   screen text fk.text at 0,ykeys attr 'bar'
   call $sl_curat('back', keep.cur)
   return

* ======================================================================
* Keys, the menu and the commands

do.key:
   msg = ''
   cmd = ''
   begin case
      case edata = 'f1'
         cmd = 'help'
      * 28 Oct 26 dm (S.88 Phase 4, the owner's keys of 20 Oct, D28 / D31 / D32 / D33): Ctrl-S is the only save key (F2 went; it is the debugger's abort), the build keys follow Geany
      *   (F5 run, F8 compile, F9 build = compile and catalogue, F7 debug), F6 is the next pane, the tabs are Ctrl-PageDown / Ctrl-PageUp, Ctrl-N new, Ctrl-O open, Ctrl-W close.
      *   F11 (find in the records: the terminal's full screen) is a menu entry; Save as and Write a copy are menu entries.
      case edata = 'ctrl-s'
         cmd = 'save'
      case edata = 'f4'
         cmd = 'nexterr'
      case edata = 'f5'
         cmd = 'run'
      case edata = 'f6'
         cmd = 'nextpane'
      case edata = 'shift-f6'
         cmd = 'prevpane'                ;* F3 is find next in the editor (the owner's D31), so the tree is reached by the panes' ring, the Go menu and the mouse
      case edata = 'f7'
         cmd = 'debug'
      case edata = 'f8'
         cmd = 'compile'
      case edata = 'f9'
         cmd = 'catalog'
      case edata = 'ctrl-pgdn' or edata = 'alt-pgdn'
         cmd = 'nexttab'                 ;* GNOME Terminal keeps Ctrl-PageUp / PageDown for its own tabs: Alt-PageUp / PageDown are the same keys with another modifier (Opus, 28 Oct)
      case edata = 'ctrl-pgup' or edata = 'alt-pgup'
         cmd = 'prevtab'
      case edata = 'f10'
         cmd = 'menu'
      case edata = 'ctrl-q'
         cmd = 'quit'
      case edata = 'ctrl-w'
         cmd = 'close'
      case edata = 'ctrl-n'
         cmd = 'new'
      case edata = 'ctrl-o'
         cmd = 'open'
      case edata = 'ctrl-e'
         cmd = 'sed'                     ;* the record goes to SED and comes back (the editor leaves this key to the IDE: passkeys)
      case edata = 'ctrl-l'
         cmd = 'goto'
      case edata = 'ctrl-r'
         cmd = 'replace'                 ;* SED's replace
      case edata = 'f12'
         cmd = 'fields'                  ;* the record as fields, values and subvalues, in CED
      case edata = 'guardquit'
         gosub rc.tick                   ;* 28 Oct 26 (D2): the copies are kept, as for a hang-up: the person could not see the buffers to decide
         done = @true                    ;* the user left from the cursor lock ($sl_guardmode): nothing is saved
      case edata = 'mouse'
         * The bar is not a widget, so a click on it comes here as a key the form had no use for.  19 Oct 26 dm: the left button on the bar's
         * row (0) opens the menu whose title is under it; the menu was opened only by F10 or Esc before, and a click did nothing until then.
         call $sl_mouse('get', mev)
         if mev<1> = 'press' and mev<2> = 1 and mev<4> = 0 then
            menu.click = mev<3>
            cmd = 'menu'
         end
   end case
   if cmd # '' then gosub run.cmd
   return

run.cmd:
   begin case
      case cmd = 'menu'
         mk = menu.click
         menu.click = ''
         if mk = '' then
            screen menubar menus returning mc then
               cmd = mc
               gosub run.cmd
            end
         end else
            screen menubar menus click mk returning mc then      ;* the menu under the click; the space beside the titles opens nothing
               cmd = mc
               gosub run.cmd
            end
         end
      case cmd = 'help'
         s = convert(char(13), '', sysmsg(11214) : sysmsg(11215) : sysmsg(11216))
         s = change(s, char(10), @vm)
         screen msgbox s returning b else b = 0
      case cmd = 'save'
         gosub save.current
      case cmd = 'tree'
         ft.id = 'tree'                    ;* SCREEN FOCUS moves the pointer and draws nothing: the form's own op shows the change
         gosub focus.to
      case cmd = 'nexterr'
         gosub next.error
      case cmd = 'nexttab'
         if nbuf > 1 then
            new.cb = cb + 1
            if new.cb > nbuf then new.cb = 1
            gosub switch.to
         end
      case cmd = 'prevtab'
         if nbuf > 1 then
            new.cb = cb - 1
            if new.cb < 1 then new.cb = nbuf
            gosub switch.to
         end
      case cmd = 'nextpane' or cmd = 'prevpane'
         * F6 and Shift-F6: the focus goes round the panes in the order the status line and the [*] marks name them (Tab does the same inside the form)
         pane.ring = 'tree' : @fm : 'tabs' : @fm : 'ed' : @fm : 'err'
         if ai.on then pane.ring<-1> = 'ai'
         locate focus.id in pane.ring<1> setting pane.at else pane.at = 0
         if cmd = 'nextpane' then pane.at += 1 else pane.at -= 1
         if pane.at > dcount(pane.ring, @fm) then pane.at = 1
         if pane.at < 1 then pane.at = dcount(pane.ring, @fm)
         ft.id = pane.ring<pane.at>
         gosub focus.to
      case cmd = 'open'
         gosub do.open
      case cmd = 'compile'
         c.opt = ''
         gosub do.compile
      case cmd = 'catalog'
         c.opt = ''
         gosub do.compile
         if c.ok then
            qp.file = c.file ; qp.id = c.id ; gosub quote.pair
            execute 'catalog ' : qp.f : ' ' : qp.i capturing co
            gosub catalog.verified
         end
      case cmd = 'run'
         c.opt = ''
         gosub do.compile
         if c.ok then
            gosub leave.screen
            qp.file = c.file ; qp.id = c.id ; gosub quote.pair
            execute 'run ' : qp.f : ' ' : qp.i trapping aborts
            gosub retake.screen
         end
      case cmd = 'debug'
         c.opt = ' debugging'
         gosub do.compile
         if c.ok then
            gosub leave.screen
            qp.file = c.file ; qp.id = c.id ; gosub quote.pair
            execute 'debug ' : qp.f : ' ' : qp.i trapping aborts
            gosub retake.screen
         end
      case cmd = 'close'
         gosub close.current
      case cmd = 'sed'
         gosub do.sed
      case cmd = 'fields'
         gosub do.fields
      case cmd = 'include'
         gosub do.include                ;* 28 Oct 26 (stage B): Go / Open the include (a menu entry; no key: a terminal sends Ctrl-Enter as Return)
      case cmd = 'quit'
         gosub do.quit
      case cmd = 'goto'
         if nbuf = 0 then
            msg = sysmsg(11218)
         end else
            screen ask sysmsg(11209) returning gl.text then
               if num(gl.text) and gl.text # '' then
                  gl.n = gl.text + 0
                  gosub goto.line
               end
            end
         end
      case cmd = 'find'
         gosub do.find
      case cmd = 'writeas'
         gosub do.writeas
      case cmd = 'saveas'
         gosub do.saveas
      case cmd = 'replace'
         gosub do.replace
      case cmd = 'new'
         gosub do.new
      case cmd = 'ai.error'
         gosub ai.error
      case cmd = 'ai.sel'
         gosub ai.selection
      case cmd = 'ai.ask'
         if nbuf = 0 then
            msg = sysmsg(11662)
         end else
            ft.id = 'ai'                  ;* the entry has the focus: the person types the request there
            gosub focus.to
            msg = sysmsg(11655)
         end
      case cmd = 'theme'
         theme.n += 1
         if theme.n > dcount(themes, @fm) then theme.n = 1
         gosub apply.theme
         screen refresh
         last.status = char(1)          ;* everything was drawn again, the status line too
   end case
   return

* Return in the tree, the table or the tab strip (the form's default button)
do.act:
   did.focus = @false
   begin case
      case focus.id = 'tree'
         screen get f, 'tree' returning code
         begin case
            case code[1, 2] = 'F:'
               lf.name = code[3, 99]
               lp = 0
               nl = dcount(lfiles, @fm)
               if lfiles = '' then nl = 0
               for q = 1 to nl
                  if lfiles<q> = lf.name then
                     lp = q
                     exit
                  end
               next q
               if lp then
                  del lfiles<lp>
                  del lrecs<lp>
                  del ldict<lp>
               end else
                  gosub load.file
               end
               cur.code = code
               gosub tree.apply
               gosub redraw.tree
            case code[1, 2] = 'D:'
               * 28 Oct 26 (stage B): the dictionary node: its items are read now (the first time), and Return again closes it
               ld.name = code[3, 99]
               lp = 0
               nl = dcount(dfiles, @fm)
               if dfiles = '' then nl = 0
               for q = 1 to nl
                  if dfiles<q> = ld.name then
                     lp = q
                     exit
                  end
               next q
               if lp then
                  del dfiles<lp>
                  del drecs<lp>
               end else
                  gosub load.dict
               end
               cur.code = code
               gosub tree.apply
               gosub redraw.tree
            case code[1, 2] = 'R:' or code[1, 2] = 'Q:'
               or.file = field(code, ':', 2)
               or.id = code[len(or.file) + 4, 9999]
               if code[1, 2] = 'Q:' then or.dict = 'DICT'      ;* an item of the file's dictionary
               cur.code = code
               * 18 Oct 26 dm - the editor is drawn once: by the focus that follows, not also by open.record (which drew the whole form, and then
               *   again at the end of this routine).  SCREEN FOCUS only moves the form's pointer and draws nothing, so the focus goes through the
               *   form's own op, which draws the widget that had it (the tree) and the one that has it (the editor, with the cursor in its text).
               lc.nodraw = @true
               gosub open.record
               lc.nodraw = @false
               if nbuf > 0 then
                  ft.id = 'ed'
                  gosub focus.to
                  did.focus = @true
                  gosub redraw.tabs
               end
         end case
      case focus.id = 'err'
         screen get f, 'err' returning rn
         if rn # '' then
            k2 = rn + 0
            gosub act.error
         end
      case focus.id = 'ai'
         * Return in the AI entry: the request is what was typed; the whole record is the text, the page says where the cursor is
         ai.req = edata
         ai.kind = 'ask'
         gosub ai.go
      case 1
         null
   end case
   if not(did.focus) then screen focus f, focus.id
   return

* The row k2 of the table: go to what it names
act.error:
   if k2 < 1 or k2 > dcount(err.rows, @fm) then return
   if out.kind = 'search' then
      or.dict = out.dict                ;* 28 Oct 26 (stage B): a select list of dictionary items lists items
      or.file = out.file
      or.id = sid<k2>
      gosub open.record
      gl.n = sln<k2> + 0
   end else
      gl.n = err.lines<k2> + 0
   end
   if gl.n >= 1 and nbuf > 0 then
      gosub goto.line
   end
   return

* In: gl.n.  The cursor of the editor goes to that line, which is brought to the middle of the window
goto.line:
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   nl = dcount(mw{'value'}, @fm)
   if gl.n > nl then gl.n = nl
   if gl.n < 1 then gl.n = 1
   mw{'cy'} = gl.n
   mw{'cx'} = 1
   mw{'want'} = 1
   mw{'left'} = 1
   mw{'mx'} = 0
   mw{'my'} = 0
   tp = gl.n - int(mh / 2)
   if tp < 1 then tp = 1
   mw{'top'} = tp
   ft.id = 'ed'                         ;* the widget that had the focus and the editor are drawn, the cursor in the editor
   gosub focus.to
   return

* F4: the row after the current one of the table, and what it names
next.error:
   n = dcount(err.rows, @fm)
   if err.rows = '' then n = 0
   if n = 0 then
      msg = sysmsg(11218)
      return
   end
   screen get f, 'err' returning rn
   k2 = rn + 1
   if k2 > n then k2 = 1
   gosub select.row
   gosub act.error
   return

* The table's current row is k2, shown near the middle
select.row:
   call $sl_form('find', f, '', 'err', tn)
   tt = f{'widgets', tn}
   tt{'cur'} = k2
   tt{'value'} = k2
   tp = k2 - int((eh - 2) / 2)
   if tp < 1 then tp = 1
   tt{'top'} = tp
   gosub redraw
   return

* The table shows err.rows
err.load:
   call $sl_form('find', f, '', 'err', tn)
   tt = f{'widgets', tn}
   tt{'rows'} = err.rows
   tt{'top'} = 1
   tt{'cur'} = 1
   tt{'value'} = 1
   tt{'picked'} = ''
   call $sl_widget_init(tt)
   gosub redraw
   return

* ======================================================================
* Saving, closing, quitting

* Save the record in the editor
save.current:
   if nbuf = 0 then
      msg = sysmsg(11218)
      sv.ok = @false
      return
   end
   gosub stash.current
   sv.i = cb
   gosub save.one
   return

* edit.check  -  may this session save a change to the file in fv?  (17 Oct 26 dm, S.64)
*   IDE is $internal, so the kernel's own test of a WRITE to a VOC, a dictionary or a program file lets it through; it asks for itself,
*   by the pathname of the OPEN file (K$EDIT.OK).  The reason goes in msg, as every IDE complaint does (DISPLAY would write over the
*   screen).  Out: edit.ok.
edit.check:
   edit.ok = @true
   edit.p = fileinfo(fv, FL$PATH)
   if kernel(K$EDIT.OK, edit.p) then return
   edit.ok = @false
   edit.kind = kernel(K$EDIT.KIND, edit.p)
   msg = edit_msg(edit.kind) ;* 11405 VOC, 11406 dictionary, 11407 program file, 11513 shared record, 11514 shared structure
   return

* The text of a refusal, whole, in a box that stays until a key is pressed (the status line is one row and cuts it).  In: rf.text
refuse.box:
   rf.w = lw - 16
   if rf.w > 100 then rf.w = 100
   call $tk_wrap(rf.text, rf.w, rf.pieces)
   rf.body = change(rf.pieces, @fm, @vm)
   screen msgbox rf.body buttons '&OK' default 1 returning rf.b else rf.b = 0
   last.status = char(1)
   return

* In: sv.i.  Out: sv.ok.  An untitled buffer first asks for its file and record (ide_name); then the record is locked, read again, compared with what the
* buffer was read as, and written ON ERROR.  The lock is given back on every path.  28 Oct 26 (S.88 Phase 4, I6, D1): the write used to abort the IDE when the kernel refused it.
save.one:
   sv.ok = @false
   ro.i = sv.i
   gosub ro.check                    ;* 28 Oct 26 (stage B): a read-only tab (another session holds the record's lock) is not saved
   if not(ro.ok) then
      rf.text = msg
      gosub refuse.box
      return
   end
   if bi<sv.i> = '' then
      gosub name.untitled
      if not(sv.named) then return
   end
   u = bu<sv.i>
   k = 't' : u
   sv.text = bx{k}
   k = 's' : u
   sv.saved = bx{k}
   k = 'n' : u
   sv.new = bx{k}
   k = 'd' : u
   sv.dict = bx{k}
   k = 'k' : u
   sv.kind = bx{k}
   k = 'l' : u
   sv.slot = bx{k} + 0
   i = sv.i
   gosub buf.label
   sv.name = bf.name
   if not(sv.new) and (sv.text : '|') = (sv.saved : '|') then
      sv.ok = @true
      msg = sysmsg(11971)
      return
   end
   if sv.kind = 'path' then
      gosub save.path                   ;* 28 Oct 26 (stage E): an operating system file is read again and written in place, not written as a record
      return
   end
   * 28 Oct 26 (stage B): a tab that holds its record's lock saves through the file variable the lock was taken through: a READU through another one would move the
   *   lock to it (it is this session's), and the close of that one would then give it away.  The tab keeps the lock after the save (WRITEU).
   if sv.slot then
      fv = tfv(sv.slot)
   end else
      open sv.dict, bn<sv.i> to fv else
         msg = sysmsg(11200, sv.name)
         return
      end
   end
   gosub edit.check                  ;* 17 Oct 26 dm - S.64; the dictionary's own path for a dictionary item (dict.edit), the VOC's for a VOC record (voc.edit)
   if not(edit.ok) then
      rf.text = msg
      gosub refuse.box
      return
   end
   sv.id = bi<sv.i>
   readu disk from fv, sv.id locked
      msg = sysmsg(11973, sv.name, sv.id)
      return
   end then
      if sv.kind = 'dict' then
         dt.rec = disk
         gosub dict.trim                     ;* the tab holds the item without its compiled code: so is the disk record compared
         disk = dt.rec
      end
      if disk # sv.saved then
         screen msgbox sysmsg(11203, sv.name, sv.id) buttons 'Overwrite,Cancel' default 2 returning b else b = 0
         if b # 1 then
            if not(sv.slot) then release fv, sv.id
            return
         end
      end
   end else
      null
   end
   if sv.slot then
      writeu sv.text on fv, sv.id on error
         sv.err = status()
         msg = sysmsg(11972, sv.name, sv.id, sv.err)
         return
      end
   end else
      write sv.text on fv, sv.id on error
         sv.err = status()
         release fv, sv.id
         msg = sysmsg(11972, sv.name, sv.id, sv.err)
         return
      end
      release fv, sv.id
   end
   k = 's' : u
   bx{k} = sv.text
   k = 'n' : u
   bx{k} = 0
   sv.ok = @true
   ri = sv.i
   gosub rc.drop.tab                            ;* 28 Oct 26 (D2): the text is in the record now; its recovery copy goes
   msg = sysmsg(11202, sv.name, sv.id)
   if sv.new then
      rt.file = bn<sv.i>
      rt.dict = sv.dict
      gosub refresh.tree.for                   ;* the record is in the file now: the tree lists it
   end
   return

* In: sv.i, u, sv.text, sv.saved, sv.slot, sv.name (a tab of kind 'path' whose text has changed).  Out: sv.ok.  The kernel's gates were asked when the file was opened, through the
*   file variable the tab keeps, and are asked again by the write itself (a file opened read-only is not written: ro.check).  The file is read once more through that variable and
*   compared with what the tab read - the text, and whether its lines end with CR LF and whether the last one had its end - and a difference (or a file that is not text now) is the
*   overwrite question, as for a record.  Then !ide_osfile writes it IN PLACE: the same inode, owner, mode and links, no truncation until the new text is written.  If the write fails
*   the tab keeps its text and its old baseline, so the next save asks again, and the message says the file may be partly written.
save.path:
   sv.id = bi<sv.i>
   k = 'p' : u
   sv.pinfo = bx{k}
   if sv.slot = 0 then
      msg = sysmsg(11734, sv.id, 0)
      return
   end
   call !ide_osfile('reread', sv.id, tfv(sv.slot), sp.text, sp.info, sp.why)
   if sp.why = 'gone' then
      * 28 Oct 26 (review, finding 2a): another program removed the file or renamed another over it; the tab holds the old inode, and a write would "succeed" into a file nobody can reach
      rf.text = sysmsg(11742, sv.name, sv.id)
      msg = rf.text
      gosub refuse.box
      return
   end
   * the texts are compared as STRINGS ((x : '|') = (y : '|')): = and # compare two numbers as numbers, so "1.0" and "1" are the same to them (review, finding 6)
   sp.same = (sp.why = '')
   if sp.same then sp.same = ((sp.text : '|') = (sv.saved : '|') and sp.info<1> + 0 = sv.pinfo<1> + 0 and sp.info<2> + 0 = sv.pinfo<2> + 0)
   if not(sp.same) then
      screen msgbox sysmsg(11203, sv.name, sv.id) buttons 'Overwrite,Cancel' default 2 returning b else b = 0
      if b # 1 then return
   end
   sp.winfo = sv.pinfo
   sp.sent = sv.text
   call !ide_osfile('save', sv.id, tfv(sv.slot), sv.text, sp.winfo, sp.why)
   begin case
      case sp.why = ''
         * the helper gave SV.TEXT and SP.WINFO back as the next reread gives them (a text ending in an empty line is written with that line end, and reads back without the line)
         k = 's' : u
         bx{k} = sv.text
         k = 'p' : u
         bx{k} = (sp.winfo<1> + 0) : @fm : (sp.winfo<2> + 0)
         if (sv.text : '|') # (sp.sent : '|') then
            k = 't' : u
            bx{k} = sv.text
            if sv.i = cb then gosub load.current
         end
         sv.ok = @true
         msg = sysmsg(11202, sv.name, sv.id)
      case sp.why = 'ro'
         msg = sysmsg(11737, sv.name, sv.id)
      case sp.why = 'bytes' or sp.why = 'big'
         rf.text = sysmsg(11741, sv.name, sv.id)
         msg = rf.text
         gosub refuse.box
      case 1
         rf.text = sysmsg(11738, sv.name, sv.id, sp.winfo<6>)
         msg = rf.text
         gosub refuse.box
   end case
   return

* In: sv.i, an untitled buffer.  Out: sv.named.  The form asks for the file and the record; the buffer becomes that record (not yet on the disk: the save that follows writes it)
name.untitled:
   sv.named = @false
   nm.mode = 'save'
   nm.file = ''
   gosub default.file
   nm.file = df
   nm.id = ''
   call $ide_name(nm.mode, nm.file, nm.id, nm.res)
   last.status = char(1)
   if nm.res # 'ok' then return
   * 28 Oct 26 (stage B): a record another tab holds (a new one, not yet on the disk, which the form cannot see) is not named twice
   tf.dict = ''
   tf.file = nm.file
   tf.id = nm.id
   gosub tab.find
   if tf.p then
      msg = sysmsg(11691, nm.file, nm.id)            ;* %1 %2 is open in another tab of the IDE: save it there
      return
   end
   bn<sv.i> = nm.file
   bi<sv.i> = nm.id
   tu.i = sv.i
   gosub tab.lock                                   ;* the record is locked for its creation and the tab keeps the lock; its kind is the file's
   tm.u = bu<sv.i>
   k = 't' : tm.u
   tm.raw = bx{k}
   gosub set.token.mode
   gosub tab.named
   sv.named = @true
   return

* The tab sv.i has just been given a file and a record: its tab label, its syntax and the tree follow
tab.named:
   if sv.i = cb then
      gosub load.current
   end
   return

* In: rt.file.  If that file's records are listed in the tree they are read again (a record has just been made in it) and the tree is drawn
refresh.tree.for:
   rt.keep = i                                  ;* the callers may be in a loop on i (do.quit); tree.nodes uses it
   rt.d = rt.dict                               ;* 28 Oct 26 (stage B): 'DICT': the item was made in the file's dictionary (taken here, and put back to '')
   rt.dict = ''
   lp = 0
   if rt.d # '' then
      nl = dcount(dfiles, @fm)
      if dfiles = '' then nl = 0
      for q = 1 to nl
         if dfiles<q> = rt.file then
            lp = q
            exit
         end
      next q
   end else
      nl = dcount(lfiles, @fm)
      if lfiles = '' then nl = 0
      for q = 1 to nl
         if lfiles<q> = rt.file then
            lp = q
            exit
         end
      next q
   end
   if lp then
      if rt.d # '' then
         ld.name = rt.file
         gosub load.dict
      end else
         lf.name = rt.file
         gosub load.file
      end
      gosub tree.apply
      gosub redraw.tree
   end
   i = rt.keep
   return

* A new untitled buffer, in the editor.  The number is the buffer's own: "Untitled 1", "Untitled 2", and it is not used again
add.untitled:
   gosub stash.current
   untitled += 1
   nbuf += 1
   uid += 1
   bn<nbuf> = ''
   bi<nbuf> = ''
   bu<nbuf> = uid
   k = 's' : uid
   bx{k} = ''
   k = 't' : uid
   bx{k} = ''
   k = 'c' : uid
   bx{k} = ''
   k = 'm' : uid
   bx{k} = 0
   k = 'n' : uid
   bx{k} = 1                         ;* not on the disk
   k = 'u' : uid
   bx{k} = untitled
   gosub rc.init.tab
   ts.kind = 'source'                ;* 28 Oct 26 (stage B): a buffer with no record is text, and holds no lock
   ts.dict = ''
   ts.slot = 0
   ts.owner = ''
   gosub tab.state
   cb = nbuf
   return

* In: nm.file, nm.id.  A record that is not on the disk yet, in a tab of its own: nothing is written until it is saved.  Out: an.made.
* 28 Oct 26 (D2): a recovery copy kept for that record is offered first; Cancel makes no tab and keeps the copy (an.made is false).
add.new.record:
   an.made = @false
   rc.file = nm.file
   rc.id = nm.id
   rc.has.disk = @false
   rc.disk = ''
   gosub rc.offer
   if rc.choice = 'cancel' then return
   * 28 Oct 26 (stage B): the new record is locked for its creation, as SED locks it, and the tab keeps the lock
   lk.dict = ''
   lk.file = nm.file
   lk.id = nm.id
   gosub lock.take
   if lk.err # '' then
      msg = lk.err
      return
   end
   if lk.exists then
      gosub lock.free
      msg = sysmsg(11217, nm.id, nm.file)        ;* made by another session since the name form looked
      return
   end
   if lk.owner # '' then
      msg = sysmsg(11686, nm.file, nm.id, lk.owner)
      return
   end
   gosub stash.current
   gosub drop.clean.untitled
   nbuf += 1
   uid += 1
   bn<nbuf> = nm.file
   bi<nbuf> = nm.id
   bu<nbuf> = uid
   k = 's' : uid
   bx{k} = ''
   k = 't' : uid
   bx{k} = rc.text                   ;* '' unless the person took the copy
   k = 'c' : uid
   bx{k} = ''
   k = 'm' : uid
   bx{k} = 0
   k = 'n' : uid
   bx{k} = 1
   gosub rc.init.tab
   ts.kind = lk.kind
   ts.dict = ''
   ts.slot = lk.slot
   ts.owner = ''
   gosub tab.state
   tm.u = uid
   tm.raw = rc.text
   if rc.choice # 'use' then gosub set.token.mode     ;* the kind decides the token form (a copy taken sets it below)
   if rc.choice = 'use' then
      tm.u = uid
      tm.raw = rc.text
      gosub set.token.mode
      gosub rc.took
   end
   na.u = uid
   na.text = rc.text
   gosub na.mark                     ;* 28 Oct 26: a copy taken that holds bytes outside ASCII is read-only, as a record is
   cb = nbuf
   an.made = @true
   return

* The tab in the editor, when it is an untitled buffer nobody has typed in, is taken away (a record that is opened or made takes its place).
* 28 Oct 26 (TUI phase 2 review): a recovery copy the tab owns goes with it (the person emptied the buffer; with the switch off, or within the quiet second,
*   no tick had dropped it), so the next bare IDE does not offer text the person deleted
drop.clean.untitled:
   if nbuf > 0 and bi<cb> = '' then
      u = bu<cb>
      k = 't' : u
      if bx{k} = '' then
         ri = cb
         gosub rc.drop.tab
         del bn<cb>
         del bi<cb>
         del bu<cb>
         nbuf -= 1
         cb = nbuf
      end
   end
   return

* Out: df, the file a new record is offered in: the file of the record in the editor, else the file the tree is on, else bp ($acc and the other $ files are not record files)
default.file:
   df = ''
   if nbuf > 0 then df = bn<cb>
   if df = 'path:' then df = ''                         ;* 28 Oct 26 (stage E): the forms start from a file of records
   if df = '' then
      gosub get.context
      df = ctx.file
   end
   if df = '' or df[1, 1] = '$' then df = 'bp'
   return

close.current:
   if nbuf = 0 then return
   gosub stash.current
   i = cb
   gosub is.dirty
   if dirty then
      gosub buf.label
      screen msgbox sysmsg(11204, bf.name, bf.id) buttons 'Save,Discard,Cancel' default 1 returning b else b = 3
      begin case
         case b = 1
            sv.i = cb
            gosub save.one
            if not(sv.ok) then return
         case b = 2
            null
         case 1
            return
      end case
   end
   ri = cb
   gosub rc.drop.tab                             ;* 28 Oct 26 (D2): the person closed it (saved, or Discard): its recovery copy goes
   tu.i = cb
   gosub tab.unlock                              ;* 28 Oct 26 (stage B): and its record's lock
   del bn<cb>
   del bi<cb>
   del bu<cb>
   nbuf -= 1
   if cb > nbuf then cb = nbuf
   if cb < 1 then cb = 1
   if nbuf = 0 then gosub add.untitled           ;* the editor is never left without a buffer to type in
   gosub load.current
   return

* In: i.  Out: bf.name, bf.id: what to call buffer i to the person (file and record, or "Untitled n")
buf.label:
   bf.name = bn<i>
   bf.id = bi<i>
   k = 'd' : bu<i>
   if bx{k} # '' then bf.name = 'dict ' : bn<i>          ;* 28 Oct 26 (stage B)
   if bf.id = '' then
      k = 'u' : bu<i>
      bf.name = sysmsg(11963, bx{k})
   end
   return

do.quit:
   gosub stash.current
   abort = @false
   * qi is this loop's own: the routines a save reaches (tab.labels, tree.nodes, refresh.tree.for) all loop on i (review, 28 Oct 26: saving an untitled tab ended this loop early)
   for qi = 1 to nbuf
      i = qi
      gosub is.dirty
      if dirty then
         gosub buf.label
         screen msgbox sysmsg(11204, bf.name, bf.id) buttons 'Save,Discard,Cancel' default 1 returning b else b = 3
         begin case
            case b = 1
               sv.i = qi
               gosub save.one
               if not(sv.ok) then abort = @true
            case b = 2
               null
            case 1
               abort = @true
         end case
      end
   until abort
   next qi
   if not(abort) then
      for ri = 1 to nbuf
         gosub rc.drop.tab                       ;* 28 Oct 26 (D2): every buffer was saved or discarded by the person: no recovery copy is left
      next ri
      done = @true
   end else
      gosub load.current              ;* a buffer that was named by the loop has its new tab label
   end
   return

* ======================================================================
* Building

* In: c.opt ('' or ' debugging').  Out: c.ok, c.file, c.id; the table holds the compiler's lines
do.compile:
   c.ok = @false
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub path.not.for                   ;* 28 Oct 26 (stage E): an operating system file is not a program
   if pa.no then return
   * 28 Oct 26 (review of L2): the record is saved first only when there is something to save - a changed text, an untitled buffer or a record not on the disk yet.  A tab that
   *   is read-only (another session holds the record's lock, or it holds bytes 128 to 247) and unchanged is compiled, run, debugged and catalogued as it is on the disk;
   *   save.one refuses a read-only tab even when nothing needs saving.
   gosub stash.current
   i = cb
   gosub is.dirty
   k = 'n' : bu<cb>
   if dirty or bi<cb> = '' or bx{k} then
      gosub save.current
      if not(sv.ok) then return
   end
   c.file = bn<cb>
   c.id = bi<cb>
   k = 'k' : bu<cb>
   if bx{k} = 'dict' then
      msg = sysmsg(11697, c.file, c.id)          ;* 28 Oct 26 (stage B), as SED: a dictionary item is not a program (its I-type is compiled when it is used)
      return
   end
   qp.file = c.file ; qp.id = c.id ; gosub quote.pair
   execute 'basic ' : qp.f : ' ' : qp.i : c.opt capturing c.out
   c.ok = (@system.return.code # 0)
   err.rows = ''
   err.lines = ''
   nerr = 0
   loop
      z = remove(c.out, delim)
      begin case
         case z matches "1N...:..."
            ln = matchfield(z, '0N0X', 1) + 0
            tx = trimf(field(z, ':', 2, 999))
            nerr += 1
            err.rows<-1> = ln : @vm : tx
            err.lines<-1> = ln
         case z matches "'WARNING:'0X"
            nerr += 1
            err.rows<-1> = 0 : @vm : trimf(z)
            err.lines<-1> = 0
      end case
   while delim
   repeat
   out.kind = 'errors'
   out.file = c.file
   gosub err.load
   if c.ok then
      msg = sysmsg(11205, c.file, c.id)
   end else
      msg = sysmsg(11206, nerr, c.file, c.id)
      n = dcount(err.lines, @fm)
      for q = 1 to n
         if err.lines<q> + 0 > 0 then
            k2 = q
            gosub select.row
            gosub act.error
            exit
         end
      next q
   end
   return

* In: co, the words CATALOG printed for c.file c.id.  The IDE says "Catalogued" only if CATALOG said the program was added to a catalogue (local, global or private: messages
* 3029-3031); anything else (the account may not catalogue, a conflicting VOC entry, an object that is missing) is shown, whole, in a box.  28 Oct 26 (S.88 Phase 4, 4.9): it used to say
* "Catalogued" whatever the verb answered.
catalog.verified:
   cv.ok = @false
   for cv.m = 3029 to 3031
      if index(upcase(co), upcase(sysmsg(cv.m, c.id)), 1) then cv.ok = @true      ;* CATALOG prints the call name in lower case; the record id may not be
   next cv.m
   if cv.ok then
      msg = sysmsg(11207, c.file, c.id)
      return
   end
   cv.why = ''
   cv.n = dcount(co, @fm)
   for cv.j = 1 to cv.n
      cv.line = trim(convert(char(13) : char(10), '  ', co<cv.j>))
      if cv.line # '' then
         cv.why = cv.line
         exit
      end
   next cv.j
   if cv.why = '' then cv.why = '(no answer)'
   rf.text = sysmsg(11974, c.file, c.id, cv.why)
   msg = rf.text
   gosub refuse.box
   return

* The terminal goes back to the program being run, and comes back to the IDE after it
leave.screen:
   gosub rc.tick                         ;* 28 Oct 26 (D2): the program run may abort the session
   screen close
   call $tk_brk('close', saved.trap)     ;* 28 Oct 26: the program run has the person's break key, and nothing is held while it runs (CED and SED keep their own)
   display @(-1) :
   return

retake.screen:
   display sysmsg(11223)
   input junk
* Without the pause (SED handed the record back and has nothing left to be read): the same, straight on.
* 28 Oct 26: the setting is read again, as the person has it now ('close' above may have put back the one an earlier aborted app had held, which is the
*   person's own and not the one this program read at its start), and kept again by $tk_brk before the break key is turned off
retake.quiet:
   saved.trap = pterm(PT$BREAK, -1)
   call $tk_brk('save', saved.trap)
   void pterm(PT$BREAK, @false)
   break off
   gosub open.screen
   gosub apply.theme
   gosub relock.all                      ;* 28 Oct 26 (stage B): the locks a program run here let go are taken again (before the form: a tab may now be read-only)
   gosub new.form
   return

* ======================================================================
* Ctrl-E, File / Edit in SED: the record goes to SED and comes back (Part B of the 140x42 plan).  SED edits the record ON DISK, so a changed
* buffer is saved first (asked; Cancel leaves everything as it is).  SED ends its edit at its first successful save (it is told so by the
* named common /sedide/, see gpl.bp/sed), or the user leaves it without saving; the IDE then reads the record again (the disk is the truth),
* forgets the compile errors (they named lines of the old text), takes the screen back WITHOUT the "press Return" pause of Run, and says
* which it was.  SED makes ide.call 2 once the record is open for editing: if it is still 1 on the way back SED stopped on a message of its
* own (a record locked by another session, a refusal), and the IDE waits for a key so that the message can be read.
do.sed:
   common /sedide/ ide.call
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub path.not.for                   ;* 28 Oct 26 (stage E): SED opens records, and none of the operating system's files since S.87
   if pa.no then return
   k = 'n' : bu<cb>
   if bi<cb> = '' or bx{k} then
      gosub save.current                ;* an untitled buffer, or a new record not yet on the disk, has no record for SED to open: it is named and written first
      if not(sv.ok) then return
   end
   gosub stash.current
   i = cb
   gosub is.dirty
   if dirty then
      screen msgbox sysmsg(11603, bn<cb>, bi<cb>) buttons 'Save,Cancel' default 1 returning b else b = 2
      if b # 1 then return
      sv.i = cb
      gosub save.one
      if not(sv.ok) then return
   end
   sd.file = bn<cb>
   sd.id = bi<cb>
   sd.u = bu<cb>
   k = 's' : sd.u
   sd.was = bx{k}
   k = 'd' : sd.u
   sd.dict = bx{k}                       ;* 28 Oct 26 (stage B): a dictionary item goes to SED as DICT file item
   k = 'k' : sd.u
   sd.kind = bx{k}
   gosub leave.screen
   ide.call = 1
   qp.file = sd.file ; qp.id = sd.id ; gosub quote.pair
   if sd.dict # '' then qp.f = 'dict ' : qp.f
   * The tab keeps the record's lock while SED has it: SED's own READU in this session is granted, and moves the lock to SED's file; retake.quiet takes it back
   execute 'sed ' : qp.f : ' ' : qp.i trapping aborts
   sd.used = (ide.call = 2)
   ide.call = 0
   disk = sd.was
   open sd.dict, sd.file to fv then
      read disk from fv, sd.id else disk = sd.was
      if sd.kind = 'dict' then
         dt.rec = disk
         gosub dict.trim
         disk = dt.rec
      end
   end
   k = 's' : sd.u
   bx{k} = disk
   k = 't' : sd.u
   bx{k} = disk
   tm.u = sd.u
   tm.raw = disk
   gosub set.token.mode
   na.u = sd.u
   na.text = disk
   gosub na.mark                         ;* 28 Oct 26: the record as SED left it may hold bytes outside ASCII
   err.rows = ''
   err.lines = ''
   out.kind = ''
   if sd.used then gosub retake.quiet else gosub retake.screen
   if disk # sd.was then msg = sysmsg(11604, sd.file, sd.id) else msg = sysmsg(11605, sd.file, sd.id)
   return

* F12, Go / Edit as fields: the record in the tab goes to CED's data mode as an array of fields (each a string or a list of values, each of those a string or a
* list of subvalues: $recarr), so that nobody types a value or a subvalue mark.  CED is given no file and no record id, so it writes nothing and takes no lock; its
* Ctrl-S keeps the changes in the array.  What comes back replaces the text of the tab (the tab is then changed, as after any edit) and the IDE's own save
* writes it, with the S.64 gate and the overwrite question as for any other change.  Nothing is saved here, and if CED did not keep anything the tab is untouched.
do.fields:
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub path.not.for                   ;* 28 Oct 26 (stage E): the lines of a file are not fields and values
   if pa.no then return
   ro.i = cb
   gosub ro.check                       ;* 28 Oct 26 (stage B): the text of a read-only tab is not changed
   if not(ro.ok) then
      gosub ro.box                      ;* 28 Oct 26: bytes outside ASCII are refused in a box
      return
   end
   k = 'n' : bu<cb>
   if bi<cb> = '' or bx{k} then
      gosub save.current                ;* an untitled buffer, or a new record not yet on the disk, is named and written first
      if not(sv.ok) then return
   end
   gosub stash.current
   fd.u = bu<cb>
   fd.file = bn<cb>
   fd.id = bi<cb>
   k = 't' : fd.u
   fd.was = bx{k}
   call $recarr('to', fd.was, fd.arr, fd.ok)
   gosub leave.screen
   fd.res = ''
   call $cedit(fd.arr, '', '', 2, fd.file : ' ' : fd.id, fd.res)
   fd.new = fd.was
   if fd.res<1> then
      call $recarr('from', fd.arr, fd.text, fd.ok)
      if fd.ok then fd.new = fd.text
   end
   if fd.new # fd.was then
      k = 't' : fd.u
      bx{k} = fd.new
      k = 'c' : fd.u
      bx{k} = ''
      tm.u = fd.u
      tm.raw = fd.new
      gosub set.token.mode
      msg = sysmsg(11989, fd.file, fd.id)
   end else
      msg = sysmsg(11990, fd.file, fd.id)
   end
   gosub retake.quiet
   return

* The window changed size: the form is made again at the new size from the state
relayout:
   gosub stash.current
   screen clear
   gosub new.form
   return

* ======================================================================
* Records: a new one, and a search

* ======================================================================
* The AI (23 Oct 26, AI line stage 2).  $tk_ai does the asking: the preview of everything that will be sent (Send or Cancel, Cancel the default), the wait, the answer and, if the
* answer proposes edits, the diff in full with Accept and Reject (Reject the default).  This program supplies what it may be told and applies what is accepted to ITS OWN BUFFER, as
* one undo step; it saves nothing (Save is the person's act, through save.current and the kernel's edit gates as ever).

* Explain the compile message the table has selected (the table must hold a compile, not a search)
ai.error:
   if nbuf = 0 then
      msg = sysmsg(11662)
      return
   end
   if err.rows = '' or out.kind # 'errors' then
      msg = sysmsg(11663)
      return
   end
   screen get f, 'err' returning ai.rn
   ai.k = ai.rn + 0
   if ai.k < 1 or ai.k > dcount(err.rows, @fm) then
      msg = sysmsg(11663)
      return
   end
   ai.req = sysmsg(11656, err.rows<ai.k, 2>)
   ai.kind = 'error'
   ai.note = 'The compile message: ' : err.rows<ai.k, 2> : (if err.lines<ai.k> + 0 > 0 then ' (line ' : err.lines<ai.k> : ')' else '')
   gosub ai.go
   return

* Explain the text from the editor's mark to its cursor
ai.selection:
   if nbuf = 0 then
      msg = sysmsg(11662)
      return
   end
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   ai.my = mw{'my'} + 0
   ai.mx = mw{'mx'} + 0
   if ai.my < 1 or ai.mx < 1 then
      msg = sysmsg(11664)
      return
   end
   ai.cy = mw{'cy'} + 0
   ai.cx = mw{'cx'} + 0
   ai.lines = mw{'value'}
   call $tk_ai('select', ai.lines, ai.my : @vm : ai.mx : @vm : ai.cy : @vm : ai.cx, ai.selr)     ;* the text between the mark and the cursor (the library's, shared with SED)
   ai.sel = ai.selr<1>
   if ai.sel = '' then
      msg = sysmsg(11664)
      return
   end
   ai.req = sysmsg(11657)
   ai.kind = 'selection'
   ai.note = 'The selection runs from line ' : ai.selr<2> : ' to line ' : ai.selr<3>
   gosub ai.go
   return

* In: ai.req (the request), ai.kind, ai.note (a sentence about what is selected, or null), ai.sel (the selected text, or null).  The record in the editor, as far as it fits, is the text
ai.go:
   if nbuf = 0 then
      msg = sysmsg(11662)
      return
   end
   if trim(ai.req) = '' then return
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   ai.lines = mw{'value'}
   ai.cy = mw{'cy'} + 0
   ai.total = dcount(ai.lines, @fm)
   * the window: the whole record when it fits in 24000 bytes, else lines round the cursor (the library's, shared with the other editors)
   call $tk_ai('window', ai.lines, ai.cy, ai.wspec)
   ai.first = ai.wspec<1>
   ai.last = ai.wspec<2>
   ai.win = ai.wspec<4>
   page ='This is the IDE of SD Core, an editor for SD BASIC programs and other records.'
   if bi<cb> = '' then
      i = cb
      gosub buf.label
      page<1, -1> = 'An untitled buffer, ' : bf.name : ', not yet saved to a record.'
   end else
      if bn<cb> = 'path:' then
         page<1, -1> = 'It is the operating system file ' : bi<cb> : ', not a record.'      ;* 28 Oct 26 (stage E)
      end else
         page<1, -1> = 'File ' : bn<cb> : ', record ' : bi<cb> : '.'
      end
      k = 'd' : bu<cb>
      if bx{k} # '' then page<1, -1> = "It is an item of the file's dictionary."
   end
   page<1, -1> = 'The cursor is on line ' : ai.cy : ' of ' : ai.total : '.'
   if ai.note # '' then page<1, -1> = ai.note
   if ai.first > 1 or ai.last < ai.total then msg = sysmsg(11667, ai.first, ai.last - ai.first + 1)
   actx = 'IDE' : @fm : 'ide' : @fm : page : @fm : '' : @fm : 0 : @fm : ai.req : @fm : ystat : @fm : ai.win : @fm : ai.first : @fm : ai.sel : @fm : 'nocmd'
   ai.ctx = ''
   ai.ctx<TK.C.W> = lw
   res = ''
   call $tk_ai('ask', ai.ctx, actx, res)
   last.status = char(1)                                   ;* the wait wrote on the status row, and the preview over the form: both are drawn again
   if res<5> # '' then msg = res<5>
   if res<1> = 'edit' then gosub ai.apply
   if focus.id = 'ai' then
      screen set f, 'ai' value ''
   end
   ai.sel = ''
   ai.note = ''
   gosub redraw
   return

* The accepted edits (res<2>: position SM length SM new text, as values, positions in the window) go into the editor's buffer, as ONE undo step.  The buffer must still hold, at each
* place, exactly what the model was shown; if the person changed it while the AI was answering, nothing is applied.  Nothing is written to the disk.
ai.apply:
   ro.i = cb
   gosub ro.check                       ;* 28 Oct 26 (stage B): the text of a read-only tab is not changed
   if not(ro.ok) then
      gosub ro.box                      ;* 28 Oct 26: bytes outside ASCII are refused in a box
      return
   end
   call $sl_form('find', f, '', 'ed', en)
   mw = f{'widgets', en}
   ai.now = change(mw{'value'}, @fm, char(10))
   ai.wspec<5> = res<2>
   call $tk_ai('splice', ai.now, ai.wspec, ai.sp)          ;* the library checks that the buffer still holds, at each place, what the model was shown
   if ai.sp = '' then
      msg = sysmsg(11666)
      return
   end
   ai.new = ai.sp<1>
   ai.line1 = ai.sp<2>
   ai.n = ai.sp<3>
   * the old text and cursor go on the memo's own undo steps as one step, and redo is forgotten: the memo's 'snap' does it, in the memo's own form.  28 Oct 26 (TUI
   *   phase 2 review): this pushed the step in the memo's OLD form (the lines joined by value marks), which the memo now reads as legacy and turns every value
   *   mark back into a line end, so Ctrl-Z after an AI edit gave back a record whose values had become lines
   call $sl_memo('snap', mw, '', '', ai.sr)
   mw{'value'} = change(ai.new, char(10), @fm)
   mw{'lastop'} = ''
   mw{'cy'} = ai.line1
   mw{'cx'} = 1
   mw{'want'} = 1
   mw{'left'} = 1
   mw{'mx'} = 0
   mw{'my'} = 0
   ai.tp = ai.line1 - int(mh / 2)
   if ai.tp < 1 then ai.tp = 1
   mw{'top'} = ai.tp
   msg = sysmsg(11661, ai.n)
   return

* Out: ctx.file, the file the tree or the editor is on
get.context:
   ctx.file = ''
   if focus.id = 'tree' or nbuf = 0 then
      screen get f, 'tree' returning code
      if code[1, 2] = 'F:' or code[1, 2] = 'D:' then ctx.file = code[3, 99]
      if code[1, 2] = 'R:' or code[1, 2] = 'Q:' then ctx.file = field(code, ':', 2)
   end
   if ctx.file = '' and nbuf > 0 then ctx.file = bn<cb>
   if ctx.file = 'path:' then ctx.file = ''             ;* 28 Oct 26 (stage E): an operating system file is in no file of records
   return

* Ctrl-W, as SED's: the text in the editor is written to a record of the file under another name and the editor goes on
* with the record it had
do.writeas:
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub na.check                       ;* 28 Oct 26: not from a tab whose record holds bytes outside ASCII (a box)
   if not(na.ok) then return
   * 28 Oct 26 (stage E, review finding 4): Write a copy WORKS on an operating system file's tab - it puts the text in a RECORD and touches neither the file nor the tab - because it is the
   *   way out of a save that failed, was refused or found the file replaced, when the editor holds the only copy of the text (a record's tab keeps one in the record; this tab keeps none
   *   in a recovery copy)
   gosub stash.current
   u = bu<cb>
   k = 't' : u
   wa.text = bx{k}
   gosub default.file
   wa.file = df
   wa.id = ''
   call $ide_name('copy', wa.file, wa.id, wa.res)       ;* the form has asked the gate and whether the record exists
   last.status = char(1)
   if wa.res # 'ok' then return
   * 28 Oct 26 (stage B): a record open in a tab (a new one, not yet on the disk, which the form cannot see) is not written from another: its tab holds its lock
   tf.dict = ''
   tf.file = wa.file
   tf.id = wa.id
   gosub tab.find
   if tf.p then
      msg = sysmsg(11691, wa.file, wa.id)
      return
   end
   open wa.file to fv else
      msg = sysmsg(11200, wa.file)
      return
   end
   gosub edit.check                  ;* asked again at the write, as save.one does: the form's answer is not the gate
   if not(edit.ok) then
      rf.text = msg
      gosub refuse.box
      return
   end
   * under the record's lock, and looked at again: a record another session made since the form asked is not overwritten (Opus's review, 28 Oct 26)
   readu x from fv, wa.id locked
      msg = sysmsg(11973, wa.file, wa.id)
      return
   end then
      release fv, wa.id
      msg = sysmsg(11217, wa.id, wa.file)
      return
   end else
      null
   end
   write wa.text on fv, wa.id on error
      wa.err = status()
      release fv, wa.id
      msg = sysmsg(11972, wa.file, wa.id, wa.err)
      return
   end
   release fv, wa.id
   rt.file = wa.file
   gosub refresh.tree.for
   msg = sysmsg(11202, wa.file, wa.id)
   return

* Ctrl-O, File / Open record: the form asks for a file and a record that exists (the picker of the plan's 5.11 C will take its place), and the record opens in a tab
do.open:
   gosub default.file
   op.file = df
   op.id = ''
   call $ide_name('open', op.file, op.id, op.res)
   last.status = char(1)
   if op.res # 'ok' then return
   if op.file = 'path:' then
      op.path = op.id                           ;* 28 Oct 26 (stage E): an operating system file: the form returns the name as it was typed
      gosub open.path
      if nbuf > 0 then
         ft.id = 'ed'
         gosub focus.to
      end
      return
   end
   or.file = op.file
   or.id = op.id
   cur.code = 'R:' : or.file : ':' : or.id
   gosub open.record
   if nbuf > 0 then
      ft.id = 'ed'
      gosub focus.to
   end
   return

* Save as: the form names the file and the record, the tab becomes that record, and it is saved.  The record the tab had is as it was on the disk.
do.saveas:
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   gosub na.check                       ;* 28 Oct 26: not from a tab whose record holds bytes outside ASCII (a box)
   if not(na.ok) then return
   gosub path.not.for                   ;* 28 Oct 26 (stage E): Save as would make the tab another record; Write a copy keeps the text
   if pa.no then return
   gosub stash.current
   gosub default.file
   sa.file = df
   sa.id = ''
   call $ide_name('saveas', sa.file, sa.id, sa.res)
   last.status = char(1)
   if sa.res # 'ok' then return
   tf.dict = ''
   tf.file = sa.file
   tf.id = sa.id
   gosub tab.find
   if tf.p then
      msg = sysmsg(11691, sa.file, sa.id)                 ;* 28 Oct 26 (stage B): another tab holds that record
      return
   end
   * 28 Oct 26 (stage B): the tab lets go of the record it had (that record is as it was on the disk) and takes the lock of the one it becomes; a read-only tab
   *   becomes an ordinary one (the lock it could not have was the old record's).  The form names a file of records: the new record is in its data part.
   tu.i = cb
   gosub tab.unlock
   u = bu<cb>
   k = 'o' : u
   bx{k} = ''
   k = 'd' : u
   bx{k} = ''
   bn<cb> = sa.file
   bi<cb> = sa.id
   k = 's' : u
   bx{k} = ''
   k = 'n' : u
   bx{k} = 1                                            ;* the record is not on the disk until the save below has written it
   gosub tab.lock
   tm.u = u
   k = 't' : u
   tm.raw = bx{k}
   gosub set.token.mode
   sv.i = cb
   gosub tab.named
   gosub save.one
   return

* Ctrl-R, as SED's: a text is replaced by another all through the record in the editor (what undo remembered is lost:
* the text area is given the new text)
do.replace:
   if nbuf = 0 then
      msg = sysmsg(11218)
      return
   end
   ro.i = cb
   gosub ro.check                       ;* 28 Oct 26 (stage B): the text of a read-only tab is not changed
   if not(ro.ok) then
      gosub ro.box                      ;* 28 Oct 26: bytes outside ASCII are refused in a box
      return
   end
   screen ask sysmsg(11232) returning rp.old else return
   if rp.old = '' then return
   screen ask sysmsg(11233) returning rp.new else return
   gosub stash.current
   u = bu<cb>
   k = 't' : u
   rp.text = bx{k}
   rp.n = count(rp.text, rp.old)
   if rp.n = 0 then
      msg = sysmsg(11234, 0)
      return
   end
   bx{k} = change(rp.text, rp.old, rp.new)
   gosub load.current
   msg = sysmsg(11234, rp.n)
   return

* New record (File menu, Ctrl-N): the form names the file and the record (it has asked the account's gate and whether the record exists), and a buffer for it
* opens in a tab of its own.  Nothing is written until it is saved (28 Oct 26, S.88 Phase 4, I1, N3).
do.new:
   gosub default.file
   nm.file = df
   nm.id = ''
   call $ide_name('new', nm.file, nm.id, nm.res)
   last.status = char(1)
   if nm.res # 'ok' then return
   * 28 Oct 26 (stage B): CREATING.SEQKEY as the name, as SED takes it: the file's next sequential id; in quotes it is a record of that name
   if upcase(nm.id) = 'CREATING.SEQKEY' then
      sq.dict = ''
      sq.file = nm.file
      gosub seq.take
      if sq.id = '' then return
      nm.id = sq.id
   end else
      if upcase(nm.id) = '"CREATING.SEQKEY"' or upcase(nm.id) = "'CREATING.SEQKEY'" then nm.id = nm.id[2, len(nm.id) - 2]
   end
   tf.dict = ''
   tf.file = nm.file
   tf.id = nm.id
   gosub tab.find
   if tf.p then
      msg = sysmsg(11691, nm.file, nm.id)                 ;* a new record of that name is already open in a tab
      return
   end
   gosub add.new.record
   if not(an.made) then return               ;* 28 Oct 26 (D2): Cancel at the recovery copy's question
   gosub load.current
   ft.id = 'ed'
   gosub focus.to
   gosub redraw.tabs
   return

do.find:
   gosub get.context
   if ctx.file = '' then
      msg = sysmsg(11212)
      return
   end
   screen ask sysmsg(11210, ctx.file) returning pat else return
   if pat = '' then return
   open ctx.file to fv else
      msg = sysmsg(11200, ctx.file)
      return
   end
   if fileinfo(fv, FL$COLLECTION) then
      msg = sysmsg(11698, ctx.file)              ;* 28 Oct 26 (stage B): a collection's records are not text; a plain READ of one would stop the IDE
      return
   end
   * 28 Oct 26 (stage B): the records are read as the tree lists them, at most MAXREC, without sorting the whole file first
   gosub list.ids
   ids = convert(@vm, @fm, lr.ids)
   n = lr.n
   if ids = '' then n = 0
   upat = upcase(pat)
   hits = 0
   err.rows = ''
   err.lines = ''
   sid = ''
   sln = ''
   for i = 1 to n
      read r from fv, ids<i> then
         nl = dcount(r, @fm)
         for j = 1 to nl
            if index(upcase(r<j>), upat, 1) then
               hits += 1
               err.rows<-1> = j : @vm : ids<i> : ': ' : trim(r<j>)
               err.lines<-1> = j
               sid<-1> = ids<i>
               sln<-1> = j
            end
         until hits >= MAXHIT
         next j
      end
   until hits >= MAXHIT
   next i
   out.kind = 'search'
   out.file = ctx.file
   out.dict = ''
   gosub err.load
   msg = sysmsg(11211, hits, ctx.file)
   if lr.more then msg := '  ' : sysmsg(11219, MAXREC, ctx.file)
   return

* END-CODE
