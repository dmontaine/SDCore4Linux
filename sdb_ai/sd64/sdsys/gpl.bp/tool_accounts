* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 25 Oct 26 dm  New.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   TOOL.ACCOUNTS      (SDSYS's VOC only; the audience is the administrator, asked of the kernel before anything is read)
*
*   A full-screen page, in the toolkit's frame (140 columns by 43 lines at least).  The top box counts the accounts (users, groups, others), the suspended ones and the sessions signed on.
*   The list is every registered account but SDSYS: its name, its kind, whether it is suspended, the gates that are ON for it (read as TOOL.GATES reads them: the register and the Linux
*   groups, through $tk_gates) and how many sessions are signed on in it.  The box at the foot shows the account under the cursor as !acc_os_info reports it (the Linux user and group, the
*   routes, a group account's members), the gates that are on, and who is signed on in it.  The gate switches themselves are TOOL.GATES's; this page is the account.
*
*   WHAT IT RUNS.  Each through a box that shows the command and what it does, answered Run or Cancel (Cancel is what Enter chooses); the verbs ask for the administrator again and write
*   their own audit lines:
*     S   MODIFY.ACCOUNT name SUSPENDED or UNSUSPENDED    (whichever the account is not; a suspended account is refused at sign-on, by ssh and by the API; nothing changes in Linux)
*     A   MODIFY.ACCOUNT group ADD user                    (a group account only: a Linux user joins its group; a question asks for the user)
*     R   MODIFY.ACCOUNT group DELETE user                 (the same, taking one away)
*     C   CREATE.ACCOUNT GROUP name NO.QUERY, CREATE.ACCOUNT OTHER name path NO.QUERY, and CREATE.ACCOUNT USER name {SSH|API|BOTH|NONE}, for which THE TERMINAL IS GIVEN TO THE VERB, because it
*         asks for the new person's password at a prompt of its own that shows nothing; nothing typed there passes through this page, and you come back to the page when it ends
*     X   DELETE.ACCOUNT name {REMOVE.HOME}, after the account's name is typed; the terminal is given to the verb for its own question (it has no NO.QUERY and never goes down a pipe)
*   A new account has every gate OFF as the verb makes it; turning one on is TOOL.GATES's.  SDSYS cannot be changed here.
*
*   Keys: Up, Down, PgUp, PgDn, Home, End; S, A, R, C, X as above; F5 reads again; F1 or ? or a click on the [?] explains the page; Ctrl-Q leaves.  A click on a row puts the cursor there.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_accounts
$catalog $tool_accounts

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'modify.account create.account'                      ;* the commands this page may run through the routines (delete.account and create.account user are run by the verb on the terminal)
   call $tk_open('tool.accounts', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.accounts')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'c', 'create', 'create', '', 1)
   call $tk_keys('add', keys, 's', 'suspend', 'suspend', '', 1)
   call $tk_keys('add', keys, 'a', 'add person', 'addperson', '', 1)
   call $tk_keys('add', keys, 'r', 'take away', 'delperson', '', 1)
   call $tk_keys('add', keys, 'x', 'delete', 'delete', '', 1)
   call $tk_keys('add', keys, 'f5', 'read', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)

   VA = 17                                                      ;* account rows on the screen
   ha = '  ' : fmt('Account', '20L') : fmt('Kind', '7L') : fmt('State', '11L') : fmt('Gates that are on', '41L') : fmt('Signed on', '10L') : 'Description'

   an = 0 ; anm = '' ; akind = '' ; asusp = '' ; agates = '' ; asess = '' ; adesc = ''
   nusers = 0 ; ngroups = 0 ; nothers = 0 ; nsusp = 0 ; nsess = 0
   udata = ''
   ci = 1 ; ta = 0
   gen = 0
   done = 0
   msg = 'C creates an account, S suspends or lifts, A and R change the people of a group account, X deletes an account'

   gosub read.all
   gosub draw.all

   loop
      call $tk_frame(ctx, keys, 'Accounts', msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key returning nm
      begin case
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the machine says

* Every registered account but SDSYS in name order, each with its kind, its suspension, the gates that are on, its description and the sessions signed on in it; the cursor goes back to its account
read.all:
   sel.a = ''
   if an > 0 and ci >= 1 and ci <= an then sel.a = anm<ci>
   names = ''
   openpath @sdsys : @ds : 'accounts' to acc.f then
      select acc.f to 9
      loop
         readnext id from 9 else exit
         if id # 'sdsys' then
            locate id in names<1> by 'AL' setting lp else
               ins id before names<lp>
            end
         end
      repeat
      close acc.f
   end
   call !listu(udata)
   nsess = dcount(udata, @fm)
   an = 0 ; anm = '' ; akind = '' ; asusp = '' ; agates = '' ; asess = '' ; adesc = ''
   nusers = 0 ; ngroups = 0 ; nothers = 0 ; nsusp = 0
   have.reg = 0
   openpath @sdsys : @ds : 'accounts' to acc.f then have.reg = 1
   for i = 1 to dcount(names, @fm)
      call $tk_gates(names<i>, g, ainfo, gerr)
      if gerr = '' then
         an += 1
         anm<an> = names<i>
         akind<an> = ainfo<1>
         asusp<an> = ainfo<2>
         on.list = ''
         for j = 1 to dcount(g, @fm)
            if g<j, 2> = 1 then on.list := (if on.list = '' then '' else ' ') : g<j, 1>
         next j
         agates<an> = on.list
         adesc<an> = ''
         if have.reg then
            read arec from acc.f, names<i> then adesc<an> = arec<ACC$DESCR>
         end
         ns = 0
         for k = 1 to nsess
            if udata<k, 9> = names<i> then ns += 1
         next k
         asess<an> = ns
         begin case
            case ainfo<1> = 'USER'
               nusers += 1
            case ainfo<1> = 'GROUP'
               ngroups += 1
            case 1
               nothers += 1
         end case
         if ainfo<2> = 1 then nsusp += 1
      end
   next i
   if have.reg then close acc.f
   if ci > an then ci = an
   if ci < 1 then ci = 1
   if sel.a # '' then
      for i = 1 to an
         if anm<i> = sel.a then
            ci = i
            exit
         end
      next i
   end
   return

* ------------------------------------------------------------------------------------------------- drawing

draw.all:
   cw2 = ctx<TK.C.W>
   chh = ctx<TK.C.H> - 5
   screen clear at 0,1 size cw2,chh
   screen box at 1,1 size 138,6 title 'Accounts'
   screen box at 1,7 size 138,20 title 'Every account'
   screen box at 1,27 size 138,13 title 'The account under the cursor'
   gosub draw.top
   gosub redraw
   return

draw.top:
   s = an : ' account' : (if an = 1 then '' else 's') : ': ' : nusers : ' user, ' : ngroups : ' group, ' : nothers : ' other.   Suspended: ' : nsusp : '.   Sessions signed on now: ' : nsess : '.'
   screen text s[1, 128] at 3,2 attr 'bold' width 128
   screen text 'SDSYS, the administrator, is not listed and cannot be changed here. The gate switches are TOOL.GATES; a new account has every gate off.' at 3,3 width 134
   screen text 'C creates an account.  X deletes one (its name is typed first).  S suspends the account under the cursor or lifts the suspension.' at 3,4 width 134
   screen text 'A adds a person to a group account and R takes one away.  F5 reads again.' at 3,5 width 134
   call $tk_help('mark', 134, 2, 0, 0)
   return

redraw:
   gosub draw.list
   gosub draw.detail
   return

draw.list:
   screen text ha at 3,8 attr 'header' width 134
   if ci <= ta then ta = ci - 1
   if ci > ta + VA then ta = ci - VA
   if ta < 0 then ta = 0
   for r = 1 to VA
      kk = ta + r
      s = ''
      if kk <= an then
         st.t = (if asusp<kk> = 1 then 'SUSPENDED' else 'active')
         gtxt = agates<kk>
         if gtxt = '' then gtxt = '(none)'
         s = (if asusp<kk> = 1 then '* ' else '  ') : fmt(anm<kk>[1, 19], '20L') : fmt(downcase(akind<kk>), '7L') : fmt(st.t, '11L') : fmt(gtxt[1, 40], '41L') : fmt(asess<kk>, '10L') : adesc<kk>
      end
      rat = 'normal'
      if kk = ci and kk <= an then rat = 'highlight'
      screen text s[1, 134] at 3,8 + r attr rat width 134
   next r
   return

* The account under the cursor: what !acc_os_info says of it, the gates that are on, and who is signed on in it
draw.detail:
   for r = 1 to 11
      screen text '' at 3,27 + r width 134
   next r
   if an = 0 or ci < 1 or ci > an then
      screen text 'There is no account to show.' at 3,28 width 134
      return
   end
   nme = anm<ci>
   lines = ''
   openpath @sdsys : @ds : 'accounts' to acc.f then
      read arec from acc.f, nme then
         call !acc_os_info(nme, arec, info, ierr)
         lines<-1> = nme : '   ' : downcase(akind<ci>) : (if asusp<ci> = 1 then '   SUSPENDED' else '   active') : '   path: ' : arec<ACC$PATH>
         if ierr # '' then
            lines<-1> = 'The account facts could not be read.'
         end else
            ln.s = ''
            for k = 1 to dcount(info, @fm)
               ln.s := (if ln.s = '' then '' else '   ') : info<k>
            next k
            call $tk_wrap(ln.s, 134, pieces)
            lines<-1> = pieces
         end
      end
      close acc.f
   end
   gtxt = agates<ci>
   lines<-1> = 'Gates that are on: ' : (if gtxt = '' then '(none)' else gtxt)
   sn = ''
   for k = 1 to nsess
      if udata<k, 9> = nme then sn := (if sn = '' then '' else ', ') : 'user ' : udata<k, 1> : ' (' : udata<k, 6> : ')'
   next k
   lines<-1> = 'Signed on in it: ' : (if sn = '' then 'nobody' else sn)
   for r = 1 to dcount(lines, @fm)
      if r <= 11 then
         lr = lines<r>
         screen text lr[1, 134] at 3,27 + r width 134
      end
   next r
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 and nm >= 'A' and nm <= 'Z' then nm = downcase(nm)
   begin case
      case nm = 'up'
         if ci > 1 then ci -= 1
         gosub redraw
      case nm = 'down'
         if ci < an then ci += 1
         gosub redraw
      case nm = 'pgup'
         ci -= VA
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'pgdn'
         ci += VA
         if ci > an then ci = an
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'home'
         ci = 1
         gosub redraw
      case nm = 'end'
         ci = an
         if ci < 1 then ci = 1
         gosub redraw
      case nm = 'c'
         gosub do.create
      case nm = 's'
         gosub do.suspend
      case nm = 'a'
         sub.word = 'add'
         gosub do.person
      case nm = 'r'
         sub.word = 'delete'
         gosub do.person
      case nm = 'x'
         gosub do.delete
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read again'
      case nm = 'f1' or nm = '?'
         call $tk_help('box', 'tool.accounts.page', hm, 0, 0)
         if hm # '' then msg = hm
      case nm = 'ctrl-q'
         done = 1
   end case
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   call $tk_help('hit', mev, 134, 2, hit.m)
   if hit.m then
      call $tk_help('box', 'tool.accounts.page', hm, 0, 0)
      if hm # '' then msg = hm
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      if mx >= 3 and mx <= 136 and my >= 9 and my <= 8 + VA then
         if ta + my - 8 <= an then
            ci = ta + my - 8
            gosub redraw
         end
      end
   end
   return

* ------------------------------------------------------------------------------------------------- the commands

* Is word a safe single word for the routines (a-z, 0-9, dot, dash, underscore, 1 to 32 characters)?  plain is 1 or 0
plain.word:
   plain = (word # '' and len(word) <= 32)
   for pi = 1 to len(word)
      if index('abcdefghijklmnopqrstuvwxyz0123456789.-_', word[pi, 1], 1) = 0 then plain = 0
   next pi
   return

* sent and el are the sentence and its explanation, typed is null or the word to type; the box is shown, the command run when Run was chosen through $tk_run, everything read again and the verb's words shown
confirm.and.run:
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      if use.x then
         call $tk_runx(allow, sent, out, stat, err)
      end else
         call $tk_run(allow, sent, out, stat, err)
      end
      gosub read.all
      gosub draw.all
      if err # '' then
         msg = err
      end else
         msg = sent[1, 60] : ' ran (status ' : stat : ')'
         lastl = ''
         for k = 1 to dcount(out, @fm)
            if trim(out<k>) # '' then lastl = trim(out<k>)
         next k
         if lastl # '' then msg = msg : ': ' : lastl
      end
   end else
      msg = cmsg
   end
   return

* The same box, but when Run is chosen the TERMINAL is given to the verb (it asks its own questions, one of them for a password that is not shown), and the page is taken again afterwards
confirm.and.hand.over:
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res # 'run' then
      msg = cmsg
      return
   end
   call $tk_close(ctx)
   execute sent
   crt
   crt sysmsg(11865) :                                         ;* Press Enter to return
   input junk
   if junk = char(1) then null                                 ;* any answer goes back; the answer itself is not used
   call $tk_open('tool.accounts', 'admin', ctx, err)
   if err # '' then
      display err
      done = 1
      return
   end
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub read.all
   gosub draw.all
   msg = 'back from ' : sent[1, 40] : ': the list shows what is registered now'
   return

do.suspend:
   if an = 0 or ci < 1 or ci > an then
      msg = 'there is no account'
      return
   end
   word = anm<ci>
   gosub plain.word
   if not(plain) then
      msg = 'this account name has characters this page will not put in a command; use modify.account at the prompt'
      return
   end
   use.x = 0
   typed = ''
   el = ''
   if asusp<ci> = 1 then
      sent = 'modify.account ' : anm<ci> : ' unsuspended'
      el<-1> = 'The suspension of ' : anm<ci> : ' is lifted: the account can be signed on to again, by the console, ssh and the API. Nothing changes in Linux.'
   end else
      sent = 'modify.account ' : anm<ci> : ' suspended'
      el<-1> = anm<ci> : ' is suspended: LOGIN, ssh and the API refuse it from now on. Sessions already signed on in it keep running until they end. Nothing changes in Linux, so lifting it later costs nothing.'
   end
   gosub confirm.and.run
   return

* sub.word is add or delete: a Linux user joins or leaves the group of the group account under the cursor
do.person:
   if an = 0 or ci < 1 or ci > an then
      msg = 'there is no account'
      return
   end
   if akind<ci> # 'GROUP' then
      msg = anm<ci> : ' is not a group account: only a group account has people to add or take away'
      return
   end
   word = anm<ci>
   gosub plain.word
   if not(plain) then
      msg = 'this account name has characters this page will not put in a command; use modify.account at the prompt'
      return
   end
   screen ask 'Linux user to ' : (if sub.word = 'add' then 'add to ' else 'take away from ') : anm<ci> : ' (a-z, 0-9, dot, dash and underscore)' width 40 value '' title 'People of a group account' returning pu else return
   word = trim(pu)
   gosub plain.word
   if not(plain) then
      msg = 'a user name has only a-z, 0-9, dot, dash and underscore, up to 32 characters'
      return
   end
   use.x = 0
   typed = ''
   sent = 'modify.account ' : anm<ci> : ' ' : sub.word : ' ' : word
   el = ''
   if sub.word = 'add' then
      el<-1> = word : ' joins the Linux group of ' : anm<ci> : ' and can then enter the account. The group is changed through the root helper, as the verb always does it.'
   end else
      el<-1> = word : ' leaves the Linux group of ' : anm<ci> : ' and can no longer enter the account. Taking access away is always allowed.'
   end
   gosub confirm.and.run
   return

* C: the kind, the name, then what that kind needs; a USER account is made with the terminal given to the verb (its password prompt)
do.create:
   screen ask 'Kind of account: user, group or other' width 10 value 'user' title 'Create an account  1 of 3' returning kd else return
   kd = downcase(trim(kd))
   if kd # 'user' and kd # 'group' and kd # 'other' then
      msg = 'the kind is user, group or other'
      return
   end
   screen ask 'Name of the new account (a-z, 0-9, dot, dash and underscore)' width 34 value '' title 'Create an account  2 of 3' returning nn else return
   word = trim(nn)
   gosub plain.word
   if not(plain) then
      msg = 'an account name has only a-z, 0-9, dot, dash and underscore, up to 32 characters'
      return
   end
   locate word in anm<1> setting px else px = 0
   if px > 0 or word = 'sdsys' then
      msg = word : ' is already an account'
      return
   end
   nn = word
   use.x = 0
   begin case
      case kd = 'user'
         screen ask 'Remote doors for the new person: none, ssh, api or both' width 10 value 'none' title 'Create an account  3 of 3' returning rt else return
         rt = downcase(trim(rt))
         if index(' none ssh api both ', ' ' : rt : ' ', 1) = 0 then
            msg = 'the doors are none, ssh, api or both'
            return
         end
         sent = 'create.account user ' : nn : ' ' : rt
         typed = ''
         el = ''
         el<-1> = 'A Linux user ' : nn : ' and the SD account are made, with every gate OFF. The terminal is given to the verb, which asks for the password of the new person (nothing is shown) and for your OK.'
         el<-1> = 'Turning a gate on afterwards is TOOL.GATES. You come back to this page when the verb ends.'
         gosub confirm.and.hand.over
      case kd = 'group'
         sent = 'create.account group ' : nn : ' no.query'
         typed = ''
         el = ''
         el<-1> = 'A group account ' : nn : ' is made: a Linux group for its people and a directory for its files, with no Linux user of its own, so it can have no remote door and no gate that reaches the operating system.'
         el<-1> = 'People are added to it afterwards with A.'
         gosub confirm.and.run
      case 1
         screen ask 'Directory of the account: an absolute path that exists' width 100 value '' title 'Create an account  3 of 3' returning pth else return
         pth = trim(pth)
         if pth[1, 1] # '/' or index(pth, ' ', 1) > 0 or len(pth) > 200 then
            msg = 'give an absolute path with no space in it'
            return
         end
         use.x = 1
         sent = 'create.account other ' : nn : ' ' : pth : ' no.query'
         typed = ''
         el = ''
         el<-1> = 'An account ' : nn : ' is made over the directory ' : pth : ', which is not changed. It has no Linux user and no Linux group of its own.'
         gosub confirm.and.run
         use.x = 0
   end case
   return

* X: the account's name is typed, then the terminal is given to DELETE.ACCOUNT for its own question; REMOVE.HOME is asked for a user account
do.delete:
   if an = 0 or ci < 1 or ci > an then
      msg = 'there is no account'
      return
   end
   word = anm<ci>
   gosub plain.word
   if not(plain) then
      msg = 'this account name has characters this page will not put in a command; use delete.account at the prompt'
      return
   end
   sent = 'delete.account ' : anm<ci>
   rh = 0
   if akind<ci> = 'USER' then
      screen ask "Also remove the home directory of the Linux user? (y or n; n keeps the person's own files and ssh keys)" width 4 value 'n' title 'Delete a user account' returning rh.a else return
      if downcase(trim(rh.a)) = 'y' then
         rh = 1
         sent := ' remove.home'
      end
   end
   typed = anm<ci>
   el = ''
   el<-1> = 'DELETE ' : anm<ci> : ': its directory, its Linux group and its register record are removed' : (if akind<ci> = 'USER' then ', and the Linux user too when SD made it (one SD did not make is left in place and the verb says so)' else '') : '.'
   if rh then el<-1> = 'Its home directory is removed too (only when it is exactly the home of the user SD made).'
   el<-1> = 'There is no taking this back. The terminal is given to the verb, which asks once to confirm; then you come back to this page.'
   gosub confirm.and.hand.over
   return

end

* END-CODE
