$internal
$no.symbols
$no.xref
function py_listcreate(listname)
$catalog !py_listcreate

$include keys.h
$include err.h

* Reject empty Python object name(s) before SDPYOBJ/SDEXT call, as the
* other PY_* programs do.
if listname = '' then
   set.status 1
   return 1
end
* --------------------
rtn_status = SDPYOBJ("","",listname,SD_PyListCrte)
*
return rtn_status

end
