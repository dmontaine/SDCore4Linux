* 23 Oct 26 dm  New (S.75; the owner: "in the shared account directory should be the documentation PDF's").
* END-HISTORY
*
* START-DESCRIPTION:
*
*   DOCS.INSTALL directory
*
*   The administrator's verb.  The PDFs are generated from the documentation repository and are not part of the source tree (no binary is tracked), so they arrive in the
*   shared account's pdf directory by this verb, from a directory the administrator names: the pdf directories of a documentation checkout, or a release's bundle unpacked.
*   Each file of the directory (not its sub-directories) is copied if its name is lower case, a-z 0-9 dot dash underscore, ends in .pdf and does not begin with a dot, and the file
*   starts with %PDF- ; anything else is skipped and named.  A file already there is replaced.  The copies are mode 0644.  The directory must be a plain absolute path of letters,
*   digits and / . _ - (it goes to cp in quotes).  The pdf directory is made by the installer (owner sdsys, group sdusers, mode 755: no SD user can add a document), never by this verb.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program docs.install
$catalog $docsinst

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001) ;* Command requires administrator privileges
   end

   words = trim(@sentence)
   if dcount(words, ' ') # 2 then stop sysmsg(11720)             ;* docs.install directory
   src = field(words, ' ', 2)
   okc = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/._-'
   if src[1, 1] # @ds or len(src) > 200 or trim(convert(okc, space(len(okc)), src)) # '' or index(src, '..', 1) > 0 then
      stop sysmsg(11721, src[1, 60])                             ;* The directory %1 cannot be read or is not a plain path
   end
   entries = dir(src)
   if entries = '' then stop sysmsg(11721, src[1, 60])

   openpath @sdsys : @ds : 'accounts' to acc.f else stop sysmsg(11724)
   read arec from acc.f, 'shared' else arec = ''
   close acc.f
   spath = arec<ACC$PATH>
   if spath[1, 1] # @ds or len(spath) < 2 or trim(convert(okc, space(len(okc)), spath)) # '' then stop sysmsg(11724)
   dest = spath : @ds : 'pdf'
   if dir(dest) = '' and status() # 0 then stop sysmsg(11724)    ;* the installer makes the directory; this verb does not

   n.copied = 0
   n.skipped = 0
   for i = 1 to dcount(entries, @fm)
      nm = entries<i, 1>
      if entries<i, 2> # 'F' then continue
      if nm[len(nm) - 3, 4] # '.pdf' then continue
      gosub copy.one
   next i

   void kernel(K$AUDIT, 'docs.install copied=' : n.copied : ' skipped=' : n.skipped)
   @system.return.code = (if n.skipped then -ER$FAILED else 0)
   display sysmsg(11722, n.copied, n.skipped)                    ;* Copied %1 document(s) into the shared account; skipped %2
   stop

copy.one:
   ok = (len(nm) >= 5 and len(nm) <= 84 and nm[1, 1] # '.' and nm = downcase(nm))
   if ok then
      if trim(convert('abcdefghijklmnopqrstuvwxyz0123456789._-', space(39), nm)) # '' then ok = 0
   end
   if not(ok) then
      display sysmsg(11723, nm[1, 60], 'the name is not lower case letters, digits and . _ -')
      n.skipped += 1
      return
   end
   magic = ''
   openseq src : @ds : nm readonly to pf then
      readseq magic from pf else magic = ''
      closeseq pf
   end
   if magic[1, 5] # '%PDF-' then
      display sysmsg(11723, nm, 'it does not start with %PDF-')
      n.skipped += 1
      return
   end
   os.execute "cp -f -- '" : src : @ds : nm : "' '" : dest : @ds : nm : "' 2>&1 && chmod 0644 '" : dest : @ds : nm : "'" capturing co
   if trim(change(co, @fm, ' ')) # '' or not(ospath(dest : @ds : nm, OS$EXISTS)) then
      display sysmsg(11723, nm, 'it could not be copied')
      n.skipped += 1
   end else
      n.copied += 1
   end
   return
end

* END-CODE
