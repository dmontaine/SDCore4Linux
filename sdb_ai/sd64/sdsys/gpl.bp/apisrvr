                                                                     * SetRight
                                                                     * In:  fileno (short integer)
                                                                     *      index name

vb.setright:
                                                                     fno = oconv(cmnd[1,2], 'ISL')
                                                                     gosub check.file
                                                                     if err then return

                                                                     setright cmnd[3,999] from files(fno)

                                                                     return

                                                                     * ======================================================================
                                                                     * SelectLeft
                                                                     * In:  fileno (short integer)
                                                                     *      list no (short integer)
                                                                     *      index name

vb.selectleft:
                                                                     fno = oconv(cmnd[1,2], 'ISL')
                                                                     gosub check.file
                                                                     if err then return

