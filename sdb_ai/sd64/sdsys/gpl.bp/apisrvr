* START-CODE

* Server error status values
$define SV$OK               0    ;* Action successful
$define SV$ON.ERROR         1    ;* Action took ON ERROR clause
$define SV$ELSE             2    ;* Action took ELSE clause
$define SV$ERROR            3    ;* Action failed. Error text available
$define SV$LOCKED           4    ;* Took locked clause

$define MAX.ARG.COUNT     255

$define APILOGGING 0    ;* 0 = no log, 1 = log

$define SEQ.BASE  10000 ;* A sequential file's number is this plus its slot, so it cannot be taken for a file of vb.open
$define SEQ.MAX    1000 ;* Sequential files open at once in one session

$internal
program apisrvr
$catalog $APISRVR

$flags cproc
$flags trusted
* mab
* Linux port, plan D6: REVSTAMP reads ./gplsrc/revstamp.h, a path that only
* exists in the dev tree, so this pair fails on an installed system.  REVSTAMP.H
* is generated by gplbld/gen_includes.py now, matching CPROC's commented pair;
* the tracked revstamp.h included below is current.
*$execute 'BASIC GPL.BP REVSTAMP'
*$execute 'RUN GPL.BP REVSTAMP'
$include revstamp.h

$include syscom.h
$include int$keys.h
$include header.h

$include err.h
$include keys.h
$include dictdict.h

* 20240219 mab user must be member of sdusers  
deffun is_grp_member(user,group) calling '!is_grp_member'
* 14 Sep 26 dm - DECLARED HERE, NOT IN vb.login, as the port did on 19 Aug:
*   vb.scram.first calls it too, and phase 5 retires vb.login.
deffun valid_os_name(name) calling '!valid_os_name'
* 17 Oct 26 dm - S.65 slice 2c: the one place that decides what a files-only session may ask for (pure; see the program).
deffun apifilesok(action, entered, writeok) calling '!apifilesok'
* 18 Oct 26 dm - S.66: the text of an edit refusal for the kind the kernel reports (1 VOC, 2 dictionary, 3 program file, 4 shared file, 5 shared structure).
deffun edit_msg(kind) calling '!edit_msg'


common /$APISRVR/ logged.in,          ;* Process is logged in
files.only,         ;* 17 Oct 26 S.65 2c: this login is FILES ONLY (sdfiles route, not sdapi): set in vb.scram.final, never cleared
files.write,        ;* 18 Oct 26 S.65: a files-only login that is also in the Linux group sdfileswrite: set with files.only, never cleared
files(100),        ;* Array of file variables
logging,            ;* Logging network traffic?
master.login.done,  ;* The MASTER.LOGIN paragraph has been run (it is run once per session)
seqfiles(SEQ.MAX),  ;* Sequential files opened by vb.openseq, numbered SEQ.BASE + their index (sheet 441)
seq.state(SEQ.MAX), ;* 1 while the slot holds an open sequential file
seq.unbuf(SEQ.MAX)  ;* 1 when it was opened unbuffered: every line written is flushed

* If this is the first time through, initialise various things in
* the SYSCOM common block.

if not(kernel(K$CPROC.LEVEL,0)) then
   abort.message = ""

   parser = "!PARSER"          ;* Command parser subroutine

   * Attach to SDSYS directory

   if not(ospath(@sdsys, OS$CD)) then
      abort.message = sysmsg(5261) ;* Cannot attach to SDSYS
      goto connection.failed
   end

   clearselect all
   i = high.select
   loop
   while i > high.user.select
      clearselect i
      i -= 1
   repeat

   i = kernel(K$CPROC.LEVEL,1)
   xeq.command = ""
   data.queue = ""
   command.stack = ""
   at.sentence = ""
   last.command = ""
   sys.bell = char(7)
   user.return.code = 0
   aliased.commands = ''
   alias.targets = ''
   default.style.rec = ''
   logname = kernel(K$USERNAME, 0)
   mat qproc.breakpoint.value = ''
   user.var.names = ''
   user.var.values = ''
   itype.mode = 0                  ;* Standard I-type
   trigger.return.code = 0
   dir.separator = '/'

   echo on

   * not having any luck with this logging = bitand(config('DEBUG'), 0x20) ;* debug=32
   logging = APILOGGING

   account.path = ospath("", os$cwd)     ;* @PATH
   initial.account.path = account.path
* 14 Sep 26 dm - no upcase: account directories are lower case on disk (plan M),
*   and LOGIN:472 takes WHO as it is.
   who = account.path[index(account.path, @ds, count(account.path, @ds)) + 1, 99999] ;* 0414
   abort.code = 0

   tty = 'apisrvr'
   master.login.done = @false      ;* MASTER.LOGIN is run once, at the first entry to an account (vb.account)
* 17 Oct 26 dm - S.65 slice 2c: THE FILES-ONLY MARK IS INITIALISED HERE, WITH logged.in AND master.login.done, AND NOT BESIDE THE scram.*
*   STATE BELOW.  A runtime abort re-enters this program from the top (the else branch below); the common block survives it and
*   so does logged.in, but every plain variable set outside this block (scram.stage and the rest) is set afresh.  A mark kept in a
*   plain variable would be false again after the first abort while the session stayed logged in: a files-only login with the whole API.
   files.only = @false
   files.write = @false       ;* 18 Oct 26, S.65: the same reason; false unless vb.scram.final finds the user in sdfileswrite

   openpath "voc" to voc else
      abort.message = sysmsg(2026) ;* Cannot open VOC
      goto connection.failed
   end


   * Open IPC file and delete any items for old versions of this process id

   openpath @sdsys:@ds:'$ipc' to ipc.f then
      recordlocku ipc.f,'M':@userno     ;* Message queue
      delete ipc.f, 'M':@userno

      recordlocku ipc.f,'P':@userno     ;* Phantom register
      delete ipc.f, 'P':@userno
   end

end else   ;* Abort
   abort.code = abort.cause()
   clearselect
   echo on
   hush off

   if abort.code = K$LOGOUT then goto abort.vbsrvr

   server.error = SV$ON.ERROR
   st = status()
   writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):@abort.message
end

gosub reset.environment

if logging then
* mab 20240219 most likely this does not work unless we pre create the log file for userno??
   openseq '/tmp/api_srvr.log' overwrite to log.f then
      writeseq '> logging started at: ': timedate() to log.f else null
   end else
      if status() then logging = @false
   end
end


* Main processing loop

dim args(MAX.ARG.COUNT)

error.msg = ''
done = @false

* 14 Sep 26 dm - SCRAM exchange state, the port's (W.4 SCRAM phase 3).  Ordinary
*   program variables: APISRVR is one process per connection running one loop,
*   so what request 47 sets is still set when 48 arrives and no two connections
*   share it.  INITIALISED HERE, outside the first-time block, because
*   scram.stage is the only thing standing between a client-final and a
*   signature check run against empty values.
scram.stage = 0        ;* 0 = no exchange in progress, 1 = client-first accepted
scram.user = ''        ;* User name from client-first, once screened
scram.cfirst.bare = '' ;* client-first-bare, the GS2 header stripped
scram.sfirst = ''      ;* server-first, exactly as it went out
scram.nonce = ''       ;* Combined nonce, client's then ours
scram.storedkey = ''   ;* From $cred, base64
scram.serverkey = ''   ;* From $cred, base64
scram.audit.name = ''   ;* Name as PRESENTED, sanitised - see scram.clean.name
scram.refuse.reason = '';* Why this exchange was refused; '' = not refused
scram.fail.delay = 0   ;* Seconds to wait AFTER the refusal is audited (3 for a bad credential)

loop
   unload.object               ;* Unload inactive object code

*  19 Oct 26 dm (K1): THE MESSAGE OF AN ON ERROR REPLY BELONGS TO THE REQUEST THAT GOT IT.  An SV$ON.ERROR reply carries @abort.message (return.status.set), which a
*   refusal sets and nothing cleared, so an ON ERROR clause that had nothing to say (write ... on error server.error = SV$ON.ERROR) sent the text of the LAST refusal in
*   the session: measured in sandbox-req29.py section G, a WRITE with an over-long id answered 'Invalid call name' after a call with no name.  The SDNet client now shows
*   the text of an ON ERROR reply, so the text has to be this reply's.  A real abort sets the message itself, after this line.
   abort.message = ''

   * Fetch new command

   cmnd = readpkt()
   if cmnd = '' then
      logmsg sysmsg(5271) ;* Connection to client lost
      goto abort.vbsrvr
   end

   if logging then
      s = oconv(cmnd, 'MX0C')
      writeseq '> ' : s[1,4] : ' ' : s[5,1000] to log.f else null
   end

   action = oconv(cmnd[1,2], 'ISL')

   cmnd = cmnd[3,99999999]          ;* Strip off action code
   response = ''
   server.error = SV$OK           ;* Assume success

   if not(logged.in) then
      * 14 Sep 26 dm - 47 and 48, the two halves of one SCRAM exchange, join 24
      * and 25 as the requests a session may make before authenticating (the
      * port's).  48 refuses itself if 47 did not come first.  24 STAYS IN THIS
      * LIST THOUGH IT IS RETIRED, so vb.login can answer 5275 and name the
      * reason (the port's, phase 5).
      if action # 24 and action # 25 and action # 47 and action # 48 then
         abort.message = sysmsg(5270) ;* Not logged in
         goto connection.failed
      end
   end

* 17 Oct 26 dm - S.65 slice 2c: THE FILES-ONLY GATE.  A session marked files.only (vb.scram.final) reaches the dispatch only with a
*   request !apifilesok allows; any other is answered with an error and NOT dispatched.  It is after the not-logged-in test and before
*   the dispatch so that no request, known or not, goes round it.  "entered" is master.login.done, true once vb.account has
*   succeeded, so the first request 3 is allowed and a later one (an SDLogto) is not.  The SDCLIENT and SDNet tests in vb.open and
*   the rest still apply to what is allowed through.
   if files.only then
      if not(apifilesok(action, master.login.done, files.write)) then
         if files.write then write.word = 'on' else write.word = 'off'
         void kernel(K$AUDIT, 'api refused request=' : action : ' route=sdfiles write=' : write.word : ' user=' : @logname)  ;* @logname, not logname: a plain variable does not survive an abort
         server.error = SV$ON.ERROR
* 18 Oct 26 dm - S.65 write group: a request the files-only table ALLOWS but that changes state, refused for want of the group, has its own text.
*   The test is the same call with the write flag made true: allowed then means the group is all that was missing.
         if not(files.write) and apifilesok(action, master.login.done, @true) then
            abort.message = sysmsg(11521, action) ;* This login cannot change or lock files here: ask the administrator for files-write-on (request %1)
         end else
            abort.message = sysmsg(11480, action) ;* This login is for files only: request %1 is not allowed
         end
         st = status()
         goto return.status.set
      end
   end

   cproc.date = date()
   cproc.time = time()

   on action + 1 gosub vb.illegal.action,
   vb.quit,           ;*   1   Quit
   vb.geterror,       ;*   2   Get extended error text
   vb.account,        ;*   3   Set account
   vb.open,           ;*   4   Open file
   vb.close,          ;*   5   Close file
   vb.read,           ;*   6   Read record (READ)
   vb.readl,          ;*   7   Read record (READL)
   vb.readlw,         ;*   8   Read record (READL, waiting)
   vb.readu,          ;*   9   Read record (READU)
   vb.readuw,         ;*  10   Read record (READU, waiting)
   vb.select,         ;*  11   Select file
   vb.readnext,       ;*  12   Read next id from select list
   vb.clearselect,    ;*  13   Clear select list
   vb.readlist,       ;*  14   Read select list
   vb.release,        ;*  15   Release lock
   vb.write,          ;*  16   Write record
   vb.writeu,         ;*  17   Write record, retaining lock
   vb.delete,         ;*  18   Delete record
   vb.deleteu,        ;*  19   Delete record, retaining lock
   vb.call,           ;*  20   Call catalogued subroutine
   vb.execute,        ;*  21   Execute command
   vb.respond,        ;*  22   Response to input
   vb.endcommand,     ;*  23   End command
   vb.login,          ;*  24   Network login - RETIRED, always refused
   vb.local.login,    ;*  25   SDLocal login
   vb.selectindex,    ;*  26   Select index
   vb.illegal.action, ;*  27   Enter licensed package - not supported
   vb.illegal.action, ;*  28   Exit licensed package  - not supported
   vb.open.sdnet,     ;*  29   Open SDNet file
   vb.lock.record,    ;*  30   Lock a record
   vb.clearfile,      ;*  31   Clearfile
   vb.filelock,       ;*  32   Get file lock
   vb.fileunlock,     ;*  33   Release file lock
   vb.recordlocked,   ;*  34   Test lock
   vb.indices1,       ;*  35   Fetch information about indices
   vb.indices2,       ;*  36   Fetch information about an index
   vb.selectlist,     ;*  37   Select file and return list
   vb.selectindexv,   ;*  38   Select index, returning indexed values
   vb.selectindexk,   ;*  39   Select index, returning keys for value
   vb.fileinfo,       ;*  40   Perform FILEINFO() action
   vb.readv,          ;*  41   READV and variants
   vb.setleft,        ;*  42   Set index at extreme left
   vb.setright,       ;*  43   Set index at extreme right
   vb.selectleft,     ;*  44   Scan index to left
   vb.selectright,    ;*  45   Scan index to right
   vb.mark.mapping,   ;*  46   Enable/disable mark mapping
   vb.scram.first,    ;*  47   SCRAM client-first
   vb.scram.final,    ;*  48   SCRAM client-final
   vb.revision,       ;*  49   Server revision (QMRevision)         15 Oct 26 dm - QM4 gaps, sheet 89
   vb.getvar,         ;*  50   Value of an @-variable (QMGetVar)    sheet 195
   vb.system,         ;*  51   SYSTEM() (QMSystem)                  sheet 499
   vb.trans,          ;*  52   TRANS(), marks lowered (QMTrans)     sheet 499
   vb.rtrans,         ;*  53   TRANS() raw (QMRTrans)               sheet 499
   vb.txn,            ;*  54   Transaction start / commit / abort (QMTxn)   sheet 442
   vb.evaluate,       ;*  55   Evaluate a dictionary item (QMEvaluate)      sheet 247
   vb.evalconv,       ;*  56   The same, output conversion applied (QMEvalConv)
   vb.iconv,          ;*  57   ICONV() (QMIConv)                            sheet 409
   vb.oconv,          ;*  58   OCONV() (QMOConv)
   vb.iconvs,         ;*  59   ICONVS() (QMIConvs)
   vb.oconvs,         ;*  60   OCONVS() (QMOConvs)
   vb.openseq,        ;*  61   Open a sequential file (QMOpenSeq)           sheet 441
   vb.readseq,        ;*  62   Read a line (QMReadSeq)
   vb.readblk,        ;*  63   Read bytes (QMReadBlk)
   vb.writeseq,       ;*  64   Write a line (QMWriteSeq)
   vb.writeblk,       ;*  65   Write bytes (QMWriteBlk)
   vb.seek,           ;*  66   Position (QMSeek)
   vb.weofseq,        ;*  67   Truncate at the position (QMWeofSeq)
   vb.writeseqkey,    ;*  68   Write a record under the file's next sequential id (QMWriteSeqKey)
   vb.writeuseqkey,   ;*  69   The same, keeping the update lock (QMWriteuSeqKey)
   vb.illegal.action

   st = status()
return.status.set: ;* Return to here if ST already set

   if server.error = SV$ON.ERROR then response = @abort.message

   * 11 Oct 26 dm - a record read from a data collection file is a collection; the client is sent its JSON
   * text, the compact form the file holds
   jt = jtype(response)
   if jt = 'collection' or jt = 'array' then response = jbuild(response)

   if logging then
      s = oconv(iconv(server.error, 'ISL'):iconv(st, 'ILL'):response, 'MX0C')
      writeseq '< ' : s[1,4] : ' ' : s[5,8] : ' ' : s[13,1000] to log.f else null
   end

   writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):response
until done
repeat

abort.vbsrvr:
return to abort.vbsrvr

connection.failed:
server.error = SV$ON.ERROR
st = status()
writepkt iconv(server.error, 'ISL'):iconv(st, 'ILL'):@abort.message
goto abort.vbsrvr

