* ======================================================================
* Revision of the server (QMRevision).   15 Oct 26 dm - QM4 gaps, sheet 89
* In:
* Out: the revision, in the form SYSTEM(1012) gives it

vb.revision:
response = system(1012)
return

* ======================================================================
* Value of an @-variable (QMGetVar).   Sheet 195
* In:  name, with or without the @, in either case
* Out: the value as a string, or the null string for a name that is not one of those below.  The names are the ones a
*      session can have a use for; each is something the account's own programs read as freely.

vb.getvar:
gv.name = upcase(trim(cmnd))
if gv.name[1,1] = '@' then gv.name = gv.name[2,99]
begin case
   case gv.name = 'SELECTED'            ; response = @selected
   case gv.name = 'LOGNAME' or gv.name = 'USER' ; response = @logname
   case gv.name = 'WHO'                 ; response = @who
   case gv.name = 'PATH'                ; response = @path
   case gv.name = 'USERNO'              ; response = @userno
   case gv.name = 'TTY'                 ; response = @tty
   case gv.name = 'DS'                  ; response = @ds
   case gv.name = 'SENTENCE'            ; response = @sentence
   case gv.name = 'COMMAND'             ; response = @command
   case gv.name = 'SYSTEM.RETURN.CODE'  ; response = @system.return.code
   case gv.name = 'USER.RETURN.CODE'    ; response = @user.return.code
   case gv.name = 'DATE'                ; response = @date
   case gv.name = 'TIME'                ; response = @time
   case gv.name = 'ID'                  ; response = @id
   case gv.name = 'ANS'                 ; response = @ans
   case gv.name = 'USER0' ; response = @user0
   case gv.name = 'USER1' ; response = @user1
   case gv.name = 'USER2' ; response = @user2
   case gv.name = 'USER3' ; response = @user3
   case gv.name = 'USER4' ; response = @user4
   case 1                               ; response = ''
end case
return

* ======================================================================
* SYSTEM() (QMSystem).   Sheet 499
* In:  key (long integer)
* Out: the value as a string

vb.system:
response = system(oconv(cmnd[1,4], 'ILL'))
return

* ======================================================================
* Transactions (QMTxn).   Sheet 442
* In:  mode (short integer): 1 start, 2 commit, 3 abort, 4 commit non-durable (a nested transaction goes to its parent)
* Commit and abort need a transaction to be running.

vb.txn:
tx.mode = oconv(cmnd[1,2], 'ISL')
if tx.mode < 1 or tx.mode > 4 or (tx.mode > 1 and not(@transaction.id)) then
   server.error = SV$ERROR
   error.msg = sysmsg(11340) ;* Transaction mode must be 1 to 4, and 2 to 4 need a transaction
   return
end
begin case
   case tx.mode = 1
      transaction start
   case tx.mode = 2
      transaction commit
   case tx.mode = 3
      transaction abort
   case 1
      void kernel(K$NON.DURABLE.TXN, 1)
      transaction commit
end case
return

* ======================================================================
* Evaluate a dictionary item (QMEvaluate, QMEvalConv).   Sheets 247 (EvalConv) and 409
* In:  file number of a DICTIONARY (short), name length (short), name(s) - several are separated by value marks -,
*      data length (long), the data, the record id
* Out: the value of each item, joined by item marks.  The data becomes @RECORD and the id @ID for the evaluation.
* An item that is not in the dictionary is the ELSE case; one that is not a data defining item (type D, A, S, C or I) or does not
* compile is an error.  QMEvalConv also applies the item's output conversion, to each value of a multivalued answer.  A correlative
* or I-type that is not compiled is compiled for this call and the dictionary is NOT written to (a request that reads must not write).
* No file number can exist when SDCLIENT is set or SDNet is in use (vb.open refuses), so no restricted session can reach this.

vb.evaluate:
ev.conv = @false
goto evaluate.common

vb.evalconv:
ev.conv = @true

evaluate.common:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.file
if err then return

ev.n = oconv(cmnd[3,2], 'ISL')
ev.names = cmnd[5,ev.n]
ev.p = 5 + ev.n
ev.n = oconv(cmnd[ev.p,4], 'ILL')
ev.data = cmnd[ev.p + 4,ev.n]
ev.id = cmnd[ev.p + 4 + ev.n,len(cmnd)]

response = ''
ev.count = count(ev.names, @vm) + 1
for ev.i = 1 to ev.count
   ev.name = ev.names<1,ev.i>
   gosub evaluate.item
   if server.error # SV$OK then
      response = ''
      return
   end
   if ev.i > 1 then response := @im
   response := ev.result
next ev.i
return

* One item: ev.name evaluated against ev.data and ev.id; the answer in ev.result, or server.error and error.msg
evaluate.item:
ev.result = ''
read ev.rec from files(fno), ev.name else
   read ev.rec from files(fno), downcase(ev.name) else
      read ev.rec from files(fno), upcase(ev.name) else
         server.error = SV$ELSE
         return
      end
   end
end

ev.type = upcase(ev.rec[1,1])
if index('DASIC', ev.type, 1) = 0 or ev.type = '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11342, ev.name) ;* %1 is not a dictionary item that defines data
   return
end

* Compile what is calculated and not yet compiled, the way the query processor decides it is (qproc: no object code, or the
* checksum no longer matches the record)
if ev.type = 'I' or ev.type = 'C' or ((ev.type = 'A' or ev.type = 'S') and ev.rec<DICT.A.CORRELATIVE> # '') then
   if len(ev.rec<DICT.ITYPE.OBJECT>) = 0 ~
   or checksum(replace(ev.rec, DICT.SYS.INFO, 1;'')) # ev.rec<DICT.SYS.INFO,1> then
      call $dcomp(files(fno), ev.name, ev.rec, ev.z, ev.z, ev.z, ev.z, ev.z, 1)
      if ev.rec<DICT.ITYPE.OBJECT> = '' then
         server.error = SV$ERROR
         error.msg = sysmsg(11341, ev.name) ;* %1 cannot be compiled
         return
      end
   end
end

ev.saved.id = @id
ev.saved.record = @record
@id = ev.id
@record = ev.data
set.status 0
ev.result = itype(ev.rec)
ev.status = status()
set.status 0                   ;* what the expression left behind is not the request's status; a conversion below sets it
@id = ev.saved.id
@record = ev.saved.record
if ev.status = ER$INVA.ITYPE then
   server.error = SV$ERROR
   error.msg = sysmsg(11342, ev.name) ;* %1 is not a dictionary item that defines data
   ev.result = ''
   return
end

if ev.conv then
   if ev.type = 'A' or ev.type = 'S' then ev.cv = ev.rec<DICT.A.CONV> else ev.cv = ev.rec<DICT.CONV>
   if ev.cv # '' then ev.result = oconvs(ev.result, ev.cv)
end
return

* ======================================================================
* ICONV(), OCONV(), ICONVS(), OCONVS() (QMIConv, QMOConv, QMIConvs, QMOConvs).   Sheet 409
* In:  conversion code length (short), the code, the data
* Out: the converted data; the STATUS() of the conversion goes back as the request's status, as ICONV and OCONV leave it
* A conversion reads a file (T with a ;) or calls a program (U): where SDCLIENT is set or SDNet is in use, which refuse both
* to the client, such a code is refused.

vb.iconv:
cv.mode = 1
goto conv.common

vb.oconv:
cv.mode = 2
goto conv.common

vb.iconvs:
cv.mode = 3
goto conv.common

vb.oconvs:
cv.mode = 4

conv.common:
cv.n = oconv(cmnd[1,2], 'ISL')
cv.code = cmnd[3,cv.n]
cv.data = cmnd[3 + cv.n,len(cmnd)]

if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   cv.count = count(cv.code, @vm) + 1
   for cv.i = 1 to cv.count
      cv.seg = upcase(trimf(cv.code<1,cv.i>))
      if cv.seg[1,1] = 'U' or (cv.seg[1,1] = 'T' and index(cv.seg, ';', 1)) then
         server.error = SV$ERROR
         error.msg = sysmsg(11343) ;* A conversion that reads a file or calls a program is not allowed here
         return
      end
   next cv.i
end

begin case
   case cv.mode = 1
      response = iconv(cv.data, cv.code)
   case cv.mode = 2
      response = oconv(cv.data, cv.code)
   case cv.mode = 3
      response = iconvs(cv.data, cv.code)
   case 1
      response = oconvs(cv.data, cv.code)
end case
return

* ======================================================================
* Sequential files (QMOpenSeq, QMReadSeq, QMReadBlk, QMWriteSeq, QMWriteBlk, QMSeek, QMWeofSeq; closed by the ordinary close).
* Sheet 441.  A sequential file's number is SEQ.BASE + its slot, apart from the files of vb.open.
*
* THE GATES.  The session may not open a sequential file when SDCLIENT is set or SDNet is in use (as for any file).  A file named
* through the VOC (file name and record id) is an SD directory file, opened as OPENSEQ opens it for any program, and one flagged
* trusted is refused.  A BARE PATHNAME (a null id) is an operating system file: this program is $internal, which the kernel
* does not hold to the OS-access gate, so the gate is asked here, as the account's own programs are asked it by OPENSEQ -
* without os-on the session reaches only its own account's directory.
*
* vb.openseq   In:  modes (long), name length (short), name, id (null: the name is a pathname)
*                   modes: 2 give up with a locked answer if another process has the file (without it, wait), 16 read only,
*                   256 append, 512 overwrite, 1024 flush every line written, 4096 shared (append, for several writers)
*              Out: the file number, or the ELSE case with STATUS() saying why

vb.openseq:
if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   abort.message = sysmsg(5262) ;* File access is disabled
   server.error = SV$ON.ERROR
   return
end

os.modes = oconv(cmnd[1,4], 'ILL')
os.n = oconv(cmnd[5,2], 'ISL')
os.name = cmnd[7,os.n]
os.id = cmnd[7 + os.n,len(cmnd)]
if os.name = '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11346) ;* A sequential file needs a name
   return
end

os.slot = 0
for os.i = 1 to SEQ.MAX
   if not(seq.state(os.i)) then
      os.slot = os.i
      exit
   end
next os.i
if os.slot = 0 then
   server.error = SV$ERROR
   error.msg = sysmsg(11344) ;* Too many sequential files are open
   return
end

if os.id = '' then
   os.path = @true
   if not(kernel(K$PATH.OK, os.name)) then
      server.error = SV$ERROR
      error.msg = sysmsg(11345, os.name) ;* %1 is not a file this account may open
      return
   end
   os.edit.ok = kernel(K$EDIT.OS.OK, os.name)   ;* 17 Oct 26 dm, S.64 part 2: see below
end else
   os.path = @false
   open os.name to os.tf else
      server.error = SV$ELSE
      return
   end
   os.trusted = bitand(fileinfo(os.tf, FL$FLAGS), FL$FLAGS.TRUSTED)
   os.edit.ok = kernel(K$EDIT.OK, fileinfo(os.tf, FL$PATH))   ;* 17 Oct 26 dm, S.64 part 2: asked of the file that is open, before it is closed
   close os.tf
   if os.trusted then
      server.error = SV$ELSE
      return
   end
end

os.m = 0
begin case
   case bitand(os.modes, 16)   ; os.m = 1
   case bitand(os.modes, 4096) ; os.m = 4
   case bitand(os.modes, 512)  ; os.m = 3
   case bitand(os.modes, 256)  ; os.m = 2
end case

* 17 Oct 26 dm - S.64 part 2.  This program is $internal, which the kernel's OPENSEQ test for a VOC, a dictionary or a program file lets
*   through, so it is asked here: a pathname with such a file in it (K$EDIT.OS.OK), or a record of one (K$EDIT.OK on the file it is
*   in), that the session may not change is opened for reading only, as the kernel opens it for a user program - nothing is made
*   and nothing written (a write then takes the ELSE case).  Reading is not refused, because the default mode is read and write.
if not(os.edit.ok) then os.m = 1

loop
   os.lk = 0
   os.ex = 0
   gosub seq.open.once
until not(os.lk) or bitand(os.modes, 2)
   nap 1000                                 ;* the lock is another process's: wait a second, as the mode asks (NAP, not SLEEP:
                                            ;* test-failaudit-units.py holds the file to one SLEEP, the scram delay)
repeat

if os.lk then
   server.error = SV$LOCKED
   return
end
os.st = status()
if not(os.ex) and os.st # 0 then            ;* neither there nor made: the open failed
   server.error = SV$ELSE
   return
end

seq.state(os.slot) = 1
seq.unbuf(os.slot) = (bitand(os.modes, 1024) # 0)
response = iconv(SEQ.BASE + os.slot, 'ISL')
return

* One try at the open: os.lk is set when the file is locked by another process, os.ex when it was there already
seq.open.once:
begin case
   case os.path and os.m = 0
      openseq os.name to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 1
      openseq os.name readonly to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 2
      openseq os.name append to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path and os.m = 3
      openseq os.name overwrite to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.path
      openseq os.name shared to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 0
      openseq os.name, os.id to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 1
      openseq os.name, os.id readonly to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 2
      openseq os.name, os.id append to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case os.m = 3
      openseq os.name, os.id overwrite to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
   case 1
      openseq os.name, os.id shared to seqfiles(os.slot) locked os.lk = 1 then os.ex = 1 else os.ex = 0
end case
return

* The file number of a request, as an index into the table: err is set, with the reply, for one that is not an open sequential file
check.seq:
err = @true
si = fno - SEQ.BASE
if si < 1 or si > SEQ.MAX then
   server.error = SV$ERROR
   error.msg = sysmsg(5268) ;* Invalid file number
   return
end
if not(seq.state(si)) then
   server.error = SV$ERROR
   error.msg = sysmsg(5268)
   return
end
err = @false
return

* 17 Oct 26 dm - S.64 part 2.  May this session save a change to the file in files(fno)?  err is set, with the reply, when it may not.
*   This program is $internal, which the kernel's own edit test lets through (op_dio3.c), so the API server asks for the client: the
*   gates are the session's, loaded at its first entry to an account (vb.account; SDSYS is given all three there).  The kernel answers
*   by the last component of the pathname of the file that is open (voc, *.dic, bp, bp.out, *.bp, *.bp.out), so a Q-pointer to a VOC
*   is caught.  Asked for WRITE, WRITEU, DELETE, DELETEU, CLEARFILE and the CREATING.SEQKEY writes; reading is never asked.
check.edit:
err = @true
ed.path = fileinfo(files(fno), FL$PATH)
if ed.path = '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11410) ;* The pathname of the file cannot be read, so a change to it is refused
   return
end
if not(kernel(K$EDIT.OK, ed.path)) then
   ed.kind = kernel(K$EDIT.KIND, ed.path)
   server.error = SV$ERROR
   error.msg = edit_msg(ed.kind) ;* 11405 VOC, 11406 dictionary, 11407 program file, 11513 shared file (18 Oct 26, S.66)
   return
end
err = @false
return

* ReadSeq.  In: fno (short).  Out: the next line without its terminator; the ELSE case at the end of the file
vb.readseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
readseq rec from seqfiles(si) on error server.error = SV$ON.ERROR then response = rec else server.error = SV$ELSE
return

* ReadBlk.  In: fno (short), bytes (long).  Out: up to that many bytes; the ELSE case when there are none
vb.readblk:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
rb.n = oconv(cmnd[3,4], 'ILL')
if rb.n < 1 or rb.n > 100000000 then
   server.error = SV$ERROR
   error.msg = sysmsg(11347) ;* The number of bytes to read is from 1 to 100000000
   return
end
readblk rec from seqfiles(si), rb.n on error server.error = SV$ON.ERROR then response = rec else server.error = SV$ELSE
return

* WriteSeq.  In: fno (short), the line.  A file opened unbuffered is flushed after each line.
vb.writeseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
ws.data = cmnd[3,len(cmnd)]
if seq.unbuf(si) then
   writeseqf ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
end else
   writeseq ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
end
return

* WriteBlk.  In: fno (short), the bytes: written exactly as given, no terminator added
vb.writeblk:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
ws.data = cmnd[3,len(cmnd)]
writeblk ws.data to seqfiles(si) on error server.error = SV$ON.ERROR then null else server.error = SV$ELSE
if seq.unbuf(si) then flush seqfiles(si) then null else null
return

* Seek.  In: fno (short), offset (signed long), relative to (short): 0 start, 1 here, 2 end
vb.seek:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
sk.off = oconv(cmnd[3,4], 'ILL')
if sk.off > 2147483647 then sk.off -= 4294967296
sk.rel = oconv(cmnd[7,2], 'ISL')
seek seqfiles(si), sk.off, sk.rel then null else server.error = SV$ELSE
return

* WeofSeq.  In: fno (short).  The file is cut off at the current position.
vb.weofseq:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.seq
if err then return
weofseq seqfiles(si)
return

* ======================================================================
* WRITE ... CREATING.SEQKEY (QMWriteSeqKey, QMWriteuSeqKey).   Sheet 441
* In:  fileno (short integer), the record
* Out: the id the file's counter gave it.  A hashed file only.  The update lock the write takes is released before the reply, or,
*      for the writeu request, kept.

vb.writeseqkey:
wk.keep = @false
goto writeseqkey.common

vb.writeuseqkey:
wk.keep = @true

writeseqkey.common:
fno = oconv(cmnd[1,2], 'ISL')
gosub check.file
if err then return
gosub check.edit   ;* 17 Oct 26 dm, S.64 part 2
if err then return
if fileinfo(files(fno), FL$TYPE) # FL$TYPE.DH then
   server.error = SV$ERROR
   error.msg = sysmsg(11348) ;* WRITE ... CREATING.SEQKEY needs a hashed file
   return
end
wk.data = cmnd[3,len(cmnd)]
wk.id = ''
if wk.keep then
   writeu wk.data to files(fno) creating.seqkey wk.id on error server.error = SV$ON.ERROR
end else
   write wk.data to files(fno) creating.seqkey wk.id on error server.error = SV$ON.ERROR
end
if server.error = SV$OK then response = wk.id
return

* ======================================================================
* TRANS() (QMTrans, QMRTrans).   Sheet 499
* In:  file name length (short), file name, field name length (short), field name, action length (short), action, record id
* Out: the data; QMTrans lowers the mark characters one level, QMRTrans leaves them
* Opened as vb.open opens a file: not at all for SDCLIENT or SDNet, and a file or dictionary flagged trusted is refused.
* The B action (binary open) is not supported.

vb.trans:
tr.lower = @true
goto trans.common

vb.rtrans:
tr.lower = @false

trans.common:
if kernel(K$SDNET, -1) or config("SDCLIENT") # 0 then
   abort.message = sysmsg(5262) ;* File access is disabled
   server.error = SV$ON.ERROR
   return
end

tr.n = oconv(cmnd[1,2], 'ISL')
tr.file = cmnd[3,tr.n]
tr.p = 3 + tr.n
tr.n = oconv(cmnd[tr.p,2], 'ISL')
tr.field = cmnd[tr.p + 2,tr.n]
tr.p = tr.p + 2 + tr.n
tr.n = oconv(cmnd[tr.p,2], 'ISL')
tr.action = upcase(cmnd[tr.p + 2,tr.n])
tr.id = cmnd[tr.p + 2 + tr.n,999999]

if tr.action = '' then tr.action = 'X'
if tr.file = '' or convert('CX', '', tr.action) # '' then
   server.error = SV$ERROR
   error.msg = sysmsg(11339) ;* The action of Trans is C or X (the B action is not supported)
   return
end

open tr.file to tr.f else
   server.error = SV$ELSE
   return
end
tr.trusted = bitand(fileinfo(tr.f, FL$FLAGS), FL$FLAGS.TRUSTED)
close tr.f
if tr.trusted then
   server.error = SV$ELSE
   return
end

if tr.field matches '1N0N' or tr.field = '-1' then
   tr.field = tr.field + 0                      ;* a field position, or -1 for the whole record
end else
   open 'DICT', tr.file to tr.d else
      server.error = SV$ELSE
      return
   end
   tr.trusted = bitand(fileinfo(tr.d, FL$FLAGS), FL$FLAGS.TRUSTED)
   close tr.d
   if tr.trusted then
      server.error = SV$ELSE
      return
   end
end

* SD's TRANS() lowers the marks of what it finds by one level (a record's field marks come back as value marks), because its
* result is meant to sit inside a list.  QMRTrans wants the marks as they are, so each record's answer is raised again; the
* answers of a list of ids are then joined with value marks: QMTrans lowers the marks of each record's data once and joins the
* records with value marks, QMRTrans joins them as they are (so one multivalued field and several single valued ones look alike).
response = ''
tr.ids = count(tr.id, @vm) + 1
for tr.i = 1 to tr.ids
   tr.one = raise(trans(tr.file, tr.id<1, tr.i>, tr.field, tr.action))
   if tr.lower then tr.one = lower(tr.one)
   if tr.i > 1 then response := @vm
   response := tr.one
next tr.i
return

                                                                     * ======================================================================
check.file:
                                                                     err = @true

                                                                     if fno < 1 or fno > inmat(files) then      ;* Invalid file number
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5268) ;* Invalid file number
                                                                        return
                                                                     end

                                                                     if not(fileinfo(files(fno), FL$OPEN)) then ;* File not open
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5268) ;* Invalid file number
                                                                        return
                                                                     end

                                                                     err = @false
                                                                     return


                                                                     * ======================================================================
check.list:
                                                                     err = @true

                                                                     if listno < 0 or listno > 10 then      ;* Invalid list number   0225
                                                                        server.error = SV$ERROR
                                                                        error.msg = sysmsg(5269) ;* Invalid select list number
                                                                        return
                                                                     end

                                                                     err = @false
                                                                     return
                                                                  end



