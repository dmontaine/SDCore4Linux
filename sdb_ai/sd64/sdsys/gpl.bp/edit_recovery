* START-HISTORY:
* 28 Oct 26 dm  New (S.88 Phase 2, plan 2.9, D2; the owner's answer to Q2 of 28 Oct: "Build it, ship it off").  A hang-up or an abort lost every unsaved
*               tab of the IDE silently.  With the account's switch on (register field 19, ACC$RECOVERY; MODIFY.ACCOUNT RECOVERY-ON) the IDE keeps a copy of the
*               text here, and offers it back the next time the record is opened.  Off as delivered.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call !edit_recovery(op, file, id, text, res)
*
*     op 'on'     res = 1 when this session may write copies (below), else 0
*        'write'  keeps text as the copy of record id of file; res = '' when it was written and read back whole, else a word saying why not:
*                 off (the switch, or not the account's own person), directory (no private directory), write (the write was refused: a full disk,
*                 say; nothing is left behind), mode (the file is not owner-only; it is removed) or verify (it read back different; it is removed)
*        'find'   res = 1 : @fm : date : @fm : time (internal) and text = the copy's text when a whole, private copy of that record is there, else
*                 res = '' and text = ''
*        'drop'   removes the copy of that record; res = 1 when one was removed
*        'list'   the copies of UNTITLED buffers (file ''): text = one field each, token @vm date @vm time, at most 20; res = how many
*
*   WHO MAY HAVE ONE.  The account the session is in (@who) must have a register record whose group is sdu_<the Linux user this process runs as>:
*   a USER account, and only its own person.  A group or other account is entered by several people, any of whom may rename entries in its directory,
*   so a directory checked as private could be swapped for theirs between the check and the write; the administrator signed on in somebody else's
*   account would be writing in a directory that person controls.  Neither ever gets a copy.  'write' also needs field 19 to say yes; 'find', 'drop'
*   and 'list' do not (a copy made while the switch was on is still the person's text after it is turned off, and is still offered and removed).
*
*   WHERE.  <account directory>/$recovery, made under umask 077 (mode 0700, or 2700 under a setgid account directory), and used only when the kernel's
*   SD_FILE_PRIVATE says it is a real directory (lstat: not a link), owned by this process's user, with no group or other bits.  A copy is one file,
*   'c' and the SHA-256 of file and id in hex, written under umask 077 (0600) and kept only when SD_FILE_PRIVATE says the same of it and it reads back
*   identical.  Inside the account so that it goes where the account goes (BACKUP.ACCOUNT, DELETE.ACCOUNT); outside every VOC, so no F-pointer of the
*   account names it.  A copy is: the line sd-recovery 1, the account, the file, the record id, the date and time, the text's length and its SHA-256,
*   then the text, in image mode (MARK.MAPPING OFF): a copy that was cut short or changed does not match and is never offered.
*
*   NOTHING HERE WRITES THE RECORD ITSELF, and nothing here reads or writes anything but the account's own $recovery directory.  No audit line holds
*   the text (none is written at all: the switch's own change is audited by MODIFY.ACCOUNT).
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine edit_recovery(op, rfile, rid, text, res)
$catalog !edit_recovery

$include keys.h
$include int$keys.h

   res = ''
   MAGIC = 'sd-recovery 1'
   MAXLIST = 20
   rc.op = downcase(op)

   gosub where
   begin case
      case rc.op = 'on'
         res = rc.on
      case rc.op = 'write'
         gosub do.write
      case rc.op = 'find'
         text = ''
         gosub do.find
      case rc.op = 'drop'
         gosub do.drop
      case rc.op = 'list'
         text = ''
         gosub do.list
   end case
   return

* ======================================================================
* Out: rc.mine (the account is a USER account and this process is its person), rc.on (rc.mine and field 19 says yes), rc.dir (the copies' directory),
* rc.acct (the account's name as the register keeps it).
where:
   rc.mine = 0
   rc.on = 0
   rc.dir = ''
   rc.acct = downcase(@who)
   rc.user = downcase(trim(kernel(K$USERNAME, 0)))
   arec = ''
   openpath @sdsys : @ds : 'accounts' to af then
      read arec from af, rc.acct else arec = ''
      close af
   end
   if arec = '' then return
   apath = trim(arec<ACC$PATH>)
   if apath[1, 1] # '/' then return
   loop
   while len(apath) > 1 and apath[len(apath), 1] = '/'
      apath = apath[1, len(apath) - 1]
   repeat
   if rc.user = '' or rc.user = 'root' or rc.user = 'sdsys' then return
   if downcase(trim(arec<ACC$GROUP>)) # 'sdu_' : rc.user then return
   rc.dir = apath : '/$recovery'
   rc.mine = 1
   if upcase(trim(arec<ACC$RECOVERY>)) = 'YES' then rc.on = 1
   return

* Out: rc.slot, the name of the copy of rfile / rid
slot.name:
   rc.slot = 'c' : downcase(digest(rfile : @fm : rid, 0, 'SHA256'))
   rc.path = rc.dir : '/' : rc.slot
   return

* Out: dir.ok, the directory is a real directory of this user's alone
check.dir:
   dir.ok = (SDEXT(rc.dir : @FM : 'DIR', @TRUE, SD_FILE_PRIVATE) = '1')
   return

* Out: file.ok, rc.path is a regular file of this user's alone in such a directory
check.file:
   file.ok = (SDEXT(rc.path : @FM : 'FILE', @TRUE, SD_FILE_PRIVATE) = '1')
   return

* The directory is made when it is not there, under umask 077; out: dir.ok
make.dir:
   if not(ospath(rc.dir, OS$EXISTS)) then
      rc.um = umask(63)
      void ospath(rc.dir, OS$MKDIR)
      if umask(rc.um) then null
   end
   gosub check.dir
   return

* In: rec.  Out: cp.ok, and when it is set cp.file, cp.id, cp.date, cp.time, cp.text
parse.copy:
   cp.ok = 0
   cp.text = ''
   if rec<1> # MAGIC then return
   if rec<2> # rc.acct then return
   cp.p = index(rec, @fm, 8)
   if cp.p = 0 then return
   cp.len = rec<7>
   if cp.len = '' or not(num(cp.len)) then return
   cp.text = rec[cp.p + 1, len(rec)]
   if len(cp.text) # cp.len + 0 then
      cp.text = ''
      return
   end
   if downcase(digest(cp.text, 0, 'SHA256')) # rec<8> then
      cp.text = ''
      return
   end
   cp.file = rec<3>
   cp.id = rec<4>
   cp.date = rec<5>
   cp.time = rec<6>
   cp.ok = 1
   return

* ======================================================================
do.write:
   res = 'off'
   if not(rc.on) then return
   gosub slot.name
   res = 'directory'
   gosub make.dir
   if not(dir.ok) then return
   openpath rc.dir to rf else return
   mark.mapping rf, off

*  Something at the name that is not a private file of ours is unlinked first (DELETE removes the entry, it does not follow it), so the write makes a new
*  file under the umask below and never writes through a link or into a file somebody else can read.
   gosub check.file
   if not(file.ok) then
      delete rf, rc.slot on error null
   end

   rec = MAGIC : @fm : rc.acct : @fm : rfile : @fm : rid : @fm : date() : @fm : int(time()) : @fm : len(text) : @fm : downcase(digest(text, 0, 'SHA256')) : @fm : text
   rc.um = umask(63)
   rc.written = @true
   write rec to rf, rc.slot on error rc.written = @false
   if umask(rc.um) then null
   if not(rc.written) then
      delete rf, rc.slot on error null        ;* a full disk can leave part of a file: it is not a copy
      close rf
      res = 'write'
      return
   end

   gosub check.file
   if not(file.ok) then
      delete rf, rc.slot on error null
      close rf
      res = 'mode'
      return
   end
   read chk from rf, rc.slot else chk = ''
   if chk # rec then
      delete rf, rc.slot on error null
      close rf
      res = 'verify'
      return
   end
   close rf
   res = ''
   return

do.find:
   res = ''
   if not(rc.mine) then return
   gosub slot.name
   gosub check.dir
   if not(dir.ok) then return
   gosub check.file
   if not(file.ok) then return
   openpath rc.dir to rf else return
   mark.mapping rf, off
   read rec from rf, rc.slot else rec = ''
   close rf
   gosub parse.copy
   if not(cp.ok) then return
   if cp.file # rfile or cp.id # rid then return
   text = cp.text
   res = 1 : @fm : cp.date : @fm : cp.time
   return

do.drop:
   res = 0
   if not(rc.mine) then return
   gosub slot.name
   gosub check.dir
   if not(dir.ok) then return
   gosub check.file
   if not(file.ok) then return
   openpath rc.dir to rf else return
   rc.gone = @true
   delete rf, rc.slot on error rc.gone = @false
   close rf
   if rc.gone then res = 1
   return

do.list:
   res = 0
   if not(rc.mine) then return
   gosub check.dir
   if not(dir.ok) then return
   openpath rc.dir to rf else return
   mark.mapping rf, off
   selectv rf to rsl
   loop
      readnext nm from rsl else exit
      if nm[1, 1] = 'c' then
         rc.path = rc.dir : '/' : nm
         gosub check.file
         if file.ok then
            read rec from rf, nm else rec = ''
            gosub parse.copy
            if cp.ok and cp.file = '' then
               if nm = 'c' : downcase(digest('' : @fm : cp.id, 0, 'SHA256')) then
                  text<-1> = cp.id : @vm : cp.date : @vm : cp.time
                  res += 1
               end
            end
         end
      end
   until res >= MAXLIST
   repeat
   close rf
   return
end

* END-CODE
