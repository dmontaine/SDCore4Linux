* 22 Oct 26 dm  New (S.75, TK-0.1).
* 22 Oct 26 dm  ctx<TK.C.GEN>: an app that has cleared or repainted the screen under the frame has all of it written again (TK-1, tool.keys).
* 28 Oct 26 dm  S.88 L1 (F1): the cache is forgotten when the context's epoch is not the one last drawn ($tk_open makes a new one, $tk_close clears
*               it: a second open of an app drew no border, status line or keys) or when the layout's geometry changed ($tk_layout 'refresh').
* 30 Oct 26 dm  S.88 F0a: the key table and the pane are kept in common /tkreg/ on every call, so that F1 can list the keys of the pane ($tk_help 'box'); $tk_close clears them.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $tk_frame(ctx, keys, pane, msg)
*
*     keys   the app's key table      pane   the pane with the focus      msg   the message for the status line (null for none)
*
*   Draws, on the rows the layout gives (tk.h): the status line, in reverse video, with the pane in brackets first and the message after it; the border,
*   one line across, in the library's own line character; the function-key row, in the bar's style, made by $tk_fkeys from the key table; and the app's name
*   and the audience at the right end of row 0.  Each is written only when its text has changed since it was last written: an app calls this on every key
*   and about once a second, and an idle app must not rewrite 140 cells each time.  The cursor is put back where the widget with the focus had left it
*   (SCREEN TEXT leaves it after the text).  An app that has a menu bar draws the menu first; this writes only the right end of row 0.
*
*   The values it compares with are kept in a common block, so one app at a time.  They are forgotten, and all four parts written again, when the context
*   is of another open than the one last drawn (its epoch, ctx<TK.C.EPOCH>: $tk_open makes a new one and $tk_close clears it), when the layout's geometry
*   is not the one last drawn (W, H and the three rows: $tk_layout 'refresh' after a resize), and when the app raised ctx<TK.C.GEN> (it cleared or
*   repainted the screen under the frame).
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine tk_frame(ctx, keys, pane, msg)
$catalog $tk_frame

$include sl.h
$include tk.h

   common /tkframe/ last.stat, last.keys, last.bord, last.top, last.gen, last.geo
   common /tkepoch/ ep.next, ep.drawn             ;* the frame cache's epoch ($tk_open counts, $tk_close clears)
   common /tkreg/ reg.keys, reg.pane, reg.epoch   ;* the key table and the pane of the app that is drawing, for $tk_help's list of keys ($tk_close clears)

   reg.keys = keys
   reg.pane = pane
   reg.epoch = ctx<TK.C.EPOCH>
   lw = ctx<TK.C.W>
   ystat = ctx<TK.C.YSTAT>
   ybord = ctx<TK.C.YBORD>
   ykeys = ctx<TK.C.YKEYS>
   geo = lw : '/' : ctx<TK.C.H> : '/' : ystat : '/' : ybord : '/' : ykeys
   * the app raised ctx<TK.C.GEN>: the screen under the frame was cleared or repainted (a resize, the cursor lock lifted), so none of what was written is known to be there.
   * F1 (28 Oct 26): so too when this is another open of an app (the epoch) or another layout (the geometry) than the one last drawn
   forget = 0
   if ctx<TK.C.GEN> # last.gen then forget = 1
   if ctx<TK.C.EPOCH> # ep.drawn then forget = 1
   if geo # last.geo then forget = 1
   if forget then
      last.gen = ctx<TK.C.GEN>
      ep.drawn = ctx<TK.C.EPOCH>
      last.geo = geo
      last.stat = ''
      last.keys = ''
      last.bord = ''
      last.top = ''
   end

   * the status line: the pane in brackets, then the message
   t = ''
   if pane # '' then t = '[' : pane : ']'
   if msg # '' then t := (if t = '' then '' else '  ') : msg
   t = fmt(t[1, lw], lw : 'L')
   if t = last.stat then
      null
   end else
      last.stat = t
      keep.cur = ''
      call $sl_curat('get', keep.cur)
      screen text t at 0,ystat attr 'reverse'
      call $sl_curat('back', keep.cur)
   end

   * the border, once for a layout
   b = lw : '/' : ybord
   if b # last.bord then
      last.bord = b
      call $sl_line('h', 0, hc)
      keep.cur = ''
      call $sl_curat('get', keep.cur)
      screen text str(hc, lw) at 0,ybord
      call $sl_curat('back', keep.cur)
   end

   * the function keys of the pane with the focus
   call $tk_fkeys(ctx, keys, pane, ft)
   if ft # last.keys then
      last.keys = ft
      keep.cur = ''
      call $sl_curat('get', keep.cur)
      screen text ft at 0,ykeys attr 'bar'
      call $sl_curat('back', keep.cur)
   end

   * the app and the audience, at the right end of row 0
   a = ctx<TK.C.APP> : '  ' : ctx<TK.C.AUD>
   a = a : ' '
   if a # last.top then
      last.top = a
      keep.cur = ''
      call $sl_curat('get', keep.cur)
      screen text a at lw - len(a),0 attr 'bar'
      call $sl_curat('back', keep.cur)
   end

   return
end

* END-CODE
