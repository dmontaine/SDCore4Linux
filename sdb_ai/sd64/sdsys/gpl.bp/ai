*
* START-DESCRIPTION:
*
*   AI text          shows what will be sent, asks whether to send it, and prints the answer
*
*   A text that ends with a question mark is put in quotes ("what is a select list?"): the command line is taken by TCL first, and a TCL command that ends with ? is added to the
*   command stack without being run (cproc, "add to stack without execution"), so this verb never sees it.  The quotes are taken off before anything is shown or sent.
*
*   THE PREVIEW IS NOT OPTIONAL HERE.  The text is shown with the provider and model that will receive it and the size, and nothing is sent unless the person answers y.  An
*   answer of anything else, an empty answer and an input that has ended (a pipe, a phantom) all send nothing, so a program cannot make this verb send by feeding it.  What is
*   sent is the text and one fixed sentence that asks for a short plain answer; nothing else of the account, the session or the data is added.
*
*   WHO MAY USE IT IS NOT DECIDED HERE.  The helper (sd-ai) reads the caller's operating system user off the connection and refuses an account that is not in the group
*   sdaiusers (modify.account NAME ai-on); this verb asks the helper for its status first only to say so in words, before it shows a preview of something that cannot
*   be sent.  The request itself goes through KERNEL(K$AI.START), which writes the audit line (account, this program's name, the size - never the text) before the
*   connection is made.  The reply is plain ASCII, with anything else already replaced by the helper, and is printed as text, never run.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program ai
$catalog $ai

$include int$keys.h
$include keys.h
$include err.h

   @system.return.code = -ER$ARGS

   words = trim(@sentence)
   sp = index(words, ' ', 1)
   question = ''
   if sp > 0 then question = trim(words[sp + 1, 99999])
   q1 = question[1, 1]
   if len(question) >= 2 and (q1 = '"' or q1 = "'") and question[len(question), 1] = q1 then question = trim(question[2, len(question) - 2])
   if question = '' then stop sysmsg(11623)                                     ;* ai text

*  A request that an earlier run left in the kernel (a break while it waited) is given up first; the kernel allows one at a time
   void kernel(K$AI.CANCEL, 0)

*  What the helper says about this caller, before anything is shown
   reply = kernel(K$AI.STATUS, 0)
   if reply<1> # 'D' then
      @system.return.code = -ER$FAILED
      stop sysmsg(11607)                                                        ;* The AI helper could not be reached
   end
   st = jparse(reply<2>)
   if status() or st{'t'} # 'status' then
      @system.return.code = -ER$FAILED
      code = st{'code'}
      msg = st{'msg'}
      stop sysmsg(11627, code, msg[1, 100])                                     ;* The AI did not answer: %1 (%2)
   end
   prov = st{'provider'}
   model = st{'model'}
   if prov = '' then
      @system.return.code = -ER$FAILED
      stop sysmsg(11624)                                                        ;* The AI is off
   end
   if not(st{'gate'}) then
      @system.return.code = -ER$FAILED
      stop sysmsg(11625, @who)                                                  ;* This account may not use the AI
   end
   if model = '' then
      @system.return.code = -ER$FAILED
      stop sysmsg(11626, prov, 'model')
   end
   if not(st{'key'}) then
      @system.return.code = -ER$FAILED
      stop sysmsg(11626, prov, 'key')
   end

*  The preview
   system.text = 'You are answering a question typed at the terminal of SD Core for Linux, a multivalue database. Answer briefly, in plain text without markup.'
   display sysmsg(11628, prov, model, len(question) + len(system.text))
   display system.text
   display question
   crt sysmsg(11629) : ' ' :
   input ans
   ans = trim(downcase(ans))
   if ans # 'y' and ans # 'yes' then
      @system.return.code = 0
      stop sysmsg(11630)                                                        ;* Nothing was sent.
   end

*  The request
   reply = kernel(K$AI.START, system.text : @fm : 1024 : @fm : question)
   if reply<1> # 'OK' then
      @system.return.code = -ER$FAILED
      if reply<2> = 'nohelper' then stop sysmsg(11607)
      stop sysmsg(11627, reply<2>, 'the request was not sent')
   end
   display sysmsg(11631)                                                        ;* Waiting for the answer ...
   got = 0
   for tries = 1 to 1600
      reply = kernel(K$AI.POLL, 0)
      if reply<1> # 'W' then
         got = 1
         exit
      end
      nap 250
   next tries
   if not(got) then
      void kernel(K$AI.CANCEL, 0)
      reply = 'E' : @fm : 'timeout'
   end

*  The answer
   if reply<1> # 'D' then
      @system.return.code = -ER$FAILED
      if reply<2> = 'nohelper' then stop sysmsg(11607)
      stop sysmsg(11627, reply<2>, 'no answer came')
   end
   j = jparse(reply<2>)
   if status() then
      @system.return.code = -ER$FAILED
      stop sysmsg(11627, 'badreply', 'the answer could not be read')
   end
   if j{'t'} # 'ok' then
      @system.return.code = -ER$FAILED
      code = j{'code'}
      if code = 'disabled' then stop sysmsg(11624)
      if code = 'nogate' then stop sysmsg(11625, @who)
      if code = 'nomodel' then stop sysmsg(11626, prov, 'model')
      if code = 'nokey' then stop sysmsg(11626, prov, 'key')
      msg = j{'msg'}
      stop sysmsg(11627, code, msg[1, 100])
   end

   width = system(2) - 1
   if width < 40 or width > 200 then width = 79
   text = change(change(j{'text'}, char(13), ''), char(10), @fm)
   display ''
   for i = 1 to dcount(text, @fm)
      call $tk_wrap(text<i>, width, pieces)
      if pieces = '' then display ''
      for p = 1 to dcount(pieces, @fm)
         display trimb(pieces<p>)
      next p
   next i
   display ''
   if j{'truncated'} then display sysmsg(11632)                                 ;* The answer was cut off at the length limit
   if j{'replaced'} > 0 then display sysmsg(11633, j{'replaced'})               ;* %1 characters of the answer were replaced with ?
   display sysmsg(11634, j{'in'}, j{'out'}, j{'provider'})                      ;* Tokens used: %1 in, %2 out (%3)
   @system.return.code = 0
   stop
end

* END-CODE
