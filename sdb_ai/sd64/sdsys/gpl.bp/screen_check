* The subroutine that SCREEN CHECK calls: add a check box to a form.
* Copyright (c) 2026, SD Core for Linux.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 12 Oct 26 dm  New.
* 22 Oct 26 dm  PLACE: where the label is (left by default; it was on the right).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   SCREEN CHECK f, id, text {AT x,y} {VALUE v} {PLACE where}
*
*   is compiled into
*
*   call !screen_check(f, id, text, x, y, value, place, ret, status)
*
*     f id     the form and the widget's name in it (as SCREEN LABEL)
*     text     the label, shown next to [x] or [ ]
*     x y      the place of the box and its label from the form's top left corner, default 1,1
*     value    1 to start checked (default 0)
*     place    where the label is, in relation to the box: left (the default: text [x]), right ([x] text), above or below (two rows)
*     status   0 added; 1 not (ELSE)
*
*   The space bar checks and unchecks it, and so does a click on the box or on the label; SCREEN GET f, id answers 1 or 0.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine screen_check(f, id, text, ax, ay, value, place, ret, status)
$catalog !screen_check

   ret = ''
   status = 1
   w = collection()
   w{'id'} = id
   w{'text'} = text
   x = 1
   y = 1
   if ax # '' then x = ax + 0
   if ay # '' then y = ay + 0
   w{'x'} = x
   w{'y'} = y
   w{'value'} = value
   w{'place'} = place
   call $sl_check('init', w, '', '', r)
   call $sl_wadd(f, w, ok)
   if ok then status = 0

   return
end

* END-CODE
