* START-DESCRIPTION:
* MODIFY.ACCOUNT account action {action ...}      every action except ADD and DELETE, any number in one command (19 Oct 26)
* MODIFY.ACCOUNT account ADD <username>
* MODIFY.ACCOUNT account DELETE <username>
* MODIFY.ACCOUNT account SUSPENDED
* MODIFY.ACCOUNT account UNSUSPENDED
* MODIFY.ACCOUNT account FILES-ON
* MODIFY.ACCOUNT account FILES-OFF
* MODIFY.ACCOUNT account FILES-WRITE-ON
* MODIFY.ACCOUNT account FILES-WRITE-OFF
*
* 18 Oct 26 dm - S.65 write group.  FILES-WRITE-ON / FILES-WRITE-OFF add or remove the account's person from the Linux group sdfileswrite.  A
*   files-only login (sdfiles) reads files on this server without it and may change them (write, delete, lock, clear) only with it: the
*   administrator of the server a remote definition points at decides.  Off for a new account.  The person must already be in sdfiles
*   (11523 otherwise: the group alone gives nothing).  The line printed is "Account %1 has FILES-WRITE yes|no", read back from /etc/group.
*
* 17 Oct 26 dm - S.65 slice 2c.  FILES-ON / FILES-OFF add or remove the account's person from the Linux group sdfiles: the files-only
*   login route SDNet uses (an API login that may work with files and do nothing else).  Off for a new account; sdapi, when also held, still
*   gives the whole API.  A user account only; the line printed is "Account %1 has FILES yes|no", read back from /etc/group.
*
* 18 Sep 26 dm - TEARDOWN.  One administrator (SDSYS) and one VOC layer means
*   this verb no longer changes ranks, OS grants or API routes - those went
*   with the tier model (S.25/S.27/S.28).  What remains is the grant mechanic
*   and the suspension:
*
*   ADD/DELETE edit the account's Linux group through sd-elevate, exactly as
*   before - that is what a grant IS (W.8: usermod -aG is the grant; this verb
*   is the same change with SD's own audit line).  DELETE stays deliberately
*   unguarded: taking access away is always allowed.
*
*   SUSPENDED sets the suspension flag - field 5, W.7: a suspension is a
*   denial, not a rank, and it hangs on its own flag now.  The doors are the
*   same as before: LOGIN, CPROC's account entry, ssh (via the ordinary
*   sign-on) and the API all refuse it.  Nothing changes in Linux, which is
*   what makes lifting it free.  UNSUSPENDED clears the flag and the retired
*   field 6.  Nobody suspends the account they logged in to or stand in
*   (10112): the session would work until it ended and could not be
*   re-established.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $modify.account
$catalog $MODIFYA

$include keys.h
$include int$keys.h
$include parser.h
$include err.h
* 
deffun is_grp_member(user,group) calling '!is_grp_member'
deffun is_group(group) calling '!is_group'
deffun valid_os_name(name) calling '!valid_os_name'

   prompt ''

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end     

   parser = "!PARSER"

   @system.return.code = -ER$ARGS     ;* Preset for argument errors
   
   openpath @sdsys:@ds:'accounts' to acc.f else
      @system.return.code = -status()
      stop sysmsg(6000) ;* Cannot open ACCOUNTS file in SDSYS account
   end

   call @parser(PARSER$RESET, 0, @sentence, 0)
   
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb modify.Account

   * Get next token, account name
   call @parser(PARSER$GET.TOKEN, token.type, acc.name, keyword)
   if token.type = PARSER$END then
      gosub show.usage
      stop
   end
   *
   acc.name = downcase(acc.name)   ;* account names are always lower case (13 Sep 26)
   if acc.name = 'sdsys' then
      stop sysmsg(2202) ;* Account name is invalid
   end   
   *
   read acc.rec from acc.f, acc.name else      
      stop sysmsg(6003) ;* Account name is invalid
   end
   
   group.name = acc.rec<ACC$GROUP>   ;* get associated group

* 09 Sep 26 dm - PRE_RELEASE 18.  THE TOKEN IS READ HERE NOW, NOT INSIDE THE
*   is_group BRANCH BELOW, because a tier change must not depend on the
*   account's Linux group being resolvable - a tier is a fact about the
*   register.  The ADD/DELETE arm is unchanged apart from losing its own
*   GET.TOKEN call; it still sees the same token in the same variable.
* 18 Sep 26 dm - TEARDOWN.  The tier changed to a flag and the register is the
*   fact about the suspension, so the same placement serves it.
   call @parser(PARSER$GET.TOKEN, token.type, action, keyword)
   if token.type = PARSER$END then
      gosub show.usage    ;* 19 Oct 26: no action at all printed "sdu_x is not a valid Linux Group"
      stop
   end
   typed.first = action
   action = upcase(action)

* 18 Oct 26 dm - A word after the action was read by nobody: MODIFY.ACCOUNT acc VOC-OFF BP-OFF did the first and said nothing of the
*   second.  A security verb that does half of what it was asked and is silent about the rest was then REFUSED (11714), the first action not done
*   either.  19 Oct 26 (owner: "modify.account should be changed to handle more than one gate at a time"): the words are now ALL carried out,
*   or the whole command is refused BEFORE ANYTHING CHANGES.  validate.actions reads every word first (an unknown word 11790, two words that
*   set one access to different states 11791, ADD or DELETE among other words 11714); run.actions then does them in a FIXED order whatever
*   order they were typed, each through do.action, each reported and audited as it always was, and a run of more than one ends with a line
*   saying which were done (11793) or which were not (11794).  Silence about half of a command is still impossible.  ADD and DELETE take a
*   user name and stand alone: they read it next, and a word after it is refused (further down).
   if (action # 'ADD') and (action # 'DELETE') then
      actions = action
      typed.list = typed.first
      loop
         call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
      until token.type = PARSER$END
         actions<-1> = upcase(token)
         typed.list<-1> = token
      repeat
      gosub validate.actions
      gosub run.actions
      stop
   end

* 20 Sep 26 dm - S.29, THE ROUTE WORDS.  Each NAMES THE STATE WANTED, as the
*   Windows port's do (its modifya:284-296), so the same four words mean the
*   same thing here and at CREATE.ACCOUNT, and the door opens both ways: SSH
*   after NONE re-widens exactly as NONE after BOTH narrows.  A one-way build
*   passes every obvious test - this teardown already paid for that once, when
*   deleting the tier keywords left no way to lift a suspension (UNSUSPENDED
*   exists because of it) - so set.route is driven in both directions.
   goto add.delete.arm

* 19 Oct 26 dm - DO.ACTION: ONE ACTION, called by run.actions once for each word of the command (it was inline and each case ended in stop, which is
*   why a second word could not be done; the case lines are unchanged and each now ends in return).  action holds the word, in capitals.
do.action:
   begin case
      case action = 'SUSPENDED'
         gosub set.suspended
         return
      case action = 'UNSUSPENDED'
         gosub set.unsuspended
         return
* 13 Oct 26 dm - S.63.  The OS-access gates, the Windows port's four words over two independent fields (so
*   SH-OFF says nothing about OS.EXECUTE).  Off unless typed.  os.set does the work; os.field and
*   os.want carry it.  ssh/api/both/none above are a different kind of word: one selector for the
*   state of two doors; these are switches, and both and none already mean ssh and api.
      case action = 'SH-ON'
         os.field = ACC$SH ; os.want = @true
         gosub os.set
         return
      case action = 'SH-OFF'
         os.field = ACC$SH ; os.want = @false
         gosub os.set
         return
      case action = 'OS-ON'
         os.field = ACC$OS.EXEC ; os.want = @true
         gosub os.set
         return
      case action = 'OS-OFF'
         os.field = ACC$OS.EXEC ; os.want = @false
         gosub os.set
         return
* 16 Oct 26 dm - the SD.ACCOUNTS gate (QM4 gap 22): SD-ON / SD-OFF, a third switch beside the other two.  Unlike SH it is
*   allowed on a GROUP account, because what it opens is decided for each person by the groups they are in.
      case action = 'SD-ON'
         os.field = ACC$SD.ACCOUNTS ; os.want = @true
         gosub os.set
         return
      case action = 'SD-OFF'
         os.field = ACC$SD.ACCOUNTS ; os.want = @false
         gosub os.set
         return
* 17 Oct 26 dm - S.64 (owner, 17 Oct): the edit gates, six more switches beside the other three.  Like SD-ON they are allowed on
*   a group account.  They take effect at the person's next SIGN-ON, not at LOGTO (LOGIN and the API server load them).
      case action = 'VOC-ON'
         os.field = ACC$VOC.EDIT ; os.want = @true
         gosub os.set
         return
      case action = 'VOC-OFF'
         os.field = ACC$VOC.EDIT ; os.want = @false
         gosub os.set
         return
      case action = 'BP-ON'
         os.field = ACC$BP.EDIT ; os.want = @true
         gosub os.set
         return
      case action = 'BP-OFF'
         os.field = ACC$BP.EDIT ; os.want = @false
         gosub os.set
         return
      case action = 'DICT-ON'
         os.field = ACC$DICT.EDIT ; os.want = @true
         gosub os.set
         return
      case action = 'DICT-OFF'
         os.field = ACC$DICT.EDIT ; os.want = @false
         gosub os.set
         return
* 17 Oct 26 dm - S.65 slice 1 (SDNet, owner's rulings of 17 Oct): NET-ON / NET-OFF, the gate for opening a file on another SD server.  Allowed on a
*   group account as SD-ON is.  Account-scoped: it takes effect at the person's next account entry (sign-on, LOGTO, the API server).  The gate takes
*   effect for the remote-file slices that follow and does nothing yet.
      case action = 'NET-ON'
         os.field = ACC$NET ; os.want = @true
         gosub os.set
         return
      case action = 'NET-OFF'
         os.field = ACC$NET ; os.want = @false
         gosub os.set
         return
* 18 Oct 26 dm - S.66 (the shared account): SHARED-READ-ON / SHARED-READ-OFF and SHARED-WRITE-ON / SHARED-WRITE-OFF, the two gates for the files of the
*   group account named shared.  Allowed on a group account as NET-ON is (and on the account shared itself: the words on THAT account decide what the
*   members of its Linux group can do inside it).  Account-scoped: they take effect at the person's next account entry.  The register says 'yes' or
*   'no' (a decided state); read is ON when the field is blank, so SHARED-READ-OFF must write 'no' even to a blank record (os.set's os.was).
      case action = 'SHARED-READ-ON'
         os.field = ACC$SHARED.READ ; os.want = @true
         gosub os.set
         return
      case action = 'SHARED-READ-OFF'
         os.field = ACC$SHARED.READ ; os.want = @false
         gosub os.set
         return
      case action = 'SHARED-WRITE-ON'
         os.field = ACC$SHARED.WRITE ; os.want = @true
         gosub os.set
         return
      case action = 'SHARED-WRITE-OFF'
         os.field = ACC$SHARED.WRITE ; os.want = @false
         gosub os.set
         return
* 17 Oct 26 dm - S.65 slice 2c: FILES-ON / FILES-OFF, membership of the Linux group sdfiles, the files-only SDNet login route (an API login
*   that may open, read and write files and do nothing else).  Like the api word it changes a Linux group, not the register, so it needs
*   a user account; sdapi, when the person is also in it, still gives the whole API.  Takes effect at the person's next login.
      case action = 'FILES-ON'
         files.grp = 'sdfiles'
         files.want = @true
         gosub set.files
         return
      case action = 'FILES-OFF'
         files.grp = 'sdfiles'
         files.want = @false
         gosub set.files
         return
* 18 Oct 26 dm - S.65 write group: the same helper, the group sdfileswrite.
      case action = 'FILES-WRITE-ON'
         files.grp = 'sdfileswrite'
         files.want = @true
         gosub set.files
         return
      case action = 'FILES-WRITE-OFF'
         files.grp = 'sdfileswrite'
         files.want = @false
         gosub set.files
         return
      case action = 'SSH'
         want.ssh = @true  ; want.api = @false ; gosub set.route
         return
      case action = 'API'
         want.ssh = @false ; want.api = @true  ; gosub set.route
         return
      case action = 'BOTH'
         want.ssh = @true  ; want.api = @true  ; gosub set.route
         return
      case action = 'NONE'
         want.ssh = @false ; want.api = @false ; gosub set.route
         return
* validate.actions has refused every word that is not one of these, so this is only a net: nothing was changed.
      case 1
         @system.return.code = -ER$ARGS
         crt sysmsg(11790, downcase(action))  ;* %1 is not a modify.account action, and nothing was changed
   end case
   return

add.delete.arm:
   if is_group(group.name) then
      if (upcase(action) = 'ADD') or (upcase(action) = 'DELETE') then
      *  valid action
      *   Get next token, user name
         call @parser(PARSER$GET.TOKEN, token.type, user.name, keyword) 
         if token.type = PARSER$END then
            stop sysmsg(10016)  ;* Missing User Name
         end
*        18 Oct 26 dm - one user name only; a second was added or removed by nobody (see the check after the action word above)
         call @parser(PARSER$GET.TOKEN, token.type, extra.word, keyword)
         if token.type # PARSER$END then
            stop sysmsg(11714, extra.word)  ;* modify.account does one action at a time, and nothing was changed: %1 was not carried out
         end

         if (upcase(action) = 'ADD') then

* 18 Sep 26 dm - TEARDOWN (S.25).  The upward-grant gate is gone with the tier
*   model: there is no rank to climb any more.  ADD below makes the identical
*   "sd-elevate addgroup" call that GRANT made, and usermod -aG is the grant
*   (W.8); the group test at CPROC's LOGTO is the whole of the wall.
            * Add user to group
            * does user belong to sdusers?
            if is_grp_member(user.name,'sdusers') then
            * this user looks legit, add to group
            * first check to see if user is already a member of the group
               if is_grp_member(user.name,group.name) THEN
                  crt sysmsg(10017,user.name,group.name)  ;* %1 is already a member of group %2
               end else
                  * Modified by Composer AI - 2026/06/10.
                  * Use shared !valid_os_name before os.execute (phase 2).
                  * if convert(os.name.chars, '', user.name) # '' ...
                  if not(valid_os_name(user.name)) or not(valid_os_name(group.name)) then
                     crt sysmsg(10019,user.name,group.name,2) ;* Unable to add user %1 to group %s status: %2
                  end else
* 09 Sep 26 dm - PRE_RELEASE 14.  Through the helper; see SET_PASSWD for why.
*   NOTE THE ARGUMENT ORDER REVERSES: raw usermod is "-aG <group> <user>",
*   sd-elevate is "addgroup <user> <group>".
                  os.execute "sudo /usr/local/sbin/sd-elevate addgroup ":user.name:" ":group.name
                  * --------------------
                  stat = OS.ERROR()
                  if stat = 0 then
                     void kernel(K$AUDIT, 'modify.account add account=' : acc.name : ' to=' : user.name)  ;* 07 Oct 26 PAL-24: lower case
                     crt sysmsg(10018,user.name,group.name)  ;* %1 added to group %2
                  end else
                     crt sysmsg(10019,user.name,group.name,stat) ;* Unable to add user %1 to group %s status: %2
                  end
                  end
               end 
            end else
               crt user.name
               crt sysmsg(10020,user.name) ;* %1 is not a member of sdusers, not allowed
            end 
         
         end else
            * already tested action, must be delete
            if is_grp_member(user.name,group.name) THEN
               * Modified by Composer AI - 2026/06/10.
               * Use shared !valid_os_name before os.execute (phase 2).
               if not(valid_os_name(user.name)) or not(valid_os_name(group.name)) then
                  crt sysmsg(10022,user.name,group.name,2) ;* Unable to remove user %1 from group %s status: %2
               end else
* 09 Sep 26 dm - PRE_RELEASE 14, AND THIS ONE IS A BUG FIX AS WELL AS A
*   HARDENING.  It was "sudo deluser <user> <group>", and ***deluser IS
*   DEBIAN-ONLY*** - this installer serves Arch and RHEL too, where the command
*   does not exist and removing a user from a group simply failed.  sd-elevate
*   uses gpasswd -d, which is in shadow-utils everywhere.
               os.execute "sudo /usr/local/sbin/sd-elevate delgroup ":user.name:" ":group.name
               * --------------------
               stat = OS.ERROR()
                  if stat = 0 then
                     void kernel(K$AUDIT, 'modify.account delete account=' : acc.name : ' from=' : user.name)  ;* 07 Oct 26 PAL-24: lower case
                     crt sysmsg(10021,user.name,group.name) ;*  %1 removed from group %2
                  end else
                     crt sysmsg(10022,user.name,group.name,stat) ;* Unable to remove user %1 from group %s status: %2
                  end
               end
            end else
               crt sysmsg(10023,user.name,group.name) ;* %1 is not a member of  %2
            end 
         
         end
         
         
      end else
         crt 'modify.account Action Must Be add, delete, ssh, api, both, none,'
         crt '   sh-on, sh-off, os-on, os-off, sd-on, sd-off, voc-on, voc-off, bp-on, bp-off, dict-on, dict-off, net-on, net-off,'
         crt '   shared-read-on, shared-read-off, shared-write-on, shared-write-off,'
         crt '   files-on, files-off, files-write-on, files-write-off, suspended or unsuspended'
      end

   end else
     crt sysmsg(10024,group.name) ;* %1 is not a valid Linux Group
   end
   stop

*****************************************************************************
* SHOW.USAGE  -  the syntax, for no account and for no action
*
* 19 Oct 26 dm - one place (the usage was typed out in the middle of the program), and printed for an account with NO ACTION as well: that used to
*   fall through to the group test and say "sdu_x is not a valid Linux Group".

show.usage:
   crt 'Command Syntax:  modify.account <account> add | delete <username>'
   crt '                 modify.account <account> ssh | api | both | none'
   crt '                 modify.account <account> sh-on | sh-off'
   crt '                 modify.account <account> os-on | os-off'
   crt '                 modify.account <account> sd-on | sd-off'
   crt '                 modify.account <account> voc-on | voc-off | bp-on | bp-off | dict-on | dict-off'
   crt '                 modify.account <account> net-on | net-off'
   crt '                 modify.account <account> shared-read-on | shared-read-off | shared-write-on | shared-write-off'
   crt '                 modify.account <account> files-on | files-off | files-write-on | files-write-off'
   crt '                 modify.account <account> suspended | unsuspended'
   crt '  Any of the actions except add and delete may be given together in one command, for example'
   crt '                 modify.account <account> sh-on os-on voc-on bp-on'
   crt '  They are all carried out, in the order of the list above whatever order they were typed, or none is.'
   return

*****************************************************************************
* VALIDATE.ACTIONS  -  every word of the command, BEFORE ANY OF THEM IS DONE
*
* 19 Oct 26 dm - owner: "modify.account should be changed to handle more than one gate at a time".  actions holds the words in capitals and
*   typed.list the same words as typed.  Nothing is changed here, and every refusal ends the program (stop), so a command is carried out
*   whole or not at all as far as its WORDS go:
*     - ADD and DELETE take a user name and stand alone: among other words they are refused with 11714 (the first word being ADD or DELETE is
*       the old arm below, which refuses a word after the user name with the same message);
*     - a word that is not an action is refused with 11790, as typed;
*     - two different words of the same slot set one access to different states (sh-on and sh-off, or ssh and api: say both) and are refused
*       with 11791; so are files-off with files-write-on, which asks for the write group of an access it takes away.
*   word.arr is also the ORDER the words are carried out in (run.actions): the routes, the register switches, the files words (files-on
*   before files-write-on, which needs it), and the suspension last.  slot.arr holds the slot of each word.  do.action's case lines are the
*   third list: test-modifya-multi-units.py holds the three in step.
*   The conflict test compares DIFFERENT words only: the same word twice is one action (want.at is set once).

validate.actions:
   word.arr = convert(',', @fm, 'SSH,API,BOTH,NONE,SH-ON,SH-OFF,OS-ON,OS-OFF,SD-ON,SD-OFF,VOC-ON,VOC-OFF,BP-ON,BP-OFF,DICT-ON,DICT-OFF,NET-ON,NET-OFF,SHARED-READ-ON,SHARED-READ-OFF,SHARED-WRITE-ON,SHARED-WRITE-OFF,FILES-ON,FILES-OFF,FILES-WRITE-ON,FILES-WRITE-OFF,SUSPENDED,UNSUSPENDED')
   slot.arr = convert(',', @fm, 'R,R,R,R,SH,SH,OS,OS,SD,SD,VOC,VOC,BP,BP,DICT,DICT,NET,NET,SR,SR,SW,SW,F,F,FW,FW,S,S')
   n.words = dcount(actions, @fm)
   pos.of = ''
   want.at = ''
   for i = 1 to n.words
      w = actions<i>
      if (w = 'ADD') or (w = 'DELETE') then
         @system.return.code = -ER$ARGS
         stop sysmsg(11714, typed.list<i>)  ;* add and delete take a user name and stand alone, and nothing was changed: %1 was not carried out
      end
      locate w in word.arr<1> setting p else
         @system.return.code = -ER$ARGS
         stop sysmsg(11790, typed.list<i>)  ;* %1 is not a modify.account action, and nothing was changed
      end
      pos.of<i> = p
      want.at<p> = 1
   next i
   for i = 1 to n.words - 1
      for j = i + 1 to n.words
         if actions<i> # actions<j> then
            pi = pos.of<i>
            pj = pos.of<j>
            if slot.arr<pi> = slot.arr<pj> then
               @system.return.code = -ER$ARGS
               stop sysmsg(11791, downcase(actions<i>), downcase(actions<j>))  ;* %1 and %2 set the same access to different states, and nothing was changed
            end
         end
      next j
   next i
   locate 'FILES-OFF' in actions<1> setting p1 then
      locate 'FILES-WRITE-ON' in actions<1> setting p2 then
         @system.return.code = -ER$ARGS
         stop sysmsg(11791, 'files-off', 'files-write-on')
      end
   end
   return

*****************************************************************************
* RUN.ACTIONS  -  the words, one after the other, each through do.action
*
* 19 Oct 26 dm - in the order of word.arr (validate.actions made it), whatever order they were typed.  Each action reports itself and audits itself
*   exactly as it did when it was the only one; the account's record is read again before each (an earlier action wrote it).  An action is
*   "carried out" when it left @system.return.code at 0, which includes "already had that access; nothing changed"; a refusal or a failed
*   write leaves a negative code.  A run of more than one ends with one line: 11793 when every action was carried out, 11794 naming the ones
*   that were not (a Linux group change can fail after a register write succeeded, and the line says so rather than leaving the person to
*   count).  The code after the run is 0 only if every action was carried out.  The remaining actions are still attempted after a failure:
*   they are independent accesses, and each says what it did.

run.actions:
   run.list = ''
   for p = 1 to dcount(word.arr, @fm)
      if want.at<p> then run.list<-1> = word.arr<p>
   next p
   n.run = dcount(run.list, @fm)
   done.list = ''
   undone.list = ''
   for i = 1 to n.run
      action = run.list<i>
      read acc.rec from acc.f, acc.name else null
      @system.return.code = 0
      gosub do.action
      if @system.return.code = 0 then
         done.list<-1> = downcase(action)
      end else
         undone.list<-1> = downcase(action)
      end
   next i
   if n.run > 1 then
      if undone.list = '' then
         crt sysmsg(11793, acc.name, n.run, change(done.list, @fm, ', '))  ;* Account %1: %2 actions carried out: %3
      end else
         if done.list = '' then done.said = 'none' else done.said = change(done.list, @fm, ', ')
         crt sysmsg(11794, acc.name, done.said, change(undone.list, @fm, ', '))  ;* Account %1: NOT every action was carried out. Done: %2. Not done: %3
      end
   end
   if undone.list = '' then
      @system.return.code = 0
   end else
      @system.return.code = -ER$FAILED
   end
   return

*****************************************************************************
* SET.SUSPENDED  -  MODIFY.ACCOUNT <account> SUSPENDED
*
* 18 Sep 26 dm - TEARDOWN (W.7).  The suspension is its own flag now: field 5,
*   blank means in service and SUSPENDED means suspended.  Same doors as
*   before - LOGIN, CPROC's account entry, ssh (the ordinary sign-on) and the
*   API all refuse the flag - and NOTHING CHANGES IN LINUX, which is what
*   makes lifting it free.  There is no prior tier to remember, so field 6
*   (the retired ACC$PRIOR.TIER) is cleared rather than written.
*
*   NOBODY SUSPENDS THE ACCOUNT THEY LOGGED IN TO OR STAND IN (10112): the
*   session would work until it ended and could not be re-established.

set.suspended:
   if upcase(trim(acc.rec<ACC$SUSPENDED>)) = 'SUSPENDED' then
      crt sysmsg(10110, acc.name, 'SUSPENDED')  ;* %1 is already %2; nothing changed
      return
   end
   if (acc.name = downcase(@logname)) or (acc.name = downcase(@who)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10112)  ;* You cannot suspend your own account or the one you are standing in
      return
   end

* 06 Oct 26 dm - PAL-18 (parity audit), the Windows port's tier.set: the register
*   record is read again UNDER A LOCK before the flag is written, so two
*   administrators changing one account cannot overwrite each other with the copy
*   this verb read at the start, and a failed write is reported (10114), not
*   dropped.  Readu, then write on error, then release on the failure arm.
   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   acc.new<ACC$SUSPENDED> = 'SUSPENDED'
   acc.new<ACC$PRIOR.TIER> = ''
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account suspend account=' : acc.name)  ;* 07 Oct 26 PAL-24: lower case
   crt sysmsg(10193, acc.name)  ;* Account %1 is now suspended
   return

*****************************************************************************
* SET.UNSUSPENDED  -  MODIFY.ACCOUNT <account> UNSUSPENDED
*
* 18 Sep 26 dm - TEARDOWN (W.7).  The way back is a keyword now, because there
*   is no tier to name.  Clears the flag and the retired field 6.

set.unsuspended:
   if upcase(trim(acc.rec<ACC$SUSPENDED>)) # 'SUSPENDED' then
      crt sysmsg(10194, acc.name)  ;* %1 is not suspended; nothing changed
      return
   end

* 06 Oct 26 dm - PAL-18: under a lock, and a failed write reported, as SET.SUSPENDED.
   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   acc.new<ACC$SUSPENDED> = ''
   acc.new<ACC$PRIOR.TIER> = ''
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account unsuspended account=' : acc.name)  ;* 07 Oct 26 PAL-24: lower case
   crt sysmsg(10192, acc.name)  ;* Account %1 is no longer suspended
   return

*****************************************************************************
* SET.ROUTE  -  MODIFY.ACCOUNT <account> SSH | API | BOTH | NONE
*
* 20 Sep 26 dm - S.29 (owner, 18/19 Sep 2026, through the port).  want.ssh and
* want.api are set by the caller; membership of sdssh and sdapi IS the route,
* so this is the whole mechanism - nothing is written to the register.
*
* ***THE LOOKUP IS THREE-VALUED AND THAT IS WHY THIS READS status().***
* !is_grp_member answers @false BOTH for "not a member" and for "could not
* tell" (empty argument, /etc unreadable, /etc/group unreadable - is_grp_member
* :48, :87, :91), distinguishing them only by status 1.  Acting on a
* could-not-tell would write a state derived from a guess: NONE would look
* like a change that already happened, and BOTH would re-add memberships that
* may be there.  So an unreadable register changes NOTHING and says so (10081
* with the status), which is the fail-closed half the port paid seven runs for.
*
* THE LINUX USER IS THE ACCOUNT NAME, lower case, which is true of every
* account CREATE.ACCOUNT makes (createa folds it).  An ATTACHed account whose
* Linux user is spelt otherwise is refused rather than guessed at: its
* sdusers membership will not be found under the folded name, and a silent
* miss would report success while changing a route nobody has.
*
* THE API HALF RUNS ONLY IF THE ssh HALF SUCCEEDED (the port's ordering): a
* failure part way leaves a state neither the caller nor a summary describes,
* so it is reported with its status rather than called a change.

set.route:
   route.user = acc.name

   if not(valid_os_name(route.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      return
   end

   in.sdusers = is_grp_member(route.user, 'sdusers')
   route.stat = status()
   if route.stat # 0 or not(in.sdusers) then
      @system.return.code = -ER$FAILED
      if route.stat = 0 then route.stat = 2
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   has.ssh = is_grp_member(route.user, 'sdssh')
   route.stat = status()
   if route.stat = 0 then
      has.api = is_grp_member(route.user, 'sdapi')
      route.stat = status()
   end
   if route.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   if (has.ssh = want.ssh) and (has.api = want.api) then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if has.ssh # want.ssh then
      if want.ssh then
         os.execute "sudo /usr/local/sbin/sd-elevate addgroup " : route.user : " sdssh"
      end else
         os.execute "sudo /usr/local/sbin/sd-elevate delgroup " : route.user : " sdssh"
      end
      route.stat = OS.ERROR()
   end

   if route.stat = 0 and (has.api # want.api) then
      if want.api then
         os.execute "sudo /usr/local/sbin/sd-elevate addgroup " : route.user : " sdapi"
      end else
         os.execute "sudo /usr/local/sbin/sd-elevate delgroup " : route.user : " sdapi"
      end
      route.stat = OS.ERROR()
   end

   if route.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, route.stat)
      return
   end

   @system.return.code = 0
* 07 Oct 26 dm - PAL-24, the owner's lower-case rule: the route word is lower case, as the
*   Windows port had it first (06 Oct 26 this was upper case on both ports by agreement,
*   T2358, which was the mistake).
   route.said = 'none'
   if want.ssh and want.api then route.said = 'both'
   if want.ssh and not(want.api) then route.said = 'ssh'
   if want.api and not(want.ssh) then route.said = 'api'
   void kernel(K$AUDIT, 'modify.account route ' : route.said : ' account=' : acc.name)

   begin case
      case want.ssh and want.api
         crt sysmsg(10078, acc.name)  ;* SD routes for %1: ssh and the API.
      case want.ssh
         crt sysmsg(10076, acc.name)  ;* SD routes for %1: ssh only, not the API.
      case want.api
         crt sysmsg(10077, acc.name)  ;* SD routes for %1: the API only, not ssh.
      case 1
         crt sysmsg(10079, acc.name)  ;* %1 has no remote access: not ssh, not the API
   end case
   return

*****************************************************************************
* SET.FILES  -  MODIFY.ACCOUNT <account> FILES-ON | FILES-OFF | FILES-WRITE-ON | FILES-WRITE-OFF
*
* 18 Oct 26 dm - S.65 write group.  files.grp is set by the caller with files.want: 'sdfiles' for the first pair, 'sdfileswrite' for the second.
*
* 17 Oct 26 dm - S.65 slice 2c.  files.want is set by the caller.  Membership of the Linux group sdfiles IS the files-only route (as
* sdapi is the API route), so nothing is written to the register.  The same helper does it as set.route: sd-elevate addgroup / delgroup.
*
* THE LINUX USER IS THE ONE THE ACCOUNT'S GROUP NAMES (sdu_<user>), which is what ACC_OS_INFO reads for the manifest, so the state line,
* the manifest and the login agree.  For every account CREATE.ACCOUNT makes it is the account name.
*
* AS SET.ROUTE, THE LOOKUP IS THREE-VALUED: !is_grp_member answers @false for "not a member" and for "could not tell" and tells them
* apart only by status().  An unreadable /etc/group changes NOTHING and says so (10081 with the status).  Three further refusals:
*   - a group (sdg_) or other account has no Linux user: 10087 for a group, 10081 for the rest, as the api word ends up saying;
*   - FILES-ON for a person who is not in sdusers: the login would refuse them first (10073), so the group is not added to look like access;
*   - FILES-ON when the Linux group sdfiles does not exist on this machine (an install from before this release has not made it yet):
*     10024 names it, and nothing is changed - sd-elevate would fail on it too, but with only a status.
*   The state line (11482) is read back from /etc/group after the change, not taken from the request, and a read back that does not
*   show the wanted state is reported as a failure (10081), never as a success.
*   sdapi is not touched: a person in both groups has the whole API (sdapi wins at login).

set.files:
   if group.name[1,4] # 'sdu_' then
      @system.return.code = -ER$FAILED
      if group.name[1,4] = 'sdg_' then
         crt sysmsg(10087, acc.name)  ;* %1 is a group account and has no remote access; reach it with logto
      end else
         crt sysmsg(10081, acc.name, 2)  ;* Unable to change remote access for %1, status: %2
      end
      return
   end
   files.user = group.name[5,999]

   if not(valid_os_name(files.user)) then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, 2)
      return
   end

   has.files = is_grp_member(files.user, files.grp)
   files.stat = status()
   if files.stat = 0 and files.want then
      in.sdusers = is_grp_member(files.user, 'sdusers')
      files.stat = status()
      if files.stat = 0 and not(in.sdusers) then files.stat = 2
   end
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

* 18 Oct 26 dm - S.65 write group: sdfileswrite on its own gives nothing (the login route needs sdfiles), so it is not handed out to a person without
*   it.  Asked before the "already had it" answer so that the refusal is the same whatever the group holds now.
   if files.grp = 'sdfileswrite' and files.want then
      in.files = is_grp_member(files.user, 'sdfiles')
      files.stat = status()
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      if not(in.files) then
         @system.return.code = -ER$FAILED
         crt sysmsg(11523, acc.name)  ;* %1 does not have files access, so it cannot be given files-write: use files-on first
         return
      end
   end

   if has.files = files.want then
      @system.return.code = 0
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   if files.want then
      files.found = is_group(files.grp)
      files.stat = status()
      if files.stat # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(10081, acc.name, files.stat)
         return
      end
      if not(files.found) then
         @system.return.code = -ER$FAILED
         crt sysmsg(10024, files.grp)  ;* %1 is not a valid Linux Group
         return
      end
      os.execute "sudo /usr/local/sbin/sd-elevate addgroup " : files.user : " " : files.grp
   end else
      os.execute "sudo /usr/local/sbin/sd-elevate delgroup " : files.user : " " : files.grp
   end
   files.stat = OS.ERROR()

* 18 Oct 26 dm - S.65 write group: FILES-OFF takes the person out of sdfileswrite too, so that a later files-on does not hand the write back
*   without the administrator saying so.  Read three-valued; a person who is not in it, or a machine with no such group, changes nothing.
   if files.stat = 0 and files.grp = 'sdfiles' and not(files.want) then
      had.write = is_grp_member(files.user, 'sdfileswrite')
      files.stat = status()
      if files.stat = 0 and had.write then
         os.execute "sudo /usr/local/sbin/sd-elevate delgroup " : files.user : " sdfileswrite"
         files.stat = OS.ERROR()
         if files.stat = 0 then
            had.write = is_grp_member(files.user, 'sdfileswrite')
            files.stat = status()
            if files.stat = 0 and had.write then files.stat = 2
         end
      end
   end
   if files.stat = 0 then
      now.files = is_grp_member(files.user, files.grp)
      files.stat = status()
      if files.stat = 0 and now.files # files.want then files.stat = 2
   end
   if files.stat # 0 then
      @system.return.code = -ER$FAILED
      crt sysmsg(10081, acc.name, files.stat)
      return
   end

   @system.return.code = 0
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   if files.grp = 'sdfileswrite' then
      crt sysmsg(11522, acc.name, if now.files then 'yes' else 'no')  ;* Account %1 has files-write %2
   end else
      crt sysmsg(11482, acc.name, if now.files then 'yes' else 'no')  ;* Account %1 has FILES %2
   end
   return

*****************************************************************************
* OS.SET  -  MODIFY.ACCOUNT <account> SH-ON | SH-OFF | OS-ON | OS-OFF
*
* 13 Oct 26 dm - S.63.  The OS-access gates, back (the 18 Sep teardown took them out with the tiers; the
*   owner's correction of 13 Oct: the tiers were to go and the gates to stay).  Off by default, and
*   SDSYS - the only account that has this verb - switches them.  os.field is ACC$SH or ACC$OS.EXEC;
*   os.want is the wanted state.  The fields are 'yes'/'no'; blank = denied.  The code is the
*   pre-teardown os.set (git show 11a4268^), without the administrator-tier refusal that has nothing to
*   refer to now, and with the register written under a lock as SET.SUSPENDED writes it (PAL-18).
*
* OS-ON ALSO GOVERNS WHAT AN ACCOUNT CAN OPEN BY PATHNAME: OPENSEQ and OPENPATH reach only the account's own
*   directory without it (op_sh.c), and SED's PATH: asks the same question (K$PATH.OK).  SH-ON governs the
*   SH verb and "!".
*
* THE GRANT TAKES EFFECT AT THE NEXT ACCOUNT ENTRY, not at once: LOGIN and CPROC's logto load the field into
*   the session (K$SH / K$OS.EXEC), so a session already in the account keeps what it had until it
*   re-enters.

os.set:
*   A GROUP or OTHER account is entered by whoever its Linux group admits, so a shell granted to it would
*   be a shell granted to all of them, decided by group membership rather than by the administrator who
*   typed SH-ON.  sdu_ is the only group that names one person (the Windows port's 10105).
   if group.name[1,4] # 'sdu_' and os.field # ACC$SD.ACCOUNTS and os.field # ACC$VOC.EDIT and os.field # ACC$BP.EDIT and os.field # ACC$DICT.EDIT and os.field # ACC$SHARED.READ and os.field # ACC$SHARED.WRITE and os.field # ACC$NET then
      @system.return.code = -ER$FAILED
      crt sysmsg(10105, acc.name)  ;* %1 is a group account and has no Linux user
      return
   end

*   18 Oct 26, S.66: shared.read is the one gate whose BLANK field means ON, so "was" is "not no" for it; for every other field it is "is yes".
*   Without this, SHARED-READ-OFF on a blank record would find was = want = false, say "already" (10080) and write nothing, and the gate could never
*   be withdrawn from an account whose field is blank.  SHARED-READ-ON on a blank record likewise says "already".
   if os.field = ACC$SHARED.READ then
      os.was = (upcase(trim(acc.rec<os.field>)) # 'NO')
   end else
      os.was = (upcase(trim(acc.rec<os.field>)) = 'YES')
   end
   if os.was = os.want then
      crt sysmsg(10080, acc.name)  ;* %1 already had that access; nothing changed
      return
   end

   readu acc.new from acc.f, acc.name else acc.new = acc.rec
   if os.want then acc.new<os.field> = 'yes' else acc.new<os.field> = 'no'
   acc.written = @true
   write acc.new to acc.f, acc.name on error acc.written = @false
   if not(acc.written) then
      release acc.f, acc.name
      @system.return.code = -ER$FAILED
      crt sysmsg(10114, acc.name)  ;* Unable to change the state of %1; its state in the register is unchanged
      return
   end

*   THE RESULTING STATE OF BOTH FIELDS, NOT A SENTENCE ABOUT ONE: SH-OFF says nothing about OS.EXECUTE, so
*   saying where both now stand is what tells the administrator the command did only what it named.
   @system.return.code = 0
   os.sh.now = 'no'
   if upcase(trim(acc.new<ACC$SH>)) = 'YES' then os.sh.now = 'yes'
   os.ex.now = 'no'
   if upcase(trim(acc.new<ACC$OS.EXEC>)) = 'YES' then os.ex.now = 'yes'
   void kernel(K$AUDIT, 'modify.account ' : downcase(action) : ' account=' : acc.name)
   if os.field = ACC$SHARED.READ or os.field = ACC$SHARED.WRITE then
*     18 Oct 26, S.66: both shared fields, as for the edit gates: SHARED-READ-OFF says nothing about write.  Read is 'no' only when the field
*     says NO (a blank field is on); write is 'yes' only when it says YES.
      sh.read.now = 'yes'
      if upcase(trim(acc.new<ACC$SHARED.READ>)) = 'NO' then sh.read.now = 'no'
      sh.write.now = 'no'
      if upcase(trim(acc.new<ACC$SHARED.WRITE>)) = 'YES' then sh.write.now = 'yes'
      crt sysmsg(11515, acc.name, sh.read.now, sh.write.now)  ;* Account %1 has shared.read %2, shared.write %3
      return
   end
   if os.field = ACC$SD.ACCOUNTS then
      crt sysmsg(11385, acc.name, if upcase(trim(acc.new<ACC$SD.ACCOUNTS>)) = 'YES' then 'yes' else 'no')   ;* Account %1 has SD.ACCOUNTS %2
   end else
      if os.field = ACC$VOC.EDIT or os.field = ACC$BP.EDIT or os.field = ACC$DICT.EDIT then
*        Where all three now stand, as for SH and OS.EXECUTE: VOC-OFF says nothing about the other two.
         ed.voc = 'no' ; ed.bp = 'no' ; ed.dict = 'no'
         if upcase(trim(acc.new<ACC$VOC.EDIT>)) = 'YES' then ed.voc = 'yes'
         if upcase(trim(acc.new<ACC$BP.EDIT>)) = 'YES' then ed.bp = 'yes'
         if upcase(trim(acc.new<ACC$DICT.EDIT>)) = 'YES' then ed.dict = 'yes'
         crt sysmsg(11409, acc.name, ed.voc, ed.bp, ed.dict)  ;* Account %1 has VOC.EDIT %2, BP.EDIT %3, DICT.EDIT %4
      end else
         if os.field = ACC$NET then
*           17 Oct 26, S.65 slice 1: the NET gate has one field of its own, so the line names only it.
            crt sysmsg(11411, acc.name, if upcase(trim(acc.new<ACC$NET>)) = 'YES' then 'yes' else 'no')   ;* Account %1 has NET %2
         end else
            crt sysmsg(10102, acc.name, os.sh.now, os.ex.now)  ;* Account %1 has SH %2, OS.EXECUTE %3
         end
      end
   end
   return

end

