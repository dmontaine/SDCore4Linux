* ======================================================================
* get.voc.parser.rec

get.voc.parser.rec:
   * Read the $VOC.PARSER record, if it exists

   read voc.parser.rec from voc, '$VOC.PARSER' then
      if voc.parser.rec[1,1] # 'X' then voc.parser.rec = ''
   end
   voc.parser.rec.keys = dcount(voc.parser.rec<2>, @vm)

   return

end

