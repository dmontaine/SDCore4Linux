* *****************************************************************************
* Perform final actions on QUIT or forced logout

exit.actions:
   if fileinfo(voc,FL$OPEN) and trap.aborts # ABORT.ON.EXIT then
      * Execute ON.EXIT paragraph

      read voc.rec from voc, "ON.EXIT" then
         trap.aborts = ABORT.ON.EXIT
         break off
         at.command = ""
         new.sentence = "ON.EXIT"
         gosub proc.sentence
      end

      if not(is.phantom) then
         * Save command stack if the $COMMAND.STACK VOC record is present as
         * an X type record.

         if not(fileinfo(voc, FL$READONLY)) then
            readu voc.rec from voc,"$command.stack" then
               if voc.rec[1,1] = "X" then
						s = initial.account.path:@ds:'stacks'
						openpath s to stk.f else
							create.file s directory on error null
						end
						openpath s to stk.f then
							write command.stack to stk.f, @logname
							close stk.f
						end
               end
            end
            release voc, '$command.stack'   ;* Catch all exit paths - the id the readu locked
         end

         if not(ospath(initial.account.path, OS$CD)) then
            display sysmsg(5260, initial.account.path)
            * Unable to change to initial account directory (xx)
         end
      end
   end

   i = ospath("", os$flush.cache)

   return

* ======================================================================
* Expand @-variables for XEQ and SET
*
* Line to expand and resultant expansion passed via VALUE

expand.at.vars:
   new.value = ''
   loop
      i = index(value, '@', 1)
   while i
      new.value := value[1,i-1]
      value = value[i+1,99999]

      * Extract a string of letters, digits and dots

      j = 1
      loop
         c = value[j,1]
* 20240121 mab use @VM not hard coded hex fd 		 
      while c matches "1A":@VM:"1N":@VM:"'.'"
         j += 1
      repeat
      word = upcase(value[1, j-1])

      call !atvar(s, word)
      if status() then continue

      new.value := s
      value = value[j, 99999]
   repeat

   value = new.value : value

   return

* ======================================================================
* scan.catalogued.options
*
* 14 Oct 26 dm  openQM item 146.  A program run by typing its catalogue name, not the name of a VOC verb, has the words
*   LPTR and NO.PAGE after the name handled as RUN handles them: LPTR sends the output to printer 0, NO.PAGE stops the
*   output being paginated.  Both stay in the sentence, so the program sees them if it scans its own command line.  A word
*   inside quotation marks is not a keyword.  The words are looked for in the sentence as typed, split at spaces; the first
*   is the program's own name.

scan.catalogued.options:
   sco.line = new.sentence : ' '      ;* the command line about to be executed (@SENTENCE is set after this)
   sco.q = ''                ;* the quotation mark in force, if any
   sco.w = ''                ;* the word being collected
   sco.first = @true         ;* the first word is the program's name
   for sco.i = 1 to len(sco.line)
      sco.c = sco.line[sco.i, 1]
      begin case
         case sco.q # ''
            sco.w := sco.c
            if sco.c = sco.q then sco.q = ''
         case sco.c = "'" or sco.c = '"' or sco.c = '\'
            sco.q = sco.c
            sco.w := sco.c
         case sco.c = ' '
            if sco.w # '' then
               if not(sco.first) then
                  begin case
                     case upcase(sco.w) = 'LPTR'
                        printer on
                     case upcase(sco.w) = 'NO.PAGE'
                        s = @(0,0)
                  end case
               end
               sco.first = @false
               sco.w = ''
            end
         case 1
            sco.w := sco.c
      end case
   next sco.i
   return

