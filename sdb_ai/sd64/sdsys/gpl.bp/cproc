*****************************************************************************
* INT.LOGTO  -  LOGTO (Internal verb 17)

int.logto:
   * Grab hold of new account name before we look for an ON.LOGTO entry

   call @parser(PARSER$GET.TOKEN, token.type, new.account, keyword)
   if token.type = PARSER$END then
      display sysmsg(5160) ;* Account name required
      unwinding = 2
      return
   end
* 20240330 mab only root can logto sdsys
* 18 Sep 26 dm - TEARDOWN (S.26).  LOGTO SDSYS IS REFUSED FOR EVERYBODY,
*   administrators included.  SDSYS is entered only by running SD as the
*   sdsys OS user on a local session - the entry block above, not LOGTO.
   if (downcase(new.account) = "sdsys") then
* 07 Oct 26 - 10002 has two lines; one DISPLAY of it put the raw field mark on the screen, so
*   it is shown a line at a time, as 10190/10191/10195 are (19 Sep).
      lg.msg = sysmsg(10002) ;* entered only by running SD as the sdsys OS user
      for lg.i = 1 to dcount(lg.msg, @fm)
         display lg.msg<lg.i>
      next lg.i
      void kernel(K$AUDIT, 'logto refused account=sdsys reason=sdsys is entered by its own session only')  ;* 07 Oct 26 PAL-24
      unwinding = 2
      return    
   end 

   * Look for options.  A LOGTO that was refused part way used to leave RESET set for the next one; both start false here (16 Oct 26)

   logto.reset = @false ; logto.reset.all = @false
   loop
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   until token.type = PARSER$END
      begin case
         case keyword = KW$RESET
            logto.reset = @true
         case keyword = KW$ALL and logto.reset
            logto.reset.all = @true
      end case
   repeat

* 16 Oct 26 dm - QM4 Fixes item 30.  RESET ALL discards the programs, menus and paragraphs at EVERY command level and returns to
*   the bottom command processor, which an API session has not got (the API server is its bottom level).  Refused before anything
*   is changed.  At the bottom level it is only RESET.
   if logto.reset.all and kernel(K$IS.SDAPISRVR, 0) then
      display sysmsg(11392) ;* LOGTO RESET ALL is not available in a client session
      logto.reset = @false ; logto.reset.all = @false
      unwinding = 2
      return
   end

   * Execute ON.LOGTO paragraph, if present

   read voc.rec from voc, "ON.LOGTO" then
      at.command = ""
      new.sentence = "ON.LOGTO"
      gosub proc.sentence
   end

   i = kernel(K$INVALIDATE.OBJECT, 0)   ;* 0400

   @system.return.code = -ER$ARGS

* 18 Oct 26 dm - S.66: clear the record first.  A failed openpath of the register would otherwise leave the PREVIOUS LOGTO's record in the
*   variable, and the account-scoped gates below are read from it.
   acc.record = ''
   openpath @sdsys:@ds:'accounts' to acc.f then
*      readv acc.rec from acc.f, upcase(new.account), ACC$PATH then
      read acc.record from acc.f, downcase(new.account) then
         acc.rec = parse.pathname.tokens(acc.record<ACC$PATH>)
         new.account = downcase(new.account)
      end else
         acc.rec = new.account
         new.account = ''
      end
      close acc.f
   end

   * new.account contains the account name, null if attaching by path
   * acc.rec contains the pathname of the account (other fields removed)
   * acc.record contains the full ACCOUNT record 

* rev 0.9.0 * is user member of account?
* 09 Sep 26 dm - PRE_RELEASE 20.  AN ADMINISTRATOR PASSES THIS GATE EXPLICITLY
*   NOW, AND THAT IS NOT NEW PRIVILEGE - IT IS THE SAME PRIVILEGE, STATED.
*
*   Until today @logname was "sdsys" for any privileged session, and CREATEA
*   builds every account group with "groupadd -U root,sdsys,<user>"
*   (CREATEA:681) - so sdsys was a member of every account it created and an
*   administrator already entered them all.  The membership test was passing
*   on a side effect of how the groups are built.
*
*   Now that @logname is the sdsys OS user itself (the teardown, S.26: the
*   administrator runs as sdsys, and root sessions are refused outright),
*   that side effect is gone: sdsys is in the account groups CREATEA builds,
*   but the account-entry gate below must not depend on that construction.
*   Naming the administrator here keeps the behaviour and makes the reason
*   legible.
*
*   OBJECTION, RECORDED RATHER THAN RESOLVED.  This converts an implicit grant
*   into an explicit one, and the two are only equivalent for accounts CREATEA
*   actually made.  ***MEASURED 9 Sep 26: `sdu_don` IS `root,don` AND HAS NO
*   sdsys***, so that account did not get the -U treatment and an
*   administrator could NOT enter it before - for that one case this is a
*   widening, not a preservation.  Why sdu_don differs is an open lead.
* 11 Sep 26 dm - A SUSPENDED ACCOUNT IS NOT ENTERED BY LOGTO (PORT_ADOPTION 12;
*   the port's logto.authorised, 27 Aug 2026).  LOGIN shuts the front door; an
*   account reached with LOGTO never goes through LOGIN.
*
* 18 Sep 26 dm - TEARDOWN (W.7).  The suspension is its own flag now: field 5,
*   blank means in service and SUSPENDED means suspended.  Nothing else about
*   the door moves.
*
*   AN ADMINISTRATOR STILL ENTERS ONE - the port's judgement call, kept rather
*   than the owner's ruling: looking at a suspended account is the ordinary
*   reason to have one, and an administrator can lift the suspension anyway.
*   If that is wrong, drop the K$ADMINISTRATOR half of this test; do not add a
*   second test.  The way out mirrors the 10003 refusal below.
   if not(kernel(K$ADMINISTRATOR,-1)) and upcase(trim(acc.record<ACC$SUSPENDED>)) = 'SUSPENDED' then
      display sysmsg(10107, new.account) ;* Account %1 is suspended
      void kernel(K$AUDIT, 'logto refused account=' : new.account : ' reason=suspended')  ;* 07 Oct 26 PAL-24
      if ospath(account.path, OS$CD) then return
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end

   if  not(kernel(K$ADMINISTRATOR,-1)) and not(is_grp_member(@logname,acc.record<ACC$GROUP>)) then
      display sysmsg(10003) ;* User not allowed in requested account
      void kernel(K$AUDIT, 'logto refused account=' : new.account : ' reason=not granted')  ;* 07 Oct 26 PAL-24
      if ospath(account.path, OS$CD) then return
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end

* 18 Sep 26 dm - TEARDOWN (S.25).  The upward-grant gate is gone with the
*   tier model: there is no rank to climb any more.  A grant is Linux group
*   membership, and the group test above is the whole of the LOGTO wall -
*   SD keeps no second one.


* 18 Sep 26 dm - TEARDOWN (S.26).  THE ADMINISTRATOR'S S.2 REFRESH.  A local
*   sdsys session started before an account's group existed would fail the
*   filesystem checks below with Error 3001 - the S.2 defect, which the old
*   root-entry block kept clear by reloading root's groups at session start
*   and after every privileged verb.  The reload now happens HERE for the
*   administrator: !EUID_SET is a uid no-op in a sdsys session (it already is
*   sdsys) and SD_EUID_SET reloads the caller's supplementary groups first
*   (sdext_eguid.c, 18 Sep), so the administrator's LOGTO picks up account
*   groups created since the session started.  initgroups() grants sdsys no
*   group it is not already a member of.
   if kernel(K$ADMINISTRATOR, -1) then
      call !EUID_SET('sdsys', rstat)
   end

   if not(ospath(acc.rec, OS$CD)) then
      display sysmsg(5161) ;* Unable to change to new directory
      if ospath(account.path, OS$CD) then return
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end

   openpath "voc" to new.voc else
      display sysmsg(5163) ;* Directory is not a SD account
      if ospath(account.path, OS$CD) then return
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end

   i = ospath("", os$flush.cache)
   account.path = ospath("", os$cwd)     ;* @PATH

   if new.account = '' then
      new.account = downcase(account.path[index(account.path, @ds, count(account.path, @ds)) + 1, 99999])
   end

   who = new.account
   void kernel(K$SET.ACCOUNT, who)   ;* 14 Oct 26 - the user table's account (LISTU, sheet 24 and 29)
   voc = new.voc ; new.voc = 0   ;* Dereference temporary VOC file var

* 13 Oct 26 dm - S.63.  The per-account OS-access gates are loaded here as LOGIN loads them at sign-on:
*   SH and OS.EXECUTE are OFF unless the account's register record says 'yes' (SDSYS switches them with
*   MODIFY.ACCOUNT SH-ON / OS-ON).  acc.record is the register record for a named account; a path-attached
*   account has none, so its fields read blank and it is denied - the safe default.  The administrator
*   needs no grant: USR_ADMIN already passes the gate.  Account-scoped: a LOGTO to another account reloads
*   from that account's own record, so one account's grant is never carried into another.
   void kernel(K$SH,      upcase(trim(acc.record<ACC$SH>)) = 'YES')
   void kernel(K$OS.EXEC, upcase(trim(acc.record<ACC$OS.EXEC>)) = 'YES')
   void kernel(K$SD.ACCOUNTS, upcase(trim(acc.record<ACC$SD.ACCOUNTS>)) = 'YES')   ;* 16 Oct 26: the SD.ACCOUNTS gate, off unless 'yes'
* 17 Oct 26 dm - S.65 slice 1: the NET gate (SDNet remote files) is account-scoped like SD.ACCOUNTS: reloaded here from the new account's own
*   record, off unless 'yes'.  It takes effect for the remote-file slices that follow and does nothing yet.
   void kernel(K$NET, upcase(trim(acc.record<ACC$NET>)) = 'YES')
* 18 Oct 26 dm - S.66: the shared-account gates, account-scoped like NET.  Read is ON unless the record says 'no' (a blank field is on), but ONLY
*   for an account that has a register record: a path-attached LOGTO has none (acc.record is blank, so is its path field) and reads OFF, as does
*   write.  Fail closed.  new.account cannot tell the two cases apart (it is reassigned from the path above); the record's path field can.
   void kernel(K$SHARED.READ,  (acc.record<ACC$PATH> # '') and (upcase(trim(acc.record<ACC$SHARED.READ>)) # 'NO'))
   void kernel(K$SHARED.WRITE, (acc.record<ACC$PATH> # '') and (upcase(trim(acc.record<ACC$SHARED.WRITE>)) = 'YES'))

   void kernel(K$AUDIT, 'logto account=' : new.account)  ;* 11 Sep 26 - PORT_ADOPTION 13; lower case 07 Oct 26 PAL-24

   gosub find.private.catalogue

   if logto.reset then
      loop
      while system(1029)
         return to logto.unwind   ;* Yuck!! Clever but really nasty!
logto.unwind:
      repeat
   end

   @system.return.code = 0

* 18 Aug 26 Windows port - the same fold as the LOGIN read above.  5.12 (b).
   login.voc.id = "LOGIN"
   read voc.rec from voc, login.voc.id else
      login.voc.id = downcase(login.voc.id)
      read voc.rec from voc, login.voc.id else login.voc.id = ""
   end

* 16 Oct 26 dm - QM4 Fixes item 30: RESET ALL.  The account has been entered and ON.LOGTO has run; what is left is the LOGIN of the
*   new account and the start of the command prompt.  Every stacked command processor is cast off first (the kernel does it at
*   the end of this opcode and calls the bottom one again), and the bottom one runs LOGIN, so a menu LOGIN starts is not itself
*   discarded.  The kernel() key keeps "level : LOGIN" for it.  At the bottom level there is nothing to cast off: it is RESET.
   if logto.reset.all then
      logto.reset.all = @false
      reset.level = kernel(K$CPROC.LEVEL, 0)
      if reset.level > 1 then
         if kernel(K$RESET.ALL, reset.level : @fm : login.voc.id) then return
      end
   end

   if login.voc.id # "" then
      at.command = ""
      new.sentence = login.voc.id
      break off
      gosub proc.sentence
      break on
   end

   if logto.reset then goto restart.cproc

* 22 Oct 26 dm - S.75: the account entered by a LOGTO typed at the prompt starts as its setting says (the home screen, or the prompt).  !HOME_ENTRY returns at once for a LOGTO run
*   by a program (the command processor is not the bottom one) and for the one the home screen runs itself.
   if @tty[1, 5] = '/dev/' then call !home_entry('logto')

   return

*****************************************************************************
* REVERT.ACCOUNT  -  Go back to the account an EXECUTE began in  (16 Oct 26 dm, QM4 gap 248)
*
* OPTION STACKED.ACCOUNT: a command run with EXECUTE that did a LOGTO leaves the process in the account it began in.  This is
* LOGTO's own change undone, from what was held when the level started, and it asks for nothing LOGTO asked for: the process
* was in that account already, so it is no new entry (no membership test, no ON.LOGTO, no LOGIN), and the two OS-access
* switches go back to what that account's entry had set, so the account the command visited keeps nothing it granted.

revert.account:
   if not(ospath(stk.path, OS$CD)) then
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end
   openpath "voc" to new.voc else
      display sysmsg(5163) ;* Directory is not a SD account
      display sysmsg(5162) ;* Fatal error : Cannot return to previous account
      return to abort.cproc
   end
   if kernel(K$ADMINISTRATOR, -1) then
      call !EUID_SET('sdsys', rstat)
   end
   i = ospath("", os$flush.cache)
   account.path = stk.account.path
   who = stk.who
   void kernel(K$SET.ACCOUNT, who)
   voc = new.voc ; new.voc = 0
   void kernel(K$SH,      stk.sh)
   void kernel(K$OS.EXEC, stk.os.exec)
   void kernel(K$SHARED.READ,  stk.shared.read)    ;* 18 Oct 26, S.66: before the SD.ACCOUNTS line, so stk.net stays next to the revert audit line
   void kernel(K$SHARED.WRITE, stk.shared.write)
   void kernel(K$SD.ACCOUNTS, stk.sd.accounts)
   void kernel(K$NET, stk.net)   ;* 17 Oct 26, S.65 slice 1
   void kernel(K$AUDIT, 'logto revert account=' : who)
   i = kernel(K$INVALIDATE.OBJECT, 0)
   gosub find.private.catalogue
   return

*****************************************************************************
* INT.IF  -  IF (Internal verb 18)

int.if:
   if not(in.paragraph) then abort sysmsg(5170) ;* IF is only allowed within a paragraph

   if.value = @false
   if.or = @true

   loop
      nocase = @false

      * 12 Oct 26 dm - openQM 28:  EXISTS file record  /  NOT.EXISTS file record  (SD's own syntax)
      call @parser(PARSER$LOOK.AHEAD, token.type, s, keyword)
      if token.type = PARSER$TOKEN and (upcase(s) = 'EXISTS' or upcase(s) = 'NOT.EXISTS') then
         negate = (upcase(s) = 'NOT.EXISTS')
         call @parser(PARSER$GET.TOKEN, token.type, s, keyword)        ;* The word
         gosub get.if.value ; exists.file = s
         gosub get.if.value ; exists.rec = s
         rel.val = @false
         open exists.file to exists.f then
            readv exists.x from exists.f, exists.rec, 0 then rel.val = @true else null
            close exists.f
         end
         if negate then rel.val = not(rel.val)
         goto test.if.result
      end

      call @parser(PARSER$GET.TOKEN, token.type, s, keyword)
      begin case
         case token.type = PARSER$TOKEN
            if s[1,1] = "@" then gosub substitute.at.var
         case token.type = PARSER$STRING
            null
         case 1
            abort sysmsg(5171) ;* Value 1 missing in IF
      end case
      value.1 = s

      if (keyword >= KW$LOW.REL.OP) and (keyword <= KW$HIGH.REL.OP) then
         * Looks like it could be a null inline prompt response
         rel.op = keyword
         value.1 = ''
      end else
         call @parser(PARSER$GET.TOKEN, token.type, s, rel.op)

         * 12 Oct 26 dm - openQM 230 and 426:  value IN v1 v2 ... {NO.CASE}  /  value NOT.IN v1 v2 ...
         if token.type = PARSER$TOKEN and (upcase(s) = 'IN' or upcase(s) = 'NOT.IN') then
            negate = (upcase(s) = 'NOT.IN')
            in.list = ''
            loop
               call @parser(PARSER$LOOK.AHEAD, token.type, s, keyword)
            until token.type = PARSER$END or keyword = KW$AND or keyword = KW$OR or upcase(s) = 'THEN' or upcase(s) = 'NO.CASE'
               gosub get.if.value
               in.list<-1> = s
            repeat
            call @parser(PARSER$LOOK.AHEAD, token.type, s, keyword)
            if upcase(s) = 'NO.CASE' then
               call @parser(PARSER$GET.TOKEN, token.type, s, keyword)
               nocase = @true
            end
            if nocase then
               value.1 = upcase(value.1) ; in.list = upcase(in.list)
            end
            locate value.1 in in.list<0> setting in.pos then rel.val = @true else rel.val = @false
            if negate then rel.val = not(rel.val)
            goto test.if.result
         end

         if (rel.op < KW$LOW.REL.OP) or (rel.op > KW$HIGH.REL.OP) then
            abort sysmsg(5172) ;* Relational operator missing in IF
         end
      end
      rel.op -= KW$LOW.REL.OP - 1

      call @parser(PARSER$LOOK.AHEAD, token.type, s, keyword)
      if keyword = KW$AND or keyword = KW$OR or upcase(s) = 'THEN' then
         * Looks like it could be a null inline prompt response
         value.2 = ''
      end else
         call @parser(PARSER$GET.TOKEN, token.type, s, keyword)
         begin case
            case token.type = PARSER$TOKEN
               if s[1,1] = "@" then gosub substitute.at.var
            case token.type = PARSER$STRING
               null
            case 1
               abort sysmsg(5173) ;* Value 2 missing in IF
         end case
         value.2 = s
      end

      * 12 Oct 26 dm - openQM 476:  NO.CASE after the second value makes the comparison ignore case
      call @parser(PARSER$LOOK.AHEAD, token.type, s, keyword)
      if upcase(s) = 'NO.CASE' then
         call @parser(PARSER$GET.TOKEN, token.type, s, keyword)
         value.1 = upcase(value.1) ; value.2 = upcase(value.2)
      end

      * Perform relational comparison

      on rel.op goto op.eq, op.ne, op.lt, op.le, op.ge, op.gt, op.like,
                  op.unlike, op.said

op.eq:
      rel.val = value.1 = value.2
      goto test.if.result

op.ne:
      rel.val = value.1 # value.2
      goto test.if.result

op.lt:
      rel.val = value.1 < value.2
      goto test.if.result

op.le:
      rel.val = value.1 <= value.2
      goto test.if.result

op.ge:
      rel.val = value.1 >= value.2
      goto test.if.result

op.gt:
      rel.val = value.1 > value.2
      goto test.if.result

op.like:
      rel.val = value.1 matches value.2
      goto test.if.result

op.unlike:
      rel.val = not(value.1 matches value.2)
      goto test.if.result

op.said:
      rel.val = soundex(value.1) = soundex(value.2)
      goto test.if.result

test.if.result:
      if.value = if if.or then (if.value or rel.val) else (if.value and rel.val)

      call @parser(PARSER$GET.TOKEN, token.type, s, keyword)

      begin case
         case keyword = kw$and ; if.or = @false
         case keyword = kw$or  ; if.or = @true
         case 1
            exit
      end case
   repeat

   if upcase(s) # "THEN" then abort sysmsg(5174) ;* THEN not found where expected in IF

   if if.value then
      call @parser(PARSER$GET.REST, token.type, new.sentence, keyword)
      return to proc.sentence.common
   end

   return

substitute.at.var:
   value = s
   gosub expand.at.vars
   s = value
   return

* Next token of an IF as a value: a word or a quoted string, @ variables expanded (12 Oct 26)
get.if.value:
   call @parser(PARSER$GET.TOKEN, token.type, s, keyword)
   begin case
      case token.type = PARSER$TOKEN
         if s[1,1] = "@" then gosub substitute.at.var
      case token.type = PARSER$STRING
         null
      case 1
         abort sysmsg(5171) ;* Value 1 missing in IF
   end case
