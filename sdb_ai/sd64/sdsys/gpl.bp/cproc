* 09 Sep 26 dm - HERE, not up in the privilege block, because $LOGIN has just
*   drawn the sign-on banner.  See display.admin.notice for the owner's shape
*   and why a notice above the banner is a notice nobody reads.
      if admin.notice # '' then gosub display.admin.notice


      
      i = ''

      gosub get.voc.parser.rec

      abort.code = 0
      report.src = @false


      * Check for non-standard private catalogue location

      gosub find.private.catalogue

      if is.phantom then
         * Open phantom como file
         * We do this with an EXECUTE so that all the extra actions of the
         * COMO verb get done such as creating $COMO if it does not exist and
         * setting an update lock on the como record.

         z = system(1005)
         s = oconv(idiv(z,86400), 'D2/DMY') : "_" : oconv(mod(z,86400), 'MTS')

         * 12 Oct 26 dm - openQM 364: PHANTOM LOG dirfile leaves the name of another directory file in the L record
         * 26 Oct 26 dm - W.11 F10.  The Xn, Dn and Ln records are read together, here, and checked (read.phantom.cargo, below) before anything in
         *   them is used: the log file name is the one the COMO below is told about, so it cannot be taken before the check.
         ph.log.file = ''
         filelock ipc.f
         gosub read.phantom.cargo
         fileunlock ipc.f
         ph.log.file = trim(ph.log.file)
         if ph.log.file # '' then
            execute "COMO ON PH" : @userno : "_" : convert('/:', '', s) : " IN " : ph.log.file
         end else
            execute "COMO ON PH" : @userno : "_" : convert('/:', '', s)
         end

         display sysmsg(5010, @userno, oconv(mod(z,86400), 'MTS') : ' ' : oconv(idiv(z,86400), 'D4DMY[,A3]'))
         * Phantom xx started at hh:mm:ss dd mmm yyyy

         * Get the file lock on the $IPC file to coordinate process start-up 
         * with the parent process.

         filelock ipc.f

         * Update phantom register of the parent process.  (The phantom command was fetched with the other start-up
         * records, above; the lock is held here only to wait for the parent to have finished and to update the register.)

         n = kernel(K$PPID,0)
         if n then    ;* Parent still running
            x = 'P':n
            readu s from ipc.f, x then
               locate @userno in s<1,1> by 'AR' setting i then
                  s<2,i> = z                ;* Set startup timestamp and...
               end
               write s to ipc.f, x
            end else
               release ipc.f, x
            end
         end

         fileunlock ipc.f

         * 26 Oct 26 dm - W.11 F10.  The records were not the ones the process that started this phantom sealed: nothing in them is run, stacked
         *   or set.  The phantom says so in its COMO log and the audit trail, and ends (terminate.phantom tells its parent).
         if ph.refused then
            message = sysmsg(11947, @userno)
            display message
            void kernel(K$AUDIT, 'phantom refused phantom=' : @userno : ' reason=start-up records not from the process that started it')
