*
* START-DESCRIPTION:
*
*    MODIFY.PASSWORD [account]
*
*    Sets the SD password of an account - the credential the SD API checks.
*    With no account name, sets your own.
*
*    THE PASSWORD IS NEVER AN ARGUMENT.  It is read from two hidden prompts,
*    and anything after the account name is refused rather than ignored.
*
*    Setting someone else's requires administrator rights.  Setting your own
*    requires your current one, when there is one.
*
*    ONE PROCESS FOR EVERYONE, TWO WRITES UNDERNEATH (19 Sep 2026, W.10; the
*    owner: "user can only change their own password, sdsys can change any",
*    and the administrator and the user follow the same process).  $cred is
*    sdsys:sdusers 0700.  The administrator - a sdsys login - writes it
*    directly through !CRED_SET.  An ordinary session cannot touch it, so for
*    its OWN account it derives the same record here and hands it to
*    "sd-elevate cred-own", which sudoers lets every SD user run for exactly
*    that and which takes the caller's identity from sudo, not from us.  The
*    keys go to it on stdin through a file in a private 0700 directory, never
*    as an argument.  The current password is proved by deriving its
*    StoredKey from the salt and iterations the helper reports; the helper
*    compares it with the record, which this session cannot read.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program set_acc_password
$catalog $MODIFY.PASSWORD

$include parser.h
$include syscom.h
$include int$keys.h
$include err.h
$include keys.h

deffun pw_complex(pw) calling '!pw_complex'

   prompt ''
   parser = "!PARSER"
   @system.return.code = -ER$ARGS

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)   ;* verb

   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if token.type = PARSER$END then
      account = downcase(@logname)
      own = @true
   end else
      account = downcase(token)
      own = (account = downcase(@logname))

*  A TRAILING TOKEN IS REFUSED, NOT DISCARDED - the port's test and reasoning,
*  20 Aug 2026.  "MODIFY.PASSWORD DON hunter2" would otherwise set the account,
*  throw "hunter2" away without a word and prompt as though nothing happened,
*  while the password was already in SD's command stack.  Refusing does not
*  put it back; it tells the person to go and deal with it.
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
      if token.type # PARSER$END then
         stop sysmsg(5276)  ;* A password is never given on the command line
      end
   end

   * Only an administrator may set an account other than their own.

   if not(own) and not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

   * The account has to be a real one.

   openpath @sdsys:@ds:'accounts' to acc.f else
      stop sysmsg(2200)  ;* Cannot open accounts register
   end

   read acc.rec from acc.f, account else
      close acc.f
      stop sysmsg(5018, account)  ;* Account %1 not in register
   end
   close acc.f

*  18 Sep 26 dm - TEARDOWN (S.26).  The administrator is a local sdsys session,
*  never root.  $cred is sdsys:sdusers 0700, so the privilege test is the
*  administrator flag (set only by CPROC's local-sdsys grant) with uid 0 kept
*  for the install bootstrap; the refused open below cannot be reached by an
*  ordinary session at all.  system(27) is getuid() (op_sys.c:222).  AFTER the
*  grammar, privilege and register checks, so 5276, 2001 and 5018 answer first
*  as they did.
*  19 Sep 26 dm - W.10.  A non-administrator reaching here is setting its OWN
*  password (not(own) was refused with 2001 above), and does it through the
*  helper - self.svc.  Everything the person sees is the same either way.
   self.svc = (not(kernel(K$ADMINISTRATOR, -1)) and system(27) # 0)
   helper = 'sudo -n /usr/local/sbin/sd-elevate cred-own'
   pdir = '' ; q.salt = '' ; q.iter = '' ; cur.sk = '' ; fail.why = ''

   * Has this account got a credential yet?  The first one cannot require the
   * previous password, since there is not one.

*  A RECORD OF ANOTHER VERSION READS AS "NO CREDENTIAL": !CRED_VERIFY cannot
*  check it and it cannot be converted without the plaintext, so the first
*  MODIFY.PASSWORD replaces it without demanding the old password.  That is not
*  a way in - the administrator can reset it anyway, and the helper applies the
*  same rule to a person's own record.
   has.cred = @false
   if self.svc then
      gosub make.pdir
      os.execute helper : " query > '" : pdir : "/q' 2>&1"
      q.rc = os.error()
      q.salt = '' ; q.iter = '' ; q.text = ''
      openseq pdir : '/q' to q.f then
         loop
            readseq line from q.f else exit
            q.text<-1> = line
            begin case
               case field(line, ' ', 1) = 'salt' ; q.salt = field(line, ' ', 2)
               case field(line, ' ', 1) = 'iter' ; q.iter = field(line, ' ', 2)
            end case
         repeat
         closeseq q.f
      end
      if q.rc # 0 or (q.text<1> # 'none' and (q.salt = '' or q.iter = '')) then
         gosub drop.pdir
         crt 'Your SD password cannot be changed here:'
         crt '  ' : change(q.text, @fm, @fm : '  ')
         stop
      end
      if q.salt # '' then has.cred = @true
   end else
      openpath @sdsys:@ds:'$cred' to cred.f then
         read cred.rec from cred.f, account then
            if cred.rec<CRED$STOREDKEY> # '' then has.cred = @true
         end
         close cred.f
      end else
         stop 'Cannot open the $cred register.  It needs an administrator (a sdsys login); has the install completed?'
      end
   end

*  20 Sep 26 dm - NOT UNDER -QUIET (owner, 20 Sep, reading an install): the
*  caller has just said whose password this is and that it is the first one,
*  so SD repeating it is noise between the explanation and the prompt.
   if not(has.cred) and not(bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET)) then
      crt 'Account ' : account : ' has no password set.  Setting the first one.'
   end

   * Changing your own password requires the current one.  An administrator
   * resetting someone else's cannot be expected to know it.

   cur.sk = ''
   if own and has.cred then
      display 'Current password: ' :
      input current HIDDEN
      display

      if self.svc then
*        The helper checks it: this session cannot read the record, so the
*        StoredKey derived here from the helper's salt and iterations is the
*        proof, and a wrong one is refused at the write.
         salted = SDEXT(current : @FM : q.salt : @FM : q.iter : @FM : SCRAM$KEY.LEN, @TRUE, SD_PBKDF2)
         current = ''
         if salted # '' then
            client.key = SDEXT(salted : @FM : 'Client Key', @TRUE, SD_HMACSHA256)
            cur.sk = SDEXT(client.key, @TRUE, SD_SHA256)
         end
         salted = '' ; client.key = ''
         ok = (cur.sk # '')
*        19 Sep 26 dm - AND CHECKED NOW, NOT ONLY AT THE WRITE.  The owner, at
*        the keyboard in the fifth cycle: a wrong current password went on to
*        the new-password prompts and failed only after both were typed.  The
*        key goes on stdin from the private directory, never as an argument.
         if ok then gosub helper.verify
      end else
         ok = @false
         call !CRED_VERIFY(account, current, ok)
         current = ''
      end
      if not(ok) then
         gosub drop.pdir
         crt 'Password not changed.'
         @system.return.code = -ER$ARGS
         stop
      end
   end

*  SAY WHAT ENTER DOES, BEFORE IT IS PRESSED - the port's, owner 26 Aug 2026.
*  Not under -QUIET, where the caller is saying it itself (port 4 Sep 2026).
   crt
   if not(bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET)) then
      crt sysmsg(10920)  ;* the rule, said before it is applied
      if has.cred then
         crt 'Press Enter on an empty line to leave the password unchanged.'
      end else
         crt 'A password is required.  Pressing Enter on an empty line does not'
         crt 'give you an account without one - it leaves this account without an'
         crt 'SD password, so it cannot be reached through the SD API until one is set.'
      end
   end

*  THREE ATTEMPTS AT THE PAIR, NOT ONE - the port's, owner 26 Aug 2026.  An empty
*  first entry still leaves at once and is not counted: it is how somebody
*  declines, and re-asking would turn a decision into a fight.
   max.tries = 3
   tries = 0

   loop
      tries += 1

*     20 Sep 26 dm - UNDER -QUIET THE PROMPT IS "<account> SD password:"
*     (owner's wording, 20 Sep: "don is my name and the account name for
*     another installer might be much longer so it should just read
*     <Installers name> SD password").  SD cannot say "Your" - the installer
*     runs both SD steps as sdsys, so SD does not know whose account the
*     person at the keyboard calls theirs - and the account name is the part
*     that has to be unambiguous.  Nothing is padded or aligned to it, so a
*     long name lengthens the line and breaks no layout.
      if bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET) then
         display account : ' SD password: ' :
      end else
         display 'New password: ' :
      end
      input pw1 HIDDEN
      display

      if pw1 = '' then
         gosub drop.pdir
         crt 'Password not changed.'
         @system.return.code = -ER$ARGS
         stop
      end

*     19 Sep 26 dm - THE RULE, BEFORE THE REPEAT (owner, 19 Sep 2026: SD
*     requires a complex password whatever the OS allows).  A weak one is an
*     attempt like a mismatch, so three of either end the command.
      if not(pw_complex(pw1)) then
         pw1 = ''
         crt sysmsg(10920)  ;* A password needs at least 8 characters, ...
         crt sysmsg(10921, tries, max.tries)  ;* That was attempt %1 of %2.
      end else
         if bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET) then
            display ' Enter password again: ' :
         end else
            display 'Repeat new password: ' :
         end
         input pw2 HIDDEN
         display

         if pw1 = pw2 then exit

         crt 'Passwords do not match.  ' : sysmsg(10921, tries, max.tries)
      end

      if tries >= max.tries then
         pw1 = '' ; pw2 = ''
         gosub drop.pdir
         crt 'Password not changed.'
         @system.return.code = -ER$ARGS
         stop
      end

      crt
   repeat

   ok = @false
   if self.svc then
      gosub helper.set
   end else
      call !CRED_SET(account, pw1, ok)
      if not(ok) then fail.why = 'status ' : status()
   end
   pw1 = '' ; pw2 = ''
*  20 Sep 26 dm - UNDER -QUIET, SUCCESS IS ONE WORD (owner, 20 Sep: "If the
*  password entry is successful just a simple 'Password Accepted' line is
*  enough").  The caller has already named the account; a failure still says
*  everything, because that is the case a person has to act on.
   if ok then
      if bitand(kernel(K$COMMAND.OPTIONS, 0), CMD.QUIET) then
*        20 Sep 26 dm - the blank line is the owner's layout: the answer sits
*        apart from the two prompts rather than running on from them.
         crt
         crt 'Password accepted'
      end else
         crt 'Password set for account ' : account
      end
      @system.return.code = 0
   end else
      crt 'Unable to set password for ' : account : ', ' : fail.why
      @system.return.code = -ER$ARGS
   end

   return

* ======================================================================
* 19 Sep 26 dm - W.10's three steps for an ordinary user's own password.
*
* make.pdir: a PRIVATE directory for the helper's input and output.  umask 077
* makes it 0700 whatever the session's own umask, and mkdir refuses a name that
* already exists - including a symlink somebody planted - so nothing written
* inside can be read or redirected by anyone else.
make.pdir:
   pdir = '/tmp/sd-pw.' : @userno : '.' : date() : time() : rnd(999999)
   os.execute "umask 077 && mkdir -- '" : pdir : "'"
   if os.error() # 0 then
      pdir = ''
      stop 'Cannot create a private working directory for the password change.'
   end
   return

drop.pdir:
   if pdir # '' then os.execute "rm -rf -- '" : pdir : "'"
   pdir = ''
   return

* helper.verify: is cur.sk the record's StoredKey?  ok is true only on the
* helper's own success line; any other answer - wrong, refused, silent - is no.
helper.verify:
   ok = @false
   v.path = pdir : '/v'
   os.execute "umask 077 && : > '" : v.path : "'"
   openseq v.path to v.f else return
   writeseq cur.sk to v.f else null
   closeseq v.f
   os.execute helper : " verify < '" : v.path : "' > '" : pdir : "/vout' 2>&1"
   v.rc = os.error()
   v.text = ''
   openseq pdir : '/vout' to v.f then
      loop
         readseq line from v.f else exit
         v.text<-1> = line
      repeat
      closeseq v.f
   end
   os.execute "rm -f -- '" : v.path : "' '" : pdir : "/vout'"
   if v.rc = 0 and index(v.text, 'the current password is correct', 1) then ok = @true
   return

* helper.set: derive the new record exactly as !CRED_SET does, write it with
* the current password's StoredKey as the first line, and hand the file to the
* helper on stdin.  Success is the helper's own success line naming this
* account, not an exit status alone.
helper.set:
   fail.why = ''
   salt = ''
   call !SD_GET_SALT(salt)
   iter = SCRAM$ITERATIONS
   salted = ''
   if salt # '' then
      salted = SDEXT(pw1 : @FM : salt : @FM : iter : @FM : SCRAM$KEY.LEN, @TRUE, SD_PBKDF2)
   end
   stored.key = '' ; server.key = ''
   if salted # '' then
      client.key = SDEXT(salted : @FM : 'Client Key', @TRUE, SD_HMACSHA256)
      stored.key = SDEXT(client.key, @TRUE, SD_SHA256)
      server.key = SDEXT(salted : @FM : 'Server Key', @TRUE, SD_HMACSHA256)
   end
   salted = '' ; client.key = ''
   if stored.key = '' or server.key = '' then
      fail.why = 'the new keys could not be derived'
      gosub drop.pdir
      return
   end

   in.path = pdir : '/in'
   os.execute "umask 077 && : > '" : in.path : "'"
   openseq in.path to in.f else
      fail.why = 'the private working file could not be opened'
      gosub drop.pdir
      return
   end
   writeseq cur.sk to in.f else null
   writeseq SCRAM$CRED.VERSION to in.f else null
   writeseq 'SCRAM-SHA-256' to in.f else null
   writeseq salt to in.f else null
   writeseq iter to in.f else null
   writeseq stored.key to in.f else null
   writeseq server.key to in.f else null
   closeseq in.f
   cur.sk = '' ; stored.key = '' ; server.key = ''

   os.execute helper : " set < '" : in.path : "' > '" : pdir : "/out' 2>&1"
   s.rc = os.error()
   s.text = ''
   openseq pdir : '/out' to out.f then
      loop
         readseq line from out.f else exit
         s.text<-1> = line
      repeat
      closeseq out.f
   end
   gosub drop.pdir

   if s.rc = 0 and index(s.text, 'SD password set for ' : account, 1) then
      ok = @true
   end else
      ok = @false
*     The helper's own reason, without its program-name prefix.
      fail.why = change(change(s.text, 'sd-elevate: REFUSED - ', ''), @fm, '; ')
      if fail.why = '' then fail.why = 'the helper said nothing (exit ' : s.rc : ')'
   end
   return
end

* END-CODE
