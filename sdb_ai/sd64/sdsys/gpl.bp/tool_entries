* START-DESCRIPTION:
*
*   TOOL.ENTRIES
*
*   For the administrator only (it is refused, before anything is read, for anyone else; it is in SDSYS's VOC only).  A full-screen page, in the toolkit's frame (140 columns by 43
*   lines at least).  Nothing is copied: every list is read from the account's own file by its pathname when it is asked for.
*
*     Accounts   every registered account but SDSYS with the edit gates it holds (voc-edit, dict-edit, bp-edit, shown as v d b or a dash), whether the sdsys user is in its group, and
*                whether it is suspended
*     Entries    the VOC of the account under the cursor: each entry's id, its type and what it points at, in name order; K switches to the DICTIONARY ITEMS of its files (the
*                dictionary each file pointer of the VOC names): file, item id, type and column heading, in file and id order
*
*   The VOC of an account is read when the cursor comes to the account, not at the start: a system with many accounts is not read as a whole.  F finds an id, or a part of one, in the
*   VOC of EVERY account (this reads them all and is asked for by name); the boxes then list the hits with their accounts, and Enter on a hit goes to that entry in its account.
*
*   Keys: Up and Down, PgUp and PgDn move in the box, Tab changes box, Enter in Accounts goes to its entries (and on a hit goes to the entry in its account), / filters the entries of the
*   account by a part of the id, F finds an id in every account, Esc takes the find and the filter off, F5 reads again, F1 or ? or a click on a [?] explains the box, Ctrl-Q leaves.
*   Esc or F10 (or a click on the top row) opens the menu bar when there is nothing to take off.
*
*   THIS STAGE ONLY READS.  The page changes no record and runs no command.  An administrator passes the edit gates; they are shown because they are what locks the account out of its
*   own files.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_entries
$catalog $tool_entries

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

deffun is_grp_member(user,group) calling '!is_grp_member'

   prompt ''

   MAXV = 3000                                                   ;* entries read for one account, or hits kept in a find: a VOC is a few hundred; more are not listed, and the page says so

   call $tk_open('tool.entries', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.entries')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'enter', 'open', 'open', '', 1)
   call $tk_keys('add', keys, 'tab', 'pane', 'pane', '', 1)
   call $tk_keys('add', keys, '/', 'filter', 'filter', '', 1)
   call $tk_keys('add', keys, 'f', 'find', 'find', '', 1)
   call $tk_keys('add', keys, 'k', 'kind', 'kind', '', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* Esc takes the find and the filter off first, else opens the menu bar
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'pane', '&View', '&Switch box', '', '')
   call $tk_keys('menu', keys, 'filter', '&View', '&Filter the entries by id', '', '')
   call $tk_keys('menu', keys, 'find', '&View', 'F&ind an id in every account', '', '')
   call $tk_keys('menu', keys, 'kind', '&View', '&Kind: VOC entries or dictionary items', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this box', '', '')
   * The AI line: offered the actions that only change what is shown; a proposal is carried out by the page's own key, and its argument is the DEFAULT of the page's own prompt.
   call $tk_keys('ai', keys, 'pane', '', '', '', '')
   call $tk_keys('ai', keys, 'filter', '', '', '', '')
   call $tk_keys('ai', keys, 'find', '', '', '', '')
   call $tk_keys('ai', keys, 'kind', '', '', '', '')
   call $tk_keys('ai', keys, 'refresh', '', '', '', '')
   call $tk_aipage('init', ctx, keys, '', '', aout)

   pnames = 'Accounts' : @fm : 'Entries'

   VIS = 10                                                      ;* rows in a list (the list pane's height less 4: set by get.rects)
   pane = 1
   ac = 1 ; atop = 1                                             ;* the row selected in Accounts, and the first row shown
   ec = 1 ; etop = 1                                             ;* the same in Entries (the hits, in a find)
   an = 0 ; anm = '' ; en = 0 ; enm = '' ; hn = 0               ;* read.all reads both before it fills them (BASIC does not short-circuit)
   ekey = '' ; efile = '' ; hfile = '' ; eout = '' ; hout = '' ; vfail = 0 ; dfail = 0
   kind = 1                                                      ;* 1 the VOC entries, 2 the dictionary items of the account's files, 3 the programs of its program files
   filt = '' ; fnd = ''
   ai.arg = ''
   gen = 0
   msg = ''
   done = 0

   perr = ''
   gosub declare.layout
   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, pnames<pane>, '', '', mr)
      call $tk_frame(ctx, keys, pnames<pane>, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key returning nm
      mr = ''
      ao = ''
      if nm # '' then call $tk_aipage('key', ctx, keys, pnames<pane>, nm, ao)
      ai.arg = ''
      if ao<1> = 'replay' then nm = ao<2>
      if ao<1> = 'replay' then ai.arg = ao<5>
      if ao<1> # '' then msg = ao<4>
      busy = (if filt # '' or fnd # '' then 1 else 0)
      if nm # '' and ao<1> = '' then call $tk_menubar('key', ctx, keys, pnames<pane>, nm, busy, mr)
      if mr<1> # '' then nm = mr<4>
      begin case
         case ao<1> = 'taken'
            if ao<3> then
               gen += 1
               ctx<TK.C.GEN> = gen
               gosub draw.all
            end
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', chg)
            gosub get.rects
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the system says

* Every registered account but SDSYS by name, with its path, the edit gates it holds, whether the sdsys user is in its group and whether it is suspended; then the VOC of the
* selected account.  The selection is kept by name through a refresh.  The account's own record is the only thing read for the list: no VOC is opened here.
read.all:
   old.acct = (if ac >= 1 and ac <= an then anm<ac> else '')
   names = ''
   apath = ''
   agate = ''
   asds = ''
   asus = ''
   openpath @sdsys:@ds:'accounts' to acc.f then
      select acc.f to 9
      loop
         readnext id from 9 else exit
         if id # 'sdsys' then
            read arec from acc.f, id then
               locate id in names<1> by 'AL' setting lp else
                  ins id before names<lp>
                  ins parse.pathname.tokens(arec<1>) before apath<lp>
                  gset = (if upcase(trim(arec<ACC$VOC.EDIT>)) = 'YES' then 'v' else '-')
                  gset := (if upcase(trim(arec<ACC$DICT.EDIT>)) = 'YES' then 'd' else '-')
                  gset := (if upcase(trim(arec<ACC$BP.EDIT>)) = 'YES' then 'b' else '-')
                  ins gset before agate<lp>
                  sdw = 'n/a'
                  if trim(arec<ACC$GROUP>) # '' then
                     sdw = 'no'
                     if is_grp_member('sdsys', trim(arec<ACC$GROUP>)) then sdw = 'yes'
                  end
                  ins sdw before asds<lp>
                  stw = ''
                  if upcase(trim(arec<ACC$SUSPENDED>)) = 'SUSPENDED' then stw = 'suspended'
                  ins stw before asus<lp>
               end
            end
         end
      repeat
      close acc.f
   end
   an = dcount(names, @fm)
   anm = names
   ac = 1
   if old.acct # '' then
      locate old.acct in anm<1> setting op then ac = op
   end
   if ac > an then ac = an
   if ac < 1 then ac = 1
   if fnd # '' then gosub run.find
   gosub read.entries
   return

* The selected account's entries of the kind shown (the VOC, or the dictionary items of its files), read by the pathname the register gives, in name order: ekey (the sort key), enm (the
* id), efile (the file, for a dictionary item), ety (the type word), esm (what it points at, or the heading), en; filt, if set, keeps what holds it.  vfail is 1 when the account's VOC
* could not be opened; dfail is the number of dictionaries that could not be opened; etrunc when MAXV were listed and there were more; eall is the number read.
read.entries:
   old.e = (if ec >= 1 and ec <= en and fnd = '' then ekey<ec> else '')
   ekey = '' ; enm = '' ; efile = '' ; ety = '' ; esm = '' ; eout = ''
   en = 0 ; eall = 0 ; etrunc = 0 ; vfail = 0 ; dfail = 0
   if an > 0 then
      ca = ac
      pat = filt
      gosub collect.account
      ekey = ckey ; enm = cid ; efile = cfile ; ety = cty2 ; esm = csm2 ; eout = cout
      en = cn ; eall = rcount ; etrunc = ctrunc ; vfail = cfail ; dfail = cdfail
   end
   if fnd = '' then
      ec = 1
      if old.e # '' then
         locate old.e in ekey<1> setting op then ec = op
      end
      if ec > en then ec = en
      if ec < 1 then ec = 1
   end
   gosub keep.tops
   return

* The entries of account number ca of the kind shown that hold the text pat ('' = all), sorted by key.  Out: ckey, cid, cfile ('' for a VOC entry), cty2, csm2, cn; rcount (how many were
* read), ctrunc (MAXV were kept and there were more), cfail (the VOC could not be opened), cdfail (dictionaries that could not be opened).  The VOC is opened by the pathname the register
* gives and the records are only read.  A dictionary item holds the text in its id or in its heading.  The dictionary path of a file pointer is read as LOGTO reads a pathname: the
* tokens are expanded (@SDSYS/voc.dic is the system's dictionary of the VOC, and the shipped pointers of every VOC use it), and a path that is still relative is the account's.
collect.account:
   ckey = '' ; cid = '' ; cfile = '' ; cty2 = '' ; csm2 = '' ; cout = '' ; cn = 0 ; rcount = 0 ; ctrunc = 0 ; cfail = 0 ; cdfail = 0
   openpath apath<ca>:@ds:'voc' to vf else
      cfail = 1
      return
   end
   select vf to 9
   if kind = 1 then
      loop
         readnext id from 9 else exit
         rcount += 1
         if pat = '' or index(upcase(id), upcase(pat), 1) > 0 then
            if cn >= MAXV then
               ctrunc = 1
            end else
               read r from vf, id then
                  gosub classify
                  locate id in ckey<1> by 'AL' setting lp else
                     ins id before ckey<lp>
                     ins id before cid<lp>
                     ins '' before cfile<lp>
                     ins cty before cty2<lp>
                     ins csm before csm2<lp>
                     ins coutf before cout<lp>
                     cn += 1
                  end
               end
            end
         end
      repeat
      close vf
      return
   end
   if kind = 3 then
      * programs: the program files of this VOC, found as tool.catalog finds them (a directory file named bp, or ending .bp, or with a file of the same name and .out beside it, where BASIC
      * puts the compiled programs), then the records of each; a program is built when its compiled program is in the .out file under the same name
      pfiles = '' ; ppaths = '' ; popaths = ''
      loop
         readnext id from 9 else exit
         read r from vf, id then
            if upcase(trim(r<1>))[1, 1] = 'F' then
               tl = downcase(id)
               isp = 0
               orr = ''
               if not(len(tl) > 4 and tl[len(tl) - 3, 4] = '.out') then
                  if tl = 'bp' then isp = 1
                  if len(tl) > 3 and tl[len(tl) - 2, 3] = '.bp' then isp = 1
                  read orr from vf, id : '.out' else orr = ''
                  if not(isp) and upcase(trim(orr<1>))[1, 1] = 'F' then isp = 1
               end
               if isp then
                  locate id in pfiles<1> by 'AL' setting lp else
                     ins id before pfiles<lp>
                     ins trim(r<2>) before ppaths<lp>
                     ins (if upcase(trim(orr<1>))[1, 1] = 'F' then trim(orr<2>) else '') before popaths<lp>
                  end
               end
            end
         end
      repeat
      close vf
      for fi = 1 to dcount(pfiles, @fm)
         pp = parse.pathname.tokens(ppaths<fi>)
         if pp[1, 1] # '/' then pp = apath<ca> : @ds : pp
         tp = pp
         gosub out.test                                              ;* a program file outside this account is not this account's to edit
         poutf = is.out
         onames = ''
         if popaths<fi> # '' then
            op2 = parse.pathname.tokens(popaths<fi>)
            if op2[1, 1] # '/' then op2 = apath<ca> : @ds : op2
         end else
            op2 = pp : '.out'                                        ;* this VOC names no .out file (a program file reached by a pointer from another account's VOC has none): the one BASIC makes BESIDE the program file
         end
         openpath op2 to ofv then
            select ofv to 9
            readlist onames from 9 else onames = ''
            close ofv
         end
         onames = downcase(onames)
         openpath pp to pfv then
            if fileinfo(pfv, FL$TYPE) = FL$TYPE.DIR then
               select pfv to 9
               loop
                  readnext pid from 9 else exit
                  rcount += 1
                  if pat = '' or index(upcase(pid), upcase(pat), 1) > 0 then
                     if cn >= MAXV then
                        ctrunc = 1
                     end else
                        pk = pfiles<fi> : '*' : pid
                        locate pk in ckey<1> by 'AL' setting lp else
                           built = '-'
                           locate downcase(pid) in onames<1> setting op3 then built = 'yes'
                           ins pk before ckey<lp>
                           ins pid before cid<lp>
                           ins pfiles<fi> before cfile<lp>
                           ins built before cty2<lp>
                           ins pp before csm2<lp>
                           ins poutf before cout<lp>
                           cn += 1
                        end
                     end
                  end
               repeat
            end
            close pfv
         end else
            cdfail += 1
         end
      next fi
      return
   end
   * dictionaries: the files of this VOC that have one (field 3 of the file pointer), then the items of each
   dfiles = '' ; dpaths = ''
   loop
      readnext id from 9 else exit
      read r from vf, id then
         if upcase(trim(r<1>))[1, 1] = 'F' and trim(r<3>) # '' then
            locate id in dfiles<1> by 'AL' setting lp else
               ins id before dfiles<lp>
               ins trim(r<3>) before dpaths<lp>
            end
         end
      end
   repeat
   close vf
   for fi = 1 to dcount(dfiles, @fm)
      dp = parse.pathname.tokens(dpaths<fi>)                      ;* @SDSYS/voc.dic and the like, as LOGTO and the VOC pointers read them
      if dp[1, 1] # '/' then dp = apath<ca> : @ds : dp
      tp = dp
      gosub out.test                                              ;* a dictionary outside this account (SDSYS's voc.dic, which every account's pointer shares, or another account's) is not this account's to edit
      doutf = is.out
      openpath dp to df then
         select df to 9
         loop
            readnext did from 9 else exit
            rcount += 1
            read dr from df, did then
               gosub dclassify
               match.it = (pat = '')
               if not(match.it) then match.it = (index(upcase(did), upcase(pat), 1) > 0 or index(upcase(dhead), upcase(pat), 1) > 0)
               if match.it then
                  if cn >= MAXV then
                     ctrunc = 1
                  end else
                     dk = dfiles<fi> : '*' : did
                     locate dk in ckey<1> by 'AL' setting lp else
                        ins dk before ckey<lp>
                        ins did before cid<lp>
                        ins dfiles<fi> before cfile<lp>
                        ins dty before cty2<lp>
                        ins dhead before csm2<lp>
                        ins doutf before cout<lp>
                        cn += 1
                     end
                  end
               end
            end
         repeat
         close df
      end else
         cdfail += 1
      end
   next fi
   return

* In: tp (a pathname with its tokens expanded and made absolute), ca (the account number).  Out: is.out, 1 when the path lies OUTSIDE the directory of that account, whether in SDSYS, in
* another account or anywhere else.  THE OWNER'S RULE (3 Nov 26, in three messages): "pointers back to sdsys should not be editable ... they need to be edited in the sdsys account"; then
* "the actual pointer should be editable, for example change @SDSYS/voc.dic to some other directory.  But the system should not follow and edit something in SDSYS from another account";
* then "no pointer records should ever allow the master to end up editing something in [one] account from [another].  The actual pointer could be edited but never the target of the
* pointer."  So a row marked > means, for a VOC entry, that the POINTER leads outside this account (the record is this account's and is edited like any VOC entry; what it points at is
* never reached from here) and, for a dictionary item, that the ITEM LIVES OUTSIDE this account (read through its pointer; it is edited in the account it lives in).  The question is
* the kernel's own geometry (K$PATH.IN: realpath, so .. and links cannot make a path look inside).  This stage edits nothing; the stages that edit follow the rule.
out.test:
   is.out = (if kernel(K$PATH.IN, apath<ca> : @fm : tp) then 0 else 1)
   return

* In: dr (a dictionary item).  Out: dty (D, I, E, L, PH or X), dhead (its column heading, or for a phrase and a text what it says), on one line
dclassify:
   t1 = upcase(trim(dr<1>))
   dty = t1[1, 1]
   if t1[1, 2] = 'PH' then dty = 'PH'
   if dty = 'D' or dty = 'I' or dty = 'E' or dty = 'L' then
      dhead = dr<4>
   end else
      dhead = dr<2>
   end
   dhead = convert(@vm, ' ', convert(@sm, ' ', dhead))
   return

* F: the text in the entries of the kind shown of EVERY account (an id for the VOC; an id or a heading for a dictionary item).  The hits are kept in name order of account and key: hacc,
* hid, hfile, hty, hsm, hn; htrunc when there were more than MAXV; hseen is the number of VOCs that could be opened.  This reads every VOC (and every dictionary); it is run only when it is
* asked for, and again by F5.  Each account's entries come back from collect.account already sorted, and the accounts are taken in name order, so the hits are appended.
run.find:
   hacc = '' ; hid = '' ; hfile = '' ; hty = '' ; hsm = '' ; hout = '' ; hn = 0 ; htrunc = 0 ; hseen = 0
   for a = 1 to an
      ca = a
      pat = fnd
      gosub collect.account
      if not(cfail) then
         hseen += 1
         for q = 1 to cn
            if hn >= MAXV then
               htrunc = 1
            end else
               hn += 1
               hacc<hn> = anm<a>
               hid<hn> = cid<q>
               hfile<hn> = cfile<q>
               hty<hn> = cty2<q>
               hsm<hn> = csm2<q>
               hout<hn> = cout<q>
            end
         next q
         if ctrunc then htrunc = 1
      end
   next a
   ec = 1 ; etop = 1
   return

* In: r (the record).  Out: cty (the type word), csm (what it points at, on one line)
classify:
   t1 = upcase(trim(r<1>))
   cty = t1[1, 1]
   if t1[1, 2] = 'PA' or t1[1, 2] = 'PH' or t1[1, 2] = 'PQ' then cty = t1[1, 2]
   begin case
      case cty = 'V'
         csm = r<2> : ' ' : r<3>
      case cty = 'K'
         csm = 'a query keyword'
      case cty = 'F'
         csm = 'data ' : r<2> : (if r<3> # '' then '  dict ' : r<3> else '')
      case cty = 'Q'
         csm = 'file ' : r<3> : ' in the account ' : r<2>
      case cty = 'R'
         csm = 'record ' : r<3> : ' of ' : r<2>
      case 1
         csm = r<2>
   end case
   csm = convert(@vm, ' ', convert(@sm, ' ', csm))
   * >: a pointer whose target lies outside this account - a file pointer whose data or dictionary path leads outside its directory, a Q-pointer to any other account, a remote item (R),
   * whose file this page does not follow to see where it lives.  The pointer record is this account's (see out.test).
   coutf = 0
   begin case
      case cty = 'F'
         tp = parse.pathname.tokens(trim(r<2>))
         if tp[1, 1] # '/' then tp = apath<ca> : @ds : tp
         gosub out.test
         coutf = is.out
         if not(coutf) and trim(r<3>) # '' then
            tp = parse.pathname.tokens(trim(r<3>))
            if tp[1, 1] # '/' then tp = apath<ca> : @ds : tp
            gosub out.test
            coutf = is.out
         end
      case cty = 'Q'
         coutf = (if downcase(trim(r<2>)) = downcase(anm<ca>) then 0 else 1)
      case cty = 'R'
         coutf = 1
   end case
   return

* The first row shown in each box follows the selection
keep.tops:
   if ac < atop then atop = ac
   if ac > atop + VIS - 1 then atop = ac - VIS + 1
   if atop < 1 then atop = 1
   if ec < etop then etop = ec
   if ec > etop + VIS - 1 then etop = ec - VIS + 1
   if etop < 1 then etop = 1
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout: the two lists side by side in the first band, the explanation in the second and the help in the third, at 140 by 43 the sizes tool.jobs has.
* Out: a.x a.y a.w a.h (Accounts), c.x c.y c.w c.h (Entries), m.x m.y m.w m.h (What this means), h.x h.y h.w h.h (Help), VIS.
declare.layout:
   d = ''
   d<1> = 'accounts' : @vm : 1 : @vm : 1 : @vm : 14 : @vm : 50 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<2> = 'entries' : @vm : 1 : @vm : 2 : @vm : 14 : @vm : 87 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<3> = 'means' : @vm : 2 : @vm : 1 : @vm : 17 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<4> = 'help' : @vm : 3 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   ctx<TK.C.FOCI> = 'accounts' : @sm : 'Accounts' : @vm : 'entries' : @sm : 'Entries'   ;* the boxes that take the focus, for $tk_frame's [*] / [-]
   call $tk_layout('declare', ctx, d, perr)
   if perr # '' then
      call $tk_close(ctx)
      display perr
      stop
   end
   gosub get.rects
   return

get.rects:
   call $tk_layout('pane', ctx, 'accounts', rc)
   a.x = rc<1, 1> ; a.y = rc<1, 2> ; a.w = rc<1, 3> ; a.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'entries', rc)
   c.x = rc<1, 1> ; c.y = rc<1, 2> ; c.w = rc<1, 3> ; c.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'means', rc)
   m.x = rc<1, 1> ; m.y = rc<1, 2> ; m.w = rc<1, 3> ; m.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'help', rc)
   h.x = rc<1, 1> ; h.y = rc<1, 2> ; h.w = rc<1, 3> ; h.h = rc<1, 4>
   m.tw = m.w - 4
   h.tw = h.w - 4
   VIS = a.h - 4                                                 ;* the header row, the rows, a blank row and the border
   gosub keep.tops
   return

draw.all:
   screen clear at 0,ctx<TK.C.YBODY> size ctx<TK.C.W>,ctx<TK.C.BODYH>
   screen box at a.x,a.y size a.w,a.h title 'Accounts'
   kw1 = (if kind = 1 then 'VOC' else (if kind = 2 then 'Dictionary items' else 'Programs'))
   if fnd # '' then
      ttl = kw1 : ' with "' : fnd : '" in every account'
   end else
      ttl = kw1 : (if an > 0 then ' of ' : anm<ac> else '') : (if filt # '' then ', matching "' : filt : '"' else '')
   end
   screen box at c.x,c.y size c.w,c.h title ttl
   screen box at m.x,m.y size m.w,m.h title 'What this means'
   screen box at h.x,h.y size h.w,h.h title 'Help'
   gosub draw.accounts
   gosub draw.entries
   gosub draw.effect
   gosub draw.help
   return

draw.accounts:
   tw = a.w - 8
   ex = a.w - 50
   screen text fmt('Account', (20 + ex) : 'L') : fmt('Gates', '7L') : fmt('SDSYS', '6L') : 'State' at a.x + 2,a.y + 1 attr 'header' width tw      ;* 20 + 7 + 6 + 'suspended' (9) = the 42 columns of the box at 140 by 43
   for r = 1 to VIS
      k = atop + r - 1
      s = ''
      if k <= an then s = fmt(anm<k>[1, 18 + ex], (20 + ex) : 'L') : fmt(agate<k>, '7L') : fmt(asds<k>, '6L') : asus<k>
      screen text s at a.x + 2,a.y + 1 + r attr (if k = ac and k <= an then (if pane = 1 then 'highlight' else 'bold') else 'normal') width tw
   next r
   if an = 0 then screen text 'No account is registered but SDSYS.' at a.x + 2,a.y + 3 width tw
   call $tk_help('mark', a.x + a.w - 5, a.y + 1, 0, 0)
   return

draw.entries:
   tw = c.w - 8
   ex = c.w - 87
   if fnd # '' then
      if kind = 1 then
         s = fmt('Account', '16L') : fmt('Id', (24 + ex) : 'L') : fmt('>', '2L') : fmt('Type', '6L') : 'Points at'
      end else
         s = fmt('Account', '14L') : fmt('File', '12L') : fmt('>', '2L') : fmt('Id', (18 + ex) : 'L') : fmt((if kind = 2 then 'Type' else 'Built'), '5L') : (if kind = 2 then 'Heading' else 'Source file')
      end
      screen text s at c.x + 2,c.y + 1 attr 'header' width tw
      for r = 1 to VIS
         k = etop + r - 1
         s = ''
         if k <= hn then
            if kind = 1 then
               s = fmt(hacc<k>[1, 14], '16L') : fmt(hid<k>[1, 22 + ex], (24 + ex) : 'L') : fmt((if hout<k> then '>' else ''), '2L') : fmt(hty<k>, '6L') : hsm<k>
            end else
               s = fmt(hacc<k>[1, 12], '14L') : fmt(hfile<k>[1, 10], '12L') : fmt((if hout<k> then '>' else ''), '2L') : fmt(hid<k>[1, 16 + ex], (18 + ex) : 'L') : fmt(hty<k>, '5L') : hsm<k>
            end
         end
         screen text s at c.x + 2,c.y + 1 + r attr (if k = ec and k <= hn then (if pane = 2 then 'highlight' else 'bold') else 'normal') width tw
      next r
      if hn = 0 then
         begin case
            case kind = 1
               s = 'No VOC has an id with "' : fnd : '" in it (' : hseen : ' VOCs read).'
            case kind = 2
               s = 'No dictionary item has "' : fnd : '" in its id or its heading (' : hseen : ' accounts read).'
            case 1
               s = 'No program has "' : fnd : '" in its id (' : hseen : ' accounts read).'
         end case
         screen text s at c.x + 2,c.y + 3 width tw
      end
      s = hn : (if hn = 1 then ' hit' else ' hits') : ' in ' : hseen
      if kind = 1 then
         s := (if hseen = 1 then ' VOC' else ' VOCs') : ' read'
      end else
         s := (if hseen = 1 then ' account' else ' accounts') : ' read'
      end
      if htrunc then s := '; only the first ' : MAXV : ' are listed'
      s := '.'
      screen text s at c.x + 2,c.y + c.h - 2 attr 'bold' width tw
   end else
      if kind = 1 then
         s = fmt('Id', (30 + ex) : 'L') : fmt('>', '2L') : fmt('Type', '6L') : 'Points at'
      end else
         s = fmt('File', '13L') : fmt('>', '2L') : fmt('Id', (22 + ex) : 'L') : fmt((if kind = 2 then 'Type' else 'Built'), '5L') : (if kind = 2 then 'Heading' else 'Source file')
      end
      screen text s at c.x + 2,c.y + 1 attr 'header' width tw
      for r = 1 to VIS
         k = etop + r - 1
         s = ''
         if k <= en then
            if kind = 1 then
               s = fmt(enm<k>[1, 28 + ex], (30 + ex) : 'L') : fmt((if eout<k> then '>' else ''), '2L') : fmt(ety<k>, '6L') : esm<k>
            end else
               s = fmt(efile<k>[1, 11], '13L') : fmt((if eout<k> then '>' else ''), '2L') : fmt(enm<k>[1, 20 + ex], (22 + ex) : 'L') : fmt(ety<k>, '5L') : esm<k>      ;* a dictionary item: its type and heading; a program: built or not, and the directory of its file
            end
         end
         screen text s at c.x + 2,c.y + 1 + r attr (if k = ec and k <= en then (if pane = 2 then 'highlight' else 'bold') else 'normal') width tw
      next r
      s = ''
      begin case
         case an = 0
            null
         case vfail
            s = "This account's VOC cannot be opened from here."
            s2 = 'Its path in the register: ' : apath<ac>                    ;* on a line of its own: a long path would be cut at the edge of the box, with the account's name in the part that is lost
            screen text s2 at c.x + 2,c.y + 4 width tw
         case en = 0 and filt # '' and kind = 1
            s = 'No entry has "' : filt : '" in its id.'
         case en = 0 and filt # '' and kind = 2
            s = 'No dictionary item has "' : filt : '" in its id or its heading.'
         case en = 0 and filt # ''
            s = 'No program has "' : filt : '" in its id.'
         case en = 0 and kind = 1
            s = 'The VOC of this account is empty.'
         case en = 0 and kind = 2
            s = 'No file of this account has a dictionary with an item in it.'
         case en = 0
            s = 'This account has no program file (a directory file named bp, or ending .bp, or with a .out file beside it) with a program in it.'
      end case
      if s # '' then screen text s at c.x + 2,c.y + 3 width tw
      if an > 0 and not(vfail) then
         begin case
            case kind = 1
               s = en : ' of ' : eall : (if eall = 1 then ' entry' else ' entries')
            case kind = 2
               s = en : ' of ' : eall : (if eall = 1 then ' item' else ' items')
            case 1
               s = en : ' of ' : eall : (if eall = 1 then ' program' else ' programs')
         end case
         if filt # '' then s := ' hold "' : filt : '"'
         if etrunc then s := '; only the first ' : MAXV : ' are listed'
         if dfail > 0 then s := '; ' : dfail : (if kind = 2 then (if dfail = 1 then ' dictionary' else ' dictionaries') else (if dfail = 1 then ' program file' else ' program files')) : ' could not be opened'
         s := '.'
         screen text s at c.x + 2,c.y + c.h - 2 attr 'bold' width tw
      end
   end
   call $tk_help('mark', c.x + c.w - 5, c.y + 1, 0, 0)
   return

* In plain sentences, for what is selected; then the entry under the cursor field by field
draw.effect:
   lines = ''
   if an = 0 then
      lines<-1> = 'There is no registered account but SDSYS, so there is nothing to list.'
   end else
      lines<-1> = anm<ac> : ': the gates ' : agate<ac> : ' are the right to save a change to its VOC (v, voc-edit), its dictionaries (d, dict-edit) and its programs (b, bp-edit); a dash means the account is locked out of that.  An administrator is not held to them.'
      begin case
         case asds<ac> = 'yes'
            lines<-1> = "The sdsys user is in the account's group, so SDSYS can write inside its directories from outside SD."
         case asds<ac> = 'no'
            lines<-1> = "The sdsys user is NOT in the account's group: SDSYS cannot write inside it from outside SD (modify.account " : anm<ac> : ' sdsys-on puts it in).'
         case 1
            lines<-1> = 'The account has no group in the register.'
      end case
      if asus<ac> # '' then lines<-1> = 'The account is suspended.'
      begin case
         case kind = 1
            lines<-1> = 'The entries are read from the account' : "'s own VOC file when the cursor comes to the account; nothing is copied.  This stage only reads: no entry is changed from here."
            lines<-1> = ">: the entry is a pointer whose target lies outside this account (in SDSYS, as @SDSYS/voc.dic does, or in another account).  The pointer is this account's own record, edited like any VOC entry; what it points at belongs to the account it lies in and is never edited from this page."
         case kind = 2
            lines<-1> = 'The dictionary items are read, when the cursor comes to the account, from the dictionary of each file its VOC points at (field 3 of the file pointer); nothing is copied.  An item matches a text in its id or in its column heading.  This stage only reads.'
            lines<-1> = ">: the item lives in a dictionary outside this account (SDSYS's, which every account's pointer to it shares, or another account's) and is only read through this account's pointer.  It is edited in the account it lives in, never from here."
         case 1
            lines<-1> = "The programs are the records of the account's program files (a directory file named bp, or ending .bp, or with a file of the same name and .out beside it), read when the cursor comes to the account; nothing is copied.  Built: yes when the compiled program is in the .out file under the same name, - when it is not (the .out file is the one the VOC names, else the one beside the program file).  This stage only reads."
            lines<-1> = ">: the program file lies outside this account (SDSYS's or another account's) and is only read through this account's pointer.  Its programs are edited, compiled and run in the account it lives in, never from here."
      end case
   end
   lines<-1> = ''
   gosub entry.lines
   gosub wrap.lines
   for r = 1 to m.h - 3
      screen text lines<r> at m.x + 2,m.y + 1 + r width m.tw
   next r
   return

* The entry under the cursor field by field (up to nine fields), read from its account's VOC; the type in words first
entry.lines:
   eacct = '' ; eid = '' ; efl = ''
   if fnd # '' and hn > 0 and ec >= 1 and ec <= hn then
      eacct = hacc<ec> ; eid = hid<ec> ; ety1 = hty<ec> ; efl = hfile<ec>
   end
   if fnd = '' and en > 0 and ec >= 1 and ec <= en then
      eacct = anm<ac> ; eid = enm<ec> ; ety1 = ety<ec> ; efl = efile<ec>
   end
   if eid = '' then return
   if kind = 2 then
      gosub dict.item.lines
      return
   end
   if kind = 3 then
      gosub prog.item.lines
      return
   end
   gosub type.word
   lines<-1> = eid : ' in ' : eacct : '  -  ' : tword
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read dr from vf2, eid then
            nfld = dcount(dr, @fm)
            if nfld > 9 then nfld = 9
            for q = 1 to nfld
               lines<-1> = fmt(q, '3R') : '  ' : convert(@vm, ' | ', convert(@sm, ' / ', dr<q>))
            next q
            if dcount(dr, @fm) > 9 then lines<-1> = '     (and ' : dcount(dr, @fm) - 9 : ' more fields)'
         end
         close vf2
      end
   end
   return

* The program under the cursor: eid in the program file efl of the account eacct, the first lines of its source (up to nine), found by the file's pointer in that account's VOC; whether
* it is built is ety1 ('yes' or '-')
prog.item.lines:
   lines<-1> = eid : ' in ' : efl : ' of ' : eacct : '  -  ' : (if ety1 = 'yes' then 'built (its compiled program is in the .out file)' else 'not built (no compiled program of that name in the .out file)')
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read fr from vf2, efl then
            pp2 = parse.pathname.tokens(trim(fr<2>))
            if pp2[1, 1] # '/' then pp2 = apath<ap1> : @ds : pp2
            openpath pp2 to pf2 then
               read psrc from pf2, eid then
                  nfld = dcount(psrc, @fm)
                  if nfld > 9 then nfld = 9
                  for q = 1 to nfld
                     lines<-1> = fmt(q, '3R') : '  ' : psrc<q>
                  next q
                  if dcount(psrc, @fm) > 9 then lines<-1> = '     (and ' : dcount(psrc, @fm) - 9 : ' more lines)'
               end
               close pf2
            end
         end
         close vf2
      end
   end
   return

* The dictionary item under the cursor: eid in the dictionary of the file efl of the account eacct, field by field (up to nine), found by the file's pointer in that account's VOC
dict.item.lines:
   begin case
      case ety1 = 'D'
         tword = 'a D-type item (a field of the record)'
      case ety1 = 'I'
         tword = 'an I-type item (calculated)'
      case ety1 = 'PH'
         tword = 'a phrase'
      case 1
         tword = 'an item of type ' : ety1
   end case
   lines<-1> = eid : ' in the dictionary of ' : efl : ' of ' : eacct : '  -  ' : tword
   locate eacct in anm<1> setting ap1 then
      openpath apath<ap1>:@ds:'voc' to vf2 then
         read fr from vf2, efl then
            dp = trim(fr<3>)
            if dp # '' then
               dp = parse.pathname.tokens(dp)
               if dp[1, 1] # '/' then dp = apath<ap1> : @ds : dp
               openpath dp to df2 then
                  read dr from df2, eid then
                     nfld = dcount(dr, @fm)
                     if nfld > 9 then nfld = 9
                     for q = 1 to nfld
                        lines<-1> = fmt(q, '3R') : '  ' : convert(@vm, ' | ', convert(@sm, ' / ', dr<q>))
                     next q
                     if dcount(dr, @fm) > 9 then lines<-1> = '     (and ' : dcount(dr, @fm) - 9 : ' more fields)'
                  end
                  close df2
               end
            end
         end
         close vf2
      end
   end
   return

* In: ety1.  Out: tword, the type in words
type.word:
   begin case
      case ety1 = 'V'
         tword = 'a verb'
      case ety1 = 'K'
         tword = 'a keyword of the query processor'
      case ety1 = 'F'
         tword = 'a file'
      case ety1 = 'Q'
         tword = 'a pointer to a file in another account'
      case ety1 = 'R'
         tword = 'a pointer to a record in another file'
      case ety1 = 'PA' or ety1 = 'PH'
         tword = 'a paragraph'
      case ety1 = 'PQ'
         tword = 'a PROC (not supported here)'
      case ety1 = 'S'
         tword = 'a stored sentence'
      case ety1 = 'X'
         tword = 'text, not a command'
      case ety1 = 'D'
         tword = 'a data descriptor'
      case ety1 = 'M'
         tword = 'a menu'
      case 1
         tword = 'an entry of type ' : ety1
   end case
   return

wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      if lines<wi> = '' then
         wrapped<-1> = ''
      end else
         call $tk_wrap(lines<wi>, m.tw, pieces)
         wrapped<-1> = pieces
      end
   next wi
   lines = wrapped
   return

draw.help:
   screen text 'Up and Down move, PgUp and PgDn a page.  Tab changes box.  Enter in Accounts goes to its entries.  F1 or ? explains the box.' at h.x + 2,h.y + 1 width h.tw
   screen text '/ filters by a part of an id (of a heading too, in dictionaries).  F finds it in every account (Enter on a hit goes to it).  Esc takes them off.' at h.x + 2,h.y + 2 width h.tw
   screen text 'K shows the VOC entries or the dictionary items.  F5 reads again.  Ctrl-Q leaves.  This stage only reads.' at h.x + 2,h.y + 3 width h.tw
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   if len(nm) = 1 then nm = downcase(nm)
   nrows = (if fnd # '' then hn else en)
   begin case
      case nm = 'up'
         if pane = 1 and ac > 1 then
            ac -= 1
            gosub new.account
         end
         if pane = 2 and ec > 1 then
            ec -= 1
            gosub redraw
         end
      case nm = 'down'
         if pane = 1 and ac < an then
            ac += 1
            gosub new.account
         end
         if pane = 2 and ec < nrows then
            ec += 1
            gosub redraw
         end
      case nm = 'pgup' or nm = 'pgdn'
         stp = (if nm = 'pgup' then 0 - VIS else VIS)
         if pane = 1 and an > 0 then
            ac = ac + stp
            if ac < 1 then ac = 1
            if ac > an then ac = an
            gosub new.account
         end
         if pane = 2 and nrows > 0 then
            ec = ec + stp
            if ec < 1 then ec = 1
            if ec > nrows then ec = nrows
            gosub redraw
         end
      case nm = 'home' or nm = 'end'
         if pane = 1 and an > 0 then
            ac = (if nm = 'home' then 1 else an)
            gosub new.account
         end
         if pane = 2 and nrows > 0 then
            ec = (if nm = 'home' then 1 else nrows)
            gosub redraw
         end
      case nm = 'tab' or nm = 'right' or nm = 'btab' or nm = 'left'
         pane = (if pane = 1 then 2 else 1)
         gosub redraw
      case nm = 'enter' or nm = ' '
         if pane = 1 then
            pane = 2
            gosub redraw
         end else
            gosub open.entry
         end
      case nm = 'f11' or nm = '/'
         gosub do.filter
      case nm = 'f'
         gosub do.find
      case nm = 'k'
         gosub do.kind
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read again'
      case nm = 'f6'
         call $tk_aipage('open', ctx, keys, pnames<pane>, '', ap)
         if ap # '' then msg = ap
      case nm = 'ctrl-q'
         done = 1
      case nm = 'esc'
         if fnd # '' or filt # '' then
            fnd = '' ; filt = ''
            ec = 1 ; etop = 1
            gosub read.entries
            gosub draw.all
            msg = 'every entry of the account'
         end
   end case
   return

* Another account selected: its VOC is read and the box is drawn again under its new title
new.account:
   if fnd = '' then
      ec = 1
      etop = 1
      gosub read.entries
      gosub draw.all
   end else
      gosub redraw
   end
   return

redraw:
   gosub keep.tops
   gosub draw.accounts
   gosub draw.entries
   gosub draw.effect
   return

* Enter in Entries: on a hit of a find it goes to that entry in its account; otherwise this stage only reads
open.entry:
   if fnd # '' and hn > 0 and ec >= 1 and ec <= hn then
      want.acct = hacc<ec>
      want.id = hid<ec>
      want.key = (if kind = 1 then hid<ec> else hfile<ec> : '*' : hid<ec>)
      fnd = ''
      locate want.acct in anm<1> setting ap2 then ac = ap2
      filt = ''
      ec = 1 ; etop = 1
      gosub read.entries
      locate want.key in ekey<1> setting ep2 then ec = ep2
      gosub keep.tops
      gosub draw.all
      msg = want.id : ' in ' : want.acct
   end else
      msg = 'this stage only reads: the entry is not changed from here'
   end
   return

* /: keep the entries of the account whose id holds a text (a dictionary item: its id or its heading)
do.filter:
   ptxt = 'Part of an id (empty shows every entry)'
   if kind = 2 then ptxt = 'Part of an item id or heading (empty shows every item)'
   if kind = 3 then ptxt = 'Part of a program id (empty shows every program)'
   screen ask ptxt width 40 value ai.arg title 'Filter' returning ft then got = 1 else got = 0
   if not(got) then return
   filt = trim(ft)
   fnd = ''
   ec = 1 ; etop = 1
   gosub read.entries
   gosub draw.all
   msg = (if filt = '' then 'every entry' else en : ' with "' : filt : '"')
   return

* F: a text in the entries of every account (an id for the VOC; an id or a heading for a dictionary item)
do.find:
   ptxt = 'Part of an id, searched in the VOC of every account'
   if kind = 2 then ptxt = 'Part of an item id or heading, searched in the dictionaries of every account'
   if kind = 3 then ptxt = 'Part of a program id, searched in the program files of every account'
   screen ask ptxt width 40 value ai.arg title 'Find' returning ft then got = 1 else got = 0
   if not(got) then return
   fnd = trim(ft)
   filt = ''
   if fnd = '' then
      ec = 1 ; etop = 1
      gosub read.entries
      gosub draw.all
      msg = 'every entry of the account'
      return
   end
   gosub run.find
   pane = 2
   gosub draw.all
   msg = hn : ' hit' : (if hn = 1 then '' else 's') : ' in ' : hseen : (if kind = 1 then ' VOCs' else ' accounts') : (if htrunc then '; only the first ' : MAXV : ' are listed' else '')
   return

* K: the other kind of entry.  What was filtered or found is taken off, because a filter that means an id in the VOC means an id or a heading in a dictionary
do.kind:
   kind += 1
   if kind > 3 then kind = 1
   fnd = '' ; filt = ''
   ec = 1 ; etop = 1
   gosub read.entries
   gosub draw.all
   begin case
      case kind = 1
         msg = 'the VOC entries'
      case kind = 2
         msg = 'the dictionary items'
      case 1
         msg = 'the programs'
   end case
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key
      return
   end
   call $tk_aipage('mouse', ctx, keys, pnames<pane>, mev, ap)
   if ap # '' then
      msg = ap
      return
   end
   call $tk_help('hit', mev, a.x + a.w - 5, a.y + 1, hit.accounts)
   call $tk_help('hit', mev, c.x + c.w - 5, c.y + 1, hit.entries)
   if hit.accounts or hit.entries then
      pane = (if hit.accounts then 1 else 2)
      gosub redraw
      gosub help.here
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      nrows = (if fnd # '' then hn else en)
      begin case
         case mx >= a.x + 1 and mx <= a.x + a.w - 2 and my >= a.y + 2 and my <= a.y + 1 + VIS
            k = atop + my - a.y - 2
            pane = 1
            if k <= an and k # ac then
               ac = k
               gosub new.account
            end else
               gosub redraw
            end
         case mx >= c.x + 1 and mx <= c.x + c.w - 2 and my >= c.y + 2 and my <= c.y + 1 + VIS
            k = etop + my - c.y - 2
            if k <= nrows then ec = k
            pane = 2
            gosub redraw
      end case
   end
   return

help.here:
