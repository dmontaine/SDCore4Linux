*
* START-DESCRIPTION:
*
*   TOOL.VIEWERS
*
*   For the administrator only (it is refused, before anything is read, for anyone else; it is in SDSYS's VOC only).  A full-screen page, in the toolkit's frame
*   (140 columns by 43 lines at least), for the programs that the PDF verb may start for ANY account, even one whose OS.EXECUTE switch is off:
*
*     Allowed    the programs on the list now (the file viewers in the SD system directory), each with whether it still passes the test made when it is started
*     Found      the PDF readers this machine has in /usr/bin, /usr/local/bin or /bin, each with whether it could be allowed and whether it is
*
*   Keys: Up and Down move in the box, Tab changes box, Enter or the space bar allows the program under the cursor (in Found) or stops allowing it (in either
*   box), F5 reads the machine again, F1 or ? or a click on a [?] explains the box, Ctrl-Q leaves.  Esc or F10 (or a click on the top row) opens the menu bar - File: Quit;
*   Program: Allow or stop allowing; View: Switch box, Refresh, Output; Help - and Alt and a title's letter opens that menu.  Ctrl-O (View > Output) shows or puts away the
*   OUTPUT PANE, 6 rows between the explanation and the help: what each command answered, newest first, kept for as long as the page is open; PgUp and PgDn scroll it, and Esc
*   puts it away (the Esc rule: what the page has open is closed before the bar opens).
*
*   THE PAGE WRITES NOTHING ITSELF.  Every change is SET.VIEWER add | remove pdf name, shown with its effect in a box answered Run or Cancel (Cancel is what Enter
*   chooses) and run by $tk_run.  ALLOWING a program asks for its name to be typed, as turning on any switch that reaches beyond SD does.  A program that is on the
*   list under a path outside the three directories is shown, and is removed at the prompt (SET.VIEWER REMOVE pdf /full/path), because the commands this page may run
*   carry no slash.
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $tool_viewers
$catalog $tool_viewers

$include keys.h
$include int$keys.h
$include err.h
$include sl.h
$include tk.h

   prompt ''

   allow = 'set.viewer'                                          ;* the one command this page may run

   call $tk_open('tool.viewers', 'admin', ctx, err)
   if err # '' then
      display err
      stop
   end
   void kernel(K$AUDIT, 'tool start app=tool.viewers')

   keys = ''
   call $tk_keys('add', keys, 'f1', 'help', 'help', '', 1)
   call $tk_keys('add', keys, 'enter', 'change', 'change', '', 1)
   call $tk_keys('add', keys, 'tab', 'pane', 'pane', '', 1)
   call $tk_keys('add', keys, 'f5', 'refresh', 'refresh', '', 1)
   call $tk_keys('add', keys, 'ctrl-q', 'quit', 'quit', '', 1)
   call $tk_keys('add', keys, 'ctrl-o', 'output', 'output', '', 1)
   call $tk_keys('add', keys, 'esc', 'menu', 'menu', '', 1)                ;* S.88 F0a: Esc closes the output pane when it is open, else opens the menu bar
   call $tk_keys('menu', keys, 'quit', '&File', '&Quit', '', '')
   call $tk_keys('menu', keys, 'change', '&Program', '&Allow or stop allowing', '', '')
   call $tk_keys('menu', keys, 'pane', '&View', '&Switch box', '', '')
   call $tk_keys('menu', keys, 'refresh', '&View', '&Refresh', '', '')
   call $tk_keys('menu', keys, 'output', '&View', '&Output', '', '')
   call $tk_keys('menu', keys, 'help', '&Help', '&Help on this box', '', '')

   cnames = 'evince' : @fm : 'okular' : @fm : 'zathura' : @fm : 'atril' : @fm : 'xreader' : @fm : 'mupdf' : @fm : 'qpdfview' : @fm : 'xpdf' : @fm : 'gv' : @fm : 'xdg-open'
   pnames = 'Allowed' : @fm : 'Found'

   VIS = 10                                                      ;* program rows in a list (the list pane's height less 4: set by get.rects)
   pane = 2
   ai = 1                                                        ;* the row selected in Allowed
   fi = 1                                                        ;* the row selected in Found
   gen = 0
   msg = ''
   done = 0
   outopen = 0                                                   ;* 1 while the output pane (what the commands answered) is shown: a pane of the layout, closed as delivered

   perr = ''
   gosub declare.layout
   gosub read.all
   gosub draw.all

   loop
      call $tk_menubar('draw', ctx, keys, pnames<pane>, '', '', mr)         ;* the bar first: it writes row 0 whole, and the frame then writes the app name at its right end
      call $tk_frame(ctx, keys, pnames<pane>, msg)
      call $sl_curat(0, ctx<TK.C.YSTAT>)
      nm = ''
      screen key returning nm
      mr = ''
      if nm # '' then call $tk_menubar('key', ctx, keys, pnames<pane>, nm, outopen, mr)       ;* F10, Alt and a letter, and Esc when no output pane is open (the Esc rule): the bar
      if mr<1> # '' then nm = mr<4>
      begin case
         case nm = ''
            if status() = ER$EOF then exit
         case nm = 'guardquit'
            exit
         case nm = 'resize'
            call $tk_layout('refresh', ctx, '', chg)
            gosub get.rects
            gen += 1
            ctx<TK.C.GEN> = gen
            gosub draw.all
         case nm = 'mouse'
            gosub on.mouse
         case 1
            gosub on.key
      end case
      if done then exit
   repeat

   call $tk_close(ctx)
   stop

* ------------------------------------------------------------------------------------------------- what the machine says

* The list, and the readers found; for each, whether the test passes now
read.all:
   call !viewlist('get', 'pdf', paths, 0)
   na = dcount(paths, @fm)
   awhy = ''
   for i = 1 to na
      call !viewlist('check', paths<i>, why, 0)
      awhy<i> = why
   next i
   fn = 0
   fpath = ''
   fname = ''
   fwhy = ''
   fon = ''
   for i = 1 to dcount(cnames, @fm)
      call !viewlist('find', cnames<i>, pth, 0)
      if pth # '' then
         fn += 1
         fname<fn> = cnames<i>
         fpath<fn> = pth
         call !viewlist('check', pth, why, 0)
         fwhy<fn> = why
         locate pth in paths<1> setting lp then fon<fn> = 1 else fon<fn> = 0
      end
   next i
   if ai > na then ai = na
   if ai < 1 then ai = 1
   if fi > fn then fi = fn
   if fi < 1 then fi = 1
   return

* ------------------------------------------------------------------------------------------------- drawing

* The layout (S.88 L2).  The four boxes are panes of the layout service, declared in the sizes of the reference layout (140 by 43, the body 138 by 39): the two lists side by side
* in the first band, the explanation in the second and the help in the third.  A bigger window gives the lists and the explanation the rows and the columns beyond the
* reference, by weight (the help box and the three rows the page has always left empty at the foot stay as they are).
* Out: a.x a.y a.w a.h (Allowed), f.x f.y f.w f.h (Found), m.x m.y m.w m.h (What this means), h.x h.y h.w h.h (Help), VIS.
declare.layout:
   d = ''
   d<1> = 'allowed' : @vm : 1 : @vm : 1 : @vm : 14 : @vm : 70 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<2> = 'found' : @vm : 1 : @vm : 2 : @vm : 14 : @vm : 67 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<3> = 'means' : @vm : 2 : @vm : 1 : @vm : 17 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   d<4> = 'help' : @vm : 3 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   call $tk_layout('declare', ctx, d, perr)
   if outopen then gosub open.layout                             ;* the output pane is open: the same panes with room for it (declaring again replaces)
   gosub get.rects
   return

* With the output pane open (30 Oct 26, S.88 F0a pilot): the same four panes, the explanation 6 rows shorter and the output pane, 6 rows, between it and the help.  The closed
* layout above is the page's own; get.rects reads the rectangles by the same names.
open.layout:
   o = ''
   o<1> = 'allowed' : @vm : 1 : @vm : 1 : @vm : 14 : @vm : 70 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   o<2> = 'found' : @vm : 1 : @vm : 2 : @vm : 14 : @vm : 67 : @vm : 1 : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   o<3> = 'means' : @vm : 2 : @vm : 1 : @vm : 11 : @vm : 138 : @vm : '' : @vm : 'stretch' : @vm : 1 : @vm : 'stretch' : @vm : 1
   o<4> = 'output' : @vm : 3 : @vm : 1 : @vm : 6 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   o<5> = 'help' : @vm : 4 : @vm : 1 : @vm : 5 : @vm : 138 : @vm : '' : @vm : '' : @vm : '' : @vm : 'stretch' : @vm : 1
   call $tk_layout('declare', ctx, o, perr)
   return

* Ctrl-O or View > Output, and Esc while it is open: the output pane is shown or put away, the layout is declared again and all of it drawn
toggle.out:
   call $tk_out('toggle', ctx, '', '', oc)
   outopen = oc
   gosub declare.layout
   gen += 1
   ctx<TK.C.GEN> = gen
   gosub draw.all
   return

get.rects:
   call $tk_layout('pane', ctx, 'allowed', rc)
   a.x = rc<1, 1> ; a.y = rc<1, 2> ; a.w = rc<1, 3> ; a.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'found', rc)
   f.x = rc<1, 1> ; f.y = rc<1, 2> ; f.w = rc<1, 3> ; f.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'means', rc)
   m.x = rc<1, 1> ; m.y = rc<1, 2> ; m.w = rc<1, 3> ; m.h = rc<1, 4>
   call $tk_layout('pane', ctx, 'help', rc)
   h.x = rc<1, 1> ; h.y = rc<1, 2> ; h.w = rc<1, 3> ; h.h = rc<1, 4>
   m.tw = m.w - 4                                                ;* the text width of the explanation and of the help: 134 at the reference
   h.tw = h.w - 4
   VIS = a.h - 4                                                 ;* the header row, the program rows, a blank row and the border: 10 rows of 14
   return

draw.all:
   screen clear at 0,ctx<TK.C.YBODY> size ctx<TK.C.W>,ctx<TK.C.BODYH>
   screen box at a.x,a.y size a.w,a.h title 'Allowed for pdf'
   screen box at f.x,f.y size f.w,f.h title 'Found on this machine'
   screen box at m.x,m.y size m.w,m.h title 'What this means'
   screen box at h.x,h.y size h.w,h.h title 'Help'
   gosub draw.allowed
   gosub draw.found
   gosub draw.effect
   gosub draw.help
   if outopen then call $tk_out('draw', ctx, 'output', '', oc)  ;* the output pane, in the rectangle the open layout gives it
   return

* The columns beyond the reference (a.w - 70) go to the program's name, the reason of a failed test is cut where it always was
draw.allowed:
   tw = a.w - 8
   ex = a.w - 70
   screen text fmt('Program', (40 + ex) : 'L') : 'Test now' at a.x + 2,a.y + 1 attr 'header' width tw
   for r = 1 to VIS
      s = ''
      if r <= na then s = fmt(paths<r>[1, 38 + ex], (40 + ex) : 'L') : (if awhy<r> = '' then 'passes' else 'FAILS: ' : awhy<r>[1, 20])
      screen text s at a.x + 2,a.y + 1 + r attr (if r = ai and r <= na then (if pane = 1 then 'highlight' else 'bold') else 'normal') width tw
   next r
   if na = 0 then screen text 'None.  pdf says that no viewer has been allowed.' at a.x + 2,a.y + 3 width tw
   call $tk_help('mark', a.x + a.w - 5, a.y + 1, 0, 0)
   return

draw.found:
   tw = f.w - 8
   ex = f.w - 67
   screen text fmt('Reader', '12L') : fmt('Allowed', '9L') : 'Could it be allowed' at f.x + 2,f.y + 1 attr 'header' width tw
   for r = 1 to VIS
      s = ''
      if r <= fn then s = fmt(fname<r>, '12L') : fmt((if fon<r> then 'yes' else 'no'), '9L') : (if fwhy<r> = '' then 'yes' else 'no: ' : fwhy<r>[1, 30 + ex])
      screen text s at f.x + 2,f.y + 1 + r attr (if r = fi and r <= fn then (if pane = 2 then 'highlight' else 'bold') else 'normal') width tw
   next r
   if fn = 0 then screen text 'No known PDF reader is in /usr/bin, /usr/local/bin or /bin.' at f.x + 2,f.y + 3 width tw
   call $tk_help('mark', f.x + f.w - 5, f.y + 1, 0, 0)
   return

* In plain sentences, for what is selected
draw.effect:
   lines = ''
   lines<-1> = 'A program on this list is started by the pdf verb for ANY account, even one whose os.execute switch is off, to show a document of the shared account.'
   lines<-1> = "The program is given one argument, the document, which is always a file of the shared account's pdf directory and never a path the person types."
   lines<-1> = 'Nothing is allowed as delivered: until you allow a reader here, pdf says that no viewer has been allowed.'
   lines<-1> = ''
   lines<-1> = 'A graphical reader can still open other files its user may read, and follow links.  Allow only programs you trust, and only ones that are not shells.'
   lines<-1> = 'The test is made again each time the program is started: an absolute path of a regular file owned by root, not writable by group or others.'
   lines<-1> = ''
   if pane = 1 and na > 0 then
      lines<-1> = 'Selected: ' : paths<ai> : (if awhy<ai> = '' then ' passes the test now.' else ' FAILS the test now (' : awhy<ai> : ') and is not started.')
   end
   if pane = 2 and fn > 0 then
      lines<-1> = 'Selected: ' : fpath<fi> : (if fon<fi> then ' is allowed.  Enter stops allowing it.' else (if fwhy<fi> = '' then ' is not allowed.  Enter allows it.' else ' cannot be allowed: ' : fwhy<fi> : '.'))
   end
   if outopen and ((pane = 1 and na > 0) or (pane = 2 and fn > 0)) then
      nl = dcount(lines, @fm)                       ;* the output pane left 8 rows: what is selected (the last line) goes first so that it is never the one cut
      sl = lines<nl>
      del lines<nl>
      lines = sl : @fm : lines
   end
   gosub wrap.lines
   for r = 1 to m.h - 3
      screen text lines<r> at m.x + 2,m.y + 1 + r width m.tw
   next r
   return

* A SCREEN TEXT longer than its width is cut, not wrapped
wrap.lines:
   wrapped = ''
   for wi = 1 to dcount(lines, @fm)
      call $tk_wrap(lines<wi>, m.tw, pieces)
      wrapped<-1> = pieces
   next wi
   lines = wrapped
   return

draw.help:
   screen text 'Up and Down move.  Tab changes box.  Enter allows or stops allowing.  F1 or ? explains the box.' at h.x + 2,h.y + 1 width h.tw
   screen text 'Each change is shown as its command; you answer Run or Cancel.  Allowing a program asks for its name to be typed.' at h.x + 2,h.y + 2 width h.tw
   screen text 'F5 reads the machine again.  Ctrl-Q leaves.' at h.x + 2,h.y + 3 width h.tw
   return

* ------------------------------------------------------------------------------------------------- keys and mouse

on.key:
   msg = ''
   begin case
      case nm = 'up'
         if pane = 1 and ai > 1 then
            ai -= 1
            gosub redraw
         end
         if pane = 2 and fi > 1 then
            fi -= 1
            gosub redraw
         end
      case nm = 'down'
         if pane = 1 and ai < na then
            ai += 1
            gosub redraw
         end
         if pane = 2 and fi < fn then
            fi += 1
            gosub redraw
         end
      case nm = 'tab' or nm = 'right' or nm = 'btab' or nm = 'left'
         pane = (if pane = 1 then 2 else 1)
         gosub redraw
      case nm = 'enter' or nm = ' '
         gosub change
      case nm = 'f1' or nm = '?'
         gosub help.here
      case nm = 'f5'
         gosub read.all
         gosub draw.all
         msg = 'read the machine again'
      case nm = 'ctrl-q'
         done = 1
      case nm = 'ctrl-o'
         gosub toggle.out
      case nm = 'esc'
         if outopen then gosub toggle.out                                ;* the Esc rule: what the page has open is closed first; with nothing open the bar took the key
      case (nm = 'pgup' or nm = 'pgdn') and outopen
         call $tk_out('key', ctx, nm, '', oc)                            ;* the output pane scrolls
         call $tk_out('draw', ctx, 'output', '', oc)
   end case
   return

redraw:
   gosub draw.allowed
   gosub draw.found
   gosub draw.effect
   return

on.mouse:
   screen mouse returning mev else mev = ''
   if mev = '' then return
   mr = ''
   call $tk_menubar('click', ctx, keys, pnames<pane>, mev, '', mr)                 ;* a click on the bar on row 0
   if mr<1> # '' then
      nm = mr<4>
      if nm # '' then gosub on.key                          ;* a bar left with nothing chosen has no name: the status message stays
      return
   end
   call $tk_help('hit', mev, a.x + a.w - 5, a.y + 1, hit.allowed)
   call $tk_help('hit', mev, f.x + f.w - 5, f.y + 1, hit.found)
   if hit.allowed or hit.found then
      pane = (if hit.allowed then 1 else 2)
      gosub redraw
      gosub help.here
      return
   end
   if mev<1> = 'press' and mev<2> = 1 then
      mx = mev<3>
      my = mev<4>
      begin case
         case mx >= a.x + 1 and mx <= a.x + a.w - 2 and my >= a.y + 2 and my <= a.y + 1 + VIS
            if my - a.y - 1 <= na then ai = my - a.y - 1
            pane = 1
            gosub redraw
         case mx >= f.x + 1 and mx <= f.x + f.w - 2 and my >= f.y + 2 and my <= f.y + 1 + VIS
            if my - f.y - 1 <= fn then fi = my - f.y - 1
            pane = 2
            gosub redraw
      end case
   end
   return

help.here:
   call $tk_help('box', (if pane = 1 then 'tool.viewers.allowed' else 'tool.viewers.found'), hm, 0, 0)
   if hm # '' then msg = hm
   return

* ------------------------------------------------------------------------------------------------- changing something: the command, its effect, Run or Cancel, then the machine's answer

change:
   acct.name = ''
   if pane = 2 then
      if fn = 0 then return
      pname = fname<fi>
      ppath = fpath<fi>
      on.now = fon<fi>
      pwhy = fwhy<fi>
      if not(on.now) and pwhy # '' then
         msg = pname : ' cannot be allowed: ' : pwhy
         return
      end
   end else
      if na = 0 then return
      ppath = paths<ai>
      on.now = 1
      pwhy = ''
      gosub name.of
      if pname = '' then
         msg = 'Not in /usr/bin, /usr/local/bin or /bin: at the prompt, set.viewer remove pdf ' : ppath
         return
      end
   end
   sent = 'set.viewer ' : (if on.now then 'remove' else 'add') : ' pdf ' : pname
   el = ''
   typed = ''
   if on.now then
      el<-1> = 'pdf will no longer start ' : ppath : '.'
      el<-1> = 'The documents stay where they are; with no viewer allowed, pdf says that none has been allowed.'
   end else
      el<-1> = 'pdf will start ' : ppath : ' for every account, even one whose os.execute switch is off, to show a document of the shared account.'
      el<-1> = 'The program gets one argument, the document; it can still open other files its user may read and follow links.'
      typed = pname
   end
   el<-1> = 'It takes effect at once.'
   call $tk_confirm(sent, el, typed, res, cmsg)
   if res = 'run' then
      call $tk_run(allow, sent, out, st, err)
      if err # '' then
         msg = err
         call $tk_out('add', ctx, 'refuse', sent : '  ' : err, '')           ;* what the command answered stays in the output pane, whether or not it is open
      end else
         said = trim(change(out, @fm, ' '))
         msg = (if said # '' then said[1, 130] else 'ran, status ' : st)
         call $tk_out('add', ctx, 'ok', sent : '  ' : (if said # '' then said else 'ran, status ' : st), '')
      end
      gosub read.all
      gosub draw.all
   end else
      msg = cmsg
   end
   return

* The bare name of the program on the Allowed row, if the three directories give that name back as this very path; else null
name.of:
   pname = ''
   cut = 0
   for ci = 1 to len(ppath)
      if ppath[ci, 1] = @ds then cut = ci
   next ci
   cand = ppath[cut + 1, 99]
   call !viewlist('find', cand, back, 0)
   if back = ppath then pname = cand
   return

end

* END-CODE
