*
* START-DESCRIPTION:
*
*    REMOTE.SDSYS {ON | OFF}
*
*    Whether the sdsys login may come in over ssh (S.95).  Shut as delivered.
*
*       ON        sd-elevate sdsys-ssh on opens the sdsys arm of sshd: sdsys can sign in over ssh from other computers with its PASSWORD, with no
*                 forwarding, straight into SD.  Nothing but that password then stands between the network and the administrator.
*       OFF       sd-elevate sdsys-ssh off shuts the arm again.  It tightens, so nothing is asked.
*
*    With no keyword it prints what the root helper reports (whether sshd lets sdsys in) and changes nothing.
*
*    ADMINISTRATOR ONLY, and audited (the keyword and the helper's status).
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $remote.sdsys
$catalog $remotesdsys

$include keys.h
$include int$keys.h
$include parser.h
$include err.h

$define HELPER     'sudo -n /usr/local/sbin/sd-elevate'

   prompt ''

   if not(kernel(K$ADMINISTRATOR, -1)) then
      stop sysmsg(2001)  ;* Command requires administrator privileges
   end

   action = ''
   extra = ''

   parser = "!PARSER"
   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)   ;* Verb remote.sdsys
   call @parser(PARSER$GET.TOKEN, token.type, action, keyword)  ;* ON | OFF

   if token.type = PARSER$END or action = '' then
      os.execute HELPER : ' sdsys-ssh status'
      rc = os.error()
      if rc # 0 then
         @system.return.code = -ER$FAILED
         crt sysmsg(11924, 'report', rc)
      end
      stop
   end

   action = downcase(trim(action))
   if action # 'on' and action # 'off' then
      @system.return.code = -ER$ARGS
      stop sysmsg(11923)  ;* remote.sdsys on | off
   end

   call @parser(PARSER$GET.TOKEN, token.type, extra, keyword)
   if token.type # PARSER$END then
      @system.return.code = -ER$ARGS
      stop sysmsg(11923)
   end

* The helper's words go straight to the terminal.  Nothing secret passes here.
   os.execute HELPER : ' sdsys-ssh ' : action
   rc = os.error()
   if rc # 0 then
      crt sysmsg(11924, action, rc)
   end else
      if action = 'on' then crt sysmsg(11929)  ;* ssh is open for sdsys
   end

   void kernel(K$AUDIT, 'remote.sdsys ' : action : ' status=' : rc)
   @system.return.code = (if rc = 0 then 0 else -ER$FAILED)
   stop

end

* END-CODE
