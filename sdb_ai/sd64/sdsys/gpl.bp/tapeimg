* START-HISTORY:
* 30 Oct 26 dm Written for S.92 (owner's yes of 30 Oct 2026, the nine recommendations).  The BASIC twin of gplbld/tapegen.py's parse_image:
*              the same checks in the same order, the same verdicts.  sandbox-tapeimg.py holds the two to each other.
* END-HISTORY
*
* START-DESCRIPTION:
*
*    call !tapeimg(op, arg, kind, num, aux, id, rec, verdict)
*
*    Reads a save image written by the old ACCOUNT.SAVE (the 3-label AS layout, see gplbld/tapegen.py) ONE ITEM AT A TIME.  It reads, it
*    never writes: the image is opened READONLY through OPENSEQ, so the OS gate and the edit gates of a caller that is not the
*    administrator still apply, and nothing from the image is compiled, catalogued or run.  This is NOT an $internal program for that reason.
*
*    op 'open'   arg<1> the absolute path of the image, arg<2> the most bytes of image (default 1073741824), arg<3> the most bytes of
*                one item (16777216), arg<4> the most files (10000).  Reads the five labels and looks at every block ONCE before it returns:
*                the end-of-file block, the pad.  On success: id = the account name, aux = the reel, num = the number of blocks,
*                rec = the time and date of the label.
*    op 'next'   the next item: kind 'D' (a file header: num = its number, aux = its level 1/2/3, id = its name, rec = the rest of the
*                header joined by field marks), 'I' (an ordinary item: aux = its group, id = the record id, rec = the record), 'O' (the
*                binary form: aux = group, a slash and the block count, rec = the data), or 'E' when the end-of-account mark was
*                read.  Nothing is built in memory but the window of one item, so an image is not read into a string.
*    op 'close'  gives the file back.  Every refusal does that too.
*
*    A refusal sets verdict to a code ('R-...': the same words as tapegen.py, and 'R-PATH', 'R-OPEN', 'R-NOTFILE', 'R-IO', 'R-STATE', 'R-OP' that
*    only an operating system can give) and rec to a sentence.  Nothing that follows a refusal is trusted.  An item whose end cannot be found
*    is a refusal (R-ITEMEND), never a guess.
*
*    Known limit: a binary item is held in memory whole, and appending to a long string is not free; an item of the 16 MB the limit allows
*    takes noticeably long.  A record id longer than the item limit is not recognised as the start of a binary item.
*
* END-DESCRIPTION
*
* START-CODE

subroutine tapeimg(op, arg, kind, num, aux, id, rec, verdict)
$catalog !tapeimg

$include syscom keys.h

   common /tapeimg/ ti.open, ti.fu, ti.nblk, ti.end, ti.next, ti.buf, ti.done, ti.maxitem, ti.maxfiles, ti.files, ti.nfiles

   ER.NSEQ = 3013                          ;* gplsrc/err.h ER_NSEQ: not a sequential file (a directory, a socket)
   TI.BLK = 512                            ;* a physical block: 12 NULs of pad and 500 bytes of payload
   TI.PAD = 12
   TI.PAY = 500
   TI.BIN = 1000                           ;* bytes to a block of the binary item form
   im = @im
   fm = @fm
   nul = char(0)
   digits = '0123456789'
   hexup = '0123456789ABCDEF'
   alphas = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
   printable = ''
   for j = 33 to 126
      printable := char(j)
   next j
   ctl = char(127)
   for j = 0 to 31
      ctl := char(j)
   next j
   for j = 248 to 255
      ctl := char(j)
   next j

   kind = ''
   num = ''
   aux = ''
   id = ''
   rec = ''
   verdict = ''
   begin case
      case op = 'open'
         gosub do.open
      case op = 'next'
         gosub do.next
      case op = 'close'
         gosub do.close
      case 1
         gosub refuse.op
   end case
   return

refuse.op:
   verdict = 'R-OP'
   rec = 'unknown operation'
   return

* A refusal: verdict is set by the caller, the file is given back.
fail:
   gosub do.close
   return

do.close:
   if ti.open then close ti.fu
   ti.open = 0
   ti.buf = ''
   ti.done = 0
   ti.files = ','
   ti.nfiles = 0
   return

* ---------------------------------------------------------------------------------------------------------------------------------------------------------
* open

do.open:
   gosub do.close
   ti.maxitem = 16777216
   ti.maxfiles = 10000
   max.image = 1073741824
   if arg<2> # '' then max.image = arg<2> + 0
   if arg<3> # '' then ti.maxitem = arg<3> + 0
   if arg<4> # '' then ti.maxfiles = arg<4> + 0
   path = arg<1>
   p.n = len(path)
   if p.n < 2 or p.n > 1000 or path[1, 1] # '/' or path[p.n, 1] = '/' or convert(ctl, '', path) # path or index(path, '//', 1) or index(path, '/./', 1) or index(path, '/../', 1) or path[p.n - 1, 2] = '/.' or path[p.n - 2, 3] = '/..' then
      verdict = 'R-PATH'
      rec = 'the path is not written in the one form'
      return
   end
   * THE CLAUSES END THE STATEMENT (see ide_osfile): ON ERROR returns itself and the LOCKED flag is tested after the statement.
   op.fail = 0
   lk.user = 0
   openseq path readonly to f on error
      op.fail = status()
   end locked
      lk.user = 1
   end then
      null
   end else
      op.fail = status()
      if op.fail = 0 then op.fail = -1
   end
   if op.fail # 0 then
      if not(unassigned(f)) then close f
      verdict = 'R-OPEN'
      rec = 'cannot open the image (' : op.fail : ')'
      if op.fail = ER.NSEQ then verdict = 'R-NOTFILE'
      return
   end
   ti.fu = f
   ti.open = 1
   if lk.user then
      verdict = 'R-OPEN'
      rec = 'the image is locked by another user'
      gosub fail
      return
   end
   if (fileinfo(ti.fu, FL$SEQTYPE) + 0) # 0 then
      verdict = 'R-NOTFILE'
      rec = 'the image is not an ordinary file'
      gosub fail
      return
   end
   seek ti.fu, 0, 2 else
      verdict = 'R-IO'
      rec = 'cannot find the size'
      gosub fail
      return
   end
   size = fileinfo(ti.fu, FL$SEQPOS) + 0
   begin case
      case size > max.image
         verdict = 'R-IMAGESIZE'
         rec = size : ' bytes'
      case size = 0
         verdict = 'R-EMPTY'
         rec = 'the image is empty'
      case mod(size, TI.BLK) # 0
         verdict = 'R-SHAPE'
         rec = size : ' bytes is not a whole number of ' : TI.BLK : ' byte blocks'
      case size < 6 * TI.BLK
         verdict = 'R-SHAPE'
         rec = (size / TI.BLK) : ' blocks'
   end case
   if verdict # '' then
      gosub fail
      return
   end
   ti.nblk = size / TI.BLK
   seek ti.fu, 0, 0 else
      verdict = 'R-IO'
      rec = 'cannot seek'
      gosub fail
      return
   end

   * the five blocks of the three labels, the end-of-file block and the descriptor
   gosub read.phys
   if verdict # '' then
      gosub fail
      return
   end
   blk.no = 0
   gosub parse.label
   if verdict # '' then
      gosub fail
      return
   end
   lab.acct = l.acct ; lab.time = l.time ; lab.date = l.date ; lab.reel = l.reel
   gosub read.phys
   if verdict # '' then
      gosub fail
      return
   end
   gosub is.eof
   if not(is.eof) then
      verdict = 'R-LAYOUT'
      rec = 'block 1 is not an end-of-file block'
      gosub fail
      return
   end
   gosub read.phys
   if verdict # '' then
      gosub fail
      return
   end
   blk.no = 2
   gosub parse.label
   if verdict # '' then
      gosub fail
      return
   end
   lab2.acct = l.acct
   gosub read.phys
   if verdict # '' then
      gosub fail
      return
   end
   gosub check.pad
   if not(pad.ok) then
      verdict = 'R-PAD'
      rec = 'block 3 has no pad'
      gosub fail
      return
   end
   desc = blk[TI.PAD + 1, TI.PAY]
   if desc[1, 7] # im : 'M65' : im : 'XC' or convert(' ', '', desc[8, TI.PAY - 7]) # '' then
      verdict = 'R-LAYOUT'
      rec = 'block 3 is not the descriptor'
      gosub fail
      return
   end
   gosub read.phys
   if verdict # '' then
      gosub fail
      return
   end
   blk.no = 4
   gosub parse.label
   if verdict # '' then
      gosub fail
      return
   end
   * strings that look like numbers compare as numbers: '#' in front of each makes them text
   if ('#' : l.second) # ('#' : l.acct) or ('#' : lab2.acct) # ('#' : lab.acct) or ('#' : l.acct) # ('#' : lab.acct) then
      verdict = 'R-LAYOUT'
      rec = 'the three labels name different accounts'
      gosub fail
      return
   end

   * the end-of-file block: the first from block 5, which must be the last; the pad of every data block before it
   end.at = -1
   pad.bad = -1
   for j = 5 to ti.nblk - 1
      gosub read.phys
      if verdict # '' then
         gosub fail
         return
      end
      gosub is.eof
      if is.eof then
         end.at = j
         exit
      end
      if pad.bad < 0 then
         gosub check.pad
         if not(pad.ok) then pad.bad = j
      end
   next j
   begin case
      case end.at < 0
         verdict = 'R-NOEOF'
         rec = 'no end-of-file block after the data'
      case end.at # ti.nblk - 1
         verdict = 'R-TRAILING'
         rec = 'blocks after the end-of-file block'
      case pad.bad >= 0
         verdict = 'R-PAD'
         rec = 'block ' : pad.bad : ' has no pad'
   end case
   if verdict # '' then
      gosub fail
      return
   end
   ti.end = end.at
   ti.next = 5
   ti.buf = ''
   ti.done = 0
   ti.files = ','
   ti.nfiles = 0
   seek ti.fu, 5 * TI.BLK, 0 else
      verdict = 'R-IO'
      rec = 'cannot seek'
      gosub fail
      return
   end
   id = lab.acct
   aux = lab.reel
   num = ti.nblk
   rec = lab.time : ' ' : lab.date
   return

* Out: blk (512 bytes), verdict 'R-IO' when the file gave less.
read.phys:
   blk = ''
   readblk blk from ti.fu, TI.BLK else
      verdict = 'R-IO'
      rec = 'a block could not be read'
      return
   end
   if len(blk) # TI.BLK then
      verdict = 'R-IO'
      rec = 'a block was short'
   end
   return

* In: blk.  Out: pad.ok, 1 when the first 12 bytes are NULs
check.pad:
   pad.ok = (len(blk) >= TI.PAD and convert(nul, '', blk[1, TI.PAD]) = '')
   return

* In: blk.  Out: is.eof, 1 for the end-of-file block: 'EOF', an item mark and nothing but NULs
is.eof:
   is.eof = 0
   if blk[1, 4] = 'EOF' : im then
      if convert(nul, '', blk[5, TI.BLK - 4]) = '' then is.eof = 1
   end
   return

* In: blk.  Out: l.acct, l.second, l.time, l.date, l.reel, or verdict 'R-PAD' / 'R-LABEL' / 'R-BLOCKSIZE'.  blk.no is only for the sentence.
parse.label:
   gosub check.pad
   if not(pad.ok) then
      verdict = 'R-PAD'
      rec = 'block ' : blk.no : ' has no pad'
      return
   end
   s = blk[TI.PAD + 1, TI.PAY]
   n = len(s)
   loop while n > 0 and s[n, 1] = nul do n -= 1 repeat
   s = s[1, n]
   ok = 0
   if n >= 39 then
      k = index(s, fm, 1)
      ok = (k >= 37)
   end
   if ok then ok = (s[1, 1] = im and s[2, 1] = 'L' and s[3, 1] = ' ' and s[8, 1] = ' ' and s[17, 2] = '  ' and s[30, 1] = ' ' and s[31, 5] = 'DATA ')
   if ok then ok = (convert(hexup, '', s[4, 4]) = '' and convert(digits, '', s[9, 2]) = '' and s[11, 1] = ':' and convert(digits, '', s[12, 2]) = '' and s[14, 1] = ':' and convert(digits, '', s[15, 2]) = '')
   if ok then ok = (convert(digits, '', s[19, 2]) = '' and s[21, 1] = ' ' and convert(alphas, '', s[22, 3]) = '' and s[25, 1] = ' ' and convert(digits, '', s[26, 4]) = '')
   if ok then ok = (convert(digits, '', s[k + 1, 2]) = '' and len(s) = k + 2)
   l.second = ''
   if ok then
      * the names: a printable token, then at most one more after ONE space, then spaces only
      names = s[36, k - 36]
      m = len(names)
      a = 1
      loop while a <= m and convert(printable, '', names[a, 1]) = '' do a += 1 repeat
      ok = (a > 1)
      l.acct = names[1, a - 1]
      if ok and a <= m and names[a, 1] = ' ' then
         b = a + 1
         e = b
         loop while e <= m and convert(printable, '', names[e, 1]) = '' do e += 1 repeat
         if e > b then
            l.second = names[b, e - b]
            a = e
         end
      end
      if ok then ok = (convert(' ', '', names[a, m]) = '' or a > m)
   end
   if not(ok) then
      verdict = 'R-LABEL'
      rec = 'block ' : blk.no : ' is not a label'
      return
   end
   if s[4, 4] # '01F4' then
      verdict = 'R-BLOCKSIZE'
      rec = 'block size field ' : s[4, 4]
      return
   end
   l.time = s[9, 8]
   l.date = s[19, 11]
   l.reel = s[k + 1, 2]
   return

* ---------------------------------------------------------------------------------------------------------------------------------------------------------
* next

do.next:
   if not(ti.open) then
      verdict = 'R-STATE'
      rec = 'the image is not open'
      return
   end
   if ti.done then
      kind = 'E'
      return
   end
   * the next item starts at ti.buf[1]
   loop while ti.buf = '' do
      gosub load.block
      if not(have) then
         verdict = 'R-NOEND'
         rec = 'the data has no end-of-account mark'
         gosub fail
         return
      end
      ti.buf = pl
   repeat
   if ti.buf[1, 1] # im then
      verdict = 'R-STREAM'
      rec = 'the data has bytes between two items'
      gosub fail
      return
   end
   * the window: up to the second item mark, or the end of the data, or one byte more than an item may hold
   p2 = index(ti.buf, im, 2)
   loop while p2 = 0 and len(ti.buf) <= ti.maxitem + 1 do
      gosub load.block
      if not(have) then exit
      k = index(pl, im, 1)
      if k then p2 = len(ti.buf) + k
      ti.buf := pl
   repeat
   if verdict # '' then
      gosub fail
      return
   end

   * the binary form is tried first, as in the twin
   gosub try.binary
   if verdict # '' then
      gosub fail
      return
   end
   if of.found then return

   * the end-of-account mark: the item's own text, up to the next item mark, is XX and spaces
   if ti.buf[2, 2] = 'XX' then
      if p2 then
         tail = ti.buf[4, p2 - 4]
      end else
         tail = ti.buf[4, 999999999]
      end
      if convert(' ', '', tail) # '' then
         verdict = 'R-TRAILING'
         rec = 'bytes after the end-of-account mark'
         gosub fail
         return
      end
      more = (p2 = 0)
      loop while more do
         gosub load.block
         if not(have) then
            more = 0
         end else
            k = index(pl, im, 1)
            if k then seg = pl[1, k - 1] else seg = pl
            if convert(' ', '', seg) # '' then
               verdict = 'R-TRAILING'
               rec = 'bytes after the end-of-account mark'
               gosub fail
               return
            end
            if k then more = 0
         end
      repeat
      if verdict # '' then
         gosub fail
         return
      end
      ti.done = 1
      kind = 'E'
      return
   end

   if p2 then
      tok = ti.buf[2, p2 - 2]
      ti.buf = ti.buf[p2, 999999999]
   end else
      tok = ti.buf[2, 999999999]
      ti.buf = ''
   end
   if len(tok) > ti.maxitem then
      verdict = 'R-ITEMCAP'
      rec = 'an item of ' : len(tok) : ' bytes'
      gosub fail
      return
   end
   t = tok[1, 1]
   nf = dcount(tok, fm)
   begin case
      case t = 'D'
         gosub parse.header
      case t = 'I'
         gosub parse.item
      case index('OBLRHFE', t, 1) and t # ''
         verdict = 'R-UNSUPPORTED'
         rec = 'an item of type ' : t
      case 1
         verdict = 'R-BLOCKTYPE'
         rec = 'an item of unknown type'
   end case
   if verdict # '' then gosub fail
   return

* Out: pl (the payload of the next data block), have (0 when there is none)
load.block:
   have = 0
   pl = ''
   if ti.next >= ti.end then return
   blk = ''
   readblk blk from ti.fu, TI.BLK else
      verdict = 'R-IO'
      rec = 'a block could not be read'
      return
   end
   ti.next += 1
   pl = blk[TI.PAD + 1, TI.PAY]
   have = 1
   return

* In: tok, nf.  A file header: IM D FM level FM number FM LLLL name FM type ...
parse.header:
   if nf < 6 or ('#' : field(tok, fm, 1)) # '#D' then
      verdict = 'R-HEADER'
      rec = 'a file header with ' : nf : ' fields'
      return
   end
   level = field(tok, fm, 2)
   lv = '#' : level
   if lv # '#1' and lv # '#2' and lv # '#3' then
      verdict = 'R-LEVEL'
      rec = 'level ' : level[1, 8]
      return
   end
   fnum = field(tok, fm, 3)
   if len(fnum) < 1 or len(fnum) > 9 or convert(digits, '', fnum) # '' then
      verdict = 'R-FILENUM'
      rec = 'file number ' : fnum[1, 12]
      return
   end
   f4 = field(tok, fm, 4)
   if len(f4) < 4 or convert(digits, '', f4[1, 4]) # '' then
      verdict = 'R-HEADER'
      rec = 'no length in front of the file name'
      return
   end
   if not(index(ti.files, ',' : fnum : ',', 1)) then
      ti.files := fnum : ','
      ti.nfiles += 1
      if ti.nfiles > ti.maxfiles then
         verdict = 'R-FILECAP'
         rec = 'more than ' : ti.maxfiles : ' files'
         return
      end
   end
   kind = 'D'
   num = fnum
   aux = level
   id = f4[5, 999999999]
   rec = field(tok, fm, 5, 999999999)
   return

* In: tok, nf.  An ordinary item: IM I<file> FM group FM LLLL id FM field FM ...
parse.item:
   f1 = field(tok, fm, 1)
   fnum = f1[2, 999999999]
   if nf < 4 or len(fnum) < 1 or len(fnum) > 9 or convert(digits, '', fnum) # '' then
      verdict = 'R-HEADER'
      rec = 'an item header with ' : nf : ' fields'
      return
   end
   grp = field(tok, fm, 2)
   if len(grp) < 1 or len(grp) > 9 or convert(digits, '', grp) # '' then
      verdict = 'R-FILENUM'
      rec = 'group ' : grp[1, 12]
      return
   end
   if not(index(ti.files, ',' : fnum : ',', 1)) then
      verdict = 'R-NOFILE'
      rec = 'an item for file ' : fnum : ', which has no header'
      return
   end
   f3 = field(tok, fm, 3)
   if len(f3) < 4 or convert(digits, '', f3[1, 4]) # '' then
      verdict = 'R-HEADER'
      rec = 'no length in front of the record id'
      return
   end
   body = field(tok, fm, 4, 999999999)
   * one field mark at the end is the writer's own
   if body[len(body), 1] = fm then body = body[1, len(body) - 1]
   kind = 'I'
   num = fnum
   aux = grp
   id = f3[5, 999999999]
   rec = body
   return

* ---------------------------------------------------------------------------------------------------------------------------------------------------------
* the binary form: IM I<file> FM group FM O<blocks> FM id FM data (1000 bytes to a block, NUL padded) IM IM IM X IM char(130) length IM
* In: ti.buf (the window), p2.  Out: of.found (1: the item is read, the buffer moved on), or verdict.  The end of the item is the block count, never a search.

try.binary:
   of.found = 0
   if ti.buf[2, 1] # 'I' then return
   q = 3
   gosub run.digits
   if dn < 1 or dn > 9 or ti.buf[q, 1] # fm then return
   o.num = ti.buf[q - dn, dn]
   q += 1
   gosub run.digits
   if dn < 1 or dn > 9 or ti.buf[q, 1] # fm then return
   o.grp = ti.buf[q - dn, dn]
   q += 1
   if ti.buf[q, 1] # 'O' then return
   q += 1
   gosub run.digits
   if dn < 1 or dn > 9 or ti.buf[q, 1] # fm then return
   o.blocks = ti.buf[q - dn, dn] + 0
   q += 1
   r0 = q
   loop while q <= len(ti.buf) and ti.buf[q, 1] # fm and ti.buf[q, 1] # im do q += 1 repeat
   if ti.buf[q, 1] # fm then return
   o.id = ti.buf[r0, q - r0]
   q += 1
   * it is the binary form: the rules of the twin
   if not(index(ti.files, ',' : o.num : ',', 1)) then
      verdict = 'R-NOFILE'
      rec = 'a binary item for file ' : o.num : ', which has no header'
      return
   end
   if o.blocks < 1 then
      verdict = 'R-HEADER'
      rec = 'a binary item of no blocks'
      return
   end
   if o.blocks * TI.BIN > ti.maxitem then
      verdict = 'R-ITEMCAP'
      rec = 'a binary item of ' : o.blocks : ' blocks'
      return
   end
   d1 = q
   t1 = d1 + o.blocks * TI.BIN             ;* where the trailer must begin
   need = t1 + 17                           ;* the trailer is 6 bytes, up to 9 digits and the mark that follows
   loop while len(ti.buf) < need do
      gosub load.block
      if not(have) then exit
      ti.buf := pl
   repeat
   if verdict # '' then return
   ok = (len(ti.buf) >= t1 - 1)
   if ok then ok = (ti.buf[t1, 3] = im : im : im and ti.buf[t1 + 3, 1] = 'X' and ti.buf[t1 + 4, 1] = im and ti.buf[t1 + 5, 1] = char(130))
   if ok then
      q = t1 + 6
      gosub run.digits
      ok = (dn >= 1 and dn <= 9 and ti.buf[q, 1] = im)
      o.len = ti.buf[q - dn, dn] + 0
   end
   if not(ok) then
      verdict = 'R-ITEMEND'
      rec = 'no trailer after ' : o.blocks : ' blocks of data'
      return
   end
   if o.len < 1 or o.len > o.blocks * TI.BIN or (o.blocks > 1 and o.len <= (o.blocks - 1) * TI.BIN) then
      verdict = 'R-ITEMEND'
      rec = 'length ' : o.len : ' does not fit ' : o.blocks : ' blocks'
      return
   end
   raw = ti.buf[d1, o.blocks * TI.BIN]
   if convert(nul, '', raw[o.len + 1, 999999999]) # '' then
      verdict = 'R-ITEMEND'
      rec = 'the padding of a binary item is not NUL'
      return
   end
   kind = 'O'
   num = o.num
   aux = o.grp : '/' : o.blocks
   id = o.id
   rec = raw[1, o.len]
   ti.buf = ti.buf[q, 999999999]
   of.found = 1
   return

* In: ti.buf, q.  Out: dn (the digits from q), q (the first byte after them).  q moves, the buffer does not.
run.digits:
   dn = 0
   loop while q <= len(ti.buf) and convert(digits, '', ti.buf[q, 1]) = '' do
      dn += 1
      q += 1
   repeat
   return
end

