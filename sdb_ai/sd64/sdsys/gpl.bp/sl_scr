* 28 Oct 26 dm  S.88 L1 (R-a): the op pending, the program's own wait asking whether a resize was read by a dialogue and not delivered (the note
*               $sl_key keeps in common /slpend/); open and close forget the note.  The block /slscr/ is unchanged (CPROC declares it too).
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $sl_scr(op, scr)
*
*     resized  scr returns 1 if the kept context has been made a new size (the terminal was resized, or TERM w,h
*            typed) since this was last asked, else 0, and the flag is cleared (SCREEN REFRESH's RETURNING)
*     pending  scr returns 1 if $sl_key has handed out the key resize since the program's own wait (SCREEN KEY, SCREEN WAIT) last
*            delivered one, else 0, and the note is cleared.  The wait asks it before it reads a key and delivers resize first: a
*            resize read by a dialogue (a menu, a message box, SCREEN ASK, a pick window, the toolkit's confirm and AI boxes, the
*            IDE's name box) redraws the dialogue and was never the program's, which went on with the old geometry (R-a, 28 Oct 2026).
*            The wait that delivers a resize it read itself asks it too, so that the note is not delivered a second time.
*     get    scr is the screen context (sl.h) the library is to use.  If the library owns the screen and the
*            terminal is no longer the size the kept context was made for, the context is first made the new
*            size, keeping every cell that still fits, and the screen drawn again from it.  Until SCREEN OPEN has been done
*            it is a blank one of the terminal's size, made afresh on every call and not kept
*            (SL.S.OWNED 0): a pop-up such as a message box can then put back only blanks, where the
*            program had text.  After SCREEN OPEN it is the kept one (SL.S.OWNED 1).
*     put    stores scr back as the kept context if there is one, and puts the terminal's cursor where
*            the context says it is (SL.S.CUR), shown or hidden as SL.S.CURON says.  Nothing to do
*            for a transient context.
*     open   makes the kept context: the terminal's size, every cell blank and style n, the cursor at
*            0,0 and shown.  scr returns it.  The terminal is not touched.
*     close  forgets it.
*
*   The routines of the SCREEN statement ask for the context here and hand it back with put, so
*   the program never handles one.  SED builds its own and calls the widget routines directly.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine sl_scr(op, scr)
$catalog $sl_scr

$include sl.h

   common /slscr/ ctx, ctx.open, ctx.resized
   common /slpend/ rz.pending                     ;* $sl_key's note of a resize handed out and not yet delivered by the program's wait

   if unassigned(ctx.open) then
      ctx = ''
      ctx.open = 0
   end

   begin case
      case op = 'get'
         if ctx.open then
            if ctx<SL.S.W> # @crtwide or ctx<SL.S.H> # @crthigh then gosub resize
            scr = ctx
            scr<SL.S.DIFF> = 0                  ;* only $sl_form turns it on, for the length of one of its calls
         end else
            gosub blank
            scr = blank.scr
         end

      case op = 'put'
         if ctx.open then
            if scr<SL.S.W> # ctx<SL.S.W> or scr<SL.S.H> # ctx<SL.S.H> then ctx.resized = 1   ;* a dialogue was resized under it
            ctx = scr
            if scr<SL.S.CURON> then
               display @(-31) : @(scr<SL.S.CUR, 1>, scr<SL.S.CUR, 2>) :
            end else
               display @(scr<SL.S.CUR, 1>, scr<SL.S.CUR, 2>) : @(-32) :
            end
         end

      case op = 'open'
         gosub blank
         blank.scr<SL.S.OWNED> = 1
         ctx = blank.scr
         ctx.open = 1
         scr = ctx
         rz.pending = 0                         ;* a resize from before this screen is not this program's

      case op = 'resized'
         scr = ctx.resized + 0                  ;* 1 if the context has been made a new size since this was last asked
         ctx.resized = 0

      case op = 'pending'
         scr = 0
         if rz.pending then scr = 1             ;* a resize handed out by $sl_key and not yet delivered by the program's wait
         rz.pending = 0

      case op = 'close'
         ctx = ''
         ctx.open = 0
         ctx.resized = 0
         rz.pending = 0
   end case

   return

* The terminal is not the size the kept context was made for (the window was resized, or TERM w,h was typed): $sl_resize
* makes it the new size, keeping every cell that still fits, and draws the screen again from it.  What was drawn with PRINT
* or CRT is not in the shadow, and goes, as for SCREEN REFRESH.
resize:
   call $sl_resize(ctx)
   ctx.resized = 1
   return

blank:
   * A context of the terminal's size, every cell blank and style n
   blank.scr = ''
   blank.scr<SL.S.W> = @crtwide
   blank.scr<SL.S.H> = @crthigh
   blank.scr<SL.S.CUR> = 0 : @vm : 0
   blank.scr<SL.S.CURON> = 1
   blank.scr<SL.S.OWNED> = 0
   for r = 0 to @crthigh - 1
      blank.scr<SL.S.SHADOW, r + 1> = space(@crtwide)
      blank.scr<SL.S.ATTRS, r + 1> = str('n', @crtwide)
   next r
   return
end

* END-CODE
