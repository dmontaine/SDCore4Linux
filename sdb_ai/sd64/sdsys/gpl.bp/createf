* START-HISTORY:
* 27 Oct 26 dm  S.87 batch 8: OPTION INHERIT.MFILE.PATH is gone; a new multifile subfile goes in the directory named for the file unless PATHNAME says otherwise.
* 17 Oct 26 dm  S.64 part 2: naming a component of a file that already has a VOC record - turning a single file into a multifile (its
*               %n parts move into a subdirectory and its pointer is rewritten) or adding a component to a multifile - changes an
*               EXISTING file, so a VOC, a dictionary or a program file is changed only by a session that has the gate for it
*               (edit.check.existing, K$EDIT.OK on each data path of the record).  Making a NEW file and its pointer, and an
*               ordinary file's conversion, are as before.
* 13 Oct 26 dm  COLLECTION makes a data collection file (the DHF_COLLECTION header bit):
*               READ gives a collection and WRITE takes one.
* 07 Oct 26 dm  PAL-1 D2 (the Windows port's RELEASE_1.1 5, 72d4a533): every file is
*               made NO.CASE by the kernel; CASE is refused outside internal mode
*               (10176); the dictionary part carries the same request.
* 06 Oct 26 dm  PAL-1 stage 2b (parity audit; the Windows port's RELEASE_1.1 5): the
*               default dictionary record is written as @id, and message 6129 says so.
* 13 Sep 26 dm  A new file is named in lower case - VOC id, directory, component
*               and .dic - unless CREATE.FILE.CASE is set; an existing entry is
*               found by the fold and keeps its id (plan M3 D4).
* 12 Sep 26 dm  Opens the file-pointer ids in lower case (plan M3).
* 12 Sep 26 dm  Name lookups fold as typed, then lower, then upper (plan M1).
* 10 Sep 26 dm  Parity audit: Enter is N at the convert-to-multifile prompt (port
*               PRE_RELEASE_FIXES 79).
* 19 Jan 04  0.6.1 SD launch. Earlier history details suppressed.
* rev 0.9.0 Jan 25 mab change dyn file prefix to %
* 18 Oct 26 dm  S.66: the refusal text comes from !edit_msg, which also knows the shared account's two refusals (11513, 11514).
* END-HISTORY
*
* START-DESCRIPTION:
*
* CREATE.FILE [{ DICT }] voc.name { DIRECTORY }
*             [{ DATA }]          { DYNAMIC {parameters {DIRECTORY path}}}
*             USING DICT filename
*             NO.QUERY
*
* Dynamic parameters:
*    MINIMUM.MODULUS n
*    GROUP.SIZE n
*    LARGE.RECORD n
*    SPLIT.LOAD n
*    MERGE.LOAD n
*    VERSION n
*    DIRECTORY path         path is existing directory to hold file
*    NO.CASE                case insensitive ids (the default, and the only
*                           kind of file since 14 Sep 26 - RELEASE_1.1 5 D2)
*    CASE                   case sensitive ids - internal mode only, for the
*                           upgrade witness; refused otherwise (10176)
*    NO.RESIZE              disable file resizing
*    COLLECTION             a data collection file: its records are data
*                           collections (JSON text on disk)
*
* END-DESCRIPTION
*
* START-CODE

$internal
program $create.file
$catalog $CREATEF

$include int$keys.h
$include parser.h
$include keys.h
$include err.h

deffun edit_msg(emk) calling '!edit_msg'     ;* 18 Oct 26 dm, S.66

$define default.merge.load 50
$define default.split.load 80

   parser = "!PARSER"
   prompt ''

   @system.return.code = -ER$ARGS            ;* Preset for argument errors

   * Open VOC here rather than using @VOC so that it will be closed on
   * exit avoiding the need for explicit releases on locks.

   open 'voc' to voc.f else stop 'Cannot open VOC'

   create.dict = @true
   create.data = @true
   file.type = FL$TYPE.DH
   no.case = @false
   collection.file = @false
   keep.case = @false
   dir.name = ""
   dir.name.with.delimiter = ""
   using.dict = @false
   no.query = @false
   no.resize = @false
   net.server = ''           ;* 21 Oct 26 dm, S.73 item 3: SERVER name - create the file on another SD server
   net.as = ''               ;* ... AS name: its name there (the local name when left out)

   group.size.value = -1
   large.rec.size = -1
   min.modulus.value = -1
   split.load.value = default.split.load
   merge.load.value = default.merge.load
   version.value = -1
   file.flags = 0
   voc.comment = ''

   call @parser(PARSER$RESET, 0, @sentence, 0)
   call @parser(PARSER$GET.TOKEN, token.type, token, keyword) ;* Verb
   call @parser(PARSER$MFILE, token.type, token, keyword) ;* First argument


   * Check for DICT or DATA keyword

   begin case
      case keyword = KW$DICT      ;* DICT
         create.data = @false
         call @parser(PARSER$MFILE, token.type, token, keyword)
  
      case keyword = KW$DATA      ;* DATA
         create.dict = @false
         call @parser(PARSER$MFILE, token.type, token, keyword)
   end case

   * Fetch file name

   if token.type = PARSER$END then stop sysmsg(2102) ;* File name required

   file.name = field(token, ',', 1)
   component = field(token, ',', 2)

   call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   if token.type = PARSER$COMMA then   ;* New multifile
      call @parser(PARSER$GET.TOKEN, token.type, component, keyword)
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   end

   if file.name = '' then stop sysmsg(6100) ;* Illegal file name

* 13 Sep 26 dm - plan M3 D4: A NEW FILE IS NAMED IN LOWER CASE - VOC id,
*   directory and dictionary - WHATEVER CASE IS TYPED.  The project standard is
*   that no file can exist in two casings, and on ext4 CREATE.FILE MYDATA
*   followed by CREATE.FILE mydata used to make two.  So the name is first
*   resolved the way every lookup folds it (as typed, lower, upper): an entry
*   that already exists keeps its id, and only a name with no entry at all
*   becomes lower case.  (27 Oct 26: the CREATE.FILE.CASE option, the way back to
*   "exactly as typed", is gone - owner's emulation survey, A-039.)
   read voc.rec from voc.f, file.name else
      read voc.rec from voc.f, downcase(file.name) then
         file.name = downcase(file.name)
      end else
         read voc.rec from voc.f, upcase(file.name) then
            file.name = upcase(file.name)
         end else
            file.name = downcase(file.name)
         end
      end
   end
   component = downcase(component)

   * Check for file type keyword. We default to DYNAMIC

   begin case
      case keyword = KW$DIRECTORY      ;* DIRECTORY
         file.type = FL$TYPE.DIR
         call @parser(PARSER$GET.TOKEN, token.type, token, keyword)

      case keyword = KW$DYNAMIC        ;* dynamic
         call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   end case

   * Check for other keywords

   loop
   until token.type = PARSER$END
      begin case
         * ---------- GROUP.SIZE n
         case keyword = KW$GROUP.SIZE and file.type # FL$TYPE.DIR
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N') or (value < 1) or (value > 8) then
               stop sysmsg(6105) ;* Group size is invalid
            end
            group.size.value = value + 0

         * ---------- LARGE.RECORD n
         case keyword = KW$LARGE.RECORD and file.type # FL$TYPE.DIR
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N0N') then
               stop sysmsg(6106) ;* Large record size is invalid
            end
            large.rec.size = value + 0
   
         * ---------- MERGE.LOAD n
         case keyword = KW$MERGE.LOAD and file.type = FL$TYPE.DH
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N0N') or value < 10 or value > 10000 then
               stop sysmsg(6107) ;* Merge load is invalid
            end
            merge.load.value = value + 0

         * ---------- MINIMUM.MODULUS n
         case keyword = KW$MINIMUM.MODULUS and file.type = FL$TYPE.DH
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N0N') or value < 1 then
               stop sysmsg(6108) ;* Minimum modulus is invalid
            end
            min.modulus.value = value + 0

         * ---------- NO.CASE
         case keyword = KW$NO.CASE
            no.case = @true

         * ---------- CASE
         * 14 Sep 26 Windows port - RELEASE_1.1 5 D2.  Owner's ruling: no two
         *   record ids may differ only by case, in any file.  The kernel makes
         *   every hashed file NOCASE whatever it is asked (op_dio1.c), so a
         *   CASE keyword would be silently ineffective here - it is refused
         *   instead, so nobody believes they have a case-sensitive file.  The
         *   one exception is internal mode: the upgrade's twin refusal
         *   (CONFIGURE.FILE) can only be witnessed on a case-sensitive file
         *   holding twins, and sd -internal is the only way to build one.
         case keyword = KW$CASE
*           07 Oct 26 - the message is several lines, so it is shown a line at a
*           time: one DISPLAY of it puts raw field marks on the screen (the
*           idiom is cproc's, 19 Sep 26).
            if not(kernel(K$INTERNAL, -1)) then
               case.msg = sysmsg(10176)
               for case.i = 1 to dcount(case.msg, @fm)
                  display case.msg<case.i>
               next case.i
               stop
            end
            keep.case = @true

         * ---------- NO.QUERY
         case keyword = KW$NO.QUERY
            no.query = @true

         * ---------- NO.RESIZE
         case keyword = KW$NO.RESIZE
            no.resize = @true

         * ---------- PATHNAME name
         case keyword = KW$PATHNAME
            call @parser(PARSER$GET.TOKEN, token.type, dir.name, keyword)
   
            if not(ospath(dir.name, OS$PATHNAME)) then
               @system.return.code = -ER$INVA.PATH
               stop sysmsg(6109) ;* Directory path name is not valid
            end
   
            if not(ospath(dir.name, OS$EXISTS)) then
               @system.return.code = -ER$NO.DIR
               stop sysmsg(6110) ;* Directory path name does not exist
            end
   
            * Get full pathname
   
            * 12 Oct 26 dm - openQM 278: a relative path is kept relative (to the account), so the account can move
            if dir.name[1,1] = @ds then dir.name = ospath(dir.name, OS$FULLPATH)   ;* 0339 removed UPCASE()
            dir.name.with.delimiter = dir.name
            if dir.name.with.delimiter[1] # @ds then dir.name.with.delimiter := @ds
   
         * ---------- SPLIT.LOAD n
         case keyword = KW$SPLIT.LOAD and file.type = FL$TYPE.DH
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N0N') or value < 20 or value > 10000 then
               stop sysmsg(6111) ;* Split load is invalid
            end
            split.load.value = value + 0
   
         * ---------- USING DICT filename
         case keyword = KW$USING
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if keyword # KW$DICT then stop sysmsg(6112, token) ;* Expected DICT after xx

            call @parser(PARSER$GET.TOKEN, token.type, dict.name, keyword)

            if not(create.data) then
               stop sysmsg(6113) ;* Inconsistent command options
            end

            read voc.rec from voc.f, dict.name else
               read voc.rec from voc.f, downcase(dict.name) then
                  dict.name = downcase(dict.name)
               end else
                  read voc.rec from voc.f, upcase(dict.name) else
                     stop sysmsg(6114, dict.name) ;* xx is not defined in your VOC
                  end
                  dict.name = upcase(dict.name)
               end
            end

            if upcase(voc.rec[1,1]) # 'F' then
               stop sysmsg(6115, dict.name) ;* xx is not an F-type VOC record
            end

            if voc.rec<3> = '' then
               stop sysmsg(6116, dict.name)  ;* xx has no dictionary
            end

            dict.path = voc.rec<3>
            using.dict = @true

         * ---------- VERSION n
         case keyword = KW$VERSION and file.type # FL$TYPE.DIR
            call @parser(PARSER$GET.TOKEN, token.type, value, keyword)
            if not(value matches '1N0N') or value < 0 or value > DH.VERSION then
               stop sysmsg(6117) ;* Invalid file version
            end
            version.value = value + 0

         * ---------- COLLECTION  (13 Oct 26 dm, data collections: records are collections, read and written as such)
         case keyword = KW$COLLECTION and file.type # FL$TYPE.DIR
            collection.file = @true

         case upcase(token) = 'COMMENT'       ;* 12 Oct 26 dm - openQM 383: COMMENT text  (quote it if it has spaces)
            call @parser(PARSER$GET.TOKEN, token.type, voc.comment, keyword)
            if token.type = PARSER$END or voc.comment = '' then stop sysmsg(11078) ;* Comment text required after COMMENT

         case upcase(token) = 'MULTIFILE'     ;* 12 Oct 26 dm - openQM 522: the data portion is a multifile named for the file
            if component = '' then component = file.name

         * ---------- SERVER name  /  AS name   (21 Oct 26 dm, S.73 item 3: the file is made on another SD server and the local pointer to it with it)
         case upcase(token) = 'SERVER'
            call @parser(PARSER$GET.TOKEN, token.type, net.server, keyword)
            if token.type = PARSER$END or net.server = '' then stop sysmsg(11536) ;* A server name is required after SERVER

         case upcase(token) = 'AS'
            call @parser(PARSER$GET.TOKEN, token.type, net.as, keyword)
            if token.type = PARSER$END or net.as = '' then stop sysmsg(11537) ;* A file name is required after AS

         case 1
            stop sysmsg(2018, token) ;* Unexpected token (xx)
      end case
         
      call @parser(PARSER$GET.TOKEN, token.type, token, keyword)
   repeat

*  21 Oct 26 dm - S.73 item 3: SERVER makes the file on another SD server and writes the N pointer to it in this account's VOC (see create.remote.file); AS without SERVER means nothing.
   if net.server # '' then
      gosub create.remote.file
      stop
   end
   if net.as # '' then stop sysmsg(11538) ;* AS is for a file on another server: give SERVER as well

   * Check that no VOC entry already exists for this name

   readu voc.rec from voc.f, file.name then
      if upcase(voc.rec[1,1]) # "F" then
         @system.return.code = -ER$VNF
         stop sysmsg(6101, file.name) ;* VOC record xx already exists but not as a file
      end

      if create.data then
         if component = '' and voc.rec<4> = '' then     ;* Creating simple file
            if (voc.rec<2> # "") then
               display sysmsg(6102) ;* DATA part of file already exists
               create.data = @false
            end
         end else
            if component = '' then component = file.name

* 17 Oct 26 dm - S.64: from here the verb changes a file that already exists - it moves a single file's parts into a subdirectory and
*   rewrites its pointer, or adds a component to its pointer - so a VOC, a dictionary or a program file is left alone unless the
*   session may change it.  It is asked before the "Convert to multifile" question, since the answer would make no difference.
            gosub edit.check.existing

            if voc.rec<2> # '' and voc.rec<4> = '' then   ;* 0262
               * We need to make this into a multifile.

               * 0484 Check if we are trying to create the default subfile.

               if file.name = component then   ;* 0484
                  stop sysmsg(6201, component) ;* Subfile %1 would be created from the existing data element
               end

               if no.query then
                  display sysmsg(6162, file.name, file.name)
                     * Converting to multifile named "%1,%1"
               end else
                  display sysmsg(6103, file.name) ;* %1 already exists but not as a multifile
                  loop
                     display sysmsg(6195, file.name, file.name) :
                        * Convert to multifile named "%1,%1" (y/<n>)?
                     input yn
                     yn = upcase(yn)
* 10 Sep 26 dm - Enter takes the default the prompt shows, N (port
*   PRE_RELEASE_FIXES 79).  An empty answer used to re-ask for ever.
                     if yn = '' then yn = 'N'
                  until yn = 'Y' or yn = 'N'
                  repeat
                  if yn = 'N' then stop
               end

               i = ospath("", os$flush.cache)

               old.path = voc.rec<2>

               * Transform invalid o/s names

               os.name = ospath(downcase(file.name), OS$MAPPED.NAME)   ;* 13 Sep 26 D4
               new.path = old.path : @ds : os.name

               subfiles = dir(old.path)

               * Create new subdirectory inside old file directory  

               if not(ospath(new.path, OS$MKDIR)) then
                  stop sysmsg(6196, new.path) ;* Unable to create %1
               end
* rev 0.9.0 *
               * Move the %n components down into the new sub directory

               for i = dcount(subfiles, @fm) to 1 step -1
                  s = subfiles<i,1>
                  if s[1,1] = '%' then
                     if not(osrename(old.path:@ds:s, new.path:@ds:s)) then
                        stop sysmsg(6197, status(), os.error(), old.path:@ds:s)
                              * Error %1.%2 moving %3
                     end
                  end
               next i

               voc.rec<2> = new.path
               voc.rec<4> = file.name
               writeu voc.rec to voc.f, file.name
            end

            locate component in voc.rec<4,1> setting i then
               display sysmsg(6102) ;* DATA part of file already exists
               create.data = @false
            end
         end
      end

      if create.dict and (voc.rec<3> # "") then
         display sysmsg(6104) ;* DICT part of file already exists
         create.dict = @false
      end

      if not(create.dict or create.data) then stop
   end else
      voc.rec = "F"        ;* Create skeletal VOC record
      if voc.comment # '' then voc.rec = "F " : voc.comment      ;* openQM 383: the description follows the type code
   end



   if group.size.value < 0 then group.size.value = config("GRPSIZE")
   if large.rec.size > (group.size.value * 1024 - 8) then
      stop sysmsg(6118) ;* Large record size must be at least 8 bytes less than group size
   end

   if split.load.value <= merge.load.value then
      stop sysmsg(6119) ;* Split load must be greater than merge load
   end


   if version.value >= 0 and version.value < 2 then
      * Validate file size

      if min.modulus.value > 1 then
         filesize = if version.value then (group.size.value * 1024) else 1024
         filesize += min.modulus.value * group.size.value * 1024
         if filesize > 2147483648 then stop sysmsg(6120) ;* File size is too large
      end
   end

   * Form operating system file name from VOC record name

   os.name = ospath(downcase(file.name), OS$MAPPED.NAME)   ;* 13 Sep 26 D4

   * Check if operating system components already exist

* 13 Sep 26 dm - plan M3 D4: the suffix goes with the naming rule - a literal
*   ".DIC" on a lower-case name is a mixed name.  Decided by the option, not by
*   testing os.name, because OS$MAPPED.NAME escapes a restricted character with
*   an UPPER-case letter (%E), and that must not flip the suffix.
   dict.suffix = '.dic'

   if create.dict and not(using.dict) then
      dict.path = dir.name.with.delimiter : os.name : dict.suffix
      if ospath(dict.path, OS$EXISTS) then        ;* Already exists
         stop sysmsg(6121, dict.path) ;* Dictionary pathname 'xx' already exists
      end
   end

   if create.data then
      * If we are creating a multifile element, use the file name as the
      * default directory under which to create the file.

      if component # '' then
         if dir.name = '' then
            dir.name = file.name
            dir.name.with.delimiter = dir.name
            if dir.name.with.delimiter[1] # @ds then dir.name.with.delimiter := @ds
         end

         os.name = ospath(downcase(component), OS$MAPPED.NAME)   ;* 13 Sep 26 D4
      end

      data.path = dir.name.with.delimiter : os.name

      if ospath(data.path, OS$EXISTS) then        ;* Already exists
         stop sysmsg(6125, data.path) ;* Data pathname 'xx' already exists
      end
   end

   * 14 Sep 26 Windows port - RELEASE_1.1 5 D2.  The case request for both
   *   parts.  NOCASE is what the kernel does anyway; asking for it here keeps
   *   the verb honest about what it makes.  KEEPCASE is a request the kernel
   *   honours only in internal mode (CASE above is refused everywhere else).
   if no.case and keep.case then stop sysmsg(6113) ;* Inconsistent command options
   case.flags = FL$FLAGS.NOCASE
   if keep.case then case.flags = FL$FLAGS.KEEPCASE

   * Create dictionary part

   if create.dict then
      if not(using.dict) then
         * 14 Sep 26 Windows port - RELEASE_1.1 5 D2.  The dictionary carries
         *   the same case request as the data part, so a CASE fixture is
         *   case sensitive in both halves and the kernel's default (NOCASE)
         *   reaches an ordinary dictionary by the same route as its data.
         create.file dict.path dynamic flags case.flags
         display sysmsg(6123, dict.path) ;* Created DICT part as xx
      end
      voc.rec<3> = dict.path
   end


   * Create data part

   if create.data then
      * If we are creating a multifile element, use the file name as the
      * default directory under which to create the file.

      if component # '' then
         if not(ospath(dir.name, OS$EXISTS)) then
            if not(ospath(dir.name, OS$MKDIR)) then
               stop sysmsg(6124, dir.name) ;* Unable to create directory xx
            end
         end
      end

      if component = '' then
         voc.rec<2> = data.path
      end else
         voc.rec<2,-1> = data.path
         voc.rec<4,-1> = component
      end

      file.flags = case.flags
      if no.resize then file.flags = bitor(file.flags, FL$FLAGS.NORESIZE)
      if collection.file then file.flags = bitor(file.flags, FL$FLAGS.COLLECTION)

      begin case
         case file.type = FL$TYPE.DH
            create.file data.path dynamic group.size group.size.value big.rec.size large.rec.size min.modulus min.modulus.value split.load split.load.value merge.load merge.load.value flags file.flags version version.value
         case 1
            create.file data.path directory
      end case
      display sysmsg(6127, data.path) ;* Created DATA part as xx
   end


   * Write VOC entry

   write voc.rec to voc.f, file.name

   * Write @id record to dictionary

   if create.dict and not(using.dict) then
      open "DICT", file.name to dict.file else
         @system.return.code = -status()
         stop sysmsg(6128) ;* Unable to open newly created dictionary
      end

      recordlocku dict.file, '@id'
      id.rec = "D" : @fm : "0" : @fm : "" : @fm : file.name : @fm
      id.rec := if file.type = FL$TYPE.DIR then "12L" else "10L"
      id.rec := @fm : "S" : @fm
      write id.rec to dict.file, "@id"

      display sysmsg(6129) ;* Added default '@id' record to dictionary

      close dict.file
   end

   @system.return.code = 0

   return

* ======================================================================
* create.remote.file  -  CREATE.FILE name ... SERVER srv {AS remote}   (21 Oct 26 dm, S.73 item 3, the owner's rule: "the pointer should be created or deleted when the file is created or
*   deleted. There should be no non-functional pointers")
*   The file is made on the server (the server runs its own create.file for this login: the definition of the server must say write here, the login needs sdfileswrite and sdfilesadmin there) and
*   the local N pointer is written ONLY AFTER the server has confirmed it - so there is never a pointer to a file that is not there.  Everything this machine can check is checked BEFORE anything is
*   sent: the name is not already in the VOC, this session may change the VOC (edit gate), and nothing that has no meaning for a remote file was asked for.  If the pointer cannot be written after
*   all, the verb says so and says the file now exists on the server; it is never deleted again behind the person's back.
create.remote.file:
   remote.what = ''
   begin case
      case not(create.dict and create.data)
         remote.what = 'dict / data'
      case dir.name # ''
         remote.what = 'pathname'
      case using.dict
         remote.what = 'using dict'
      case voc.comment # ''
         remote.what = 'comment'
      case component # ''
         remote.what = 'multifile'
      case keep.case
         remote.what = 'case'
   end case
   if remote.what # '' then
      @system.return.code = -ER$ARGS
      stop sysmsg(11528, net.server, 'create.file ' : remote.what) ;* %2 is not available for a file on server %1
   end

   if net.as = '' then remote.name = file.name else remote.name = net.as

   read voc.rec from voc.f, file.name then
      @system.return.code = -ER$VNF
      stop sysmsg(11539, file.name, net.server) ;* The name %1 is already in your VOC: nothing was created on server %2
   end
   vp = fileinfo(voc.f, FL$PATH)
   if not(kernel(K$EDIT.OK, vp)) then
      @system.return.code = -ER$PERM
      stop edit_msg(kernel(K$EDIT.KIND, vp)) ;* the pointer could not be written afterwards, so the file is not made at all
   end

   remote.words = remote.name
   if group.size.value # -1 then remote.words := ' GROUP.SIZE ' : group.size.value
   if large.rec.size # -1 then remote.words := ' LARGE.RECORD ' : large.rec.size
   if min.modulus.value # -1 then remote.words := ' MINIMUM.MODULUS ' : min.modulus.value
   if merge.load.value # default.merge.load then remote.words := ' MERGE.LOAD ' : merge.load.value
   if split.load.value # default.split.load then remote.words := ' SPLIT.LOAD ' : split.load.value
   if version.value # -1 then remote.words := ' VERSION ' : version.value
   if no.case then remote.words := ' NO.CASE'
   if no.resize then remote.words := ' NO.RESIZE'
   if collection.file then remote.words := ' COLLECTION'
   if file.type = FL$TYPE.DIR then remote.words := ' DIRECTORY'      ;* the server takes DIRECTORY as the last word only

   call !netadmin(voc.f, 8, net.server : @fm : remote.words, net.rc, @false)
   if net.rc # 0 then
      @system.return.code = net.rc
      return
   end

   voc.rec = 'N' : @fm : downcase(net.server) : @fm : downcase(remote.name)
   write voc.rec to voc.f, file.name on error
      @system.return.code = -ER$PERM
      display sysmsg(11529, remote.name, net.server, file.name) ;* The file %1 now exists on server %2, but the pointer %3 could not be written to your VOC
      return
   end
   @system.return.code = 0
   display sysmsg(11533, remote.name, net.server, file.name) ;* File %1 was created on server %2 and the pointer %3 was written to your VOC
   return

* ======================================================================
* edit.check.existing  -  may this session change the file that VOC.REC (an existing F record) describes?  (17 Oct 26 dm, S.64)
*   The kernel decides by the last component of each data path of the record (K$EDIT.OK): voc, *.dic, bp, bp.out, *.bp, *.bp.out.
*   The dictionary path (field 3) is not looked at: converting an ordinary file does not touch its dictionary, and it is the
*   dictionary of a file called customers that is named customers.dic.  A refusal stops the verb with the reason and nothing has been
*   changed (the VOC file is this program's own, so the record lock goes when it ends).

edit.check.existing:
   for ek = 1 to dcount(voc.rec<2>, @vm)
      ek.path = voc.rec<2, ek>
      if ek.path # '' then
         if not(kernel(K$EDIT.OK, ek.path)) then
            ek.kind = kernel(K$EDIT.KIND, ek.path)
            @system.return.code = -ER$PERM
            stop edit_msg(ek.kind) ;* 11405 VOC, 11406 dictionary, 11407 program file, 11513 shared record, 11514 shared structure
         end
      end
   next ek
   return
end

