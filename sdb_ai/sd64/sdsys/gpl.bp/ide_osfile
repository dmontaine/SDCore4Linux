* START-HISTORY:
* 28 Oct 26 dm  New (S.88 stage E).  The IDE opens and saves a file of the operating system by its path.  THIS PROGRAM IS NOT $internal ON PURPOSE: the kernel trusts a $internal
*               program with an OPENSEQ by pathname (it asks neither the account's OS gate nor the edit gates), so the IDE, which is $internal, would have been the only guard.
*               Here the OPENSEQ is asked as the account is: inside the account's directory, or the account holds os-on (or is SDSYS); a path in a VOC, a dictionary, a
*               program file or the shared account that the account may not change opens READ-ONLY.  A name that starts with a dollar sign is for internal programs only (the compiler refuses it here), so this is a !-routine that any program can call: it can do nothing the
*               caller's own OPENSEQ, READBLK, WRITEBLK and WEOFSEQ could not, under the same gates.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call !ide_osfile(op, path, f, text, info, why)
*
*     op     'check'   is PATH written in the form the IDE takes? (why 'name' when not; nothing is opened or touched, F TEXT and INFO are not used)
*            'open'    open PATH (it must be there), keep the file variable F and give its text; the file is opened for reading and writing without truncation (or
*                      for reading only when the account may not change it) and the SD record lock on it is taken, which F keeps until the caller closes F
*            'reread'  read F again from the start (the caller keeps F): TEXT and INFO as for 'open'; the IDE compares them with what it read before it writes
*            'save'    write TEXT over the file F is open on, in place (SEEK 0, WRITEBLK, then WEOFSEQ at the new length), with the line ends INFO<1> and INFO<2> say
*     path   the full name of the file, as the IDE has checked it (absolute, no . or .., no doubled slash)
*     f      the file variable (out for 'open'; in for 'reread' and 'save')
*     text   the lines of the file as a record: the lines separated by field marks (out for 'open' and 'reread'; in for 'save')
*     info   one field mark between the parts:
*              <1> 1 when every line ended with CR LF (they are taken off, and put back by 'save'); 0 for LF, and a CR in a line is then just a character
*              <2> 1 when the last line ended with its line end (it is not in TEXT, and 'save' puts it back)
*              <3> 1 when the file was opened read-only ('open' only)
*              <4> the size in bytes (of the file read, or of the file written by 'save'; of the file or text found too large)
*              <6> the STATUS() of an OPENSEQ that failed in a way nothing below names ('cant'), or of the SEEK, WRITEBLK or WEOFSEQ of a 'save' that failed ('io')
*            for 'save', INFO<1> and INFO<2> are IN.  NOTHING IS CONVERTED OR GUESSED ABOUT THE BYTES: a file is its bytes, split into lines at the line end it uses.
*     why    '' for success, else:
*              'name'    the path is not absolute, or has a . or .. component, a doubled or final slash, or a control character
*              'none'    no file of that name                        'gate'   the account may not reach that path (the OS gate)
*              'dir'     not a plain file: a directory, a socket     'special'  a device, a pipe or a port (the file is closed again before it is read)
*              'locked'  another session holds the file's SD lock    'big'    more than 2 MB (2,097,152 bytes); INFO<4> is its size
*              'bytes'   a NUL, or a byte from 248 to 255 (SD's marks): not text this editor can keep as it is
*              'io'      reading, positioning, writing or cutting the file failed, or the file is not the size it was a moment ago
*              'ro'      'save' on a file opened read-only (no write was tried)   'cant'  an OPENSEQ that failed: INFO<6> is its STATUS()   'op'  an unknown OP
*     A file that is NOT open (a failure of 'open') is closed here: an OPENSEQ that took its ELSE keeps the name locked until the variable is closed.
*
* END-DESCRIPTION
*
* START-CODE

subroutine ide_osfile(op, path, f, text, info, why)
$catalog !ide_osfile

$include syscom keys.h

   ER.NSEQ = 3013                          ;* gplsrc/err.h ER_NSEQ: not a sequential file (a directory, a socket)
   ER.PERM = 3035                          ;* ER_PERM: the OS gate, or an edit gate for a file that does not exist yet, refused
   OSF.MAX = 2097152                       ;* the largest file the IDE opens, and the largest it writes
   OSF.BLK = 32768                         ;* bytes to a READBLK
   cr.c = char(13)
   lf.c = char(10)
   nope = char(0)                          ;* the bytes that are not text for this editor: NUL, and 248 to 255, which are SD's own marks (the line end of a record is 254)
   for j = 248 to 255
      nope := char(j)
   next j

   ctl = char(127)                         ;* and the control characters: a path with one in it is refused (the screen would show it as a letter and the person could not tell it from another name)
   for j = 0 to 31
      ctl := char(j)
   next j

   why = ''
   begin case
      case op = 'check'
         gosub check.name
      case op = 'open'
         gosub open.file
      case op = 'reread'
         gosub read.file
      case op = 'save'
         gosub write.file
      case 1
         why = 'op'
   end case
   return

* In: path.  Out: why, 'name' when the path is not written in the one form the IDE takes: absolute, with no . or .. component, no doubled slash, no slash at the end and
*   no control character.  One spelling for one file, so that the tab that holds a file is found again (the kernel resolves links and .. for its gate, and does not for the tab).
check.name:
   p.n = len(path)
   if p.n < 2 or p.n > 1000 or path[1, 1] # '/' or path[p.n, 1] = '/' or convert(ctl, '', path) # path then
      why = 'name'
      return
   end
   if index(path, '//', 1) or index(path, '/./', 1) or index(path, '/../', 1) or path[p.n - 1, 2] = '/.' or path[p.n - 2, 3] = '/..' then why = 'name'
   return

* In: path.  Out: f (open) with the lock, text, info, why.  The file is closed again when why is not ''.
open.file:
   text = ''
   info = ''
   gosub check.name
   if why # '' then return
   lk.user = 0
   openseq path to f locked lk.user = 1 then
      null
   end else
      op.st = status()
      if not(unassigned(f)) then close f
      begin case
         case lk.user
            why = 'locked'
         case op.st = 0
            why = 'none'
         case op.st = ER.PERM
            why = 'gate'
         case op.st = ER.NSEQ
            why = 'dir'
         case 1
            why = 'cant'
            info<6> = op.st
      end case
      return
   end
   if (fileinfo(f, FL$SEQTYPE) + 0) # 0 then
      close f
      why = 'special'
      return
   end
   ro = fileinfo(f, FL$READONLY) + 0
   gosub read.file
   if why # '' then
      close f
      return
   end
   info<3> = ro
   return

* In: f (open).  Out: text, info, why
read.file:
   text = ''
   info = ''
   gosub read.all
   if why # '' then return
   gosub parse.raw
   return

* In: f.  Out: raw, why.  The size is asked first (SEEK to the end), so that a large file is refused without being read, and the bytes read must come to that size: the
*   kernel's READBLK reports a read error as the end of the file, and a text that is short is never offered for saving.
read.all:
   raw = ''
   seek f, 0, 2 else why = 'io'
   if why # '' then return
   fsize = fileinfo(f, FL$SEQPOS) + 0
   if fsize > OSF.MAX then
      why = 'big'
      info<4> = fsize
      return
   end
   seek f, 0, 0 else why = 'io'
   if why # '' then return
   loop
      readblk blk from f, OSF.BLK else exit
      raw := blk
   repeat
   if len(raw) # fsize then why = 'io'
   return

* In: raw.  Out: text, info<1>, info<2>, info<4>, why
parse.raw:
   if convert(nope, '', raw) # raw then
      why = 'bytes'
      return
   end
   n.lf = count(raw, lf.c)
   crlf = 0
   if n.lf > 0 then
      if count(raw, cr.c) = n.lf and count(raw, cr.c : lf.c) = n.lf then crlf = 1
   end
   eol = lf.c
   if crlf then eol = cr.c : lf.c
   fin = 0
   body = raw
   if len(raw) >= len(eol) then
      if raw[len(raw) - len(eol) + 1, len(eol)] = eol then
         fin = 1
         body = raw[1, len(raw) - len(eol)]
      end
   end
   text = change(body, eol, @fm)
   info<1> = crlf
   info<2> = fin
   info<4> = len(raw)
   return

* In: f (open), text, info<1>, info<2>.  The file is written where it is, so its owner, mode, inode and links stay: a new file renamed over it would change all four.
write.file:
   if fileinfo(f, FL$READONLY) then
      why = 'ro'
      return
   end
   flat = convert(@fm, '', text)
   if convert(nope, '', flat) # flat then
      why = 'bytes'
      return
   end
   eol = lf.c
   if info<1> then eol = cr.c : lf.c
   data = change(text, @fm, eol)
   if info<2> then data := eol
   if len(data) > OSF.MAX then
      why = 'big'
      info<4> = len(data)
      return
   end
   seek f, 0, 0 else why = 'io'
   if why # '' then
      info<6> = status()
      return
   end
   writeblk data to f else why = 'io'
   if why # '' then
      info<6> = status()                  ;* what was written so far stays: the caller says the file may be partly written
      return
   end
   weofseq f on error
      why = 'io'
      info<6> = status()
   end
   if why = '' then info<4> = len(data)
   return
end

* END-CODE
