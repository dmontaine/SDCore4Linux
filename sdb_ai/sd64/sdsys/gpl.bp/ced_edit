* CED_EDIT
* The data collection editor (openQM CED and !CED(), 1.2-0).  This is the editor itself; the
* CED command (gpl.bp/ced) and the !CED() subroutine (gpl.bp/ced_sub) call it.
* Copyright (c) 2026, SD Core for Linux.  This program is free software; you can redistribute
* it and/or modify it under the terms of the GNU General Public License, version 3 or later.
*
* START-HISTORY:
* 12 Oct 26 dm  New.  Written from the openQM pages for CED and !CED(); the keys are theirs, the
*               layout and the messages are SD's own.
* END-HISTORY
*
* START-DESCRIPTION:
*
*   call $cedit(c, fv, id, ftype, title, result)
*
*     c       the collection or array to edit.  It is edited in place; if the changes are not
*             kept it is put back as it was when the editor was called.
*     fv      the file variable the record is to be saved to (any value when id is null)
*     id      the record id; null for a plain variable, when Ctrl-S and a saving quit keep the
*             changes in c and write nothing
*     ftype   0 if the file is a data collection file (the collection is written), 1 if it is
*             an ordinary file (the JSON text is written)
*     title   what the top line says the editor is editing
*     result  returned: <1> 1 if the record was saved (or c was kept), <2> 1 if the user asked
*             to leave the editor altogether (Ctrl-Q) so a caller with more records stops
*
*   The caller has the record locked with READU when fv is a file; the editor saves with
*   WRITEU and leaves the lock for the caller to release.
*
*   The screen: a title, the headings, one line for each element of the container being shown
*   (its name - or its number, for an array - its type and its value), the path of the container,
*   and a line for messages and prompts.  A '>' in the first column marks the selected element.
*   An element whose name is empty or holds a slash cannot be reached by a path, so it is shown
*   and left alone; every other element can be edited.
*
*   A run time error would lose the user's work, so every name and position is checked before
*   it is used in a path.
*
* END-DESCRIPTION
*
* START-CODE

$internal
subroutine ced_edit(c, fv, id, ftype, title, result)
$catalog $cedit

$include keyin.h
$include int$keys.h

   result = ''
   kind = jtype(c)
   if kind # 'collection' and kind # 'array' then return

   prompt ''
   * Ctrl-C is a key here (copy), so neither the break key nor the terminal's break character may act on
   * it; both are given back on the way out
   saved.trap = pterm(PT$BREAK, -1)
   void pterm(PT$BREAK, @false)
   break off
   w = @crtwide
   h = @crthigh
   if w < 40 then w = 40
   if h < 10 then h = 10
   per.page = h - 5                  ;* element lines
   first.row = 2
   path.row = h - 2
   msg.row = h - 1

   * Characters shown as a dot: the control characters and the SD marks
   bad.chars = ''
   for j = 1 to 31
      bad.chars := char(j)
   next j
   bad.chars := char(127) : char(248) : char(249) : char(250) : char(251) : char(252) : char(253) : char(254) : char(255)
   bad.repl = str('.', len(bad.chars))

   path = ''                         ;* names of the containers dived through, outermost first
   hist.sel = ''                     ;* the selection in each of them, to come back to
   hist.top = ''
   clip.has = @false
   clip = ''
   clip.type = ''
   clip.name = ''
   dirty = @false
   kept = @false
   saved.text = jbuild(c)            ;* what the file, or the caller, has been given
   quit.all = @false
   message.text = ''
   eof.count = 0
   sel = 1
   top = 1
   old.sel = 1
   old.top = 1
   done = @false

   gosub resolve
   gosub build.list
   need.full = @true

   loop
      gosub paint
      c.key = keycode()
      gosub handle.key
   until done
   repeat

   display @(-1) :
   break on
   void pterm(PT$BREAK, saved.trap)
   result<1> = kept
   result<2> = quit.all
   return

* ======================================================================
* resolve  -  cur is the container the path names, ctype its type

resolve:
   cur = c
   n.path = dcount(path, @fm)
   if path = '' then n.path = 0
   for j = 1 to n.path
      comp = path<j>
      cur = cur{comp}
   next j
   ctype = jtype(cur)
   return

* ======================================================================
* build.list  -  The elements of cur: count, names (an object's, in order) and nw, the name column

build.list:
   if ctype = 'array' then
      count = inmat(cur)
      names = ''
      nw = len(count)
   end else
      names = enumerate(cur)
      count = dcount(names, @fm)
      if names = '' then count = 0
      nw = 0
      for j = 1 to count
         if len(names<j>) > nw then nw = len(names<j>)
      next j
      if nw > 24 then nw = 24
   end
   if nw < len(sysmsg(11133)) then nw = len(sysmsg(11133))
   vw = w - (nw + 15)               ;* what is left for the value: marker, 2 spaces, type column
   gosub fix.window
   return

fix.window:
   if sel > count then sel = count
   if sel < 1 then sel = 1
   if sel < top then top = sel
   if sel >= top + per.page then top = sel - per.page + 1
   if top < 1 then top = 1
   return

* ======================================================================
* element.info  -  In: i.  Out: nm, addr.ok (the element can be reached by a path), et (its type)
*                   and vtext (what the value column says)

element.info:
   if ctype = 'array' then nm = i else nm = names<i>
   addr.ok = @true
   if nm = '' or index(nm, '/', 1) then
      addr.ok = @false
      et = '?'
      vtext = ''
      return
   end
   et = jtype(cur{nm})
   begin case
      case et = 'collection'
         x = cur{nm}
         y = enumerate(x)
         n = dcount(y, @fm)
         if y = '' then n = 0
         vtext = '{' : n : '}'
      case et = 'array'
         x = cur{nm}
         vtext = '[' : inmat(x) : ']'
      case et = 'boolean'
         x = cur{nm}
         vtext = if x then 'true' else 'false'
      case et = 'null'
         vtext = 'null'
      case 1
         x = cur{nm}
         vtext = x
   end case
   vtext = convert(bad.chars, bad.repl, vtext)
   return

* ======================================================================
* Painting

paint:
   if need.full then
      display @(-1) :
      for i = top to top + per.page - 1
         gosub paint.row
      next i
      need.full = @false
   end else
      if old.top = top then
         if old.sel # sel then
            i = old.sel
            gosub paint.row
         end
         i = sel
         gosub paint.row
      end else
         for i = top to top + per.page - 1
            gosub paint.row
         next i
      end
   end
   old.sel = sel
   old.top = top
   gosub paint.title
   gosub paint.path
   gosub paint.message
   if count > 0 then display @(0, first.row + sel - top) :
   return

paint.title:
   t = sysmsg(11132, title)
   if dirty then t := ' *'
   display @(0, 0) : @(-13) : fmt(t[1, w - 1], (w - 1) : 'L') : @(-14) :
   hd = ' ' : fmt(sysmsg(11133), nw : 'L') : ' ' : fmt(sysmsg(11134), '10L') : ' ' : sysmsg(11135)
   display @(0, 1) : @(-13) : fmt(hd[1, w - 1], (w - 1) : 'L') : @(-14) :
   return

paint.path:
   t = sysmsg(11138, '/' : change(path, @fm, '/'))
   display @(0, path.row) : fmt(t[1, w - 1], (w - 1) : 'L') :
   return

paint.message:
   t = message.text
   if t = '' then t = sysmsg(11139)
   display @(0, msg.row) : fmt(t[1, w - 1], (w - 1) : 'L') :
   return

paint.row:
   r = first.row + i - top
   if r < first.row or r >= first.row + per.page then return
   if i < 1 or i > count then
      display @(0, r) : @(-4) :
      return
   end
   gosub element.info
   line = (if i = sel then '>' else ' ') : ' ' : fmt(nm[1, nw], nw : 'L') : ' ' : fmt(et, '10L') : ' ' : vtext[1, vw]
   if i = sel then
      display @(0, r) : @(-13) : fmt(line[1, w - 1], (w - 1) : 'L') : @(-14) :
   end else
      display @(0, r) : fmt(line[1, w - 1], (w - 1) : 'L') :
   end
   return

* ======================================================================
* handle.key  -  One key, in c.key

handle.key:
   if c.key = '' then
      * End of input: the terminal has gone.  Give up without asking anything.
      eof.count += 1
      if eof.count > 20 then
         gosub revert
         quit.all = @true
         done = @true
      end
      return
   end
   eof.count = 0
   message.text = ''
   n = seq(c.key[1, 1])
   uk = upcase(c.key)

   begin case
      case n = K$UP
         if sel > 1 then sel -= 1
         gosub fix.window
      case n = K$DOWN
         if sel < count then sel += 1
         gosub fix.window
      case n = K$PAGE.UP
         * A page: the window and the selection both move by one, the selection keeping its place on the screen
         if top > 1 then
            top -= per.page
            if top < 1 then top = 1
            sel -= per.page
            if sel < 1 then sel = 1
         end else
            sel = 1
         end
         gosub fix.window
      case n = K$PAGE.DOWN
         if top + per.page <= count then
            top += per.page
            sel += per.page
            if sel > count then sel = count
         end else
            sel = count
         end
         gosub fix.window
      case n = K$HOME
         sel = 1
         gosub fix.window
      case n = K$END
         sel = count
         gosub fix.window
      case n = K$RETURN
         gosub dive
      case n = K$ESC
         gosub go.up
      case n = K$F1 or c.key = '?'
         gosub show.help
      case n = K$F3
         gosub rename.element
      case n = K$F4
         gosub change.type
      case n = K$F5 or n = CTRL.C
         gosub copy.element
      case n = K$F6 or n = CTRL.X
         gosub cut.element
      case n = K$F7 or n = CTRL.V
         gosub paste.element
      case n = K$INSERT or n = CTRL.I
         gosub insert.element
      case n = K$DELETE
         gosub delete.element
      case n = CTRL.S
         gosub save.record
      case n = CTRL.Q
         q.all = @true
         gosub quit.editor
      case uk = 'Q' and path = ''
         q.all = @false
         gosub quit.editor
      case 1
         display @sys.bell :
   end case
   return

* ======================================================================
* Moving about

dive:
   if count = 0 then
      display @sys.bell :
      return
   end
   i = sel
   gosub element.info
   if not(addr.ok) then
      message.text = sysmsg(11156)
      return
   end
   if et = 'collection' or et = 'array' then
      path<-1> = nm
      hist.sel<-1> = sel
      hist.top<-1> = top
      sel = 1
      top = 1
      gosub resolve
      gosub build.list
      need.full = @true
   end else
      gosub edit.value
   end
   return

go.up:
   n.path = dcount(path, @fm)
   if path = '' then n.path = 0
   if n.path = 0 then
      display @sys.bell :
      return
   end
   del path<n.path>
   sel = hist.sel<n.path>
   top = hist.top<n.path>
   del hist.sel<n.path>
   del hist.top<n.path>
   gosub resolve
   gosub build.list
   need.full = @true
   return

show.help:
   display @(-1) :
   s = change(sysmsg(11136), char(10), @fm)
   n.lines = dcount(s, @fm)
   for j = 1 to n.lines
      display @(2, j) : s<j>[1, w - 3] :
   next j
   display @(2, n.lines + 2) : sysmsg(11137) :
   x = keycode()
   need.full = @true
   return

* ======================================================================
* A line of text, edited at the message line.  In: pl.label, pl.text (the text to start from).
* Out: pl.text and pl.key (K$RETURN to accept, K$ESC to cancel).

prompt.line:
   display @(0, msg.row) : fmt('', (w - 1) : 'L') :
   display @(0, msg.row) : pl.label : ': ' :
   le.col = len(pl.label) + 2
   le.w = w - le.col - 1
   if le.w < 10 then le.w = 10
   le.text = pl.text
   gosub line.edit
   pl.text = le.text
   pl.key = le.key
   display @(0, msg.row) : fmt('', (w - 1) : 'L') :
   return

line.edit:
   le.pos = len(le.text) + 1
   le.off = 1
   loop
      if le.pos < le.off then le.off = le.pos
      if le.pos - le.off >= le.w - 1 then le.off = le.pos - le.w + 2
      shown = convert(bad.chars, bad.repl, le.text[le.off, le.w - 1])
      display @(le.col, msg.row) : fmt(shown, (le.w - 1) : 'L') :
      display @(le.col + le.pos - le.off, msg.row) :
      k = keycode()
      if k = '' then
         le.key = K$ESC
         exit
      end
      kn = seq(k[1, 1])
      begin case
         case kn = K$RETURN
            le.key = K$RETURN
            exit
         case kn = K$ESC
            le.key = K$ESC
            exit
         case kn = K$BACKSPACE or kn = 127
            if le.pos > 1 then
               le.text = le.text[1, le.pos - 2] : le.text[le.pos, 999999]
               le.pos -= 1
            end
         case kn = K$DELETE
            if le.pos <= len(le.text) then
               le.text = le.text[1, le.pos - 1] : le.text[le.pos + 1, 999999]
            end
         case kn = K$LEFT
            if le.pos > 1 then le.pos -= 1
         case kn = K$RIGHT
            if le.pos <= len(le.text) then le.pos += 1
         case kn = K$HOME
            le.pos = 1
         case kn = K$END
            le.pos = len(le.text) + 1
         case kn = CTRL.U
            le.text = ''
            le.pos = 1
         case kn >= 32 and kn < 127
            le.text = le.text[1, le.pos - 1] : k[1, 1] : le.text[le.pos, 999999]
            le.pos += 1
         case 1
            display @sys.bell :
      end case
   repeat
   return

* ======================================================================
* Changing the data

* edit.value  -  The selected element is a string, a number or a boolean: change it

edit.value:
   if et = 'null' then
      message.text = sysmsg(11158)
      return
   end
   x = cur{nm}
   if et = 'boolean' then pl.text = if x then 'true' else 'false'
   else pl.text = x
   loop
      pl.label = sysmsg(11147)
      gosub prompt.line
      if pl.key = K$ESC then return
      ok = @true
      begin case
         case et = 'number'
            if pl.text = '' or not(num(pl.text)) then
               ok = @false
               message.text = sysmsg(11148)
            end else
               cur{nm} = pl.text + 0
            end
         case et = 'boolean'
            b = upcase(pl.text)
            if b = 'TRUE' or b = '1' then
               cur{nm} = jboolean(1)
            end else if b = 'FALSE' or b = '0' then
               cur{nm} = jboolean(0)
            end else
               ok = @false
               message.text = sysmsg(11149)
            end
         case 1
            cur{nm} = pl.text
      end case
      if ok then
         dirty = @true
         i = sel
         gosub paint.row
         return
      end
      gosub show.error
   repeat
   return

* show.error  -  message.text on the path line, where the prompt about to come back does not wipe it

show.error:
   t = message.text
   display @(0, path.row) : @(-13) : fmt(t[1, w - 1], (w - 1) : 'L') : @(-14) :
   message.text = ''
   return

* new.name  -  Ask for an element name in an object.  In: pl.text (to start from).  Out: ok, nn.

new.name:
   ok = @false
   pl.label = sysmsg(11140)
   gosub prompt.line
   if pl.key = K$ESC then return
   nn = pl.text
   if nn = '' or index(nn, '/', 1) then
      message.text = sysmsg(11142)
      return
   end
   locate nn in names<1> setting j then
      message.text = sysmsg(11141)
      return
   end
   ok = @true
   return

* new.position  -  Ask for a position in an array, 1 to count + 1.  In: pl.text.  Out: ok, np.

new.position:
   ok = @false
   pl.label = sysmsg(11146, count + 1)
   gosub prompt.line
   if pl.key = K$ESC then return
   np = pl.text
   if not(np matches '1N0N') or np < 1 or np > count + 1 then
      message.text = sysmsg(11146, count + 1)
      return
   end
   np += 0
   ok = @true
   return

rename.element:
   if count = 0 then
      display @sys.bell :
      return
   end
   if ctype = 'array' then
      message.text = sysmsg(11143)
      return
   end
   i = sel
   gosub element.info
   if not(addr.ok) then
      message.text = sysmsg(11156)
      return
   end
   old.name = nm
   pl.text = old.name
   gosub new.name
   if not(ok) then return
   x = cur{old.name}
   del cur{old.name}
   cur{nn} = x
   dirty = @true
   gosub reselect
   return

* reselect  -  The element called nn (or number np, in an array) is the selected one

reselect:
   gosub build.list
   if ctype = 'array' then
      sel = np
   end else
      locate nn in names<1> setting j then sel = j
   end
   gosub fix.window
   need.full = @true
   return

delete.element:
   if count = 0 then
      display @sys.bell :
      return
   end
   i = sel
   gosub element.info
   if not(addr.ok) then
      message.text = sysmsg(11156)
      return
   end
   del cur{nm}
   dirty = @true
   gosub build.list
   need.full = @true
   return

copy.element:
   gosub take.element
   return

cut.element:
   gosub take.element
   if clip.has and took then
      del cur{nm}
      dirty = @true
      gosub build.list
      need.full = @true
   end
   return

* take.element  -  Put a copy of the selected element in the clip.  Out: took

take.element:
   took = @false
   if count = 0 then
      display @sys.bell :
      return
   end
   i = sel
   gosub element.info
   if not(addr.ok) then
      message.text = sysmsg(11156)
      return
   end
   x = cur{nm}
   if et = 'collection' or et = 'array' then
      clip = jparse(jbuild(x))
   end else
      clip = x
   end
   clip.type = et
   clip.name = if ctype = 'array' then '' else nm
   clip.has = @true
   took = @true
   return

paste.element:
   if not(clip.has) then
      message.text = sysmsg(11150)
      return
   end
   if clip.type = 'collection' or clip.type = 'array' then
      v = jparse(jbuild(clip))
   end else
      v = clip
   end
   if ctype = 'array' then
      pl.text = if count = 0 then 1 else sel
      gosub new.position
      if not(ok) then return
      ins v as cur{np}
   end else
      pl.text = clip.name
      gosub new.name
      if not(ok) then return
      cur{nn} = v
   end
   dirty = @true
   gosub reselect
   return

* choose.type  -  A menu of the types in ct.allowed (a field mark list).  Out: ct.pick, null if cancelled.

choose.type:
   ct.pick = ''
   n.allowed = dcount(ct.allowed, @fm)
   if ct.allowed = '' then n.allowed = 0
   if n.allowed = 0 then
      message.text = sysmsg(11145)
      return
   end
   menu = ''
   for j = 1 to n.allowed
      menu := j : '=' : ct.allowed<j> : ' '
   next j
   t = sysmsg(11144, trimb(menu))
   display @(0, msg.row) : fmt(t[1, w - 1], (w - 1) : 'L') :
   loop
      k = keycode()
      if k = '' then return
      if seq(k[1, 1]) = K$ESC then return
      if k matches '1N' and k >= 1 and k <= n.allowed then
         ct.pick = ct.allowed<k>
         return
      end
      display @sys.bell :
   repeat
   return

change.type:
   if count = 0 then
      display @sys.bell :
      return
   end
   i = sel
   gosub element.info
   if not(addr.ok) then
      message.text = sysmsg(11156)
      return
   end
   x = cur{nm}
   ct.allowed = ''
   begin case
      case et = 'string'
         if x # '' and num(x) then ct.allowed<-1> = 'number'
         if upcase(x) = 'TRUE' or upcase(x) = 'FALSE' then ct.allowed<-1> = 'boolean'
         if x = '' then ct.allowed<-1> = 'null'
         y = jparse(x)
         if status() = 0 then
            if jtype(y) = 'collection' then ct.allowed<-1> = 'collection'
            if jtype(y) = 'array' then ct.allowed<-1> = 'array'
         end
      case et = 'number'
         ct.allowed<-1> = 'string'
         if x = 0 or x = 1 then ct.allowed<-1> = 'boolean'
      case et = 'boolean'
         ct.allowed<-1> = 'string'
         ct.allowed<-1> = 'number'
      case et = 'null'
         ct.allowed<-1> = 'string'
      case et = 'collection'
         ct.allowed<-1> = 'string'
         names2 = enumerate(x)
         reachable = @true
         for j = 1 to dcount(names2, @fm)
            if names2<j> = '' or index(names2<j>, '/', 1) then reachable = @false
         next j
         if reachable then ct.allowed<-1> = 'array'
      case et = 'array'
         ct.allowed<-1> = 'string'
         ct.allowed<-1> = 'collection'
   end case
   gosub choose.type
   if ct.pick = '' then return
   gosub apply.type
   dirty = @true
   i = sel
   gosub paint.row
   return

* apply.type  -  Make the element nm of cur the type ct.pick; x is its value, et its type now

apply.type:
   begin case
      case ct.pick = 'string'
         begin case
            case et = 'number'
               v = x : ''
            case et = 'boolean'
               v = if x then 'true' else 'false'
            case et = 'null'
               v = ''
            case 1
               v = jbuild(x)
         end case
         cur{nm} = v
      case ct.pick = 'number'
         * (a boolean plus nothing is still a boolean, so a boolean is turned into 1 or 0 by hand)
         if et = 'boolean' then v = if x then 1 else 0 else v = x + 0
         cur{nm} = v
      case ct.pick = 'boolean'
         if et = 'string' then b = (upcase(x) = 'TRUE') else b = (x # 0)
         v = jboolean(b)
         cur{nm} = v
      case ct.pick = 'null'
         v = jnull()
         cur{nm} = v
      case ct.pick = 'collection'
         if et = 'string' then
            v = jparse(x)
         end else
            v = collection()
            for j = 1 to inmat(x)
               v{j} = x{j}
            next j
         end
         cur{nm} = v
      case ct.pick = 'array'
         if et = 'string' then
            v = jparse(x)
         end else
            v = mat()
            names2 = enumerate(x)
            for j = 1 to dcount(names2, @fm)
               nm2 = names2<j>
               ins x{nm2} as v{j}
            next j
         end
         cur{nm} = v
   end case
   return

insert.element:
   if ctype = 'array' then
      pl.text = count + 1
      gosub new.position
      if not(ok) then return
   end else
      pl.text = ''
      gosub new.name
      if not(ok) then return
   end
   ct.allowed = 'string' : @fm : 'number' : @fm : 'boolean' : @fm : 'null' : @fm : 'collection' : @fm : 'array'
   gosub choose.type
   if ct.pick = '' then return
   begin case
      case ct.pick = 'collection'
         v = collection()
      case ct.pick = 'array'
         v = mat()
      case ct.pick = 'null'
         v = jnull()
      case 1
         loop
            pl.label = sysmsg(11147)
            pl.text = if ct.pick = 'boolean' then 'false' else ''
            gosub prompt.line
            if pl.key = K$ESC then return
            ok = @true
            begin case
               case ct.pick = 'number'
                  if pl.text = '' or not(num(pl.text)) then
                     ok = @false
                     message.text = sysmsg(11148)
                  end else
                     v = pl.text + 0
                  end
               case ct.pick = 'boolean'
                  b = upcase(pl.text)
                  if b = 'TRUE' or b = '1' then
                     v = jboolean(1)
                  end else if b = 'FALSE' or b = '0' then
                     v = jboolean(0)
                  end else
                     ok = @false
                     message.text = sysmsg(11149)
                  end
               case 1
                  v = pl.text
            end case
            if ok then exit
            gosub show.error
         repeat
   end case
   if ctype = 'array' then
      ins v as cur{np}
   end else
      cur{nn} = v
   end
   dirty = @true
   gosub reselect
   return

* ======================================================================
* Saving and leaving

save.record:
   save.ok = @true
   save.status = 0
   if id # '' then                   ;* (fv is a file variable, which cannot be compared with a string)
      if ftype = 0 then
         writeu c on fv, id on error
            save.ok = @false
            save.status = status()
         end
      end else
         text = jbuild(c)
         writeu text on fv, id on error
            save.ok = @false
            save.status = status()
         end
      end
   end
   if save.ok then
      saved.text = jbuild(c)
      dirty = @false
      kept = @true
      message.text = sysmsg(11152)
   end else
      message.text = sysmsg(11153, save.status)
   end
   return

* revert  -  Put c back as it was when it was last saved (or when the editor was called)

revert:
   if dirty then
      y = jparse(saved.text)
      if status() = 0 then c = y
      dirty = @false
   end
   return

quit.editor:
   if dirty then
      display @(0, msg.row) : fmt(sysmsg(11151) : ' ', (w - 1) : 'L') :
      display @(len(sysmsg(11151)) + 1, msg.row) :
      loop
         k = keycode()
         if k = '' then
            gosub revert
            exit
         end
         if upcase(k) = 'Y' then
            gosub save.record
            if not(save.ok) then return
            exit
         end
         if upcase(k) = 'N' then
            gosub revert
            exit
         end
         if seq(k[1, 1]) = K$ESC then return
         display @sys.bell :
      repeat
   end
   done = @true
   if q.all then quit.all = @true
   return

end

