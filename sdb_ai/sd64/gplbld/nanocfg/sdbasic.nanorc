## SD BASIC, for the NANO verb of SD Core for Linux.
##
## GENERATED FROM THE COMPILER'S OWN TABLES by gplbld/mknanosyntax.py, which
## reads sdsys/GPL.BP/BCOMP.  Do not hand-edit: regenerate it, or the
## highlighting and the language drift apart.
##
## DETECTION IS ON THE WORKING COPY'S NAME, not on the record's.  GPL.BP/EDIT
## writes a BP record to $HOLD as "<record>.editing.sdbasic" precisely so
## that this can match.  The installer places this file in /usr/share/nano,
## which /etc/nanorc includes.
##
## KNOWN LIMIT: \< and \> are word boundaries, so a name ending in "$" is not
## matched at its end and shows uncoloured.  It costs colour, not correctness.

syntax sdbasic "\.sdbasic$"
comment "*"

## Statements - 218 names from BCOMP
icolor brightcyan "\<(REMOVE\.BREAK\.HANDLER|SET\.BREAK\.HANDLER|SET\.EXIT\.STATUS|CONFIGURE\.FILE|KEYBOARD\.INPUT|RESTORE\.SCREEN|SET\.UNASSIGNED|DELETE\.COMMON|UNLOAD\.OBJECT|CLOSE\.SOCKET|MARK\.MAPPING|RELEASE\.LOCK|REMOVE\.TOKEN|CLEARCOMMON|CLEARSELECT|CREATE\.FILE|RECORDLOCKL|RECORDLOCKU|RESET\.MODES|SELECTINDEX|SELECTRIGHT|SET\.TRIGGER|TRANSACTION|BREAKPOINT|CLEARINPUT|DELETELIST|DISINHERIT|DPARSE\.CSV|FILEUNLOCK|INPUTCLEAR|INPUTFIELD|MATREADCSV|OS\.EXECUTE|SELECTLEFT|SET\.STATUS|SUBROUTINE|AKRELEASE|CLEARDATA|CLEARFILE|CREATE\.AK|DEBUG\.OFF|DEBUG\.SET|DELETE\.AK|DELETESEQ|DIMENSION|MATWRITEU|PRECISION|PROCWRITE|RANDOMIZE|SET\.MODES|SORTCLEAR|WRITESEQF|AKDELETE|AKENABLE|CLOSESEQ|CONTINUE|DEBUG\.ON|FILELOCK|FORMLIST|FUNCTION|INPUTCSV|INPUTERR|MATBUILD|MATPARSE|MATREADL|MATREADU|MATWRITE|OPENPATH|PRINTCSV|PRINTERR|PROCREAD|READLIST|READNEXT|ROLLBACK|SAVELIST|SENDMAIL|SETRIGHT|SORTINIT|WRITEBLK|WRITECSV|WRITEPKT|WRITESEQ|AKCLEAR|AKWRITE|CONVERT|DELETEU|DISPLAY|EXECUTE|FINDSTR|FOOTING|GETLIST|HEADING|INCLUDE|INHERIT|KEYEDIT|KEYEXIT|KEYTRAP|MATREAD|OPENSEQ|PERFORM|PRINTER|PRIVATE|PROGRAM|READBLK|READCSV|READSEQ|RELEASE|SELECTE|SELECTN|SELECTV|SET\.ARG|SETLEFT|SORTADD|SSELECT|TCLREAD|TIMEOUT|WEOFSEQ|WRITEVU|AKREAD|COMMIT|COMMON|CREATE|DEFFUN|DELETE|DPARSE|EQUATE|ERRMSG|LOCATE|LOGMSG|MODIFY|PROMPT|PUBLIC|READVL|READVU|REMARK|REMOVE|REPEAT|RETURN|REWIND|SELECT|SETNLS|SETREM|STATUS|UNLOCK|VARSET|WRITEU|WRITEV|ABORT|BEGIN|BREAK|CALLV|CHAIN|CLASS|CLEAR|CLOSE|DEBUG|ENTER|FLUSH|GOSUB|INPUT|LOCAL|NOBUF|PAUSE|PRINT|READL|READU|READV|SETPU|SLEEP|UNTIL|WATCH|WHILE|WRITE|CALL|CASE|COMO|DATA|ECHO|ELSE|EXIT|FILE|FIND|GOTO|HUSH|LOCK|LOOP|NEXT|NULL|OPEN|PAGE|QUIT|READ|SEEK|STOP|VOID|WAKE|ADD|COM|CRT|DEL|DIM|END|EQU|FOR|GET|INS|MAT|NAP|REM|RQM|RUN|SET|SUB|DO|GO|IF|IN|ON)\>"
## Reserved words inside statements - 37 names
icolor brightmagenta "\<(CURRENT\.LEVEL|NOCASEINVERT|CAPTURING|OVERWRITE|RETURNING|PASSLIST|READONLY|TRAPPING|OVERLAY|PANNING|RTNLIST|SETTING|TIMEOUT|WAITING|APPEND|BEFORE|HIDDEN|LOCKED|REPEAT|UPCASE|GOSUB|UNTIL|WHILE|EDIT|ELSE|FROM|GOTO|NEXT|STEP|THEN|FOR|BY|DO|GO|IN|ON|TO)\>"
## Intrinsic functions - 176 names
icolor brightgreen "\<(ACCEPT\.SOCKET\.CONNECTION|CREATE\.SERVER\.SOCKET|GET\.PORT\.PARAMS|PRINTER\.SETTING|SET\.PORT\.PARAMS|SET\.SOCKET\.MODE|GET\.MESSAGES|RECORDLOCKED|WRITE\.SOCKET|OPEN\.SOCKET|READ\.SOCKET|SAVE\.SCREEN|SERVER\.ADDR|SOCKET\.INFO|CATALOGUED|FIELDSTORE|MATCHFIELD|SELECTINFO|SUBSTITUTE|SUBSTRINGS|UNASSIGNED|ARG\.COUNT|LISTINDEX|OUTERJOIN|SDDECRYPT|SDENCRYPT|SUMMATION|ASSIGNED|BITRESET|CHECKSUM|CHGPHANT|DOWNCASE|FILEINFO|INPUTBLK|KEYREADY|OS\.ERROR|SENTENCE|SOUNDEXS|SWAPCASE|TERMINFO|TIMEDATE|BINDKEY|BITTEST|COMPARE|CONVERT|EXTRACT|INDICES|KEYCODE|MAXIMUM|MINIMUM|OBJINFO|REPLACE|SOUNDEX|VARTYPE|BITAND|BITNOT|BITSET|BITXOR|CHANGE|CONFIG|COUNTS|DCOUNT|DELETE|DQUOTE|EBCDIC|FIELDS|GETNLS|GETREM|ICONVS|INDEXS|INSERT|KEYINC|KEYINR|LOCATE|OBJECT|OCONVS|REMOVE|RTRANS|SPACES|SPLICE|SQUOTE|STATUS|SYSMSG|SYSTEM|TRIMBS|TRIMFS|UPCASE|VSLICE|ALPHA|ASCII|BITOR|CCALL|COUNT|CSVDQ|FIELD|FOLDS|GETPU|ICONV|INDEX|INMAT|ITYPE|KEYIN|LOWER|OCONV|QUOTE|RAISE|REUSE|SHIFT|SPACE|TRANS|TRIMB|TRIMF|TRIMS|UMASK|XLATE|ABSS|ACOS|ANDS|ASIN|ATAN|CATS|CHAR|COL1|COL2|CROP|DATE|FMTS|FOLD|IDIV|LENS|MODS|NEGS|NOTS|NUMS|RDIV|SQRT|STRS|SUBR|SWAP|TIME|TRIM|ABS|ARG|COS|DIR|DIV|DTX|ENV|EQS|EXP|FMT|GES|GTS|IFS|INT|LEN|LES|LTS|MAX|MIN|MOD|NEG|NES|NOT|NUM|ORS|PWR|REM|RND|SEQ|SIN|STR|SUM|TAN|XTD|LN)\>"
## @VARIABLES, @FM and the rest
color yellow "@[A-Za-z][A-Za-z0-9.]*"
## $INCLUDE, $CATALOG, $INTERNAL - compiler directives
color brightred "^[[:space:]]*\$[A-Za-z][A-Za-z0-9.]*"
## Labels
color cyan "^[[:space:]]*[A-Za-z][A-Za-z0-9.$]*:"
## Numbers
color brightyellow "\<[0-9]+(\.[0-9]+)?\>"
## Double-quoted strings
color green ""[^"]*""
## Single-quoted strings
color green "'[^']*'"
## A comment: "*" or "!" first on the line
color brightblue "^[[:space:]]*[*!].*"
## A trailing ";*" comment
color brightblue ";[[:space:]]*\*.*"
