# END-HISTORY
#
# START-DESCRIPTION:
#
# WHY THIS EXISTS AT ALL, rather than eight commands in sudoers.
#
# Ten call sites in GPL.BP shell out to sudo (CREATE_USER, SET_PASSWD, DELACC,
# CREATEA, MODIFYA).  Naming those commands directly in a sudoers drop-in would
# hand the group root by another route, because none of them is restricted by
# argument:
#
#   sudo passwd root                 - own the machine
#   sudo usermod -aG sudo <me>       - add yourself to sudo
#   sudo useradd -o -u 0 <name>      - make a second root
#   sudo chmod g+s <any path>        - setgid anything
#
# So sudoers names ONE command - this script - and this script decides what may
# actually happen.  That is the shape the Windows port uses too: os_group()
# routes through a single elevated helper rather than elevating each verb.
#
# THE RULES IT ENFORCES, and they are whitelists wherever a whitelist is
# possible, because a blacklist that forgets "docker" or "lxd" is root:
#
#   users   - must exist (except useradd), must have uid >= UID_MIN, and must
#             never be root or sdsys.  System accounts are out of reach.
#             20 Sep 26 - ***sdsys IS REFUSED BY NAME, NOT BY UID, AND THAT
#             MATTERS AS OF TODAY***: S.38 makes it an ordinary account with a
#             uid ABOVE UID_MIN so the greeter will list it (the owner's
#             ruling, matching Windows).  A guard that had relied on the uid
#             test to cover sdsys would have stopped covering it, silently, on
#             the next install.  It never did, and this note is here so the
#             next person to touch either rule knows the two are independent.
#   groups  - must be one of SD's own: sdusers, sdssh, sdapi, sdfiles, sdfileswrite, sdfilesadmin, sdaiusers, sdu_*, sdg_*.
#             Nothing else is addressable, so "add me to sudo" has no spelling
#             here.
#   paths   - setgid only under the SD accounts root, and the path is resolved
#             with realpath first so a symlink cannot point out of it.
#   stamp   - 26 Oct 26 (F12): setpw, passwd and userdel (like userdel-home) act only on a user whose
#             comment is "SD account", which useradd gives every user SD makes; the login of anyone
#             else, the machine's own administrator included, is out of reach.
#
# INSTRUMENT RULE.  It prints the command it actually resolved, not the one it
# was asked for, and a refusal says which rule refused and why.  --dry-run
# validates and prints without acting and without needing root, which is the
# surface gplbld/test-sd-elevate.py drives.
#
# END-DESCRIPTION
#

set -uo pipefail

# 26 Oct 26 dm - F12e.  THE HELPER RUNS AS ROOT AND CALLS getent, id, stat, realpath, python3, useradd and the rest BY NAME, so the caller's PATH must not decide which ones.  sudo resets PATH to its
# secure_path on Debian, Ubuntu and Fedora, but that is the distribution's setting and not ours (Arch's sudoers has none); this line makes it ours.  A free test that needs stand-in commands
# in front of these puts them in SD_PATH_PREPEND, which is read only where trust_fixtures says (main, below).
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# 30 Oct 26 dm - S.78 (Opus's decision 3d).  THE LOCALE IS THE SAME KIND OF INPUT AS THE PATH: sudo keeps LANG and LC_* from the caller on the distributions whose sudoers say so, and the helper reads the
# output of stat, getent, id and the rest as text and gives python3 its arguments, so the caller must not decide how a name is sorted, folded or spelled.  SD is English only; C is the locale it has always been tested in.
LC_ALL=C
export LC_ALL

PROG=${0##*/}

# The SD accounts root.  installsdcore.sh uses /home/sd; kept in one place here.
# 26 Oct 26 dm - F12e: the environment's SD_ACCT_ROOT is a TEST knob, read only where trust_fixtures says (a dry run, or a process that is not root); a root run through sudo uses /home/sd.
SD_ACCT_ROOT_REAL=/home/sd
SD_ACCT_ROOT=${SD_ACCT_ROOT:-$SD_ACCT_ROOT_REAL}

# Below this, an account is a system account and out of reach.  Read from
# /etc/login.defs when it is there rather than assumed, because distributions
# differ (1000 on Debian/Ubuntu/Arch, 1000 on modern RHEL, 500 on old ones).
uid_min() {
  local v
  v=$(awk '/^[[:space:]]*UID_MIN[[:space:]]/ {print $2; exit}' /etc/login.defs 2>/dev/null)
  if [[ $v =~ ^[0-9]+$ ]]; then printf '%s' "$v"; else printf '1000'; fi
}

die() {
  printf '%s: REFUSED - %s\n' "$PROG" "$1" >&2
  exit 2
}

usage() {
  cat >&2 <<'EOF'
sd-elevate - SD Core's privileged helper.  Invoked through sudo by SD.

  sd-elevate [--dry-run] useradd  <user>
  sd-elevate [--dry-run] userdel  <user>       (SD-created user only: the "SD account" stamp)
  sd-elevate [--dry-run] userdel-home <user>   (SD-created user; also its home)
  sd-elevate [--dry-run] passwd   <user>       (SD-created user only)
  sd-elevate [--dry-run] groupadd <group> [member[,member...]]   (sdu_<user>: for an SD user that exists, holding root and that user)
  sd-elevate [--dry-run] groupdel <group>
  sd-elevate [--dry-run] addgroup <user> <group>
  sd-elevate [--dry-run] delgroup <user> <group>
  sd-elevate [--dry-run] setgid   <path>
  sd-elevate [--dry-run] chown-account <user> <group> <path>   (sdsys: only the files of a group account, in its own group)
  sd-elevate [--dry-run] rmtree-account <account directory>
  sd-elevate [--dry-run] setpw    <user>   (the Linux password of an SD-created user, one line on stdin)
  sd-elevate --dry-run   pw-check          (SD's password rule, one line on stdin)
  sd-elevate [--dry-run] remote-api on | local | off | show
  sd-elevate [--dry-run] remote-ssh on | off | show
  sd-elevate [--dry-run] cred-own query | verify | set   (the caller's own SD
                                  password; verify reads 1 line, set 7, on stdin)
  sd-elevate [--dry-run] netcred-dir            (makes the caller's own /var/lib/sd-net/<user>, mode 0700, for
                                  their SDNet logins; no argument, the caller is from sudo)
  sd-elevate [--dry-run] tree-count <account directory>
  sd-elevate [--dry-run] backup-pack <name>=<account directory> ...
                                  (the manifest on stdin, the zip on stdout)
  sd-elevate [--dry-run] restore-place <owner> <group> <staged dir> <account dir>
  sd-elevate [--dry-run] akpath-set <data path> <index path>   (both in one account: a hashed file's directory and a directory)
  sd-elevate [--dry-run] tls-show               (the API certificate's fields, never the key;
                                                 "certificate: not yet generated" when there is none)
  sd-elevate [--dry-run] tls-key                (the SHA-256 of the API certificate's public key, the value a
                                                 server definition pins; never the private key)
  sd-elevate [--dry-run] bakdir-set <full path of an existing directory>
                                  (saves BACKUPDIR=<path> in /etc/sd.conf, nothing else)
  sd-elevate [--dry-run] bakdir-make <full path of a directory that does not exist>
                                  (makes it for sdsys, mode 0700, only below /media, /run/media,
                                  /mnt, /var/backups, /srv, /opt, /home/sdsys or a place listed
                                  in /etc/sd-backup-roots)
  sd-elevate [--dry-run] conf-set <PARAMETER> <whole number>
                                  (changes one tuning parameter of /etc/sd.conf, such as CLEANUP 600: only the parameters on
                                  the helper's list, only inside the range SD itself enforces; the old file is kept as sd.conf.bak)
  sd-elevate [--dry-run] sdsys-join <sdu_ group>
                                  (puts the user sdsys, and no other user, into the group of an SD
                                  user's account, so that a master edit can be written into it)
  sd-elevate [--dry-run] sdsys-leave <sdu_ group>
                                  (takes the user sdsys, and no other user, out of the group of an SD
                                  user's account; a group that does not list sdsys is left as it is)
  sd-elevate [--dry-run] group-write <account directory>
                                  (gives the account's own group write on its VOC and dictionaries,
                                  only where that group already owns them)

--dry-run validates and prints the command that would run, and acts on nothing.
EOF
  exit 2
}

# ------------------------------------------------------ remote access (S.13)
#
# 14 Sep 26 dm - REMOTE.API and REMOTE.SSH, the port's verbs (its REMOTEAPI /
# REMOTESSH, PRE_RELEASE_FIXES 78 and 148, owner 30 Aug 2026).  THE SAME TWO
# AXES THE PORT HAS, ON LINUX'S MECHANISMS: whether SD listens is systemd's
# sdclient.socket, and who may reach it is the firewall - ufw, or firewalld since
# 4 Oct 2026 (fw_kind, below).  The rules touched are exactly
# the ones installsdcore.sh adds - "ufw allow $SD_API_PORT/tcp" (4247 since 2 Oct
# 2026; 4243 before) and "ufw allow 22/tcp" - so the verb and the installer
# describe one state.
#
# ***THE LISTENER IS A DROP-IN, NOT AN EDIT OF THE UNIT.***  The installer seds
# the shipped unit; a drop-in overrides it without a second copy of that sed,
# survives a package-free reinstall of the unit, and "ListenStream=" (empty)
# first clears the unit's list so the result is exactly what is written.  The
# unit's own Unix-socket line is read and carried into the drop-in, so the
# local socket stays whatever the shipped unit says it is.
#
# ***SSH IS GATED BY THE FIREWALL OR IT IS NOT GATED, AND THIS SAYS WHICH.***
# REMOTE.SSH does not stop sshd - that is the distribution's service, and an
# administrator's own shell may be using it.  So with ufw absent, inactive, or
# allowing incoming by default, a rule for port 22 would gate nothing, and ON
# and OFF refuse with exit 3 rather than report a change that changes nothing.

SD_SOCKET_UNIT_REAL=/usr/lib/systemd/system/sdclient.socket
SD_SOCKET_UNIT=${SD_SOCKET_UNIT:-$SD_SOCKET_UNIT_REAL}      # 26 Oct 26 dm - F12 review: a test knob like SD_ACCT_ROOT (remote-api reads its ListenStream as root); reset in main unless trust_fixtures
SD_SOCKET_DROPIN_DIR=/etc/systemd/system/sdclient.socket.d
SD_SOCKET_DROPIN=$SD_SOCKET_DROPIN_DIR/sd-remote-api.conf

# 02 Oct 26 dm - THE API PORT, FIXED (owner, 2 Oct 2026: "make ports 4247 and
# 4249 -- do not allow adjustable ports").  Deliberately not taken from the
# environment, as the paths above are for tests: nothing a caller passes moves
# it.  4247 is the full SD Core products'; both Solos use 4249.
SD_API_PORT=4247

step() {   # print the resolved command, then run it unless --dry-run
  printf '%s: %s\n' "$PROG" "$*"
  [[ $DRY -eq 1 ]] && return 0
  "$@"
}

# tls-show and tls-key look for the same certificate the same way (17 Oct 26: one copy, so a mutant of either rule hits both verbs).
tls_find() {   # sets tls_pem and tls_can_see; only root can say the file is absent, another user's test would say absent for a file that is there
  tls_pem=/etc/sd-tls/api.pem
  tls_can_see=0
  [[ ${EUID:-$(id -u)} -eq 0 ]] && tls_can_see=1
  if [[ $DRY -eq 1 && -n ${SD_TLS_PEM_FIXTURE:-} ]]; then
    tls_pem=$SD_TLS_PEM_FIXTURE
    tls_can_see=1
  fi
}

tls_absent_exit() {   # one plain line and a clean exit when there is no certificate yet
  if [[ $tls_can_see -eq 1 && ! -e $tls_pem ]]; then
    printf 'certificate: not yet generated\n'
    exit 0
  fi
}

# 26 Oct 26 dm - F12e.  MAY THE ENVIRONMENT'S TEST KNOBS BE READ?  SD_ACCT_ROOT, SD_ACCARCHIVE and SD_PATH_PREPEND name another accounts root, another archiver (python3 runs it) and commands to put
# in front of the real ones: they exist so that a free test can drive the helper on scratch files as an ordinary user.  Read from a root process they would make the helper trust the caller of
# sudo, which is the one thing it exists not to do (sudo's env_reset drops them today; that is sudo's rule, not ours).  So: a dry run (it acts on nothing), or a process that is not root (it
# cannot act: every verb that changes something dies at need_root).  A real run as root reads none of them.  $1 is DRY, $2 the effective uid, passed in so that a test can lift this function.
trust_fixtures() {   # trust_fixtures DRY EUID
  [[ $1 -eq 1 || $2 -ne 0 ]]
}

need_root() {
  [[ $DRY -eq 1 ]] && return 0
  [[ ${EUID:-$(id -u)} -eq 0 ]] || die "must run as root (it is invoked through sudo); use --dry-run to validate"
}

ufw_state() {   # absent | inactive | active-deny | active-allow  (root only)
  command -v ufw >/dev/null 2>&1 || { printf 'absent'; return; }
  local v
  v=$(ufw status verbose 2>/dev/null)
  if ! printf '%s\n' "$v" | grep -q '^Status: active'; then printf 'inactive'; return; fi
  if printf '%s\n' "$v" | grep -Eq 'Default: (deny|reject) \(incoming\)'; then
    printf 'active-deny'
  else
    printf 'active-allow'
  fi
}

# 15 Sep 26 dm - RULES ARE READ FROM "ufw show added", NOT "ufw status".  While
# ufw is inactive, "ufw status" prints "Status: inactive" and no rules at all,
# so every rule read as absent: REMOTE.API LOCAL and OFF never deleted the
# installer's 4243/tcp rule, and a later "ufw enable" would have opened a port
# SD had reported closed (witness 13h H5c, 14 Sep).  "show added" lists what
# ufw has configured, enforcing or not, one "ufw <rule>" line each - the same
# words that added it.
ufw_added() {   # the configured rules, active or not (root only)
  ufw show added 2>/dev/null
}

ufw_has_allow() {   # $1 port/proto; true if an allow rule for it is configured
  ufw_added | grep -Eq "^ufw allow (in )?$1( |\$)"
}

ufw_ssh_rules() {   # the configured rules that allow ssh, one per line
  ufw_added | grep -E '^ufw allow (in )?((22(/tcp)?|OpenSSH)( |$)|.* port 22( |$)|.* app OpenSSH( |$))' | sed 's/^ufw //'
}

ufw_delete_allow() {   # $1 port/proto
  if [[ $DRY -eq 1 ]]; then printf '%s: ufw delete allow %s  (if present)\n' "$PROG" "$1"; return 0; fi
  command -v ufw >/dev/null 2>&1 || { printf '%s: ufw is not installed; no rule to delete\n' "$PROG"; return 0; }
  if ufw_has_allow "$1"; then
    step ufw delete allow "$1"
  else
    printf '%s: no ufw allow rule for %s; nothing to delete\n' "$PROG" "$1"
  fi
}

ufw_add_allow() {   # $1 port/proto
  if [[ $DRY -eq 1 ]]; then printf '%s: ufw allow %s\n' "$PROG" "$1"; return 0; fi
  command -v ufw >/dev/null 2>&1 || { printf '%s: ufw is not installed; no rule was added - the listener alone decides\n' "$PROG"; return 0; }
  step ufw allow "$1"
}

# 04 Oct 26 dm - FIREWALLD, Fedora's and openSUSE's front end (owner, 4 Oct 2026).
# The same four answers as ufw_state, from firewalld: not installed, not running,
# running with the default zone refusing what it does not allow (its target is
# "default", REJECT or DROP), or accepting everything (ACCEPT).  ***RULES ARE READ
# FROM THE SAVED CONFIGURATION*** - "--permanent", or firewall-offline-cmd while the
# daemon is stopped - for the reason "ufw show added" is read: a stopped firewall
# shows no live rules, and a rule left in its saved set opens a port when it
# starts.  The rule is the default zone's "port 4247/tcp" or "port 22/tcp"; the
# distribution's own "ssh" service is reported and never removed, as ufw's OpenSSH
# rule is.  A change is saved and then applied with --reload.
fwd_running() { [[ $(firewall-cmd --state 2>/dev/null) == running ]]; }

fwd_perm() {   # the saved configuration, running or not (root only)
  if fwd_running; then firewall-cmd --permanent "$@"; else firewall-offline-cmd "$@"; fi
}

fwd_state() {   # absent | inactive | active-deny | active-allow  (root only)
  command -v firewall-cmd >/dev/null 2>&1 || command -v firewall-offline-cmd >/dev/null 2>&1 || { printf 'absent'; return; }
  fwd_running || { printf 'inactive'; return; }
  local zone target
  zone=$(firewall-cmd --get-default-zone 2>/dev/null)
  target=$(firewall-cmd --permanent --zone="$zone" --get-target 2>/dev/null)
  if [[ $target == ACCEPT ]]; then printf 'active-allow'; else printf 'active-deny'; fi
}

fwd_has_allow() {   # $1 port/proto; true if the saved default zone ALLOWS it (a range counts)
  fwd_perm --query-port="$1" >/dev/null 2>&1
}

# 04 Oct 26 dm - "ALLOWED" IS NOT "SD'S RULE".  Measured on a Fedora 44 Workstation VM:
# its zone carries 1025-65535/tcp, --query-port answers yes for 4247 with no entry
# of SD's, and --remove-port=4247/tcp then SPLIT the distribution's range into
# 1025-4246/tcp and 4248-65535/tcp - a hole cut in a rule SD never made.  So a
# rule is removed only when the exact entry is listed; whether the port is
# reachable (api_show's verdict) still asks --query-port.
fwd_has_rule() {   # $1 port/proto; true if exactly that entry is in the saved default zone
  fwd_perm --list-ports 2>/dev/null | tr ' ' '\n' | grep -qx -- "$1"
}

fwd_ssh_rules() {   # the saved default-zone entries that allow ssh, one per line
  fwd_perm --query-port=22/tcp >/dev/null 2>&1 && echo "port 22/tcp"
  fwd_perm --query-service=ssh >/dev/null 2>&1 && echo "service ssh"
  return 0
}

fwd_add_allow() {   # $1 port/proto
  if [[ $DRY -eq 1 ]]; then printf '%s: firewall-cmd --permanent --add-port=%s && firewall-cmd --reload\n' "$PROG" "$1"; return 0; fi
  if fwd_running; then
    step firewall-cmd --permanent --add-port="$1" && step firewall-cmd --reload
  else
    step firewall-offline-cmd --add-port="$1"
  fi
}

fwd_delete_allow() {   # $1 port/proto
  if [[ $DRY -eq 1 ]]; then printf '%s: firewall-cmd --permanent --remove-port=%s && firewall-cmd --reload  (if present)\n' "$PROG" "$1"; return 0; fi
  if ! fwd_has_rule "$1"; then printf '%s: no firewalld rule for port %s; nothing to delete\n' "$PROG" "$1"; return 0; fi
  if fwd_running; then
    step firewall-cmd --permanent --remove-port="$1" && step firewall-cmd --reload
  else
    step firewall-offline-cmd --remove-port="$1"
  fi
}

# Which front end SD's rules go to: an active one first, then an installed one
# (ufw before firewalld, as before 4 Oct), else none.  "ufw status" needs root, so
# a --dry-run by an ordinary user falls through to "installed".
fw_kind() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then printf 'ufw'; return; fi
  if command -v firewall-cmd >/dev/null 2>&1 && fwd_running; then printf 'firewalld'; return; fi
  if command -v ufw >/dev/null 2>&1; then printf 'ufw'; return; fi
  if command -v firewall-cmd >/dev/null 2>&1 || command -v firewall-offline-cmd >/dev/null 2>&1; then printf 'firewalld'; return; fi
  printf 'none'
}
FW=
fw()              { [[ -n $FW ]] || FW=$(fw_kind); }
fw_state()        { fw; case $FW in ufw) ufw_state ;; firewalld) fwd_state ;; *) printf 'absent' ;; esac; }
fw_has_allow()    { fw; case $FW in ufw) ufw_has_allow "$1" ;; firewalld) fwd_has_allow "$1" ;; *) return 1 ;; esac; }
fw_ssh_rules()    { fw; case $FW in ufw) ufw_ssh_rules ;; firewalld) fwd_ssh_rules ;; esac; }
fw_add_allow()    { fw; case $FW in ufw) ufw_add_allow "$1" ;; firewalld) fwd_add_allow "$1" ;;
                    *) printf '%s: no firewall (ufw or firewalld) is installed; no rule was added - the listener alone decides\n' "$PROG" ;; esac; }
fw_delete_allow() { fw; case $FW in ufw) ufw_delete_allow "$1" ;; firewalld) fwd_delete_allow "$1" ;;
                    *) printf '%s: no firewall (ufw or firewalld) is installed; no rule to delete\n' "$PROG" ;; esac; }

api_show() {
  if [[ $DRY -eq 1 ]]; then printf '%s: (dry run - state not read)\n' "$PROG"; return 0; fi
  local enabled active listen fw rule verdict
  enabled=$(systemctl is-enabled sdclient.socket 2>/dev/null)
  active=$(systemctl is-active sdclient.socket 2>/dev/null)
  listen=$(systemctl show -p Listen --value sdclient.socket 2>/dev/null | tr '\n' ' ')
  fw; fw=$(fw_state)
  rule=absent
  [[ $fw != absent ]] && fw_has_allow "$SD_API_PORT/tcp" && rule=present
  printf 'sdclient.socket: %s, %s\n' "${enabled:-unknown}" "${active:-unknown}"
  printf 'listening on   : %s\n' "${listen:-nothing}"
  printf 'firewall       : %s %s; a rule or range allowing %s/tcp %s\n' "$FW" "$fw" "$SD_API_PORT" "$rule"
  if [[ $active != active ]]; then
    verdict=OFF
  elif [[ $listen == *0.0.0.0:$SD_API_PORT* ]]; then
    if [[ $fw == active-deny && $rule == absent ]]; then
      verdict="LISTENING ON EVERY ADDRESS BUT BLOCKED BY THE FIREWALL"
    else
      verdict=ON
    fi
  elif [[ $listen == *127.0.0.1:$SD_API_PORT* ]]; then
    verdict=LOCAL
  else
    verdict="LOCAL SOCKET ONLY"
  fi
  printf 'The SD API is %s.\n' "$verdict"
}

remote_api() {
  local mode=$1 unix addr
  need_root
  [[ $mode == show ]] && { api_show; return 0; }
  unix=$(sed -n 's#^ListenStream=\(/.*\)#\1#p' "$SD_SOCKET_UNIT" 2>/dev/null | head -1)
  [[ -n $unix ]] || die "no Unix-socket ListenStream in $SD_SOCKET_UNIT"
  case $mode in
    on|local)
      addr=127.0.0.1:$SD_API_PORT
      [[ $mode == on ]] && addr=0.0.0.0:$SD_API_PORT
      step mkdir -p "$SD_SOCKET_DROPIN_DIR" || return 1
      printf '%s: write %s: ListenStream= / ListenStream=%s / ListenStream=%s\n' "$PROG" "$SD_SOCKET_DROPIN" "$unix" "$addr"
      if [[ $DRY -eq 0 ]]; then
        printf '# Written by sd-elevate remote-api %s (REMOTE.API).  Do not edit.\n[Socket]\nListenStream=\nListenStream=%s\nListenStream=%s\n' \
          "$mode" "$unix" "$addr" > "$SD_SOCKET_DROPIN" || return 1
      fi
      step systemctl daemon-reload || return 1
      step systemctl enable sdclient.socket || return 1
      step systemctl restart sdclient.socket || return 1
      if [[ $mode == on ]]; then fw_add_allow "$SD_API_PORT/tcp" || return 1; else fw_delete_allow "$SD_API_PORT/tcp" || return 1; fi
      ;;
    off)
      step systemctl disable --now sdclient.socket || return 1
      fw_delete_allow "$SD_API_PORT/tcp" || return 1
      ;;
  esac
  api_show
  return 0
}

ssh_show() {
  if [[ $DRY -eq 1 ]]; then printf '%s: (dry run - state not read)\n' "$PROG"; return 0; fi
  local sshd fw rules verdict
  sshd=$(systemctl is-active ssh 2>/dev/null)
  [[ $sshd == active ]] || sshd=$(systemctl is-active sshd 2>/dev/null)
  fw; fw=$(fw_state)
  rules=
  [[ $fw != absent ]] && rules=$(fw_ssh_rules | tr '\n' ';')
  printf 'ssh server     : %s\n' "${sshd:-unknown}"
  printf 'firewall       : %s %s; rules allowing ssh: %s\n' "$FW" "$fw" "${rules:-none}"
  if [[ $fw != active-deny ]]; then
    verdict="NOT GATED BY THIS MACHINE'S FIREWALL"
  elif [[ -n $rules ]]; then
    verdict=ON
  else
    verdict=OFF
  fi
  printf 'Remote ssh access is %s.\n' "$verdict"
}

remote_ssh() {
  local mode=$1 fw left
  need_root
  [[ $mode == show ]] && { ssh_show; return 0; }
  if [[ $DRY -eq 0 ]]; then
    fw; fw=$(fw_state)
    if [[ $fw != active-deny ]]; then
      printf '%s: REFUSED - the firewall (%s) is %s, so a rule for port 22 would gate nothing; nothing was changed\n' "$PROG" "$FW" "$fw" >&2
      ssh_show
      return 3
    fi
  fi
  if [[ $mode == on ]]; then
    fw_add_allow 22/tcp || return 1
  else
    fw_delete_allow 22/tcp || return 1
    if [[ $DRY -eq 0 ]]; then
      left=$(fw_ssh_rules)
      [[ -n $left ]] && printf '%s: WARNING - other rules still allow ssh and were not added by SD: %s\n' "$PROG" "$(printf '%s' "$left" | tr '\n' ';')"
    fi
  fi
  ssh_show
  return 0
}

# ---------------------------------------------------------------- validation

# A login or group name we are willing to pass to shadow-utils.  Deliberately
# tighter than POSIX allows: no leading dash (which would read as an option),
# no dots, no spaces, no upper case.
valid_name() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]
}

require_name() {
  local what=$1 name=$2
  [[ -n $name ]] || die "$what is empty"
  valid_name "$name" || die "$what '$name' is not a valid name (want ^[a-z_][a-z0-9_-]{0,31}\$)"
}

# A user SD is allowed to act on.  Must exist, must not be root or sdsys, and
# must not be a system account.
require_sd_user() {
  local user=$1 uid min
  require_name "user" "$user"
  [[ $user != root  ]] || die "root is never a target"
  [[ $user != sdsys ]] || die "sdsys is SD's own administrator account and is never a target"
  uid=$(id -u "$user" 2>/dev/null) || die "user '$user' does not exist"
  [[ $uid =~ ^[0-9]+$ ]] || die "could not read a uid for '$user'"
  [[ $uid -ne 0 ]] || die "'$user' has uid 0; refusing"
  min=$(uid_min)
  [[ $uid -ge $min ]] || die "'$user' has uid $uid, below UID_MIN $min - a system account"
}

# 26 Oct 26 dm - F12.  THE "SD account" STAMP, IN ONE PLACE.  useradd (below) gives every user SD makes the comment "SD account", and DELETE.ACCOUNT's own test (GPL.BP/IS_SD_USER) reads
# exactly that back.  userdel-home has asked for it since 10 Sep; setpw, passwd and userdel ask now (26 Oct), because without it the helper would set the password of, or delete, ANY local user
# above UID_MIN - the machine's own administrator, a login that was there before SD - for whoever can run it.  $2 ends the refusal ("so ..."): each verb says what it would have done.  Call
# after require_sd_user.  The callers: create.account (setpw for the user it has just made; userdel and userdel-home to take that user away again when no password is set) and delete.account
# (userdel and userdel-home only after it has read the same stamp itself); nobody calls passwd.
require_sd_stamp() {   # require_sd_stamp USER CONSEQUENCE
  local user=$1 consequence=$2 ent gecos
  ent=$(getent passwd "$user") || die "user '$user' does not exist"
  gecos=$(printf '%s\n' "$ent" | cut -d: -f5)
  [[ $gecos == "SD account" ]] || die "'$user' was not created by SD (no \"SD account\" stamp), so $consequence"
}

# 26 Oct 26 dm - F12c.  setpw SETS A FIRST PASSWORD AND NEVER RESETS ONE.  Its one caller (create.account, through set_passwd) sets the password of the user it has just made, whose shadow entry
# holds none: useradd leaves "!" (Debian, Ubuntu) or "!!" (Fedora); "*", "!*" and an empty field are the other spellings of "no password".  A user with a hash - an SD user whose login works, over ssh
# or at the console - is refused in the helper's words, so a stolen sdsys login cannot reset it.  (A retry after a failed set_passwd is still a first password: the failed attempt changed nothing.)
# The entry is read with `getent shadow`, which only root can read: a real run is root; a dry run by an ordinary user cannot read it and is REFUSED too, rather than passed as if it had been
# judged (a test gives it a getent that answers).  Call after require_sd_stamp.
require_pw_unset() {   # require_pw_unset USER
  local user=$1 ent hash
  ent=$(getent shadow "$user" 2>/dev/null) || die "cannot read the shadow entry of '$user' (setpw reads it as root; a dry run needs a getent that can)"
  hash=$(printf '%s\n' "$ent" | cut -d: -f2)
  case $hash in
    ''|'*'|'!'|'!!'|'!*') : ;;
    *) die "'$user' already has a Linux password, so setpw does not set another: it sets the first password of a user SD has just made, and never resets one" ;;
  esac
}

# 10 Sep 26 - userdel -r deletes a user's home directory and mail spool, so the
# helper re-checks here what DELETE.ACCOUNT REMOVE.HOME checked in BASIC, rather
# than trusting the caller: the user carries SD's "SD account" GECOS stamp (SD
# created it - useradd above), and its home is exactly <useradd's HOME base>/<user>.
# A home that is /, a shared directory, a system path, or one somebody re-pointed
# elsewhere is never removed here.  Call after require_sd_user.
require_sd_home() {
  local user=$1 ent home base
  require_sd_stamp "$user" "its home is never removed here"
  ent=$(getent passwd "$user") || die "user '$user' does not exist"
  home=$(printf '%s\n' "$ent" | cut -d: -f6)
  base=$(useradd -D 2>/dev/null | sed -n 's/^HOME=//p')
  [[ -n $base ]] || die "could not read useradd's HOME base"
  [[ $base == /* && $base != / ]] || die "useradd's HOME base '$base' is not an absolute directory below /"
  [[ $home == "$base/$user" ]] || die "home '$home' of '$user' is not $base/$user, so it is never removed here"
}

# A user we are about to CREATE.  The opposite test: it must not exist yet.
require_new_user() {
  local user=$1
  require_name "user" "$user"
  [[ $user != root  ]] || die "root is never a target"
  [[ $user != sdsys ]] || die "sdsys is SD's own administrator account and is never a target"
  ! id -u "$user" >/dev/null 2>&1 || die "user '$user' already exists"
}

# SD's own groups, and nothing else.  This is the whitelist that stops
# "add me to sudo" from having a spelling.
#
# 18 Sep 26 dm - TEARDOWN.  sdadmin and sdapi are gone with the tier model, so
# the whitelist is sdusers plus the per-account groups.  An administrator is
# the sdsys OS user, and sdsys alone is granted the sudoers drop-in.
require_sd_group() {
  local group=$1
  require_name "group" "$group"
  # 20 Sep 26 dm - S.29: sdssh and sdapi are SD's own groups again.  They are
  # the AUTHORITY for a per-account remote route (membership = permitted), the
  # shape the Windows port uses; an allow group fails CLOSED, which a deny
  # group cannot - a group lookup that cannot answer reads as "not a member",
  # and with a deny group that silently grants remote access.
  # 17 Oct 26 dm - S.65 slice 2c: sdfiles is the third route group, the SDNet
  # files-only API route (a member of sdusers and sdfiles but not sdapi logs in
  # to files and nothing else).  Exact name, like the other two.
  # 18 Oct 26 dm - S.65 write group: sdfileswrite is the fourth, the right to CHANGE files over that route (a files-only login in it may write,
  # delete, lock and clear; one outside it may read).  Exact name again: sdfiles* would let a lookalike through.
  # 21 Oct 26 dm - S.73 item 3: sdfilesadmin is the fifth, the right to ADMINISTER files over that route (configure, index, create and delete
  # a file, the file's counter).  Exact name, for the same reason.
  # 23 Oct 26 dm - S.69 step 2: sdaiusers is the sixth, the right to use the AI provider's API through the helper sd-ai (the owner's "API gate for each user
  # account").  Exact name, for the same reason.
  case $group in
    sdusers|sdssh|sdapi|sdfiles|sdfileswrite|sdfilesadmin|sdaiusers) : ;;
    sdu_?*|sdg_?*) : ;;
    *) die "'$group' is not an SD group (want sdusers, sdssh, sdapi, sdfiles, sdfileswrite, sdfilesadmin, sdaiusers, sdu_*, or sdg_*)" ;;
  esac
}

# 26 Oct 26 dm - F12.  THE GROUP OF AN SD USER'S ACCOUNT IS MADE FOR THAT USER.  create.account makes sdu_<user> for a Linux user that exists by then (one it has just made, or one it attaches),
# with root and that user in it: `groupadd sdu_<user> root,<user>`.  Nothing else is a call it makes, so nothing else is taken: the user must be an SD user that exists (require_sd_user: not
# root, not sdsys, not a system account), and the members named, if any, are root and that user - not the sdsys user, who joins an account's group through sdsys-join and nothing else, and
# not another person (a person is put in the group of another's account with addgroup, which modify.account add calls, and that one is deliberately not narrowed).  Called for a name
# that begins sdu_ (require_sd_group has seen the name and that something follows).  MEMBERS is the comma list as typed, or empty.
require_own_account_group() {   # require_own_account_group GROUP MEMBERS
  local group=$1 members=$2 m
  local user=${group#sdu_}
  local -a list=()
  require_sd_user "$user"
  if [[ -n $members ]]; then
    IFS=',' read -r -a list <<<"$members"
    for m in "${list[@]}"; do
      [[ -z $m || $m == root || $m == "$user" ]] \
        || die "'$m' cannot be a member of $group when it is made: the group of an SD user's account holds root and that user, and the sdsys user joins it only through sdsys-join"
    done
  fi
}

# Absolute, existing and inside the accounts root.  realpath first, so a symlink
# planted inside the tree cannot aim the chmod or the chown outside it.  Sets
# real (the canonical path) and root in the caller, which declares them local.
# 19 Oct 26 dm - pulled out of require_sd_path so that require_sd_chown_path
#   below has the same first half.
resolve_in_accounts_root() {
  local path=$1
  [[ -n $path ]] || die "path is empty"
  [[ $path == /* ]] || die "path '$path' is not absolute"
  real=$(realpath -e -- "$path" 2>/dev/null) || die "path '$path' does not exist"
  root=$(realpath -e -- "$SD_ACCT_ROOT" 2>/dev/null) || die "accounts root '$SD_ACCT_ROOT' does not exist"
  [[ $real == "$root"/* ]] || die "path '$real' is outside the accounts root '$root'"
}

# setgid is restricted to the accounts root, and to directories.
require_sd_path() {
  local path=$1 real root
  resolve_in_accounts_root "$path"
  [[ -d $real ]] || die "path '$real' is not a directory"
}

# 19 Oct 26 dm - THE SDSYS SHAPE OF CHOWN-ACCOUNT TAKES A DIRECTORY OR ONE OF TWO RECORD FILES.  It used require_sd_path, which wants a
#   directory, so for a GROUP account the four files createa's set.owner names inside its directory files - voc/%0, voc/%1,
#   $hold.dic/%0 and $hold.dic/%1 - were refused ("is not a directory"), createa printed "Unable change ownership of directory
#   error ... err: 0" four times, and the files stayed sdsys:sdusers 664: writable by every SD user, in an account only the group
#   may enter.  A user account's same four files were chowned without complaint (that shape has no directory rule).  A file is
#   accepted only when its canonical name is %0 or %1 and nothing else links to it: a hard link would let the chown reach an inode
#   outside the tree.  Nothing wider than the directory case already allowed: once sdsys owns a directory it can replace what is in it.
require_sd_chown_path() {
  local path=$1 real root
  resolve_in_accounts_root "$path"
  if [[ -d $real ]]; then
    return 0
  fi
  [[ -f $real ]] || die "path '$real' is neither a directory nor a file"
  case ${real##*/} in
    %0|%1) : ;;
    *) die "path '$real' is a file, and only the dictionary record files %0 and %1 are chowned" ;;
  esac
  [[ $(stat -c %h -- "$real") == 1 ]] || die "path '$real' has more than one hard link"
}

# 26 Oct 26 dm - F12.  THE SDSYS SHAPE IS FOR THE FILES OF A GROUP ACCOUNT AND NOTHING ELSE.  Its callers are createa's set.owner for an account of type GROUP - the account directory, voc, the
#   dictionaries and their %0 / %1, which sdsys owns, in the group sdg_<name> (the shared account's group is sdusers) - and the installer's repair_group_account_files, which gives four record
#   files of each group account the group its directory has.  A USER account's directory, voc and record files belong to the person and to sdu_<person>; the shape took those too (a dry run of
#   `chown-account sdsys sdu_victim <root>/user_accounts/victim/voc` was accepted, 26 Oct 26: route R-C of the review), and it took any SD group for any account.  Call after
#   require_sd_chown_path, which has already seen that PATH is a directory or a lone %0 / %1 in the accounts root; this adds which account it is in and which group that account has.
require_group_account_files() {   # require_group_account_files GROUP PATH
  local group=$1 path=$2 real root rel name want
  resolve_in_accounts_root "$path"
  rel=${real#"$root"/}
  [[ $rel == group_accounts/?* ]] \
    || die "path '$real' is not in a group account ($root/group_accounts/<name>): chown-account sdsys is for the files of a group account, and never for a user account's"
  name=${rel#group_accounts/}
  name=${name%%/*}
  require_name "group account" "$name"
  if [[ $name == shared ]]; then want=sdusers; else want=sdg_$name; fi
  [[ $group == "$want" ]] || die "group account '$name' belongs to the group $want, not '$group'"
}

# 26 Oct 26 dm - F12b.  WHICH UID IS "THE SDSYS USER": the sdsys user's own (id -u sdsys); on a --dry-run only, SD_SDSYS_UID_FIXTURE (a free test has no such user, and its scratch files are its
# own).  Sets SDSYS_UID.  A real run ignores the fixture, as every fixture here is ignored by a real run.
sdsys_uid() {
  SDSYS_UID=
  if [[ $DRY -eq 1 && -n ${SD_SDSYS_UID_FIXTURE:-} ]]; then
    [[ $SD_SDSYS_UID_FIXTURE =~ ^[0-9]+$ ]] || die "SD_SDSYS_UID_FIXTURE is not a number"
    SDSYS_UID=$SD_SDSYS_UID_FIXTURE
  else
    SDSYS_UID=$(id -u sdsys 2>/dev/null) || die "the user sdsys does not exist, so nothing can be shown to be its"
  fi
  [[ $SDSYS_UID =~ ^[0-9]+$ ]] || die "could not read a uid for sdsys"
}

# 26 Oct 26 dm - F12b.  require_sdsys_owned REAL - dies unless REAL (already canonical) is a directory or a plain file whose owner is the sdsys user.  This is the rule of chown-account root sdusers:
# what create.account has just made for an OTHER account belongs to sdsys, and nothing of root's does.  The check on the path is the helper's own words and the dry run's; the real run asks
# again of the file it has opened (FC_PY below), which is the one that cannot be swapped for a link between the two.
require_sdsys_owned() {
  local real=$1 have
  sdsys_uid
  [[ -d $real || -f $real ]] || die "path '$real' is neither a directory nor a plain file"
  have=$(stat -c %u -- "$real" 2>/dev/null) || die "cannot read '$real'"
  [[ $have == "$SDSYS_UID" ]] \
    || die "path '$real' belongs to uid $have, not to the user sdsys (uid $SDSYS_UID): chown-account root sdusers takes only what sdsys has just made"
}

# BEGIN fc_worker
# The real run of chown-account root sdusers, as python3 text so that it can be run on a scratch tree by gplbld/test-sd-elevate.py.  Arguments: the path, the uid that must own it (the sdsys user's; -1 for no rule, 30 Oct 26),
# the group's name, and the uid it is given (a number, or a user's name; 0 for the root shape).  It opens the path with O_NOFOLLOW (a link at the end is refused), asks the OPEN FILE who owns it and what it is, checks that the path still names
# that file (a link planted in a directory above it would show here), and chowns through the descriptor.  RUN WITH THE ISOLATED FLAG (26 Oct 26, review): sudo keeps the caller's current directory,
# and python's -c option puts it first on sys.path, so a grp.py planted there by sdsys would run as root wherever grp is not built into python; the isolated flag leaves the directory and the environment out.
read -r -d '' FC_PY <<'FC_PY_END' || true
import grp
import os
import pwd
import stat
import sys

path = sys.argv[1]
owner = int(sys.argv[2])
group = sys.argv[3]
new_user = sys.argv[4]          # 30 Oct 26 (S.78 3c): a number, or a user's name looked up here (the account shapes name the user, and a dry run must not need the user to exist)
PROG = "sd-elevate"


def refuse(s):
    sys.stderr.write("%s: REFUSED - %s\n" % (PROG, s))
    sys.exit(2)


try:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY)
except OSError as e:
    refuse("cannot open %s without following a link: %s" % (path, e.strerror))
try:
    st = os.fstat(fd)
    if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
        refuse("%s is neither a directory nor a plain file" % path)
    if owner >= 0 and st.st_uid != owner:      # 30 Oct 26 (S.78 3c): -1 is "no rule about who owns it now" (the account shapes: the path was validated against the account's tree)
        refuse("%s belongs to uid %d, not to the user sdsys (uid %d)" % (path, st.st_uid, owner))
    try:
        here = os.readlink("/proc/self/fd/%d" % fd)
    except OSError as e:
        refuse("cannot tell where the open file is (is /proc mounted?): %s" % e.strerror)
    if here != path:
        refuse("%s is not where it was when it was checked (the open file is %s)" % (path, here))
    try:
        gid = grp.getgrnam(group).gr_gid
    except KeyError:
        refuse("the group %s does not exist" % group)
    try:
        new_uid = int(new_user) if new_user.isdigit() else pwd.getpwnam(new_user).pw_uid
    except KeyError:
        refuse("the user %s does not exist" % new_user)
    try:
        os.fchown(fd, new_uid, gid)
    except OSError as e:
        sys.stderr.write("%s: FAILED - the change of owner of %s failed: %s\n" % (PROG, path, e.strerror))
        sys.exit(1)
    print("%s: chowned %s to %d:%s through the open file" % (PROG, path, new_uid, group))
finally:
    os.close(fd)
FC_PY_END
# END fc_worker

# 30 Oct 26 dm - S.78 3c (Opus's decision).  THE SETGID BIT, THROUGH THE OPEN DIRECTORY.  `chmod g+s PATH` named the directory a second time, after the check: a directory of the tree swapped for a link
# between the two would have given a file elsewhere the setgid bit, as root.  The worker opens the path as a directory without following a link at its end, checks that the path still names the open
# directory (a link planted in a directory above it would show here), and sets the bit with fchmod on the descriptor.  Run with the isolated flag, as FC_PY is.
# BEGIN sg_worker
read -r -d '' SG_PY <<'SG_PY_END' || true
import os
import stat
import sys

path = sys.argv[1]
PROG = "sd-elevate"


def refuse(s):
    sys.stderr.write("%s: REFUSED - %s\n" % (PROG, s))
    sys.exit(2)


try:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NOCTTY)
except OSError as e:
    refuse("cannot open %s as a directory without following a link: %s" % (path, e.strerror))
try:
    try:
        here = os.readlink("/proc/self/fd/%d" % fd)
    except OSError as e:
        refuse("cannot tell where the open directory is (is /proc mounted?): %s" % e.strerror)
    if here != path:
        refuse("%s is not where it was when it was checked (the open directory is %s)" % (path, here))
    try:
        os.fchmod(fd, stat.S_IMODE(os.fstat(fd).st_mode) | stat.S_ISGID)
    except OSError as e:
        sys.stderr.write("%s: FAILED - the setgid bit of %s could not be set: %s\n" % (PROG, path, e.strerror))
        sys.exit(1)
    print("%s: set the setgid bit of %s through the open directory" % (PROG, path))
finally:
    os.close(fd)
SG_PY_END
# END sg_worker

# 30 Oct 26 dm - S.78 3c.  THE SETGID BIT ON EVERY DIRECTORY OF A RESTORED TREE, THROUGH THE OPEN DIRECTORIES.  restore-place ran `find TREE -type d -exec chmod g+s {} +`: find lists a name, chmod then follows
# whatever the name is by then, so an account user who swapped a directory of the restored tree for a link in that moment aimed root's chmod at a file elsewhere (a setgid root program).  The worker walks
# the tree with python's os.fwalk on descriptors, which compares each directory it opens with what it listed and never follows a link, and sets the bit with fchmod on the descriptor; it does not leave the
# filesystem the tree is on.  Run with the isolated flag.
# BEGIN sw_worker
read -r -d '' SW_PY <<'SW_PY_END' || true
import os
import stat
import sys

top = sys.argv[1]
PROG = "sd-elevate"
done = same = other_fs = 0


def refuse(s):
    sys.stderr.write("%s: REFUSED - %s\n" % (PROG, s))
    sys.exit(2)


try:
    topfd = os.open(top, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_NOCTTY)
except OSError as e:
    refuse("cannot open %s as a directory without following a link: %s" % (top, e.strerror))
try:
    if os.readlink("/proc/self/fd/%d" % topfd) != top:
        refuse("%s is not where it was when it was checked" % top)
    dev = os.fstat(topfd).st_dev
finally:
    os.close(topfd)
for dirpath, dirnames, filenames, dirfd in os.fwalk(top, follow_symlinks=False):
    st = os.fstat(dirfd)
    if st.st_dev != dev or not stat.S_ISDIR(st.st_mode):
        dirnames[:] = []
        other_fs += 1
        continue
    mode = stat.S_IMODE(st.st_mode)
    if mode & stat.S_ISGID:
        same += 1
        continue
    try:
        os.fchmod(dirfd, mode | stat.S_ISGID)
    except OSError as e:
        sys.stderr.write("%s: FAILED - the setgid bit of %s could not be set: %s\n" % (PROG, dirpath, e.strerror))
        sys.exit(1)
    done += 1
if done + same + other_fs == 0:
    refuse("nothing was walked under %s (it was changed while it was being opened)" % top)       # fwalk gives nothing, without an error, for a top that is not what it lstat'ed
print("%s: setgid on %d director%s of %s through the open directories, %d already had it, %d left alone (another filesystem)" % (
    PROG, done, "y" if done == 1 else "ies", top, same, other_fs))
SW_PY_END
# END sw_worker

# 18 Sep 26 dm - CHOWN-ACCOUNT, FOR CREATE.ACCOUNT'S OWN STEP (the A4 finding of
# the first fresh cycle's witness run).  createa's set.owner computed
# "<user><VM><group><VM><path>" and chowned it with the OS$CHOWN intrinsic,
# which needs root; the administrator is a local sdsys session and is NEVER
# root (S.26), so every account created after an install came out
# sdsys:sdusers - six "Unable change ownership of directory ... err: 1" (EPERM)
# lines, and an account directory owned by the sdusers group that EVERY
# account belongs to.  The three shapes below are exactly what createa's
# set.owner computes, and nothing else is accepted:
#
#   <user>  sdu_<user>    the account's own directory      (createa:365-366)
#   sdsys   <sdg_ group>  a GROUP account's directory, and (19 Oct 26) the
#                         record files %0 and %1 of a directory file in it;
#                         26 Oct 26 (F12): only inside group_accounts/<name>, and
#                         the group is sdg_<name> (sdusers for shared)
#   root    sdusers       an OTHER account's attached path
#
# A PERSON IS CONFINED TO ITS OWN ACCOUNT DIRECTORY and to its own sdu_ group,
# so a chown can never move one account's files into another account's tree, nor
# put them in sdusers - the group every account belongs to, which is the
# confinement the teardown exists to give.  sdsys and root name no such thing,
# so the sdsys shape's paths must sit inside the accounts root.
# 26 Oct 26 (F12b): THE root:sdusers SHAPE WAS "THE ONE UNRESTRICTED CASE, AND IT GRANTS
# NOTHING".  IT GRANTED THE GROUP sdusers - every SD user - ON ANY PATH THAT EXISTS:
# a dry run of `chown-account root sdusers /etc/shadow` was accepted, and a real one
# turns root:shadow 0640 into root:sdusers 0640.  Its one caller is create.account
# for an OTHER account, whose path the administrator names (anywhere: create.account
# other <name> <path>) and which create.file has just made as the sdsys user, with
# everything in it.  So the path stays free and the owner is the rule: a directory or
# a plain file that the sdsys user owns (require_sdsys_owned), which nothing of
# root's is, and a real run chowns through the file it has opened (FC_PY).
require_account_owner() {
  local user=$1 group=$2 path=$3 real uroot
  [[ -n $user && -n $group && -n $path ]] || die "chown-account needs <user> <group> <path>"
  require_sd_group "$group"
  [[ $path == /* ]] || die "path '$path' is not absolute"
  real=$(realpath -e -- "$path" 2>/dev/null) || die "path '$path' does not exist"
  case $user in
    root)
      [[ $group == sdusers ]] || die "an OTHER account's owner is root:sdusers, not root:$group"
      require_sdsys_owned "$real"
      FC_PATH=$real
      FC_GROUP=$group
      FC_OWNER=$SDSYS_UID
      FC_NOTE="(opened without following a link, found to belong to uid $SDSYS_UID - the sdsys user - and chowned through the open file)"
      ;;
    sdsys)
      require_sd_chown_path "$path"
      require_group_account_files "$group" "$path"
      # 30 Oct 26 (S.78 3c, Opus's decision): the real run chowns through the file it has opened without following a link, not through the path again - a directory of the
      # tree swapped for a link between the check above and the chown would otherwise have aimed root's chown at a file elsewhere
      FC_PATH=$real
      FC_GROUP=$group
      FC_OWNER=-1
      FC_USER=sdsys
      FC_NOTE="(opened without following a link, found to be where it was checked, and chowned to sdsys through the open file)"
      ;;
    *)
      require_sd_user "$user"
      # The stamp check that guards userdel-home is NOT repeated here: that one
      # guards a REMOVAL (a home is deleted only when SD made it), while this is
      # an ownership change confined to the account's own directory below, and
      # an ADOPTed account - which SD did not create - is a legitimate owner of
      # its own directory.
      [[ $group == "sdu_$user" ]] || die "'$user' owns its own files through sdu_$user, not '$group'"
      uroot=$(realpath -e -- "$SD_ACCT_ROOT/user_accounts" 2>/dev/null) \
        || die "the user accounts root '$SD_ACCT_ROOT/user_accounts' does not exist"
      [[ $real == "$uroot/$user" || $real == "$uroot/$user"/* ]] \
        || die "'$real' is not the account directory of '$user'"
      FC_PATH=$real                        # 30 Oct 26 (S.78 3c): through the open file, as above
      FC_GROUP=$group
      FC_OWNER=-1
      FC_USER=$user
      FC_NOTE="(opened without following a link, found to be where it was checked, and chowned to $user through the open file)"
      ;;
  esac
  # Not -R: createa names each path it made, exactly as the intrinsic did.
  cmd=(chown -- "$user:$group" "$real")
}

# 19 Sep 26 dm - RMTREE-ACCOUNT, FOR DELETE.ACCOUNT'S DIRECTORY STEP (the fifth
# cycle's witness run).  delacc removed the account directory with the
# OS$DELETE intrinsic, which runs as the calling session; before the teardown
# that was root, and now it is the local sdsys session (S.26).  A file the
# account's own Linux user made without group write - a 755 directory, which is
# what its default umask gives - cannot be removed by sdsys, so the directory
# survived a DELETE.ACCOUNT that had said it would go (zzrel1's zzdeep, 19 Sep).
#
# ***EXACTLY AN ACCOUNT DIRECTORY AND NOTHING ELSE***: a direct child of
# <accounts root>/user_accounts or <accounts root>/group_accounts, named as an
# SD name, given in canonical form (a symlink or a ".." anywhere in the path is
# refused rather than resolved), and never the roots themselves.  This hands
# sdsys nothing new: chown-account already lets it take any path under the
# accounts root, after which it could remove it without help.
require_account_dir() {
  local path=$1 real parent name root
  [[ -n $path ]] || die "path is empty"
  [[ $path == /* ]] || die "path '$path' is not absolute"
  real=$(realpath -e -- "$path" 2>/dev/null) || die "path '$path' does not exist"
  [[ $real == "$path" ]] || die "path '$path' is not in canonical form (it resolves to '$real')"
  [[ -d $real && ! -L $real ]] || die "path '$real' is not a directory"
  root=$(realpath -e -- "$SD_ACCT_ROOT" 2>/dev/null) || die "accounts root '$SD_ACCT_ROOT' does not exist"
  parent=${real%/*}
  name=${real##*/}
  [[ $parent == "$root/user_accounts" || $parent == "$root/group_accounts" ]] \
    || die "'$real' is not directly inside $root/user_accounts or $root/group_accounts"
  require_name "account directory" "$name"
  cmd=(rm -rf --one-file-system -- "$real")
}

# ------------------------------------------------------ account backup (S.50)
#
# 01 Oct 26 dm - BACKUP.ACCOUNT / RESTORE.ACCOUNT (owner, 30 Sep / 1 Oct 2026;
# the format and the helper split are agreed with SD Core for Windows by mail).
# The archive work itself is gplbld/sd-accarchive, installed root-owned beside
# this script; these verbs decide WHICH paths it may touch.
#
#   tree-count    counts an account directory as root (the manifest's files,
#                 bytes and dirs come from this, before the pack).
#   backup-pack   packs account directories as root.  Every directory must pass
#                 require_account_dir and be named for its own account; the
#                 manifest arrives on stdin and the zip leaves on stdout, so root
#                 never opens a file the caller named.  sd-accarchive never
#                 follows a symlink, so one planted in an account cannot pull a
#                 file the administrator cannot read into the zip.
#   restore-place puts a staged tree into an account directory, replacing what
#                 is there, then chowns it to the account's owner and sets setgid
#                 on its directories.  The staged tree must be exactly
#                 <root>/.sdrestore.<n>/accounts/<name>, the target exactly
#                 <root>/user_accounts/<name> or <root>/group_accounts/<name>,
#                 and the owner pair one chown-account would accept for it.
#   akpath-set    sdidx -p on a restored hashed file whose indices were relocated
#                 inside its own account.  Both paths must be in one account.
#
# NONE OF THESE HANDS sdsys ANYTHING NEW: chown-account and rmtree-account
# already let it take or remove any account directory.  What they do not give it
# is READING a file it is not allowed to read, and backup-pack is shaped so that
# it still cannot: the zip goes to the caller, but only of account trees, and
# sdsys was a member of every account's group by construction (createa's
# groupadd), so an account file was one it was entitled to see.  26 Oct 26 (F6):
# that is no longer so as delivered (the membership is switched on per account,
# modify.account sdsys-on); backup-pack's reading of an account tree is then
# decided by the tree's modes alone, as for any other group member that is not in the group.

SD_ACCARCHIVE_REAL=/usr/local/sbin/sd-accarchive
SD_ACCARCHIVE=${SD_ACCARCHIVE:-$SD_ACCARCHIVE_REAL}      # 26 Oct 26 dm - F12e: a test knob like SD_ACCT_ROOT (python3 runs it as root); reset to the real one in main unless trust_fixtures

# The canonical account directory, by the same rules rmtree-account uses,
# without building the removal.  Sets ACCT_REAL and ACCT_NAME.
account_dir_checked() {
  require_account_dir "$1"
  ACCT_REAL=$(realpath -e -- "$1")
  ACCT_NAME=${ACCT_REAL##*/}
}

# The account directory a path lies in, or refuse.  Sets ACCT_REAL.
account_of_path() {
  local path=$1 real root rel kind name
  [[ $path == /* ]] || die "path '$path' is not absolute"
  real=$(realpath -e -- "$path" 2>/dev/null) || die "path '$path' does not exist"
  [[ $real == "$path" ]] || die "path '$path' is not in canonical form (it resolves to '$real')"
  root=$(realpath -e -- "$SD_ACCT_ROOT" 2>/dev/null) || die "accounts root '$SD_ACCT_ROOT' does not exist"
  rel=${real#"$root"/}
  [[ $rel != "$real" ]] || die "'$real' is outside the accounts root '$root'"
  kind=${rel%%/*}
  rel=${rel#*/}
  name=${rel%%/*}
  [[ $kind == user_accounts || $kind == group_accounts ]] \
    || die "'$real' is not inside $root/user_accounts or $root/group_accounts"
  require_name "account directory" "$name"
  ACCT_REAL=$root/$kind/$name
}

# 26 Oct 26 dm - F12.  akpath-set RUNS sdidx AS ROOT, and sdidx opens <data path>/%0 for writing (it checks the magic number of the primary subfile and rewrites its header, and nothing else).  So
# the argument has to be what a restored hashed file is: a directory holding a plain %0 that nothing else links to (a link planted at %0 would be followed by root's open), and the new index
# path a directory (sdidx stats it too).  account_of_path has already seen that both are canonical paths of ONE account.  The only caller is restorea, through acc_os_akpath, with the data
# path of a hashed file it has just placed (a VOC pointer's path, mapped into the account) and the relocated index directory inside the account.
require_hashed_dir() {   # require_hashed_dir DATA_PATH INDEX_PATH
  local data=$1 index=$2
  [[ -d $data && ! -L $data ]] || die "the data path '$data' is not a directory (a hashed file is a directory that holds %0)"
  [[ -f $data/%0 && ! -L $data/%0 ]] || die "'$data/%0' is not a plain file, so the data path is not a hashed file"
  [[ $(stat -c %h -- "$data/%0") == 1 ]] || die "'$data/%0' has more than one hard link"
  [[ -d $index && ! -L $index ]] || die "the index path '$index' is not a directory"
}

restore_place() {
  local owner=$1 group=$2 staged=$3 target=$4 root sreal treal sname tname kind old n want
  [[ -n $owner && -n $group && -n $staged && -n $target ]] || usage
  root=$(realpath -e -- "$SD_ACCT_ROOT" 2>/dev/null) || die "accounts root '$SD_ACCT_ROOT' does not exist"

  # The staged tree: exactly <root>/.sdrestore.<n>/accounts/<name>, canonical.
  [[ $staged == /* ]] || die "staged path '$staged' is not absolute"
  sreal=$(realpath -e -- "$staged" 2>/dev/null) || die "staged path '$staged' does not exist"
  [[ $sreal == "$staged" ]] || die "staged path '$staged' is not in canonical form (it resolves to '$sreal')"
  [[ -d $sreal && ! -L $sreal ]] || die "staged path '$sreal' is not a directory"
  [[ $sreal =~ ^"$root"/\.sdrestore\.([0-9]+)/accounts/([^/]+)$ ]] \
    || die "'$sreal' is not $root/.sdrestore.<n>/accounts/<name>"
  n=${BASH_REMATCH[1]}
  sname=${BASH_REMATCH[2]}
  require_name "staged account" "$sname"

  # The target: exactly <root>/user_accounts/<name> or group_accounts/<name>.
  [[ $target == /* ]] || die "target '$target' is not absolute"
  treal=$(realpath -e -- "$target" 2>/dev/null) || die "target '$target' does not exist (CREATE.ACCOUNT makes it first)"
  [[ $treal == "$target" ]] || die "target '$target' is not in canonical form (it resolves to '$treal')"
  [[ -d $treal && ! -L $treal ]] || die "target '$treal' is not a directory"
  tname=${treal##*/}
  kind=${treal%/*}
  [[ $tname == "$sname" ]] || die "the staged tree is account '$sname' but the target is '$tname'"
  [[ $kind == "$root/user_accounts" || $kind == "$root/group_accounts" ]] \
    || die "'$treal' is not directly inside $root/user_accounts or $root/group_accounts"

  # The owner pair: what createa's set.owner gives that kind of account.
  require_sd_group "$group"
  if [[ $kind == "$root/user_accounts" ]]; then
    require_sd_user "$owner"
    [[ $owner == "$tname" ]] || die "user account '$tname' belongs to user '$tname', not '$owner'"
    [[ $group == "sdu_$owner" ]] || die "'$owner' owns its own files through sdu_$owner, not '$group'"
  else
    [[ $owner == sdsys ]] || die "a group account's owner is sdsys, not '$owner'"
    [[ $group == sdg_?* || $group == sdusers ]] || die "a group account's group is sdg_<name>, not '$group'"
    # 26 Oct 26 dm - F12.  restorea passes the group of the account's directory, which create.account made as sdg_<the account's own name>; another account's group is not one it sends.
    # 26 Oct 26 dm - THE SHARED ACCOUNT'S DIRECTORY IS IN sdusers (every SD user's process reads it through the kernel; its register group sdg_shared is only who may sign on), as
    #   require_group_account_files already says; a restore used to give it sdg_shared, and no ordinary user could read the shared account after RESTORE.ACCOUNT.  Found on the VM.
    if [[ $tname == shared ]]; then want=sdusers; else want=sdg_$tname; fi
    [[ $group == "$want" ]] || die "group account '$tname' belongs to the group $want, not '$group'"
  fi
  getent group "$group" >/dev/null 2>&1 || [[ $DRY -eq 1 ]] || die "group '$group' does not exist"

  old=$root/.sdrestore.$n/old.$tname
  [[ ! -e $old ]] || die "'$old' already exists; a previous restore did not finish"

  need_root
  step mv -T -- "$treal" "$old" || die "could not move the current account aside"
  if ! step mv -T -- "$sreal" "$treal"; then
    step mv -T -- "$old" "$treal"
    die "could not put the restored tree in place; the current account was put back"
  fi
  step chown -R -P -- "$owner:$group" "$treal" || die "chown of $treal failed; the restored tree is in place, the old one is at $old"
  # 30 Oct 26 (S.78 3c): the setgid bit goes on through the open directories (SW_PY), not by `find -exec chmod` naming each directory a second time
  printf '%s: setgid on every directory of %s, through the open directories (no link followed)\n' "$PROG" "$treal"
  if [[ $DRY -ne 1 ]]; then
    python3 -I -c "$SW_PY" "$treal" || die "setgid on $treal failed"
  fi
  step rm -rf --one-file-system -- "$old" || die "the restore is in place, but the old tree at $old could not be removed"
  printf '%s: restored %s (%s:%s)\n' "$PROG" "$treal" "$owner" "$group"
  exit 0
}

# ------------------------------------------------------ cred-own (W.10)
#
# 19 Sep 26 dm - A PERSON SETS THEIR OWN SD PASSWORD (owner, 19 Sep 2026: "user
# can only change their own password, sdsys can change any password"; parity
# with SD Core for Windows, whose RESULT this matches by a Linux route).
#
# $cred is sdsys:sdusers 0700, so an ordinary session can neither read nor
# write it, and that stays true: this is the one door, and it opens on ONE
# record - the caller's own.  WHO THE CALLER IS COMES FROM sudo, NOT FROM THE
# CALLER: SUDO_USER and SUDO_UID are set by sudo itself, and both must agree
# with the passwd database.  sudoers grants sdusers exactly the two argument
# lists "cred-own query" and "cred-own set", nothing else in this script.
#
# NOTHING SECRET IS EVER AN ARGUMENT.  "set" reads its seven lines on stdin,
# redirected from a file in a private (0700) directory of the caller's - so
# no key reaches a command line, ps, or a log:
#
#   1  the CURRENT password's StoredKey, derived by the caller from the salt
#      and iterations "query" gave it (empty when there is no credential yet)
#   2  version (2)   3  SCRAM-SHA-256   4  salt   5  iterations
#   6  StoredKey     7  ServerKey       (base64, as !CRED_SET writes them)
#
# THE CURRENT PASSWORD IS CHECKED WITHOUT ANY CRYPTOGRAPHY HERE.  The caller
# cannot read $cred, so arriving with the record's exact StoredKey proves it
# derived it from the password; a string comparison is the whole check.  The
# new record is written through a temp file and a rename, owned sdsys:sdusers
# 0600 like the rest, and READ BACK - the port's rule for $cred.
# The fixture override is for --dry-run only (test-sd-elevate.py).  A real run
# never trusts it: where sudo passes the environment through (!env_reset), a
# caller could otherwise point the helper at a register of its own making.
SD_SYS_ROOT_REAL=/usr/local/sdsys

# 19 Sep 26 dm - SD'S PASSWORD RULE (owner's ruling, 19 Sep 2026: SD requires
# a complex password whatever the OS allows).  The same rule as
# GPL.BP/PW_COMPLEX, byte for byte: 8+ characters, at least one a-z, A-Z, 0-9
# and one other printable ASCII character (space included); anything outside
# 32-126 fails.  LC_ALL=C so length and the character codes are bytes.
pw_complex() {
  local p=$1 i c lo=0 up=0 di=0 sy=0
  local LC_ALL=C
  (( ${#p} >= 8 )) || return 1
  for (( i = 0; i < ${#p}; i++ )); do
    printf -v c '%d' "'${p:i:1}"
    if   (( c >= 97 && c <= 122 )); then lo=1
    elif (( c >= 65 && c <= 90 ));  then up=1
    elif (( c >= 48 && c <= 57 ));  then di=1
    elif (( c >= 32 && c <= 126 )); then sy=1
    else return 1
    fi
  done
  (( lo && up && di && sy ))
}

# 19 Sep 26 dm - SETPW: CREATE.ACCOUNT's Linux password, set by SD rather than
# by an interactive passwd, so SD's rule can be applied to it (passwd's own
# prompt is the OS's rule, and SD never sees what is typed there).  The
# password arrives as ONE line on stdin, never as an argument, is checked
# against the rule here as well as in SD, and goes to chpasswd on its stdin.
set_pw() {
  local user=$1 pw extra
  require_sd_user "$user"
  require_sd_stamp "$user" "its Linux password is never set here"
  require_pw_unset "$user"
  IFS= read -r pw || die "setpw wants the password on stdin"
  IFS= read -r extra && die "setpw wants exactly one line on stdin; there were more"
  pw_complex "$pw" || die "the password does not meet SD's rule (10920): 8+ characters with a lower-case letter, an upper-case letter, a digit and a symbol"
  printf '%s: chpasswd for %s (the password on stdin)\n' "$PROG" "$user"
  [[ $DRY -eq 1 ]] && exit 0
  need_root
  printf '%s:%s\n' "$user" "$pw" | chpasswd || die "chpasswd refused the password for $user"
  printf '%s: Linux password set for %s\n' "$PROG" "$user"
  exit 0
}

cred_b64() {   # $1 value, $2 min bytes, $3 max bytes; true if base64 of that size
  local n
  [[ $1 =~ ^[A-Za-z0-9+/]+={0,2}$ ]] || return 1
  n=$(printf '%s' "$1" | base64 -d 2>/dev/null | wc -c) || return 1
  [[ $n -ge $2 && $n -le $3 ]]
}

cred_own() {
  local mode=$1 user=${SUDO_USER:-} suid=${SUDO_UID:-} acct reg cdir cfile
  local cur ver mech salt iter sk svk extra line old_ver old_sk tmp v SD_SYS_ROOT
  SD_SYS_ROOT=$SD_SYS_ROOT_REAL
  [[ $DRY -eq 1 ]] && SD_SYS_ROOT=${SD_SYS_ROOT_FIXTURE:-$SD_SYS_ROOT_REAL}
  [[ -n $user && -n $suid ]] || die "cred-own is reached only through sudo (no SUDO_USER/SUDO_UID)"
  [[ $suid =~ ^[0-9]+$ ]] || die "SUDO_UID '$suid' is not a number"
  acct=${user,,}
  require_name "account" "$acct"
  [[ $acct != root && $suid -ne 0 ]] || die "root has no SD password of its own"
  [[ $acct != sdsys ]] || die "sdsys sets passwords as the administrator (MODIFY.PASSWORD), not here"
  [[ $(id -u "$user" 2>/dev/null) == "$suid" ]] || die "SUDO_USER '$user' does not match SUDO_UID $suid"
  reg="$SD_SYS_ROOT/accounts/$acct"
  [[ -f $reg ]] || die "'$acct' is not in the SD account register"
  [[ $(sed -n '3p' "$reg") == "sdu_$acct" ]] || die "'$acct' is not a user's own account (register group is not sdu_$acct)"
  [[ -z $(sed -n '5p' "$reg") ]] || die "account '$acct' is suspended"
  cdir="$SD_SYS_ROOT/\$cred"
  [[ -d $cdir ]] || die "the credential register '$cdir' does not exist"
  cfile="$cdir/$acct"
  old_ver='' old_sk=''
  if [[ -f $cfile ]]; then
    old_ver=$(sed -n '1p' "$cfile"); old_sk=$(sed -n '5p' "$cfile")
  fi

  case $mode in
    query)
      # Salt and iterations are not secret - SCRAM sends both to any client.
      if [[ $old_ver == 2 && -n $old_sk ]]; then
        printf 'salt %s\niter %s\n' "$(sed -n '3p' "$cfile")" "$(sed -n '4p' "$cfile")"
      else
        printf 'none\n'
      fi
      exit 0
      ;;
    # 19 Sep 26 dm - VERIFY: the current password, checked BEFORE the new one
    # is asked for (the owner at the keyboard, fifth cycle: a wrong current
    # password went on to the new-password prompts and failed only at the
    # write).  One line on stdin, the StoredKey; the same comparison set makes.
    # It is an oracle only for the caller's own password, at the caller's own
    # PBKDF2 cost per guess - no cheaper than trying set.
    verify)
      IFS= read -r cur || true
      IFS= read -r extra && die "verify wants exactly one line on stdin; there were more"
      [[ ${#cur} -le 256 ]] || die "an input line is over 256 characters"
      [[ $old_ver == 2 && -n $old_sk ]] || die "'$acct' has no SD password to check against"
      [[ -n $cur && $cur == "$old_sk" ]] || die "the current password is not correct"
      printf '%s: the current password is correct\n' "$PROG"
      exit 0
      ;;
    set) ;;
    *) die "cred-own takes query, verify or set - not '$mode'" ;;
  esac

  IFS= read -r cur  || true
  for v in ver mech salt iter sk svk; do
    IFS= read -r line || die "set wants seven lines on stdin; it ended early"
    printf -v "$v" '%s' "$line"
  done
  IFS= read -r extra && die "set wants exactly seven lines on stdin; there were more"
  for line in "$cur" "$ver" "$mech" "$salt" "$iter" "$sk" "$svk"; do
    [[ ${#line} -le 256 ]] || die "an input line is over 256 characters"
  done
  [[ $ver == 2 ]]              || die "record version must be 2, not '$ver'"
  [[ $mech == SCRAM-SHA-256 ]] || die "mechanism must be SCRAM-SHA-256, not '$mech'"
  cred_b64 "$salt" 8 64        || die "the salt is not base64 of 8-64 bytes"
  [[ $iter =~ ^[0-9]{4,8}$ && $iter -ge 4096 && $iter -le 10000000 ]] \
                               || die "iterations '$iter' is outside 4096-10000000"
  cred_b64 "$sk" 32 32         || die "StoredKey is not base64 of 32 bytes"
  cred_b64 "$svk" 32 32        || die "ServerKey is not base64 of 32 bytes"

  if [[ $old_ver == 2 && -n $old_sk ]]; then
    [[ -n $cur ]] || die "'$acct' has a password; the current one is required"
    [[ $cur == "$old_sk" ]] || die "the current password is not correct"
  fi

  printf '%s: write %s (6 fields, sdsys:sdusers 0600)\n' "$PROG" "$cfile"
  [[ $DRY -eq 1 ]] && exit 0
  need_root

  tmp=$(mktemp "$cdir/.cred-own.XXXXXX") || die "cannot create a temp file in $cdir"
  printf '%s\n' "$ver" "$mech" "$salt" "$iter" "$sk" "$svk" > "$tmp" \
    && chown sdsys:sdusers "$tmp" && chmod 0600 "$tmp" && mv -f -- "$tmp" "$cfile" \
    || { rm -f -- "$tmp"; die "writing $cfile failed"; }
  [[ $(sed -n '5p' "$cfile") == "$sk" && $(sed -n '6p' "$cfile") == "$svk" ]] \
    || die "the record did not read back as written"
  logger -t sd-elevate "cred-own: SD password set for $acct" 2>/dev/null || true
  printf '%s: SD password set for %s\n' "$PROG" "$acct"
  exit 0
}

# ------------------------------------------------------ netcred-dir (S.65 slice 2b)
#
# 17 Oct 26 dm - THE DIRECTORY OF A PERSON'S SDNET LOGINS.  Using a server defined by SDSYS (set.server) needs a login on it, and
# what is kept is never the password: the SCRAM values derived for that one user on that one server (salt, iterations, ClientKey,
# ServerKey), one file per server in /var/lib/sd-net/<linux user>/.  That directory sits OUTSIDE the account directory on purpose:
# an account program whose OS-access gate is off cannot reach it with OPENSEQ.  (An account holding the sh or os.execute gate can
# read whatever its Linux user can read, this directory included, exactly as it can read ~/.ssh; the docs say so.)
#
# This verb only MAKES the directory - the files in it are written by the person's own session, as that person, so root never
# writes or reads a credential.  SELF-SERVICE like cred-own: WHO is from sudo (SUDO_USER and SUDO_UID, which must agree with the
# passwd database), there is no argument, and sudoers grants sdusers exactly "netcred-dir".  What it will do, and nothing else:
#
#   /var/lib/sd-net          root:root, mode 0755, made if missing; an existing one must be a plain directory (not a link), owned
#                            by root and not writable by group or world, or it is refused
#   /var/lib/sd-net/<user>   <user>:<their primary group>, mode 0700, made if missing; an existing one must be a plain directory
#                            owned by that user (anything else is refused), and is set back to 0700 if it was not
#
# Root, sdsys and every uid below UID_MIN are refused, as every verb here does.  Because /var/lib/sd-net is root's and not
# writable by anybody else, the person cannot swap their directory for a link between the checks and the chmod.
# The commands are run through step(), so the line printed IS the command run.  The success line is "netcred-dir: <path>" alone on
# its line (that is what the caller anchors on); a dry run prints the commands and "(dry run - nothing made or changed)" instead.
# SD_NET_ROOT_FIXTURE moves the root of /var/lib/sd-net on a DRY RUN ONLY (a real run never trusts it), and then the directory
# stands in for root's, so it is expected to belong to the caller rather than to root.
SD_NET_ROOT_REAL=/var/lib/sd-net

net_plain_dir() {   # $1 path, $2 the uid that must own it, $3 mode bits (octal) that must be clear; sets NET_MODE (the octal mode)
  local p=$1 ids
  [[ -d $p && ! -L $p ]] || die "netcred-dir: $p is not a plain directory (a link or a file); refusing to use it"
  ids=$(stat -c '%u %a' -- "$p" 2>/dev/null) || die "netcred-dir: cannot stat $p"
  [[ ${ids% *} -eq $2 ]] || die "netcred-dir: $p is owned by uid ${ids% *}, not uid $2"
  NET_MODE=${ids#* }
  (( (8#$NET_MODE & 8#$3) == 0 )) || die "netcred-dir: $p is writable by its group or by everyone (mode $NET_MODE)"
}

netcred_dir() {
  local user=${SUDO_USER:-} suid=${SUDO_UID:-} grp net_root dir root_uid
  [[ -n $user && -n $suid ]] || die "netcred-dir is reached only through sudo (no SUDO_USER/SUDO_UID)"
  [[ $suid =~ ^[0-9]+$ ]] || die "netcred-dir: SUDO_UID '$suid' is not a number"
  require_sd_user "$user"
  [[ $(id -u "$user" 2>/dev/null) == "$suid" ]] || die "netcred-dir: SUDO_USER '$user' does not match SUDO_UID $suid"
  grp=$(id -gn "$user" 2>/dev/null) && [[ -n $grp ]] || die "netcred-dir: cannot read the primary group of '$user'"
  net_root=$SD_NET_ROOT_REAL root_uid=0
  if [[ $DRY -eq 1 && -n ${SD_NET_ROOT_FIXTURE:-} ]]; then
    [[ $SD_NET_ROOT_FIXTURE == /* && $SD_NET_ROOT_FIXTURE != / ]] || die "netcred-dir: the fixture root is not an absolute directory"
    net_root=$SD_NET_ROOT_FIXTURE root_uid=$(id -u)
  fi
  dir=$net_root/$user

  # The checks come first and apply to what is there already, on a dry run as well as a real one.
  if [[ -e $net_root || -L $net_root ]]; then net_plain_dir "$net_root" "$root_uid" 022; fi
  if [[ -e $dir || -L $dir ]]; then net_plain_dir "$dir" "$suid" 0; fi

  if [[ $DRY -eq 0 ]]; then need_root; fi
  if [[ -e $net_root ]]; then
    printf '%s: %s is in place\n' "$PROG" "$net_root"
  else
    step install -d -o root -g root -m 0755 -- "$net_root" || die "netcred-dir: could not make $net_root"
  fi
  if [[ -d $dir ]]; then
    if [[ ${NET_MODE:-} == 700 ]]; then
      printf '%s: %s is in place (owner uid %s, mode 700)\n' "$PROG" "$dir" "$suid"
    else
      step chmod 0700 -- "$dir" || die "netcred-dir: could not set $dir to mode 0700"
    fi
  else
    step install -d -o "$user" -g "$grp" -m 0700 -- "$dir" || die "netcred-dir: could not make $dir"
  fi
  if [[ $DRY -eq 1 ]]; then
    printf '%s: (dry run - nothing made or changed)\n' "$PROG"
    exit 0
  fi
  net_plain_dir "$net_root" 0 022
  net_plain_dir "$dir" "$suid" 077
  [[ $NET_MODE == 700 ]] || die "netcred-dir: $dir did not read back as mode 700 (it is $NET_MODE)"
  logger -t sd-elevate "netcred-dir: $dir for $user" 2>/dev/null || true
  printf 'netcred-dir: %s\n' "$dir"
  exit 0
}

# ------------------------------------------------------ the backup directory (S.53)
#
# 02 Oct 26 dm - SET.BACKUP.DIRECTORY (owner's ruling, 1 Oct 2026, for both ports; the verb,
# the key and the helper split are shared with SD Core for Windows).  /etc/sd.conf is root's
# and the administrator, sdsys, is never root, so SAVING BACKUPDIR=<path> there is a root
# step.  Two verbs, each shaped so that it can do nothing else:
#
#   bakdir-set <dir>   SAVES the line.  The directory must ALREADY EXIST and root changes
#                      nothing about it - so a directory on a USB drive, in the pCloud folder
#                      or anywhere else that already exists can be saved from anywhere.  The
#                      path is checked character by character BEFORE it can reach the file, so
#                      a newline cannot add a second line to sd.conf (an SDSYS= line, say);
#                      the file is /etc/sd.conf and nothing a caller passes moves it, as
#                      SD_API_PORT; the rewrite is a temp file beside it with the same owner
#                      and mode, renamed over it, and the line is read back.
#   bakdir-make <dir>  CREATES a directory SDSYS may not create itself (SET.BACKUP.DIRECTORY
#                      tries mkdir as sdsys first), owned by sdsys, mode 0700 because a backup
#                      holds every account's files - and ONLY INSIDE THE PLACES BELOW.
#
# WHY NOT ANYWHERE (owner, 2 Oct 2026: the full product has the capability Solo and Windows
# have, and "restricting it to locations normally available to sdsys ... a USB or other
# removable drive" is acceptable).  A directory that sdsys owns inside a place root reads
# configuration from - /etc/systemd/system/ssh.service.d, say - lets sdsys write a drop-in that
# runs as root, and sdsys is never root.  So root creates only below:
#     /media  /run/media  /mnt     removable and mounted drives
#     /var/backups  /srv  /opt     the usual homes for backups and site data
#     /home/sdsys                  sdsys's own home
#   and below any directory listed, one per line, in /etc/sd-backup-roots - the way an
#   administrator relaxes it by choice (SECURITY SHIPS TIGHT, owner 12 Sep 2026).  That file
#   is read only when root owns it and nobody else may write it.  Other users' homes are not
#   in the list (a directory sdsys owns inside one runs as that user), so the pCloud folder
#   is added there if sdsys is to CREATE inside it; an existing one is saved with no entry.
# Symlinks are resolved before the test, so a link inside an allowed place cannot lead out.
# gplbld/test-bakdir-elevate-units.py cuts the functions between the markers out of this file and
# runs them on scratch files and scratch directories; keep the lines, and keep the code between
# them free of anything but die().

SD_CONF=/etc/sd.conf
SD_BAKROOTS=/etc/sd-backup-roots

# BEGIN bakdir_functions
bakdir_valid() {   # bakdir_valid PATH - dies unless PATH is a path that may be saved or made
  local p=$1 re='^/[A-Za-z0-9._@+=,:/ -]+$'
  [[ -n $p ]] || die "no directory was given"
  [[ ${#p} -le 180 ]] || die "the directory path is longer than 180 characters"
  [[ $p == /* ]] || die "'$p' is not a full path: it must start with /"
  [[ $p =~ $re ]] || die "the directory path may hold only letters, digits and . _ @ + = , : / - and a space"
  [[ $p != */ ]] || die "'$p' must not end with /"
  case "$p/" in
    *//*)       die "'$p' has an empty path component (//)" ;;
    */./*|*/../*) die "'$p' has a . or .. path component" ;;
    *" /"*|*"/ "*) die "'$p' has a path component that starts or ends with a space" ;;
  esac
}

bakdir_checked() {   # bakdir_checked PATH - dies unless PATH may be saved as the backup directory
  bakdir_valid "$1"
  [[ -d $1 ]] || die "$1 is not an existing directory: SET.BACKUP.DIRECTORY makes it first (as sdsys, or through bakdir-make inside an allowed place)"
}

bakdir_roots() {   # bakdir_roots FILE [UID] - the places root may create in, canonical, one per line
  local f=$1 owner_uid=${2:-0} r line mode
  for r in /media /run/media /mnt /var/backups /srv /opt /home/sdsys; do realpath -m -- "$r"; done
  [[ -e $f || -L $f ]] || return 0
  [[ -f $f && ! -L $f ]] || die "$f is not a regular file"
  [[ $(stat -c '%u' -- "$f") == "$owner_uid" ]] || die "$f is not owned by the user that must own it ($owner_uid), so it is not read"
  mode=$(stat -c '%a' -- "$f")
  (( (8#$mode & 8#022) == 0 )) || die "$f is writable by someone besides its owner (mode $mode), so it is not read"
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line#"${line%%[![:space:]]*}"}
    line=${line%"${line##*[![:space:]]}"}
    [[ -n $line ]] || continue
    ( bakdir_valid "$line" ) 2>/dev/null || die "$f has a line that is not a usable directory: '$line'"
    r=$(realpath -m -- "$line") || die "cannot resolve '$line' in $f"
    [[ $r != / ]] || die "$f lists '$line', which resolves to / - the whole machine"
    printf '%s\n' "$r"
  done < "$f"
}

# bakdir_plan PATH ROOTSFILE [UID] - PATH does not exist: sets BAK_REAL (its deepest existing
# directory, symlinks resolved) and BAK_REST (the part still to make), or dies.
bakdir_plan() {
  local p=$1 rootsfile=$2 owner_uid=${3:-0} anc r ok=0 target rl
  local -a roots
  bakdir_valid "$p"
  [[ ! -e $p && ! -L $p ]] || die "$p already exists: nothing to make"
  anc=$p
  while [[ ! -e $anc ]]; do
    [[ ! -L $anc ]] || die "$anc is a dangling symlink"
    anc=${anc%/*}
    [[ -n $anc ]] || anc=/
  done
  [[ -d $anc ]] || die "$anc is not a directory, so nothing can be made below it"
  BAK_REAL=$(realpath -e -- "$anc") || die "cannot resolve $anc"
  if [[ $anc == / ]]; then BAK_REST=$p; else BAK_REST=${p#"$anc"}; fi
  [[ -n $BAK_REST ]] || die "internal: nothing left to make"
  if [[ $BAK_REAL == / ]]; then target=$BAK_REST; else target=$BAK_REAL$BAK_REST; fi
  # not a process substitution: a die inside one would end only that subshell and be missed here
  rl=$(bakdir_roots "$rootsfile" "$owner_uid") || exit 2
  mapfile -t roots <<< "$rl"
  for r in "${roots[@]}"; do
    [[ $target == "$r"/* ]] && ok=1
  done
  [[ $ok -eq 1 ]] || die "$target is not below a place where root may make a backup directory (${roots[*]}); make it yourself and give it to sdsys, or list its parent in $rootsfile"
}

bakdir_make() {   # bakdir_make OWNER GROUP - after bakdir_plan: makes BAK_REST below BAK_REAL
  local owner=$1 group=$2 cur=$BAK_REAL comps i last
  IFS=/ read -ra comps <<< "${BAK_REST#/}"
  last=$(( ${#comps[@]} - 1 ))
  for i in "${!comps[@]}"; do
    cur=${cur%/}/${comps[i]}
    if (( i == last )); then
      mkdir -m 0700 -- "$cur" || die "cannot make $cur"
      chown -h -- "$owner:$group" "$cur" || die "cannot give $cur to $owner:$group"
    else
      mkdir -m 0755 -- "$cur" || die "cannot make $cur"   # explicit: not whatever umask this process has
    fi
  done
  [[ $(stat -c '%U:%G %a' -- "$cur") == "$owner:$group 700" ]] || die "$cur does not read back as $owner:$group, mode 700"
  BAK_MADE=$cur
}

conf_set_backupdir() {   # conf_set_backupdir FILE PATH - one BACKUPDIR= line, last; every other line kept
  local f=$1 p=$2 tmp
  [[ -f $f && ! -L $f ]] || die "$f is not a regular file"
  tmp=$(mktemp "$f.XXXXXX") || die "cannot create a temp file beside $f"
  { grep -v -E '^[[:space:]]*BACKUPDIR=' -- "$f" || true; printf 'BACKUPDIR=%s\n' "$p"; } > "$tmp" \
    && chown --reference="$f" -- "$tmp" && chmod --reference="$f" -- "$tmp" \
    && mv -f -- "$tmp" "$f" \
    || { rm -f -- "$tmp"; die "writing $f failed"; }
  [[ $(grep -c -E '^BACKUPDIR=' -- "$f") -eq 1 && $(grep -E '^BACKUPDIR=' -- "$f") == "BACKUPDIR=$p" ]] \
    || die "$f does not read back as written"
}
# END bakdir_functions

# ------------------------------------------------------ the parameters of sd.conf (S.75 A6, the write half of tool.config)
#
# 26 Oct 26 dm - conf-set KEY VALUE (the owner chose to build it - "do a6", 26 Oct 2026 - after being warned once that it is a new root-level write of /etc/sd.conf, a wider
# permission than the delivered system has; the tighter alternative was to stay view-only and show the line to add by hand).  It is built as tightly as the work allows:
#
#   THE LIST.  14 parameters, the TUNING ones: CLEANUP DHCACHE GRPSIZE LGNWAIT LPTRHIGH LPTRWIDE MAXCALL MAXRLOCK NETREPLY NETWAIT NUMLOCKS RECCACHE SORTMRG USPLIT.  Each is a parameter
#   config.c itself range-checks (rangecheck() in read_config), so the range here is the range SD enforces at start-up and the helper cannot accept what SD would refuse.  The other
#   38 parameters of the parser are known here by name (confset_fixed) only so that a refusal can say "known, not changed here" instead of "unknown": they are the doors (NETFILES,
#   SDCLIENT), every path and command (DUMPDIR, GRPDIR, USRDIR, SDSYS, SH, SH1, SORTWORK, SPOOLER, STARTUP, TEMPDIR, TERMINFO, BACKUPDIR), the log, dump and
#   diagnostic settings (DEBUG, DEADLOCK, ERRLOG, PDUMP), the security throttle PWDELAY, the sizing and combining parameters config.c does not range-check or checks against each other
#   (CMDSTACK, FDS, MAXIDLEN, NUMFILES, NUMUSERS, OBJECTS, OBJMEM, PHANTOMS, SORTMEM, USERPOOL) and the ones that change what existing programs compute or how files are
#   written (FLTDIFF, FSYNC, INTPREC, MUSTLOCK, SAFEDIR, YEARBASE, SCREENTHEME).  (27 Oct 26, S.87: APILOGIN, CODEPAGE, CREATUSR, EXCLREM, FIXUSERS, GDI, JNLDIR, JNLMODE, PORTMAP, RINGWAIT and TXCHAR were removed from the parser.)
#   sdsys/config.table has the same split in its 'write' column with one reason per parameter; gplbld/test-confset-elevate-units.py holds this list to config.c and to that table.
#   ***AN UNRECOGNISED NAME IN sd.conf STOPS SD AND EVERY NEW SESSION FROM STARTING (config.c)***: that is why the name is checked against a list and never against a pattern.
#   THE VALUE is a whole number of up to 7 digits, no sign, no leading zero, inside the range - so no byte of it can be a second line, a quote or a comment.
#   THE WRITE.  The line is added or replaced inside an [sd] section (config.c reads lines only there: one appended after another section's header would be ignored without a word);
#   a second KEY= line in an [sd] section is dropped (config.c keeps the last, so a stale one would win over the new); every other line is kept as it was; the new file is made beside
#   the old, given its owner and mode, the old one is copied to sd.conf.bak (ONE generation: the file as it was before this change), and the new file is renamed over sd.conf.  Nothing
#   is written when the file already says that; the file is read back.
#   THE CALLER.  Only sdsys is given this helper by sudoers (sdsys ALL=(root) NOPASSWD: sd-elevate; %sdusers get four exact argument lists, none of them conf-set).  As the other verbs do
#   not ask who the caller is, that is where they stop; conf-set also refuses a caller sudo says is somebody else, so that a widened sudoers line does not widen this.
#
# gplbld/test-confset-elevate-units.py cuts the functions between the markers out of this file and runs them on scratch files, as test-bakdir-elevate-units.py does for the backup
# directory; keep the lines, and keep the code between them free of anything but die().

# BEGIN confset_functions
CS_WRITABLE="CLEANUP DHCACHE GRPSIZE LGNWAIT LPTRHIGH LPTRWIDE MAXCALL MAXRLOCK NETREPLY NETWAIT NUMLOCKS RECCACHE SORTMRG USPLIT"

confset_fixed() {   # confset_fixed KEY - true when KEY is a parameter config.c takes that conf-set does not change
  case $1 in
    BACKUPDIR|CMDSTACK|DEADLOCK|DEBUG|DUMPDIR|ERRLOG|FDS|FLTDIFF|FSYNC|GRPDIR|INTPREC|MAXIDLEN|MUSTLOCK|NETFILES) return 0 ;;
    NUMFILES|NUMUSERS|OBJECTS|OBJMEM|PDUMP|PHANTOMS|PWDELAY|SAFEDIR|SCREENTHEME|SDCLIENT|SDSYS|SH|SH1|SORTMEM|SORTWORK|SPOOLER) return 0 ;;
    STARTUP|TEMPDIR|TERMINFO|USERPOOL|USRDIR|YEARBASE) return 0 ;;
  esac
  return 1
}

confset_limits() {   # confset_limits KEY - sets CS_MIN, CS_MAX (config.c's rangecheck) and CS_EFFECT for a parameter conf-set may change; false for any other name
  case $1 in
    CLEANUP)  CS_MIN=30; CS_MAX=3600;    CS_EFFECT=restart ;;
    DHCACHE)  CS_MIN=0;  CS_MAX=1024;    CS_EFFECT=session ;;
    GRPSIZE)  CS_MIN=1;  CS_MAX=8;       CS_EFFECT=session ;;
    LGNWAIT)  CS_MIN=0;  CS_MAX=32767;   CS_EFFECT=restart ;;
    LPTRHIGH) CS_MIN=10; CS_MAX=32767;   CS_EFFECT=session ;;
    LPTRWIDE) CS_MIN=10; CS_MAX=1000;    CS_EFFECT=session ;;
    MAXCALL)  CS_MIN=10; CS_MAX=1000000; CS_EFFECT=session ;;
    MAXRLOCK) CS_MIN=0;  CS_MAX=100000;  CS_EFFECT=session ;;
    NETREPLY) CS_MIN=1;  CS_MAX=3600;    CS_EFFECT=session ;;
    NETWAIT)  CS_MIN=1;  CS_MAX=3600;    CS_EFFECT=session ;;
    NUMLOCKS) CS_MIN=1;  CS_MAX=32767;   CS_EFFECT=restart ;;
    RECCACHE) CS_MIN=0;  CS_MAX=32;      CS_EFFECT=session ;;
    SORTMRG)  CS_MIN=2;  CS_MAX=10;      CS_EFFECT=session ;;
    USPLIT)   CS_MIN=0;  CS_MAX=1;       CS_EFFECT=restart ;;
    *) return 1 ;;
  esac
  return 0
}

confset_caller() {   # confset_caller - dies unless sudo says the caller is sdsys; a run by root with no sudo (SUDO_USER unset) is not asked
  [[ -z ${SUDO_USER:-} || ${SUDO_USER:-} == sdsys ]] || die "conf-set is the administrator's (the user sdsys); sudo says it was asked for by another user"
}

confset_check() {   # confset_check KEY VALUE - dies unless conf-set may write VALUE as KEY's value; sets CS_MIN, CS_MAX and CS_EFFECT.  The offending text is not echoed until it has passed
  local k=$1 v=$2
  local LC_ALL=C
  [[ -n $k ]] || die "no parameter name was given"
  [[ $k =~ ^[A-Z][A-Z0-9]*$ ]] || die "the parameter name holds a character that is not a capital letter or a digit: sd.conf spells a parameter in capitals (CLEANUP, not cleanup) and SD does not start when it meets a name it does not know"
  [[ ${#k} -le 12 ]] || die "the parameter name is longer than any parameter SD has"
  if ! confset_limits "$k"; then
    if confset_fixed "$k"; then
      die "$k is a parameter SD knows, and conf-set does not change it (a door, a path or a command, a log or security setting, a size config.c does not check, or one nothing acts on): tool.config says why, and the line to add by hand"
    fi
    die "$k is not a parameter SD knows, so nothing was written (a name SD does not know in sd.conf stops SD from starting)"
  fi
  [[ -n $v ]] || die "no value was given for $k"
  [[ $v =~ ^[0-9]+$ ]] || die "the value must be a whole number written with digits only: no sign, point, space, quote or line break"
  [[ ${#v} -le 7 ]] || die "the value has more than 7 digits"
  [[ $v == 0 || $v != 0* ]] || die "the value must not start with a zero"
  (( 10#$v >= CS_MIN && 10#$v <= CS_MAX )) || die "$v is outside the range $CS_MIN to $CS_MAX that SD accepts for $k"
}

# confset_scan FILE KEY - reads FILE as config.c does: a line beginning # and an empty line are skipped, a line beginning [ names the section (up to the first ], 32 characters, capitals), and
# a KEY= line counts only inside an [sd] section.  Sets CS_L (the lines), CS_N (how many), CS_FIRST (the index of the first KEY= line in an [sd] section, -1 when there is none), CS_DROPS
# (" i j " for the later ones), CS_COUNT (how many there are) and CS_AFTER (the index to add a line after: the last line that sets anything in the last [sd] section, or its header; -1 when no
# [sd] section exists).
confset_scan() {
  local f=$1 k=$2 i line name insd=0
  local LC_ALL=C
  mapfile -t CS_L < "$f"
  CS_N=${#CS_L[@]}
  CS_FIRST=-1; CS_AFTER=-1; CS_COUNT=0; CS_DROPS=" "
  for (( i = 0; i < CS_N; i++ )); do
    line=${CS_L[i]}
    [[ -n $line && ${line:0:1} != '#' ]] || continue
    if [[ ${line:0:1} == '[' ]]; then
      name=${line:1}
      name=${name%%]*}
      name=${name:0:32}
      name=${name^^}
      if [[ $name == SD ]]; then insd=1; CS_AFTER=$i; else insd=0; fi
      continue
    fi
    (( insd )) || continue
    CS_AFTER=$i
    if [[ $line == "$k="* ]]; then
      CS_COUNT=$(( CS_COUNT + 1 ))
      if (( CS_FIRST < 0 )); then CS_FIRST=$i; else CS_DROPS="$CS_DROPS$i "; fi
    fi
  done
}

conf_set() {   # conf_set FILE KEY VALUE - after confset_check: FILE's KEY= line in its [sd] section becomes KEY=VALUE (or is added), every other line is kept, the old FILE stays as FILE.bak; sets CS_CHANGED
  local f=$1 k=$2 v=$3 bak=$1.bak tmp i
  local -a out
  [[ -f $f && ! -L $f ]] || die "$f is not a regular file"
  if [[ -e $bak || -L $bak ]]; then
    [[ -f $bak && ! -L $bak ]] || die "$bak is not a regular file"
  fi
  tr -d '\000' < "$f" | cmp -s -- - "$f" || die "$f holds a NUL byte, so it is not rewritten"
  confset_scan "$f" "$k"
  (( CS_AFTER >= 0 )) || die "$f has no [sd] section, so there is nowhere to put $k"
  out=()
  for (( i = 0; i < CS_N; i++ )); do
    if (( i == CS_FIRST )); then
      out+=("$k=$v")
    elif [[ $CS_DROPS == *" $i "* ]]; then
      :
    else
      out+=("${CS_L[i]}")
    fi
    if (( CS_FIRST < 0 && i == CS_AFTER )); then out+=("$k=$v"); fi
  done
  tmp=$(mktemp "$f.XXXXXX") || die "cannot create a temp file beside $f"
  printf '%s\n' "${out[@]}" > "$tmp" || { rm -f -- "$tmp"; die "writing $f failed"; }
  CS_CHANGED=0
  if cmp -s -- "$tmp" "$f"; then
    rm -f -- "$tmp"
    return 0
  fi
  chown --reference="$f" -- "$tmp" && chmod --reference="$f" -- "$tmp" \
    && cp -p -- "$f" "$bak" \
    && mv -f -- "$tmp" "$f" \
    || { rm -f -- "$tmp"; die "writing $f failed"; }
  confset_scan "$f" "$k"
  [[ $CS_COUNT -eq 1 && $CS_N -eq ${#out[@]} && ${CS_L[CS_FIRST]} == "$k=$v" ]] || die "$f does not read back as written (the file as it was is $bak)"
  for (( i = 0; i < CS_N; i++ )); do
    [[ ${CS_L[i]} == "${out[i]}" ]] || die "$f does not read back as written (the file as it was is $bak)"
  done
  CS_CHANGED=1
}
# END confset_functions

# ------------------------------------------- the sdsys user in the account groups (S.67 stage 2, D7)
#
# 19 Oct 26 dm - THE OWNER'S DECISION OF 17 OCT 2026 (D7), TAKEN WITH THE WIDER OF TWO OPTIONS AND WARNED: SDSYS WRITES A MASTER EDIT INTO THE ACCOUNT'S
# OWN VOC OR DICTIONARY, so the sdsys OPERATING-SYSTEM USER is a member of every account's group and those files are group-writable.
# 26 Oct 26 (F6, the owner's "do f6"): THAT IS NO LONGER THE DELIVERED STATE.  The sdsys user is in no user account's group as delivered; modify.account <name> sdsys-on
# puts it in one account's group (sdsys-join + group-write below) and sdsys-off takes it out (sdsys-leave).  What follows describes what the membership is, when it is on.
# ***THAT GIVES THE sdsys OS USER WRITE ACCESS TO EVERY ACCOUNT'S VOC AND DICTIONARIES (and, through the group, to what else the group may write)***: a
# compromised sdsys is a code-execution route into every account (a VOC entry or an I-type is code that runs in the account).  The tighter option was an
# outbox the account applies itself; the owner chose not to.  What follows is the narrowest way of carrying out the choice, and nothing wider:
#
#   sdsys-join GROUP     puts the user sdsys - ONLY sdsys, whatever else is typed - into GROUP, which must be sdu_<user> for an SD user that exists
#                        (require_sd_user: not root, not sdsys, not a system account) and must itself exist.  Not sdusers, not a route group, not an
#                        sdg_ group (a group account's group is made with sdsys in it already), not any group that is not an account's own.
#   sdsys-leave GROUP    26 Oct 26, F6: the same checks as sdsys-join (require_account_group), and takes the user sdsys - ONLY sdsys - OUT of GROUP with
#                        `gpasswd -d sdsys GROUP`, the tool delgroup uses.  It removes that one membership and no other: never `usermod -G`, which would
#                        replace the user's whole group list.  A group that does not list sdsys is left alone ("sdsys is not in GROUP", exit 0), so the
#                        installer's one-time walk and `modify.account <name> sdsys-off` can be repeated.  A running session keeps the groups it started with.
#   group-write DIR      for ONE account directory (the same canonical-path rules as rmtree-account), gives the account's own group write on its VOC
#                        and on its dictionaries (the directories named voc and *.dic below it): g+rwxs on each directory, g+rw on the files directly in
#                        it.  Only where the object's group IS the account's own group (sdu_<name> in user_accounts, sdg_<name> in group_accounts -
#                        never sdusers, which every SD user is in) and its owner is the account directory's owner or sdsys; nothing else is changed.
#                        It is done on file descriptors opened with O_NOFOLLOW (python's os.fwalk), so a symbolic link a user plants in the tree
#                        cannot make root change the mode of a file elsewhere, and it does not leave the account directory's filesystem.
#
# SD_GROUP_FIXTURE and SD_GW_GROUP_FIXTURE are for --dry-run only (a free test needs a group the machine does not have); a real run ignores them.
# sdsys-leave asks the machine's own group entry who is in the group (getent), on a dry run too: a free test puts a getent of its own first on PATH.

group_exists() {   # group_exists NAME - /etc/group, or on a dry run SD_GROUP_FIXTURE (a comma list) when it is set
  if [[ $DRY -eq 1 && -n ${SD_GROUP_FIXTURE:-} ]]; then
    [[ ",$SD_GROUP_FIXTURE," == *",$1,"* ]]
  else
    getent group "$1" >/dev/null 2>&1
  fi
}

require_account_group() {   # require_account_group GROUP - dies unless GROUP is sdu_<an SD user> and exists
  local group=$1 user
  require_name "group" "$group"
  [[ $group == sdu_?* ]] || die "'$group' is not an account group (want sdu_<user>; sdsys is put into no other group)"
  user=${group#sdu_}
  require_sd_user "$user"
  group_exists "$group" || die "group '$group' does not exist"
}

group_lists_sdsys() {   # group_lists_sdsys GROUP - true when the member list of GROUP (field 4 of its group entry) holds the user sdsys as a whole name
  local members
  members=$(getent group "$1" 2>/dev/null | cut -d: -f4)
  [[ ",$members," == *",sdsys,"* ]]
}

# BEGIN gw_worker
# The work of group-write, as python3 text so that it can be run on a scratch tree by gplbld/test-accelevate-units.py.  Arguments: the account
# directory, the gid its group must have, the uids that may own what is changed (comma list), and 1 for a dry run.
read -r -d '' GW_PY <<'GW_PY_END' || true
import os
import stat
import sys

top = sys.argv[1]
gid = int(sys.argv[2])
owners = set(int(x) for x in sys.argv[3].split(",") if x)
dry = sys.argv[4] == "1"
PROG = "sd-elevate"
D_BITS = stat.S_IRWXG | stat.S_ISGID
F_BITS = stat.S_IRGRP | stat.S_IWGRP
changed_d = changed_f = same = skipped = 0


def say(s):
    print("%s: %s" % (PROG, s))


def refuse(s):
    sys.stderr.write("%s: REFUSED - %s\n" % (PROG, s))
    sys.exit(2)


def ours(st):
    return st.st_gid == gid and st.st_uid in owners


def fix(fd, st, bits, word, rel):
    global changed_d, changed_f, same
    old = stat.S_IMODE(st.st_mode)
    new = old | bits
    if new == old:
        same += 1
        return
    say("chmod %s %s" % (word, rel))
    if not dry:
        os.fchmod(fd, new)
    if word == "g+rwxs":
        changed_d += 1
    else:
        changed_f += 1


try:
    topfd = os.open(top, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
except OSError as e:
    refuse("cannot open %s: %s" % (top, e.strerror))
tst = os.fstat(topfd)
if tst.st_gid != gid:
    refuse("%s is not owned by the group the account has (gid %d, not %d)" % (top, tst.st_gid, gid))
dev = tst.st_dev
for dirpath, dirnames, filenames, dirfd in os.fwalk(top, follow_symlinks=False):
    dst = os.fstat(dirfd)
    if dst.st_dev != dev:
        dirnames[:] = []
        continue
    rel = os.path.relpath(dirpath, top)
    if dirpath == top or not (rel == "voc" or os.path.basename(dirpath).endswith(".dic")):
        continue
    dirnames[:] = []
    if not (stat.S_ISDIR(dst.st_mode) and ours(dst)):
        say("skipped %s: not owned by the account's own group and owner" % rel)
        skipped += 1
        continue
    fix(dirfd, dst, D_BITS, "g+rwxs", rel)
    for name in filenames:
        frel = os.path.join(rel, name)
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY, dir_fd=dirfd)
        except OSError as e:
            say("skipped %s: %s" % (frel, e.strerror))
            skipped += 1
            continue
        try:
            fst = os.fstat(fd)
            if not (stat.S_ISREG(fst.st_mode) and ours(fst) and fst.st_dev == dev):
                say("skipped %s: not a plain file of the account's own group and owner" % frel)
                skipped += 1
            else:
                fix(fd, fst, F_BITS, "g+rw", frel)
        finally:
            os.close(fd)
say("group-write: %d director%s and %d file(s) %s, %d already right, %d skipped%s" % (
    changed_d, "y" if changed_d == 1 else "ies", changed_f, "would be changed" if dry else "changed", same, skipped,
    " (dry run - nothing changed)" if dry else ""))
GW_PY_END
# END gw_worker

require_group_write_target() {   # require_group_write_target DIR - dies unless DIR is an account directory whose group is the account's own; sets GW_GROUP GW_GID GW_OWNERS
  local kind dirgroup sdsys_uid
  account_dir_checked "$1"
  kind=${ACCT_REAL%/*}
  kind=${kind##*/}
  if [[ $kind == user_accounts ]]; then GW_GROUP=sdu_$ACCT_NAME; else GW_GROUP=sdg_$ACCT_NAME; fi
  if [[ $DRY -eq 1 && -n ${SD_GW_GROUP_FIXTURE:-} ]]; then GW_GROUP=$SD_GW_GROUP_FIXTURE; fi
  dirgroup=$(stat -c %G -- "$ACCT_REAL" 2>/dev/null) || die "cannot read '$ACCT_REAL'"
  [[ $dirgroup == "$GW_GROUP" ]] \
    || die "'$ACCT_REAL' belongs to group '$dirgroup', not to the account's own group '$GW_GROUP': nothing is changed (a group that other accounts are in is never given write here)"
  GW_GID=$(stat -c %g -- "$ACCT_REAL") && GW_OWNERS=$(stat -c %u -- "$ACCT_REAL") || die "cannot read '$ACCT_REAL'"
  if sdsys_uid=$(id -u sdsys 2>/dev/null) && [[ $sdsys_uid =~ ^[0-9]+$ ]]; then GW_OWNERS=$GW_OWNERS,$sdsys_uid; fi
}

