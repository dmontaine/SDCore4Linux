    # sdidx.
    printf '%s: %s -p %s %s\n' "$PROG" "$SD_SYS_ROOT_REAL/bin/sdidx" "$1" "$2"
    printf '%s: %s -q %s\n' "$PROG" "$SD_SYS_ROOT_REAL/bin/sdidx" "$1"
    [[ $DRY -eq 1 ]] && exit 0
    need_root
    "$SD_SYS_ROOT_REAL/bin/sdidx" -p "$1" "$2" || die "sdidx -p failed (status $?)"
    q=$("$SD_SYS_ROOT_REAL/bin/sdidx" -q "$1" 2>&1) || die "sdidx -q failed (status $?)"
    [[ $q == *"Index directory is $2"* ]] || die "sdidx -q does not show the new path: ${q//$'\n'/ | }"
    printf '%s: index path of %s is now %s\n' "$PROG" "$1" "$2"
    exit 0
    ;;

  # 02 Oct 26 dm - S.53.  See "the backup directory" above.  Makes a directory SDSYS could
  # not make for itself, owned by sdsys, mode 0700 - and only below the allowed places.  The
  # success line is the one !acc_os_bakdir anchors on: nothing else prints "BACKUPDIR directory made".
  bakdir-make)
    [[ $# -eq 1 ]] || usage
    bakdir_plan "$1" "$SD_BAKROOTS"
    if ! sd_group=$(id -gn sdsys 2>/dev/null); then
      [[ $DRY -eq 1 ]] || die "the user sdsys does not exist"
      sd_group='(sdsys is not on this machine)'
    fi
    printf '%s: make %s (below %s) owned by sdsys:%s, mode 0700\n' "$PROG" "$1" "$BAK_REAL" "$sd_group"
    [[ $DRY -eq 1 ]] && exit 0
    need_root
    bakdir_make sdsys "$sd_group"
    logger -t sd-elevate "bakdir-make: made $BAK_MADE for sdsys" 2>/dev/null || true
    printf '%s: BACKUPDIR directory made %s (as %s)\n' "$PROG" "$1" "$BAK_MADE"
    exit 0
    ;;

  # 19 Oct 26 dm - S.67 stage 2 (D7).  See "the sdsys user in the account groups" above.  The user is NOT an argument: it is sdsys, written
  # here, so the verb cannot put anybody else in a group, nor sdsys in a group that is not an account's own.
  sdsys-join)
    [[ $# -eq 1 ]] || usage
    require_account_group "$1"
    [[ $DRY -eq 1 ]] || id -u sdsys >/dev/null 2>&1 || die "the user sdsys does not exist"
    cmd=(usermod -aG "$1" -- sdsys)
    LOG_LINE="sdsys-join: the user sdsys is now in $1"
    ;;

  # 26 Oct 26 dm - F6.  The other half of sdsys-join, with the same checks and the same rule that the user is written here.  gpasswd -d takes out the one
  # membership; a group that does not list sdsys is not an error (the walk and `sdsys-off` are repeatable) and is not touched.
  sdsys-leave)
    [[ $# -eq 1 ]] || usage
    require_account_group "$1"
    if ! group_lists_sdsys "$1"; then
      printf '%s: sdsys is not in %s\n' "$PROG" "$1"
      exit 0
    fi
    [[ $DRY -eq 1 ]] || id -u sdsys >/dev/null 2>&1 || die "the user sdsys does not exist"
    cmd=(gpasswd -d sdsys "$1")
    LOG_LINE="sdsys-leave: the user sdsys is no longer in $1"
    ;;

  # The work is the python3 text GW_PY; the account is checked here first.  The result line is the one witness-masters.sh anchors on.
  group-write)
    [[ $# -eq 1 ]] || usage
    require_group_write_target "$1"
    printf '%s: group-write %s (group %s, gid %s; owners uid %s)\n' "$PROG" "$ACCT_REAL" "$GW_GROUP" "$GW_GID" "$GW_OWNERS"
    need_root
    python3 -I -c "$GW_PY" "$ACCT_REAL" "$GW_GID" "$GW_OWNERS" "$DRY" || exit $?
    [[ $DRY -eq 1 ]] || logger -t sd-elevate "group-write: the VOC and dictionaries of $ACCT_REAL are group-writable for $GW_GROUP" 2>/dev/null || true
    exit 0
    ;;

  # The success line is the one !acc_os_bakdir anchors on: nothing else prints "BACKUPDIR is now".
  bakdir-set)
    [[ $# -eq 1 ]] || usage
    bakdir_checked "$1"
    printf '%s: set BACKUPDIR=%s in %s\n' "$PROG" "$1" "$SD_CONF"
    [[ $DRY -eq 1 ]] && exit 0
    need_root
    conf_set_backupdir "$SD_CONF" "$1"
    logger -t sd-elevate "bakdir-set: the backup directory is now $1" 2>/dev/null || true
    printf '%s: BACKUPDIR is now %s in %s\n' "$PROG" "$1" "$SD_CONF"
    exit 0
    ;;

  # 26 Oct 26 dm - S.75 A6.  See "the parameters of sd.conf" above.  The success line is the one SET.CONFIG anchors on: nothing else prints " is now <value> in " (the dry run stops
  # before it, and every refusal is a die).  The file is /etc/sd.conf and nothing a caller passes moves it.
  conf-set)
    [[ $# -eq 2 ]] || die "conf-set takes exactly two arguments, a parameter's name and its value (set.config PARAMETER VALUE)"
    confset_check "$1" "$2"
    printf '%s: set %s=%s in %s\n' "$PROG" "$1" "$2" "$SD_CONF"
    [[ $DRY -eq 1 ]] && exit 0
    need_root
    confset_caller
    conf_set "$SD_CONF" "$1" "$2"
    cs_note=''
    [[ $CS_CHANGED -eq 1 ]] || cs_note=' (it already was; nothing was written)'
    logger -t sd-elevate "conf-set: $1 is now $2 in $SD_CONF$cs_note" 2>/dev/null || true
    printf '%s: %s is now %s in %s%s; takes effect: %s\n' "$PROG" "$1" "$2" "$SD_CONF" "$cs_note" "$CS_EFFECT"
    exit 0
    ;;

  *)
    die "unknown verb '$verb'"
    ;;
esac

[[ ${#cmd[@]} -gt 0 ]] || die "internal: no command was built for '$verb'"

# Instrument rule: say what was RESOLVED, not what was asked for.
printf '%s: %s\n' "$PROG" "${cmd[*]}"
[[ -z $FC_PATH ]] || printf '%s: %s\n' "$PROG" "$FC_NOTE"
[[ -z $SG_PATH ]] || printf '%s: %s\n' "$PROG" "(opened as a directory without following a link, found to be where it was checked, and the setgid bit set through the open directory)"
for m in "${extra[@]:-}"; do
  [[ -n $m ]] && printf '%s: gpasswd -a %s %s\n' "$PROG" "$m" "${cmd[-1]}"
done

if [[ $DRY -eq 1 ]]; then
  exit 0
fi

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  die "must run as root (it is invoked through sudo); use --dry-run to validate"
fi

if [[ -n $FC_PATH ]]; then
  python3 -I -c "$FC_PY" "$FC_PATH" "$FC_OWNER" "$FC_GROUP" "$FC_USER" || exit $?
elif [[ -n $SG_PATH ]]; then
  python3 -I -c "$SG_PY" "$SG_PATH" || exit $?
else
  "${cmd[@]}" || exit $?
fi

for m in "${extra[@]:-}"; do
  [[ -n $m ]] || continue
  gpasswd -a "$m" "${cmd[-1]}" || exit $?
done

[[ -z ${LOG_LINE:-} ]] || logger -t sd-elevate "$LOG_LINE" 2>/dev/null || true

exit 0
