* verify-lcnames.bp - the BASIC half of gplbld/verify-lcnames.py.  Plan
* section M3, one category at a time.
*
* STAGED, COMPILED AND RUN BY verify-lcnames.py IN THE CALLER'S OWN ACCOUNT.
*
* WHY BASIC: every verb that could look at the VOC FOLDS the id - CT VOC
* $SAVEDLISTS finds $savedlists - so no verb can say which spelling is actually
* on disk.  A READ of a DYNAMIC file is an exact match, and that is the
* instrument.
*
*    RUN BP ZZLCN READ id    report which spellings of id exist
*    RUN BP ZZLCN DOWN id    move id to UPCASE(id) (an account from before the
*                            rename)
*    RUN BP ZZLCN UP id      move it back, if it is still upper case
*
* id is the lower-case name, e.g. $savedlists.  Every answer is TAG=value on its
* own line, each printed on one path only.
*
program zzlcn

   mode = upcase(field(trim(@sentence), ' ', 4))
   lid = field(trim(@sentence), ' ', 5)
   uid = upcase(lid)
   crt 'ZZLCN.MODE=':mode
   crt 'ZZLCN.ID=':lid

   if lid = '' or lid # downcase(lid) then
      crt 'ZZLCN.FATAL=id must be given in lower case'
      stop
   end

   open 'VOC' to v.f else
      crt 'ZZLCN.FATAL=cannot open VOC'
      stop
   end

   begin case
      case mode = 'READ'
         null

      case mode = 'DOWN'
         readu rec from v.f, lid then
            write rec to v.f, uid
            delete v.f, lid
            crt 'DOWN=1'
         end else
            release v.f, lid
            crt 'DOWN=0'
         end

      case mode = 'UP'
         read lrec from v.f, lid then
            crt 'UP=nothing'
         end else
            readu rec from v.f, uid then
               write rec to v.f, lid
               delete v.f, uid
               crt 'UP=moved'
            end else
               release v.f, uid
               crt 'UP=neither'
            end
         end

      case 1
         crt 'ZZLCN.FATAL=unknown mode'
         stop
   end case

   read x from v.f, lid then crt 'EXACT.LOWER=Y' else crt 'EXACT.LOWER=N'
   read x from v.f, uid then crt 'EXACT.UPPER=Y' else crt 'EXACT.UPPER=N'
   crt 'ZZLCN.END=1'
end
