#!/usr/bin/env python3
#
# sd-accarchive - the archive step of BACKUP.ACCOUNT and RESTORE.ACCOUNT, SD Core
#                 for Linux (S.50, owner 30 Sep / 1 Oct 2026; Windows RELEASE_1.1 116).
#
# START-HISTORY:
# 01 Oct 26 dm  Written for S.50.  The archive format is agreed with SD Core for
#               Windows by mail (to-windows/2026-09-30T2359, 2026-10-01T1030):
#               a zip, deflate or stored, "/" separators, manifest.txt at the
#               root and one tree per account under accounts/<name>/, a directory
#               entry ("name/", stored, no data) for EVERY directory, empty or not.
# END-HISTORY
#
# START-DESCRIPTION:
#
#   sd-accarchive pack NAME=DIR [NAME=DIR ...]
#       The manifest on stdin, the zip on stdout.  Run as root by
#       "sd-elevate backup-pack", which has already checked that every DIR is an
#       account directory; this program reads nothing else.  Prints one line per
#       account on stderr:  COUNT <name> <files> <bytes> <dirs>
#   sd-accarchive count DIR
#       Counts DIR the way pack stores it.  Prints  COUNT . <files> <bytes> <dirs>
#   sd-accarchive extract ZIP TARGET
#       Unpacks the whole archive into TARGET, which must not exist.  Run by the
#       SDSYS session itself, without root.  Prints one COUNT line per account.
#
#   Exit 0 done, 2 refused (one "sd-accarchive: REFUSED - <why>" line on
#   stderr), 3 an I/O failure part way (same shape, "FAILED").
#
# WHAT IS COUNTED, AND WHY pack AND count MUST AGREE.  The verb writes the
# manifest's files/bytes/dirs from "count" BEFORE packing, then compares them
# with what pack reports it WROTE; a mismatch deletes the zip.  So both walk the
# tree with one function: a directory below DIR is one dir, a regular file is one
# file and its size in bytes.  DIR itself is not counted.
#
# SYMLINKS AND SPECIAL FILES ARE NEVER FOLLOWED AND NEVER STORED.  pack runs as
# root, so following a link planted in an account (to /etc/shadow, say) would
# copy a file the administrator cannot read into a zip the administrator can.
# Each one is skipped and named on stderr ("SKIPPED <path> (symlink)"), and
# count skips the same ones, so the counts still agree.  Files are opened with
# O_NOFOLLOW, so a file swapped for a link between the walk and the open is
# refused, not followed.
#
# EXTRACT CHECKS THE WHOLE ARCHIVE BEFORE IT WRITES ANYTHING.  Refused: no
# manifest.txt; a name outside manifest.txt and accounts/<name>/; an absolute
# name; ".", ".." or an empty segment; a backslash; a control character; a
# duplicate name; a symlink entry.  Case-only pairs are NOT refused here: on
# Linux "MyProg" and "myprog" are two records (agreed with Windows, whose
# extractor refuses them because NTFS cannot hold both).
#
# WHAT IT DOES NOT DO.  It does not read or check the manifest's contents; the
# verb does.  It does not set ownership; RESTORE.ACCOUNT's acc_os_place does,
# as root.  It does not compress or store anything outside the named trees.
#
# END-DESCRIPTION

import os
import re
import stat
import sys
import time
import zipfile

PROG = "sd-accarchive"
NAME_RE = re.compile(r"^[a-z][a-z0-9._-]{0,31}$")
CHUNK = 1 << 20


class Refused(Exception):
    pass


class Failed(Exception):
    pass


def note(line):
    sys.stderr.write(line + "\n")
    sys.stderr.flush()


def walk(top, on_dir, on_file, skipped):
    """Visit every entry below top without following links, in a stable order.
    on_dir(rel) for each directory, on_file(rel, path) for each regular file;
    anything else is appended to skipped as (rel, why)."""
    stack = [""]
    while stack:
        rel_dir = stack.pop()
        path_dir = os.path.join(top, rel_dir) if rel_dir else top
        try:
            entries = sorted(os.scandir(path_dir), key=lambda e: e.name)
        except OSError as e:
            raise Failed("cannot list %s: %s" % (path_dir, e.strerror))
        subdirs = []
        for e in entries:
            rel = rel_dir + "/" + e.name if rel_dir else e.name
            try:
                st = e.stat(follow_symlinks=False)
            except OSError as ex:
                raise Failed("cannot stat %s: %s" % (e.path, ex.strerror))
            if stat.S_ISLNK(st.st_mode):
                skipped.append((rel, "symlink"))
            elif stat.S_ISDIR(st.st_mode):
                on_dir(rel)
                subdirs.append(rel)
            elif stat.S_ISREG(st.st_mode):
                on_file(rel, e.path, st)
            else:
                skipped.append((rel, "not a regular file"))
        stack.extend(reversed(subdirs))


def count_tree(top):
    totals = {"files": 0, "bytes": 0, "dirs": 0}
    skipped = []

    def on_dir(rel):
        totals["dirs"] += 1

    def on_file(rel, path, st):
        totals["files"] += 1
        totals["bytes"] += st.st_size

    walk(top, on_dir, on_file, skipped)
    return totals, skipped


def zip_time(mtime):
    t = time.localtime(mtime)
    if t.tm_year < 1980:
        return (1980, 1, 1, 0, 0, 0)
    return t[:6]


def check_manifest(data):
    if not data:
        raise Refused("the manifest on stdin is empty")
    for b in data:
        if not (b in (9, 10) or 32 <= b <= 126):
            raise Refused("the manifest is not plain ASCII text (byte %d)" % b)


def do_pack(pairs):
    accounts = []
    seen = set()
    for p in pairs:
        if "=" not in p:
            raise Refused("'%s' is not NAME=DIR" % p)
        name, d = p.split("=", 1)
        if not NAME_RE.match(name):
            raise Refused("account name '%s' is not a lower-case SD account name" % name)
        if name in seen:
            raise Refused("account '%s' is named twice" % name)
        seen.add(name)
        if not os.path.isabs(d) or not os.path.isdir(d) or os.path.islink(d):
            raise Refused("'%s' is not an absolute directory" % d)
        accounts.append((name, d))
    if not accounts:
        raise Refused("no account to pack")
    manifest = sys.stdin.buffer.read()
    check_manifest(manifest)

    out = sys.stdout.buffer
    with zipfile.ZipFile(out, "w", compression=zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
        zi = zipfile.ZipInfo("manifest.txt", zip_time(time.time()))
        zi.compress_type = zipfile.ZIP_DEFLATED
        zi.external_attr = (stat.S_IFREG | 0o644) << 16
        zf.writestr(zi, manifest)
        note("MANIFEST %d" % len(manifest))
        for name, top in accounts:
            totals = {"files": 0, "bytes": 0, "dirs": 0}
            skipped = []
            base = "accounts/" + name + "/"

            def add_dir(rel, path):
                st = os.stat(path, follow_symlinks=False)
                zi = zipfile.ZipInfo(rel + "/", zip_time(st.st_mtime))
                zi.compress_type = zipfile.ZIP_STORED
                zi.external_attr = ((stat.S_IFDIR | (st.st_mode & 0o777)) << 16) | 0x10
                zf.writestr(zi, b"")

            add_dir(base[:-1], top)

            def on_dir(rel, top=top, base=base, totals=totals):
                add_dir(base + rel, os.path.join(top, rel))
                totals["dirs"] += 1

            def on_file(rel, path, st, base=base, totals=totals):
                try:
                    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
                except OSError as e:
                    raise Failed("cannot open %s: %s" % (path, e.strerror))
                with os.fdopen(fd, "rb") as f:
                    fst = os.fstat(f.fileno())
                    if not stat.S_ISREG(fst.st_mode):
                        raise Failed("%s changed while it was being read" % path)
                    zi = zipfile.ZipInfo(base + rel, zip_time(fst.st_mtime))
                    zi.compress_type = zipfile.ZIP_DEFLATED
                    zi.external_attr = (stat.S_IFREG | (fst.st_mode & 0o777)) << 16
                    zi.file_size = fst.st_size
                    written = 0
                    with zf.open(zi, "w", force_zip64=fst.st_size > 0x7FFFFFFF) as w:
                        while True:
                            b = f.read(CHUNK)
                            if not b:
                                break
                            w.write(b)
                            written += len(b)
                totals["files"] += 1
                totals["bytes"] += written

            walk(top, on_dir, on_file, skipped)
            for rel, why in skipped:
                note("SKIPPED %s/%s (%s)" % (name, rel, why))
            note("COUNT %s %d %d %d" % (name, totals["files"], totals["bytes"], totals["dirs"]))
    out.flush()


def do_count(top):
    if not os.path.isabs(top) or not os.path.isdir(top) or os.path.islink(top):
        raise Refused("'%s' is not an absolute directory" % top)
    totals, skipped = count_tree(top)
    for rel, why in skipped:
        note("SKIPPED %s (%s)" % (rel, why))
    print("COUNT . %d %d %d" % (totals["files"], totals["bytes"], totals["dirs"]))


def check_entry(name):
    """'manifest.txt', or (account, rest, is_dir) for an accounts/ entry."""
    if name == "manifest.txt":
        return None
    if any(ord(c) < 32 or ord(c) == 127 for c in name):
        raise Refused("entry %r has a control character" % name)
    if "\\" in name:
        raise Refused("entry %r has a backslash" % name)
    if name.startswith("/"):
        raise Refused("entry %r is an absolute path" % name)
    is_dir = name.endswith("/")
    segs = (name[:-1] if is_dir else name).split("/")
    if any(s in ("", ".", "..") for s in segs):
        raise Refused("entry %r has an empty, '.' or '..' segment" % name)
    if len(segs) < 2 or segs[0] != "accounts":
        raise Refused("entry %r is outside manifest.txt and accounts/" % name)
    if not NAME_RE.match(segs[1]):
        raise Refused("entry %r names '%s', which is not a lower-case SD account name" % (name, segs[1]))
    return (segs[1], "/".join(segs[2:]), is_dir)


def do_extract(zpath, target):
    if not os.path.isabs(target):
        raise Refused("target '%s' is not absolute" % target)
    if os.path.lexists(target):
        raise Refused("target '%s' already exists; a restore never reuses one" % target)
    parent = os.path.dirname(target)
    if not os.path.isdir(parent):
        raise Refused("the target's parent '%s' is not a directory" % parent)
    try:
        zf = zipfile.ZipFile(zpath, "r")
    except (OSError, zipfile.BadZipFile) as e:
        raise Refused("'%s' is not a readable zip: %s" % (zpath, e))
    with zf:
        infos = zf.infolist()
        seen = set()
        plan = []
        has_manifest = False
        for zi in infos:
            if zi.filename in seen:
                raise Refused("entry %r appears twice" % zi.filename)
            seen.add(zi.filename)
            mode = zi.external_attr >> 16
            if zi.create_system == 3 and stat.S_ISLNK(mode):
                raise Refused("entry %r is a symlink" % zi.filename)
            parsed = check_entry(zi.filename)
            if parsed is None:
                if zi.is_dir():
                    raise Refused("manifest.txt is a directory entry")
                has_manifest = True
            plan.append((zi, parsed))
        if not has_manifest:
            raise Refused("the archive has no manifest.txt")

        os.mkdir(target, 0o700)
        totals = {}
        for zi, parsed in plan:
            if parsed is None:
                dest = os.path.join(target, "manifest.txt")
                acct = None
            else:
                acct, rest, is_dir = parsed
                totals.setdefault(acct, {"files": 0, "bytes": 0, "dirs": 0})
                dest = os.path.join(target, "accounts", acct, *rest.split("/")) if rest \
                    else os.path.join(target, "accounts", acct)
            mode = zi.external_attr >> 16
            if zi.is_dir():
                if not os.path.isdir(dest):
                    os.makedirs(dest, 0o775)
                if acct is not None and parsed[1]:
                    totals[acct]["dirs"] += 1
                continue
            d = os.path.dirname(dest)
            if not os.path.isdir(d):
                os.makedirs(d, 0o775)
            written = 0
            fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as w, zf.open(zi, "r") as r:
                while True:
                    b = r.read(CHUNK)
                    if not b:
                        break
                    w.write(b)
                    written += len(b)
            perm = (mode & 0o775) if (zi.create_system == 3 and mode & 0o777) else 0o664
            os.chmod(dest, perm | 0o600)
            mt = time.mktime(zi.date_time + (0, 0, -1))
            os.utime(dest, (mt, mt))
            if acct is not None:
                totals[acct]["files"] += 1
                totals[acct]["bytes"] += written
        # A directory implied only by a file path still counts once, so the
        # count matches a writer that omitted the entry.  Recount from disk.
        for acct in totals:
            t, skipped = count_tree(os.path.join(target, "accounts", acct))
            totals[acct]["dirs"] = t["dirs"]
        for acct in sorted(totals):
            t = totals[acct]
            print("COUNT %s %d %d %d" % (acct, t["files"], t["bytes"], t["dirs"]))


def main(argv):
    if len(argv) < 2:
        raise Refused("usage: pack NAME=DIR... | count DIR | extract ZIP TARGET")
    mode, args = argv[1], argv[2:]
    if mode == "pack":
        do_pack(args)
    elif mode == "count" and len(args) == 1:
        do_count(args[0])
    elif mode == "extract" and len(args) == 2:
        do_extract(args[0], args[1])
    else:
        raise Refused("usage: pack NAME=DIR... | count DIR | extract ZIP TARGET")


if __name__ == "__main__":
    os.umask(0o002)
    try:
        main(sys.argv)
    except Refused as e:
        note("%s: REFUSED - %s" % (PROG, e))
        sys.exit(2)
    except Failed as e:
        note("%s: FAILED - %s" % (PROG, e))
        sys.exit(3)
    except OSError as e:
        note("%s: FAILED - %s: %s" % (PROG, getattr(e, "filename", ""), e.strerror))
        sys.exit(3)
    sys.exit(0)
