opcode.byte = OP.JZE ; gosub emit.jump

opcode.byte = OP.POP ; gosub emit.simple
if look.ahead.token = TKN.END then     ;* LOCKED / END construct
gosub get.token
loop
if end.source then
err.msg = sysmsg(2948) ;* Unterminated LOCKED clause
gosub error
goto exit.back.end
