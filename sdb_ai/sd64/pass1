err.msg = sysmsg(3455)  ;* Duplicate VARSET name
goto error
end
varsets<1,pos> = u.token.string
varsets<2,pos> = var.count
varsets<3,pos> = @true
var.count += 1
goto st.subroutine.varset.continue
end else
dim.dimensions = 0

