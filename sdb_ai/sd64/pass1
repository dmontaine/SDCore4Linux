end case

case s = 'DEFINE'
define.token = field(voc.rec<1>, ' ', 2)
if not(bittest(mode, M.CASE.SENSITIVE)) then define.token = upcase(define.token)

s = field(voc.rec<1>, ' ', 3, 99)  ;* 0200
c = s[1,1]
if alpha(define.token[1,1]) and convert(name.chars, '', define.token) = '' then
begin case
case s = ''
n = 0
case num(s)
