err.msg = sysmsg(2838) ;* Misformed $DEFINE
gosub error
goto exit.proc.directive
end
n = 1

case look.ahead.token = TKN.MINUS
gosub get.token
if look.ahead.token # TKN.NUM and look.ahead.token # TKN.FLOAT then
err.msg = sysmsg(2838) ;* Misformed $DEFINE
gosub error
goto exit.proc.directive
end
