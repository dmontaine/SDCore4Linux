* Add new entry to jump stack
ins j.back.end:@vm:jump.no before jump.stack<1>

jump.no += 1

* Emit lock opcode if required

if lock.opcode then
opcode.byte = lock.opcode ; gosub emit.simple
lock.opcode = 0
