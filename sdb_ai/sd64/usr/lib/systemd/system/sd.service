[Unit]
Description=SD service start
# 25 Oct 26  The daemon sdlnxd is its own unit now (sd-lnxd.service), which this one wants: it is started after this unit's ExecStart has made the shared segment, stopped
#            with it, and started again if it dies.  See that unit for why.
Wants=sd-lnxd.service

[Service]
# 13 Sep 26  PRE_RELEASE 29.  WAS Type=forking, WHICH LEFT SD STOPPED - measured
#            on boot after boot, and on every installer start.  "sd -start" forks
#            sdlnxd, and that child calls daemon(), which forks again and exits
#            (gplsrc/sysseg.c:365/:383).  With no PIDFile systemd GUESSES the
#            main PID, sometimes picks that short-lived intermediate child, sees
#            it exit, declares the service dead and runs ExecStop - "has been
#            started" and "has been shut down" a second apart in the journal.
#            sd writes no PID file, so there is nothing to point PIDFile at.
#            ONESHOT DOES NOT GUESS: the unit is up when "sd -start" exits 0 and
#            stays up (RemainAfterExit) until it is stopped.  (Until 25 Oct 26
#            sdlnxd stayed in this unit's cgroup; it has a unit of its own now.)
#            ***WOULD FALSIFY:*** a journal still showing "sd -stop" within a
#            second of "sd -start" with no stop requested.
Type=oneshot
RemainAfterExit=yes
# 12 Sep 26  PORT_ADOPTION 19, owner's ruling of 12 Sep: SWEEP, as the port
#            does at its own service start.  The register is the inventory and
#            must hold no record whose Linux user has gone; the stale account's
#            directory goes with it, and an administrator who wants the data
#            kept suspends the account instead of deleting the user.
#
#            THE LEADING "-" IS LOAD BEARING: it tells systemd to ignore the
#            exit status, and the script exits 1 whenever anything was left
#            behind - a refused row, or a directory that would not go.  Without
#            it a stale record would refuse to start SD, which is a far worse
#            outcome than a stale record.
#
#            IT RUNS BEFORE "sd -start" SO THE REGISTER IS NOT OPEN when its
#            records are removed - the port's ordering and its reason.
#
#            ***THE SCRIPT WILL REFUSE TO SWEEP ON A MACHINE WHOSE nsswitch.conf
#            NAMES A REMOTE NAME SOURCE***, and will report instead.  That is
#            deliberate and it is a boot-time problem, not a general one: this
#            can run before sssd or nslcd is up, and a directory user is then
#            absent from NSS *and* from /etc/passwd, which is the one signature
#            the sweep treats as "gone".  --allow-remote-nss overrides it for an
#            administrator who knows the directory is up.
ExecStartPre=-/usr/local/sbin/sd-reconcile-accounts --sweep
# 25 Oct 26  -nodaemon: "sd -start" does not fork sdlnxd; sd-lnxd.service runs it.
ExecStart=/usr/local/sdsys/bin/sd -start -nodaemon
# This should be here but currently seems to crash things ...
ExecStop=/usr/local/sdsys/bin/sd -stop

[Install]
WantedBy=default.target
